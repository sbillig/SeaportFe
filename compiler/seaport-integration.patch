+    db: &'db dyn HirAnalysisDb,
+    key: SemanticInstanceKey<'db>,
+) -> SemanticInstanceKey<'db> {
+    let BodyOwner::Func(func) = key.owner(db) else {
+        return key;
+    };
+    let specializations = key.effect_providers(db).providers(db);
+    if !specializations
+        .iter()
+        .any(|specialization| is_shared_root_provider(db, &specialization.provider))
+    {
+        return key;
+    }
+    let site = EffectParamSite::Func(func);
+    let view = EffectEnvView::new(site);
+    let canonical_providers = view.providers(db);
+    let requirements = view.requirements(db);
+    let mut sources = FxHashSet::default();
+    let mut providers = Vec::with_capacity(specializations.len());
+    for specialization in specializations {
+        if matches!(
+            specialization.provider.source,
+            ProviderSource::UsesParam { site: source_site, .. } if source_site == site
+        ) {
+            providers.push(specialization.clone());
+            continue;
+        }
+        let Some(canonical) = canonical_providers
+            .iter()
+            .find(|provider| provider.provider_idx == specialization.provider.provider_idx)
+        else {
+            return key;
+        };
+        let ProviderSource::UsesParam {
+            requirement_idx, ..
+        } = canonical.source
+        else {
+            return key;
+        };
+        let Some(requirement) = requirements
+            .iter()
+            .find(|requirement| requirement.binding_idx == requirement_idx)
+        else {
+            return key;
+        };
+        let source = match &specialization.provider.source {
+            ProviderSource::UsesParam { .. } => {
+                if !sources.insert(specialization.provider.source.clone()) {
+                    return key;
+                }
+                canonical.source.clone()
+            }
+            source @ (ProviderSource::ContractField { .. }
+            | ProviderSource::RootProvider { .. }) => source.clone(),
+        };
+        providers.push(EffectProviderSpecialization {
+            provider: ProviderBinding {
+                source,
+                ..specialization.provider.clone()
+            },
+            provenance: EffectProviderProvenance::Binding {
+                owner: BodyOwner::Func(func),
+                binding: LocalBinding::EffectParam {
+                    site,
+                    idx: requirement_idx as usize,
+                    binding_name: requirement.binding_name,
+                    provider_idx: canonical.provider_idx,
+                    is_mut: requirement.is_mut,
+                },
+            },
+        });
+    }
+
+    let impl_env = key.impl_env(db);
+    let caller_scope = impl_env.normalization_scope(db);
+    // Trait solving and normalization consult the scope only for its ingot.
+    let scope = if caller_scope.ingot(db) == func.scope().ingot(db) {
+        func.scope()
+    } else {
+        caller_scope
+    };
+    let mut relevant = FxHashSet::default();
+    collect_ty_params(db, &key.subst(db).generic_args(db), &mut relevant);
+    collect_ty_params(db, &providers, &mut relevant);
+    // A predicate over parameters the key never mentions cannot help prove a
+    // goal about the callee's types. Ground predicates are kept.
+    let is_relevant = |pred: &crate::analysis::ty::trait_def::TraitInstId<'db>| {
+        let mut params = FxHashSet::default();
+        collect_ty_params(db, pred, &mut params);
+        params.is_empty() || !params.is_disjoint(&relevant)
+    };
+    let assumptions = impl_env
+        .assumptions(db)
+        .list(db)
+        .iter()
+        .copied()
+        .filter(is_relevant)
+        .collect::<Vec<_>>();
+    let witnesses = impl_env
+        .witnesses(db)
+        .iter()
+        .copied()
+        .filter(is_relevant)
+        .collect::<Vec<_>>();
+    let assumptions = if assumptions.len() == impl_env.assumptions(db).list(db).len() {
+        impl_env.assumptions(db)
+    } else {
+        PredicateListId::new(db, assumptions)
+    };
+    SemanticInstanceKey::new(
+        db,
+        key.owner(db),
+        key.subst(db),
+        EffectProviderSubst::new(db, providers),
+        ImplEnv::new(db, scope, assumptions, witnesses),
     )
 }
 
+/// Whether `provider` can only come from a checking root: its type mentions
+/// a shared provider placeholder, or it is a receive arm's runtime object
+/// re-rooted at the contract.
+fn is_shared_root_provider<'db>(
+    db: &'db dyn HirAnalysisDb,
+    provider: &ProviderBinding<'db>,
+) -> bool {
+    if let ProviderSource::RootProvider {
+        site: EffectParamSite::Contract(_),
+        registration,
+    } = &provider.source
+        && registration.site_kind
+            == crate::analysis::ty::provider::RootProviderSiteKind::ContractRecvArm
+    {
+        return true;
+    }
+    let mut params = FxHashSet::default();
+    collect_ty_params(db, &provider.provider_ty, &mut params);
+    if let Some(target_ty) = provider.semantics.target_ty {
+        collect_ty_params(db, &target_ty, &mut params);
+    }
+    params.iter().any(is_shared_provider_placeholder)
+}
+
+/// Shared provider placeholders are the only effect provider parameters owned
+/// by a module; see [`shared_effect_provider_args`].
+fn is_shared_provider_placeholder(param: &crate::analysis::ty::ty_def::TyParam<'_>) -> bool {
+    param.is_effect_provider()
+        && matches!(
+            param.owner,
+            ScopeId::Item(crate::hir_def::ItemKind::TopMod(_))
+        )
+}
+
+fn collect_ty_params<'db, T>(
+    db: &'db dyn HirAnalysisDb,
+    value: &T,
+    params: &mut FxHashSet<crate::analysis::ty::ty_def::TyParam<'db>>,
+) where
+    T: crate::analysis::ty::visitor::TyVisitable<'db> + ?Sized,
+{
+    struct Collector<'a, 'db> {
+        db: &'db dyn HirAnalysisDb,
+        params: &'a mut FxHashSet<crate::analysis::ty::ty_def::TyParam<'db>>,
+    }
+    impl<'db> crate::analysis::ty::visitor::TyVisitor<'db> for Collector<'_, 'db> {
+        fn db(&self) -> &'db dyn HirAnalysisDb {
+            self.db
+        }
+        fn visit_param(&mut self, param: &crate::analysis::ty::ty_def::TyParam<'db>) {
+            self.params.insert(param.clone());
+        }
+        fn visit_const_param(
+            &mut self,
+            param: &crate::analysis::ty::ty_def::TyParam<'db>,
+            ty: TyId<'db>,
+        ) {
+            self.params.insert(param.clone());
+            self.visit_ty(ty);
+        }
+    }
+    value.visit_with(&mut Collector { db, params });
+}
