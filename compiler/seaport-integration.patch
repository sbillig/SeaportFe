+    let params = CallableDef::Func(func).params(db);
+    let requirements = EffectEnvView::new(EffectParamSite::Func(func)).requirements(db);
+    let mut args = params.to_vec();
+    let mut ordinals: FxHashMap<crate::hir_def::Trait<'db>, usize> = FxHashMap::default();
+    let mut changed = false;
+    for (effect_idx, param_idx) in place_effect_provider_param_index_map(db, func)
+        .iter()
+        .enumerate()
+        .filter_map(|(effect_idx, param_idx)| param_idx.map(|param_idx| (effect_idx, param_idx)))
+    {
+        let Some(requirement) = requirements
+            .iter()
+            .find(|requirement| requirement.binding_idx as usize == effect_idx)
+        else {
+            continue;
+        };
+        let EffectRequirementKey::Trait(trait_inst) = requirement.key else {
+            continue;
+        };
+        let Some(&param_ty) = params.get(param_idx) else {
+            continue;
+        };
+        let is_own_provider_param = matches!(
+            param_ty.data(db),
+            crate::analysis::ty::ty_def::TyData::TyParam(param)
+                if param.is_effect_provider() && param.owner == func.scope()
+        );
+        // Other trait arguments must not name this function's parameters,
+        // or the placeholder's bound would depend on them.
+        let closed = trait_inst.args(db)[1..]
+            .iter()
+            .chain(trait_inst.assoc_type_bindings(db).values())
+            .all(|ty| !ty.has_param(db) && !ty.has_var(db) && !ty.has_invalid(db));
+        let trait_ = trait_inst.def(db);
+        let Some(name) = trait_.name(db).to_opt() else {
+            continue;
+        };
+        // The canonical requirement leaves `Self` unfilled; the provider
+        // parameter mapped to this effect supplies it.
+        let self_ty = trait_inst.self_ty(db);
+        let self_is_param = self_ty == param_ty || self_ty.has_invalid(db);
+        if !self_is_param || !is_own_provider_param || !closed {
+            continue;
+        }
+        let ordinal = ordinals.entry(trait_).or_default();
