@@ -0,0 +1,217 @@
+use core::ptr
+use std::evm::{calls::has_min_gas, Create, RawOps}
+
+#[test]
+fn admission_boundaries_and_overflow() {
+    assert!(has_min_gas(40000, 0, 0))
+    assert!(!has_min_gas(39999, 0, 0))
+    assert!(has_min_gas(40002, 1, 0))
+    assert!(!has_min_gas(40001, 1, 0))
+    assert!(has_min_gas(41064, 63, 1000))
+    assert!(!has_min_gas(41063, 63, 1000))
+    assert!(has_min_gas(41066, 64, 1000))
+    assert!(!has_min_gas(41065, 64, 1000))
+    let max = !0 as u256
+    assert!(!has_min_gas(max, max, 0))
+    assert!(!has_min_gas(max, 1, max))
+    assert!(!has_min_gas(max, max, max))
+    assert!(has_min_gas(max, 0, max - 40000))
+    assert!(!has_min_gas(max, 0, max - 39999))
+}
+
+// Deploy tiny independent EVM programs so the first GAS instruction measures
+// the forwarded allotment without compiler-generated dispatch overhead.
+fn deploy(_ runtime: u256, _ length: u256, _ salt: u256) -> Address
+uses (create: mut Create)
+{
+    let p = ptr::alloc_bytes(64)
+    core::abi::store_word(
+        ptr: p,
+        value: (0x6000600c60003960006000f3 as u256) << 160 | length << 240 | length << 184,
+    )
+    core::abi::store_word(
+        ptr: ptr::offset_bytes(p, 12),
+        value: runtime << (256 - length * 8),
+    )
+    let target = create
+        .create2_raw(
+            value: 0,
+            init_code: ptr::MemSpan::from_raw_parts(ptr: p, len: 12 + length),
+            salt,
+        )
+    assert!(target != Address::zero())
+    target
+}
+
+#[test]
+fn full_allotment()
+uses (call: mut Call, create: mut Create, raw: mut RawOps, ctx: Ctx)
+{
+    // GAS; PUSH0; MSTORE; PUSH1 32; PUSH0; RETURN
+    let target = deploy(0x5a5f5260205ff3, 7, 0)
+    let mut output = ptr::MemBuffer::alloc(32)
+    let result = call
+        .call_with_min_gas(
+            addr: target,
+            minimum: 50000,
+            reserved: 20000,
+            value: 0,
+            args: ptr::MemSpan::empty(),
+        )
+    match result {
+        Result::Err(_,) => assert!(false),
+        Result::Ok(outcome,) => {
+            assert!(outcome.success() && outcome.returndata_len() == 32)
+            raw.returndatacopy(dest: mut output, dest_offset: 0, src_offset: 0, len: 32)
+            assert!(raw.mload(output.ptr()) == 49998)
+            assert!(ctx.gas() > 20000)
+        },
+    }
+}
+
+#[test(balance = 1000)]
+fn value_forwarding_to_cold_new_account() uses (call: mut Call, ctx: Ctx) {
+    let target = Address { inner: 0x12345678 }
+    match call.call_with_min_gas(
+        addr: target,
+        minimum: 10000,
+        reserved: 20000,
+        value: 7,
+        args: ptr::MemSpan::empty(),
+    ) {
+        Result::Err(_,) => assert!(false),
+        Result::Ok(outcome,) => assert!(outcome.success() && outcome.returndata_len() == 0),
+    }
+    assert!(ctx.balance(target) == 7)
+}
+
+msg RunMsg {
+    #[selector = 1]
+    Run { target: Address, minimum: u256, reserved: u256 } -> (bool, bool, u256, u256),
+}
+pub contract Runner {
+    recv RunMsg {
+        Run { target, minimum, reserved } -> (bool, bool, u256, u256)
+        uses (call: mut Call, ctx: Ctx)
+        {
+            match call.call_with_min_gas(
+                addr: target,
+                minimum,
+                reserved,
+                value: 0,
+                args: ptr::MemSpan::empty(),
+            ) {
+                Result::Err(_,) => (false, false, 0, ctx.gas()),
+                Result::Ok(outcome,) => (
+                    true,
+                    outcome.success(),
+                    outcome.returndata_len(),
+                    ctx.gas(),
+                ),
+            }
+        }
+    }
+}
+
+#[test]
+fn exhausted_callee_preserves_reserve()
+uses (evm: mut Evm, create: mut Create)
+{
+    // JUMPDEST; PUSH1 0; JUMP: consume the entire allotment.
+    let burner = deploy(0x5b600056, 4, 1)
+    let runner = evm.create2<Runner>(value: 0, args: (), salt: 2)
+    let answer: (bool, bool, u256, u256) = evm
+        .call(
+            addr: runner,
+            gas: 120000,
+            value: 0,
+            message: RunMsg::Run { target: burner, minimum: 50000, reserved: 20000 },
+        )
+    assert!(
+        answer.0 && !answer.1 && answer.2 == 0 && answer.3 >= 20000,
+    )
+}
+
+#[test]
+fn insufficient_budget_skips_external_call()
+uses (evm: mut Evm, create: mut Create)
+{
+    // Increment slot 0 and return its new value.
+    let target = deploy(0x5f54600101805f555f5260205ff3, 13, 1)
+    let runner = evm.create2<Runner>(value: 0, args: (), salt: 2)
+    let answer: (bool, bool, u256, u256) = evm
+        .call(
+            addr: runner,
+            gas: 90000,
+            value: 0,
+            message: RunMsg::Run { target, minimum: 50000, reserved: 20000 },
+        )
+    assert!(
+        !answer.0 && !answer.1 && answer.2 == 0 && answer.3 > 50000,
+    )
+}
+
+#[test]
+fn large_return_is_not_copied() uses (evm: mut Evm, create: mut Create) {
+    // PUSH3 196608; PUSH0; RETURN.
+    let target = deploy(0x620300005ff3, 6, 1)
+    let runner = evm.create2<Runner>(value: 0, args: (), salt: 2)
+    let answer: (bool, bool, u256, u256) = evm
+        .call(
+            addr: runner,
+            gas: 170000,
+            value: 0,
+            message: RunMsg::Run { target, minimum: 100000, reserved: 20000 },
+        )
+    assert!(
+        answer.0 && answer.1 && answer.2 == 196608 && answer.3 >= 20000,
+    )
+}
+
+#[test(balance = 1000)]
+fn value_stipend_and_balance()
+uses (call: mut Call, create: mut Create, raw: mut RawOps, ctx: Ctx)
+{
+    let target = deploy(0x5a5f5260205ff3, 7, 0)
+    let mut output = ptr::MemBuffer::alloc(32)
+    match call.call_with_min_gas(
+        addr: target,
+        minimum: 50000,
+        reserved: 20000,
+        value: 7,
+        args: ptr::MemSpan::empty(),
+    ) {
+        Result::Err(_,) => assert!(false),
+        Result::Ok(outcome,) => {
+            assert!(outcome.success())
+            raw.returndatacopy(dest: mut output, dest_offset: 0, src_offset: 0, len: 32)
+            assert!(raw.mload(output.ptr()) == 52298)
+            assert!(ctx.balance(target) == 7)
+        },
+    }
+}
+
+#[test]
+fn input_is_forwarded_and_revert_is_not_bubbled()
+uses (call: mut Call, create: mut Create, raw: mut RawOps)
+{
+    // CALLDATALOAD(0); MSTORE(0); REVERT(0,32).
+    let target = deploy(0x5f355f5260205ffd, 8, 0)
+    let input = ptr::MemBuffer::alloc(4096)
+    core::abi::store_word(ptr: input.ptr(), value: 0xdeadbeef)
+    let mut output = ptr::MemBuffer::alloc(32)
+    match call.call_with_min_gas(
+        addr: target,
+        minimum: 50000,
+        reserved: 20000,
+        value: 0,
+        args: input.span(),
+    ) {
+        Result::Err(_,) => assert!(false),
+        Result::Ok(outcome,) => {
+            assert!(!outcome.success() && outcome.returndata_len() == 32)
+            raw.returndatacopy(dest: mut output, dest_offset: 0, src_offset: 0, len: 32)
+            assert!(raw.mload(output.ptr()) == 0xdeadbeef)
+        },
+    }
+}
diff --git a/crates/fe/tests/fixtures/fe_test/pointer_field_writes_in_loop.fe b/crates/fe/tests/fixtures/fe_test/pointer_field_writes_in_loop.fe
new file mode 100644
index 000000000..b52ac3c1d
--- /dev/null
+++ b/crates/fe/tests/fixtures/fe_test/pointer_field_writes_in_loop.fe
@@ -0,0 +1,115 @@
+use core::ptr
+use core::ptr::MemArray
+
+// Every call below writes through a pointer loaded from raw memory, which may
+// overwrite the pointers stored next to it. Borrow checking must keep the
+// resulting replacement families bounded across calls and loop iterations.
+
+struct Arr<T> {
+    ptr: *T,
+    len: u256,
+}
+
+impl<T> Copy for Arr<T> {}
+
+impl<T> Arr<T> {
+    fn new(_ len: u256) -> Self {
+        Arr { ptr: MemArray<T>::new_uninit(len).ptr_at(0), len }
+    }
+
+    fn at(self, _ i: u256) -> *T {
+        if i >= self.len {
+            core::panic()
+        }
+        ptr::offset(self.ptr, i)
+    }
+}
+
+struct Item {
+    t: u256,
+    id: u256,
+}
+
+impl Copy for Item {}
+
+struct Pair {
+    a: Arr<Item>,
+    b: Arr<Item>,
+    n: u256,
+}
+
+impl Copy for Pair {}
+
+fn update(_ items: Arr<Item>, _ value: u256) {
+    let item = items.at(0)
+    item.t = item.t + value
+}
+
+fn step(_ pairs: Arr<Pair>, _ i: u256) {
+    let pair = pairs.at(i)
+    update(pair.a, 1)
+    update(pair.b, 2)
+}
+
+fn apply(_ pairs: Arr<Pair>, n: u256) {
+    let mut i: u256 = 0
+    while i < n {
+        step(pairs, i)
+        i += 1
+    }
+}
+
+fn apply_inline(_ pairs: Arr<Pair>, n: u256) {
+    let mut i: u256 = 0
+    while i < n {
+        let pair = pairs.at(i)
+        update(pair.a, 20)
+        update(pair.b, 40)
+        i += 1
+    }
+}
+
+fn apply_straight(_ pairs: Arr<Pair>) {
+    let pair = pairs.at(1)
+    update(pair.a, 200)
+    update(pair.b, 200)
+    update(pair.a, 200)
+    update(pair.b, 200)
+}
+
+fn pairs(_ n: u256) -> Arr<Pair> {
+    let pairs = Arr<Pair>::new(n)
+    let mut i: u256 = 0
+    while i < n {
+        let a = Arr<Item>::new(1)
+        let b = Arr<Item>::new(1)
+        *a.at(0) = Item { t: 0, id: i }
+        *b.at(0) = Item { t: 0, id: i }
+        *pairs.at(i) = Pair { a, b, n: i }
+        i += 1
+    }
+    pairs
+}
+
+fn item(_ pairs: Arr<Pair>, _ i: u256, second: bool) -> *Item {
+    let pair = pairs.at(i)
+    let items = if second { pair.b } else { pair.a }
+    items.at(0)
+}
+
+#[test]
+fn writes_through_stored_pointers_in_loops() {
+    let pairs = pairs(2)
+    apply(pairs, n: 2)
+    apply_inline(pairs, n: 2)
+    apply_straight(pairs)
+    let first_a = item(pairs, 0, second: false)
+    let first_b = item(pairs, 0, second: true)
+    let last_a = item(pairs, 1, second: false)
+    let last_b = item(pairs, 1, second: true)
+    assert(first_a.t == 21)
+    assert(first_b.t == 42)
+    assert(last_a.t == 421)
+    assert(last_b.t == 442)
+    assert(last_b.id == 1)
+}
diff --git a/crates/fe/tests/fixtures/fe_test/pointer_loop_offset.fe b/crates/fe/tests/fixtures/fe_test/pointer_loop_offset.fe
new file mode 100644
index 000000000..c7482de56
--- /dev/null
+++ b/crates/fe/tests/fixtures/fe_test/pointer_loop_offset.fe
@@ -0,0 +1,66 @@
+use core::ptr
+use core::ptr::MemArray
+
+// Each loop reassigns a pointer derived from its own previous value. Borrow
+// checking must reach a fixed point instead of nesting one more offset per
+// iteration.
+
+fn fill(_ data: *u256, n: u256) {
+    let mut p = data
+    let mut i: u256 = 0
+    while i < n {
+        *p = i + 1
+        p = ptr::offset_bytes(p, 32)
+        i += 1
+    }
+}
+
+fn sum(_ data: *u256, n: u256) -> u256 {
+    let mut p = data
+    let mut i: u256 = 0
+    let mut total: u256 = 0
+    while i < n {
+        total += *p
+        p = ptr::offset(p, 1)
+        i += 1
+    }
+    total
+}
+
+fn skip(_ data: *u8, n: u256) -> *u8 {
+    let mut p = data
+    let mut i: u256 = 0
+    while i < n {
+        p = ptr::offset_bytes(p, 32)
+        i += 1
+    }
+    p
+}
+
+#[test]
+fn self_offset_pointer_in_loop() {
+    let values = MemArray<u256>::new_uninit(4)
+    fill(values.ptr_at(0), n: 4)
+    assert(sum(values.ptr_at(0), n: 4) == 10)
+    assert(*values.ptr_at(3) == 4)
+}
+
+#[test]
+fn nested_self_offset_pointers() {
+    let values = MemArray<u256>::new_uninit(6)
+    let mut row = values.ptr_at(0)
+    let mut i: u256 = 0
+    while i < 2 {
+        let mut cell = row
+        let mut j: u256 = 0
+        while j < 3 {
+            *cell = i * 3 + j
+            cell = ptr::offset(cell, 1)
+            j += 1
+        }
+        row = ptr::offset(row, 3)
+        i += 1
+    }
+    assert(sum(values.ptr_at(0), n: 6) == 15)
+    assert(*values.ptr_at(5) == 5)
+}
diff --git a/crates/fe/tests/fixtures/fe_test/pointer_parameter_writes_in_loop.fe b/crates/fe/tests/fixtures/fe_test/pointer_parameter_writes_in_loop.fe
new file mode 100644
index 000000000..574040ad6
--- /dev/null
+++ b/crates/fe/tests/fixtures/fe_test/pointer_parameter_writes_in_loop.fe
@@ -0,0 +1,172 @@
+use core::ptr
+
+// The functions below take Copy structs holding raw pointers and, inside
+// loops, write through several of those pointers and through a buffer
+// pointer in callees. Every write may overwrite the pointers stored in the
+// parameter places. Borrow checking must keep those conditional replacements
+// bounded: one per possibly overlapping pair of objects, not one per write
+// site, offset and loop iteration.
+
+struct Arr<T> {
+    ptr: *T,
+    len: u256,
+}
+
+impl<T> Copy for Arr<T> {}
+
+impl<T> Arr<T> {
+    fn alloc(_ len: u256) -> Self {
+        Arr { ptr: ptr::cast<u8, T>(ptr::alloc_bytes(len * 64)), len }
+    }
+
+    fn at(self, _ i: u256) -> *T {
+        if i >= self.len {
+            core::panic()
+        }
+        ptr::offset(self.ptr, i)
+    }
+}
+
+struct Item {
+    amount: u256,
+    original: u256,
+}
+
+impl Copy for Item {}
+
+struct Order {
+    start: u256,
+    len: u256,
+}
+
+impl Copy for Order {}
+
+struct Book {
+    orders: Arr<Order>,
+    items: Arr<Item>,
+    used: u256,
+    blob: *u8,
+}
+
+impl Copy for Book {}
+
+impl Book {
+    fn order(self, _ i: u256) -> *Order {
+        self.orders.at(i)
+    }
+
+    fn item(self, _ order: *Order, _ i: u256) -> *Item {
+        self.items.at(order.start + i)
+    }
+}
+
+fn store_word(_ at: *u8, _ value: u256) {
+    let word = ptr::cast<u8, u256>(at)
+    *word = value
+}
+
+fn load_word(_ at: *u8) -> u256 {
+    *ptr::cast<u8, u256>(at)
+}
+
+fn record(_ buf: *u8, _ value: u256) -> u256 {
+    let at = ptr::offset_bytes(buf, (value & 3) * 0xc0)
+    store_word(at, value)
+    store_word(ptr::offset_bytes(at, 0x20), value)
+    store_word(ptr::offset_bytes(at, 0x40), value)
+    store_word(ptr::offset_bytes(at, 0x60), value)
+    store_word(ptr::offset_bytes(at, 0x80), value)
+    store_word(ptr::offset_bytes(at, 0xa0), value)
+    value + 1
+}
+
+fn dispatch(_ buf: *u8, _ kind: u256, _ value: u256) -> u256 {
+    if kind == 0 {
+        return record(buf, value)
+    }
+    if kind == 1 {
+        return record(buf, value + 1)
+    }
+    record(buf, value + 2)
+}
+
+fn settle_item(_ book: Book, order: *Order, index: u256, acc: u256, buf: *u8) -> u256 {
+    let item = book.item(order, index)
+    let mut current = acc
+    if item.amount != 0 {
+        current = dispatch(buf, item.original, item.amount)
+    }
+    item.amount = item.original
+    if item.original != 0 {
+        current = dispatch(buf, current, item.amount)
+    }
+    item.original = current
+    store_word(book.blob, current)
+    current
+}
+
+fn check_item(_ book: Book, order: *Order, index: u256) {
+    let item = book.item(order, index)
+    if item.amount > item.original {
+        core::panic()
+    }
+    item.amount = item.original
+}
+
+fn settle(_ book: Book, available: Arr<bool>, index: u256, acc: u256, buf: *u8) -> u256 {
+    let order = book.order(index)
+    *available.at(index) = order.len != 0
+    let mut current = acc
+    let mut j: u256 = 0
+    while j < order.len {
+        current = settle_item(book, order, index: j, acc: current, buf)
+        j += 1
+    }
+    j = 0
+    while j < order.len {
+        check_item(book, order, index: j)
+        current = dispatch(book.blob, current, j)
+        j += 1
+    }
+    current
+}
+
+fn settle_all(_ book: Book, available: Arr<bool>, acc: u256, buf: *u8) -> u256 {
+    let mut current = acc
+    let mut i: u256 = 0
+    while i < book.orders.len {
+        current = settle(book, available, index: i, acc: current, buf)
+        i += 1
+    }
+    current
+}
+
+fn settle_rounds(_ book: Book, available: Arr<bool>, rounds: u256, buf: *u8) -> u256 {
+    let mut current: u256 = 0
+    let mut r: u256 = 0
+    while r < rounds {
+        current = settle_all(book, available, acc: current, buf)
+        r += 1
+    }
+    current
+}
+
+#[test]
+fn writes_through_pointer_parameters_in_loops() {
+    let orders = Arr<Order>::alloc(1)
+    *orders.at(0) = Order { start: 0, len: 2 }
+    let items = Arr<Item>::alloc(2)
+    *items.at(0) = Item { amount: 5, original: 1 }
+    *items.at(1) = Item { amount: 0, original: 0 }
+    let book = Book { orders, items, used: 2, blob: ptr::alloc_bytes(0x300) }
+    let available = Arr<bool>::alloc(1)
+    let buf = ptr::alloc_bytes(0x300)
+    let result = settle_rounds(book, available, rounds: 1, buf)
+    assert(result == 4)
+    assert(*available.at(0))
+    assert(items.at(0).amount == 4)
+    assert(items.at(1).original == 4)
+    assert(load_word(book.blob) == 4)
+    assert(load_word(ptr::offset_bytes(buf, 0x2a0)) == 3)
+    assert(load_word(ptr::offset_bytes(book.blob, 0x240)) == 3)
+}
diff --git a/crates/fe/tests/fixtures/fe_test/sol_slot.fe b/crates/fe/tests/fixtures/fe_test/sol_slot.fe
new file mode 100644
index 000000000..6d4462d96
--- /dev/null
+++ b/crates/fe/tests/fixtures/fe_test/sol_slot.fe
@@ -0,0 +1,172 @@
+// `SolSlot` reads and writes Solidity-packed fields without touching the
+// neighbouring bytes of the slot.
+use std::abi::{Bytes, Bytes4, DynString, FixedBytes}
+use std::abi::sol::{Int24, Uint24}
+use core::ptr::{self, MemSpan}
+use core::abi::store_word
+use std::evm::{Address, Evm, RawStorage, SolMapping, SolSlot, keccak256}
+
+#[test]
+fn packed_fields_round_trip() uses (evm: mut Evm) {
+    with (RawStorage = evm) {
+        // address currency; uint24 fee; int24 tickSpacing; bool flag; int8 small
+        let slot = SolSlot::at(7)
+        slot.write(offset: 0, value: Address { inner: 0xabc })
+        slot.write(offset: 20, value: Uint24 { val: 3000 })
+        slot.write(offset: 23, value: Int24 { val: -60 })
+        slot.write(offset: 26, value: true)
+        slot.write(offset: 27, value: -2 as i8)
+        slot.write(offset: 28, value: Bytes4 { val: 0x11223344 })
+
+        let currency: Address = slot.read(offset: 0)
+        let fee: Uint24 = slot.read(offset: 20)
+        let spacing: Int24 = slot.read(offset: 23)
+        let flag: bool = slot.read(offset: 26)
+        let small: i8 = slot.read(offset: 27)
+        let tag: Bytes4 = slot.read(offset: 28)
+        assert(currency.inner == 0xabc)
+        assert(fee.val == 3000)
+        assert(spacing.val == -60)
+        assert(flag)
+        assert(small == -2)
+        assert(tag.val == 0x11223344)
+
+        // Overwriting one field keeps the others.
+        slot.write(offset: 0, value: Address { inner: 0 })
+        let fee_again: Uint24 = slot.read(offset: 20)
+        assert(fee_again.val == 3000)
+        let word: u256 = SolSlot::at(7).read(offset: 0)
+        assert(word == 0x11223344fe01ffffc4000bb8 << 160)
+    }
+}
+
+#[test]
+fn bytes_and_strings_use_solidity_layout() uses (evm: mut Evm) {
+    with (RawStorage = evm) {
+        let slot = SolSlot::at(3)
+        slot.write_string("short")
+        // Short strings live in the slot: data in the high bytes, 2 * len low.
+        let head: u256 = slot.read(offset: 0)
+        assert(head == (0x73686f7274 << 216) | 10)
+        let short = slot.read_string()
+        assert(short.len() == 5)
+        assert(short.byte_at(0) == 0x73)
+        assert(short.byte_at(4) == 0x74)
+
+        let long: DynString = "a string that is longer than thirty-two bytes"
+        slot.write_string(long)
+        let head: u256 = slot.read(offset: 0)
+        assert(head == long.len() * 2 + 1)
+        let read_back = slot.read_string()
+        assert(read_back.len() == long.len())
+        assert(read_back.byte_at(0) == 0x61)
+        assert(read_back.byte_at(44) == long.byte_at(44))
+        assert(slot.read_bytes().len() == long.len())
+
+        // Shrinking clears the words the long value left behind.
+        slot.write_bytes(Bytes::from_word_prefix(word: 0xabcd << 240, len: 2))
+        let second_word: u256 = SolSlot::at(hash_words(3, 0, 1) + 1).read(offset: 0)
+        assert(second_word == 0)
+        assert(slot.read_bytes().len() == 2)
+        assert(slot.read_bytes().byte_at(1) == 0xcd)
+    }
+}
+
+#[test(should_revert)]
+fn write_past_slot_end_reverts() uses (evm: mut Evm) {
+    with (RawStorage = evm) {
+        SolSlot::at(1).write(offset: 31, value: 0x1234 as u16)
+    }
+}
+
+#[test(should_revert)]
+fn read_past_slot_end_reverts() uses (evm: mut Evm) {
+    with (RawStorage = evm) {
+        let _: Address = SolSlot::at(1).read(offset: 13)
+    }
+}
+
+#[test(should_revert)]
+fn noncanonical_fixed_bytes_write_reverts() uses (evm: mut Evm) {
+    with (RawStorage = evm) {
+        SolSlot::at(1).write(offset: 0, value: Bytes4 { val: 0x1122334455 })
+    }
+}
+
+#[test(should_revert)]
+fn zero_width_fixed_bytes_write_reverts() uses (evm: mut Evm) {
+    with (RawStorage = evm) {
+        SolSlot::at(1).write(offset: 0, value: FixedBytes<0> { val: 0 })
+    }
+}
+
+#[test(should_revert)]
+fn noncanonical_address_write_reverts() uses (evm: mut Evm) {
+    with (RawStorage = evm) {
+        SolSlot::at(1).write(offset: 0, value: Address { inner: 1 << 160 })
+    }
+}
+
+#[test]
+fn short_read_zeroes_bytes_past_len() uses (evm: mut Evm) {
+    with (RawStorage = evm) {
+        // "a" (len 1) with stray bytes behind it in the slot.
+        let head: u256 = (0x61 << 248) | (0x99 << 200) | 2
+        SolSlot::at(5).write(offset: 0, value: head)
+        let value = SolSlot::at(5).read_bytes()
+        assert(value.len() == 1)
+        assert(value.payload_span().word_at(0) == 0x61 << 248)
+    }
+}
+
+#[test]
+fn long_read_zeroes_bytes_past_len() uses (evm: mut Evm) {
+    with (RawStorage = evm) {
+        // 33 bytes: a full first word, then "b" with stray bytes behind it.
+        SolSlot::at(6).write(offset: 0, value: 33 * 2 + 1 as u256)
+        let tail: u256 = (0x62 << 248) | (0x99 << 200)
+        SolSlot::at(hash_words(6, 0, 1) + 1).write(offset: 0, value: tail)
+        let value = SolSlot::at(6).read_bytes()
+        assert(value.len() == 33)
+        assert(value.payload_span().word_at(32) == 0x62 << 248)
+    }
+}
+
+// A long head (odd) with a short length is corrupt, as in Solidity.
+#[test(should_revert, panic = 0x22)]
+fn long_head_with_short_length_panics() uses (evm: mut Evm) {
+    with (RawStorage = evm) {
+        SolSlot::at(5).write(offset: 0, value: 3 as u256)
+        let _ = SolSlot::at(5).read_bytes()
+    }
+}
+
+// A short head (even) with a length of 32 or more is corrupt, as in Solidity.
+#[test(should_revert, panic = 0x22)]
+fn short_head_with_long_length_panics() uses (evm: mut Evm) {
+    with (RawStorage = evm) {
+        SolSlot::at(5).write(offset: 0, value: 64 as u256)
+        SolSlot::at(5).write_string("x")
+    }
+}
+
+// keccak256 over the first `n` of the words `a`, `b`.
+fn hash_words(_ a: u256, _ b: u256, _ n: u256) -> u256 {
+    let buffer = ptr::alloc_bytes(64)
+    store_word(ptr: buffer, value: a)
+    store_word(ptr: ptr::offset_bytes(buffer, 32), value: b)
+    keccak256(MemSpan::from_raw_parts(ptr: buffer, len: n * 32))
+}
+
+#[test]
+fn mapping_slots_follow_solidity() {
+    // mapping(uint256 => V) at slot 3: keccak256(abi.encode(key, 3))
+    assert(SolMapping::at(3).slot_of(5 as u256) == hash_words(5, 3, 2))
+    // Signed and custom-width keys are sign-extended like abi.encode.
+    assert(SolMapping::at(3).slot_of(Int24 { val: -1 }) == hash_words(u256::max(), 3, 2))
+    assert(SolMapping::at(3).slot_of(-1 as i16) == hash_words(u256::max(), 3, 2))
+    // mapping(address => mapping(address => V)) at slot 1
+    let a = Address { inner: 0xa }
+    let b = Address { inner: 0xb }
+    assert(SolMapping::at(1).nested(a).slot_of(b) == hash_words(0xb, hash_words(0xa, 1, 2), 2))
+}
diff --git a/crates/fe/tests/fixtures/fe_test/temporary_pointer_field.fe b/crates/fe/tests/fixtures/fe_test/temporary_pointer_field.fe
new file mode 100644
