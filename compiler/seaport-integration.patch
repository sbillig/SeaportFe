+struct IsolatedObjectCompiler<'db, 'a> {
+    db: &'db DriverDataBase,
+    package: &'a RuntimePackage<'db>,
+    opt_level: OptLevel,
+    emit_observability: bool,
+    compiled: HashMap<String, ObjectArtifact>,
+    in_progress: FxHashSet<String>,
