+++ b/crates/fe/tests/fixtures/fe_test/erc1167_clones.fe
@@ -0,0 +1,190 @@
+use std::evm::{clones, Create, RawMem}
+
+msg ProxyMsg {
+    #[selector = sol("set(uint256)")]
+    Set { next: u256 },
+    #[selector = sol("get()")]
+    Get -> u256,
+    #[selector = sol("context()")]
+    Context -> (Address, Address),
+    #[selector = sol("fail()")]
+    Fail,
+}
+
+pub contract Implementation {
+    mut value: u256,
+    init() uses (mut value) { value = 99 }
+    recv ProxyMsg {
+        Set { next } uses (mut value) {
+            value = next
+        }
+        Get -> u256 uses (value) {
+            value
+        }
+        Context -> (Address, Address) uses (ctx: Ctx) {
+            (ctx.address(), ctx.caller())
+        }
+        Fail {} {
+            revert((0xdeadbeef as u256) << 224)
+        }
+    }
+}
+
+#[test]
+fn deterministic_address_and_isolated_storage()
+uses (evm: mut Evm, ctx: Ctx, create: mut Create, mem: mut RawMem)
+{
+    let implementation = evm.create2<Implementation>(value: 0, args: (), salt: 0)
+    let predicted = clones::predict_deterministic_address(
+        implementation,
+        salt: 42,
+        deployer: ctx.address(),
+    )
+    let proxy = clones::clone_deterministic(implementation, salt: 42, value: 0)
+    assert!(proxy == predicted)
+    assert!(ctx.extcodesize(proxy) == 45)
+    let initial: u256 = evm.call(
+            addr: proxy,
+            gas: 100000,
+            value: 0,
+            message: ProxyMsg::Get {},
+        )
+    assert!(initial == 0)
+    evm.call(
+        addr: proxy,
+        gas: 100000,
+        value: 0,
+        message: ProxyMsg::Set { next: 17 },
+    )
+    let stored: u256 = evm.call(
+            addr: proxy,
+            gas: 100000,
+            value: 0,
+            message: ProxyMsg::Get {},
+        )
+    let original: u256 = evm
+        .call(
+            addr: implementation,
+            gas: 100000,
+            value: 0,
+            message: ProxyMsg::Get {},
+        )
+    assert!(stored == 17)
+    assert!(original == 99)
+    let context: (Address, Address) = evm
+        .call(
+            addr: proxy,
+            gas: 100000,
+            value: 0,
+            message: ProxyMsg::Context {},
+        )
+    assert!(context.0 == proxy)
+    assert!(context.1 == ctx.address())
+    let other = clones::clone_deterministic(implementation, salt: 43, value: 0)
+    assert!(other != proxy)
+    let other_value: u256 = evm.call(
+            addr: other,
+            gas: 100000,
+            value: 0,
+            message: ProxyMsg::Get {},
+        )
+    assert!(other_value == 0)
+}
+
+#[test(balance = 1000)]
+fn create_and_value_forwarding()
+uses (evm: mut Evm, ctx: Ctx, create: mut Create)
+{
+    let implementation = evm.create2<Implementation>(value: 0, args: (), salt: 0)
+    let first = clones::clone(implementation, value: 11)
+    let second = clones::clone(implementation, value: 0)
+    assert!(first != second)
+    assert!(ctx.extcodesize(first) == 45)
+    assert!(ctx.balance(first) == 11)
+    assert!(ctx.balance(second) == 0)
+}
+
+#[test(should_revert, selector = 0xc2f868f4)]
+fn duplicate_salt_reverts() uses (evm: mut Evm, create: mut Create) {
+    let implementation = evm.create2<Implementation>(value: 0, args: (), salt: 0)
+    let _ = clones::clone_deterministic(implementation, salt: 1, value: 0)
+    let _ = clones::clone_deterministic(implementation, salt: 1, value: 0)
+}
+
+#[test(should_revert, selector = 0xdeadbeef)]
+fn implementation_revert_is_forwarded()
+uses (evm: mut Evm, create: mut Create)
+{
+    let implementation = evm.create2<Implementation>(value: 0, args: (), salt: 0)
+    let proxy = clones::clone(implementation, value: 0)
+    evm.call(
+        addr: proxy,
+        gas: 100000,
+        value: 0,
+        message: ProxyMsg::Fail {},
+    )
+}
+
+#[test(should_revert)]
+fn rejects_dirty_implementation() {
+    let _ = clones::clone_initcode(Address { inner: 1 << 160 })
+}
+
+// Independent CREATE2 vectors computed with cast from the standard byte sequence.
+#[test]
+fn initcode_and_prediction_vectors() uses (mem: mut RawMem) {
+    let code = clones::clone_initcode(Address { inner: 0x0 })
+    assert!(code.len() == 55)
+    assert!(
+        std::evm::crypto::keccak256(code)
+            == 0x3df3da56b3ea8de108a8606dea387d6535fca78db07a7d90f7a05ad323dd43c7,
+    )
+    assert!(
+        clones::predict_deterministic_address(
+                Address { inner: 0x0 },
+                salt: 0x0,
+                deployer: Address { inner: 0x0 },
+            )
+                .inner
+            == 0x581044648ac97323e1b73267e6efefc5e4df7296,
+    )
+    let code = clones::clone_initcode(
+        Address { inner: 0x1234567890123456789012345678901234567890 },
+    )
+    assert!(code.len() == 55)
+    assert!(
+        std::evm::crypto::keccak256(code)
+            == 0xe7971b4c6044c35b70d5a08ab3392419fc58f7b81f0d040f361f845230bfc4f6,
+    )
+    assert!(
+        clones::predict_deterministic_address(
+                Address { inner: 0x1234567890123456789012345678901234567890 },
+                salt: 0x2a,
+                deployer: Address { inner: 0xdeadbeef },
+            )
+                .inner
+            == 0x941382bbe12b952f70c4a06171d222574c8ae0b5,
+    )
+    let code = clones::clone_initcode(
+        Address { inner: 0xffffffffffffffffffffffffffffffffffffffff },
+    )
+    assert!(code.len() == 55)
+    assert!(
+        std::evm::crypto::keccak256(code)
+            == 0xda14c3403f303db48130d52dd0067668bffdab48a7bca92d8aad6944f62ea9f2,
+    )
+    assert!(
+        clones::predict_deterministic_address(
+                Address { inner: 0xffffffffffffffffffffffffffffffffffffffff },
+                salt: 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff,
+                deployer: Address { inner: 0xffffffffffffffffffffffffffffffffffffffff },
+            )
+                .inner
+            == 0x32384a86f842e859fdead08acc219b0cd0de23d9,
+    )
+}
+
+#[test(should_revert, selector = 0xc2f868f4)]
+fn insufficient_balance_reverts() uses (create: mut Create, ctx: Ctx) {
+    let _ = clones::clone(Address::zero(), value: ctx.selfbalance() + 1)
+}
diff --git a/crates/fe/tests/fixtures/fe_test/event_zero_fields.fe b/crates/fe/tests/fixtures/fe_test/event_zero_fields.fe
new file mode 100644
index 000000000..f7740b2e6
--- /dev/null
+++ b/crates/fe/tests/fixtures/fe_test/event_zero_fields.fe
@@ -0,0 +1,57 @@
+// Regression test for `#[event]` and `#[error]` structs with zero fields.
+//
+// The `#[event]` desugar used to push a `self` expression into the generated
+// `emit` body unconditionally. With no fields nothing referenced it, so the
+// orphaned expression was never typed and MIR lowering rejected the body as
+// invalid, even though `fe check` passed. A zero-field event emits LOG1 with
+// topic0 = keccak256("Paused()") and empty data, like Solidity's
+// `event Paused();`. `event_dynamic.rs` asserts the emitted log.
+
+use std::evm::{Evm, Log, revert_error}
+
+#[event]
+pub struct Paused {}
+
+#[error]
+pub struct Unauthorized {}
+
+msg ProbeMsg {
+    #[selector = sol("pause()")]
+    Pause -> u256,
+    #[selector = sol("fail()")]
+    Fail,
+}
+
+pub contract Probe uses (log: mut Log) {
+    recv ProbeMsg {
+        Pause -> u256 uses (mut log) {
+            log.emit(Paused {})
+            let ret: u256 = 1
+            ret
+        }
+
+        Fail {} {
+            revert_error(Unauthorized {})
+        }
+    }
+}
+
+#[test]
+fn topic0_paused() {
+    // cast keccak "Paused()"
+    assert!(Paused::TOPIC0 == 0x9e87fac88ff661f02d44f95383c817fece4bce600a3dab7a54406878b965e752)
+}
+
+#[test]
+fn emit_zero_field_event() uses (evm: mut Evm) {
+    let c = evm.create2<Probe>(value: 0, args: (), salt: 0)
+    let r: u256 = evm.call(addr: c, gas: 5000000, value: 0, message: ProbeMsg::Pause {})
+    assert!(r == 1)
+}
+
+// cast sig "Unauthorized()"
+#[test(should_revert, selector = 0x82b42900)]
+fn revert_zero_field_error() uses (evm: mut Evm) {
+    let c = evm.create2<Probe>(value: 0, args: (), salt: 0)
+    evm.call(addr: c, gas: 5000000, value: 0, message: ProbeMsg::Fail {})
+}
diff --git a/crates/fe/tests/fixtures/fe_test/evm_hashing.fe b/crates/fe/tests/fixtures/fe_test/evm_hashing.fe
new file mode 100644
index 000000000..a80db2729
--- /dev/null
+++ b/crates/fe/tests/fixtures/fe_test/evm_hashing.fe
@@ -0,0 +1,47 @@
+// Word hashing, packed hashing and CREATE2 addresses.
+use core::abi::ByteInput
+use std::abi::Bytes4
+use std::abi::sol::{Int24, Uint24}
+use std::evm::{Address, RawMem, create2_address, keccak256, keccak_words}
+use std::evm::packed::{EncodePacked, Packed, encode_packed, keccak_packed}
+use core::ptr::{self, MemSpan}
+
+fn hash_words(_ a: u256, _ b: u256) -> u256 uses (mem: mut RawMem) {
+    let buffer = ptr::alloc_bytes(64)
+    mem.mstore(addr: buffer, value: a)
+    mem.mstore(addr: ptr::offset_bytes(buffer, 32), value: b)
+    keccak256(MemSpan::from_raw_parts(ptr: buffer, len: 64))
+}
+
+#[test]
+fn keccak_words_matches_abi_encode() uses (mem: mut RawMem) {
+    assert(keccak_words([1, 2]) == hash_words(1, 2))
+    // keccak256(abi.encode(uint256(0))) and keccak256("")
+    assert(keccak_words([0]) == 0x290decd9548b62a8d60345a988386fc84ba6bc95484008f6362f93160ef3e563)
+    assert(keccak_words([]) == 0xc5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470)
+}
+
+#[test]
+fn keccak_packed_writes_each_type_at_its_width() uses (mem: mut RawMem) {
+    // abi.encodePacked(address(0xabc), int24(-60), uint24(3000), true, uint256(7))
+    let owner = Address { inner: 0xabc }
+    let packed = encode_packed((owner, Int24 { val: -60 }, Uint24 { val: 3000 }, true, 7 as u256))
+    assert(packed.len() == 20 + 3 + 3 + 1 + 32)
+    let span = packed.as_bytes().payload_span()
+    assert(span.word_at(0) == (0xabc << 96) | (0xffffc4 << 72) | (0x000bb8 << 48) | (1 << 40))
+    assert(span.word_at(27) == 7)
+    // The direct `write_packed` path hashes the same bytes as the builder.
+    let built = (owner, Int24 { val: -60 }, Uint24 { val: 3000 }, true, 7 as u256).pack_into(Packed::new())
+    assert(keccak_packed((owner, Int24 { val: -60 }, Uint24 { val: 3000 }, true, 7 as u256)) == built.keccak256())
+    let small = (-1 as i8, 2 as u16, Bytes4 { val: 0xdeadbeef }).pack_into(Packed::new())
+    assert(keccak_packed((-1 as i8, 2 as u16, Bytes4 { val: 0xdeadbeef })) == small.keccak256())
+}
+
+#[test]
+fn create2_address_matches_eip1014() uses (mem: mut RawMem) {
+    // EIP-1014 example 2: deployer 0xdeadbeef00000000000000000000000000000000,
+    // salt 0, init code 0x00 -> 0xB928f69Bb1D91Cd65274e3c79d8986362984fDA3
+    let deployer = Address { inner: 0xdeadbeef00000000000000000000000000000000 }
+    let init_code_hash = 0xbc36789e7a1e281436464229828f817d6612f7b477d66591ff96a9e064bcc98a
+    assert(create2_address(deployer, salt: 0, init_code_hash).inner == 0xB928f69Bb1D91Cd65274e3c79d8986362984fDA3)
+}
