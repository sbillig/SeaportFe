+/// so the substitution is a renaming. Placeholders of different functions may
+/// coincide; instance keys still carry every assumption about them.
+fn shared_effect_provider_args<'db>(
+    db: &'db dyn HirAnalysisDb,
+    func: crate::hir_def::Func<'db>,
