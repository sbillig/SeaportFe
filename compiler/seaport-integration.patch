--- /dev/null
+++ b/crates/fe/tests/fixtures/fe_test/temporary_pointer_field.fe
@@ -0,0 +1,60 @@
+use core::ptr::MemArray
+
+struct Item {
+    a: u256,
+    b: u256,
+}
+
+struct Order {
+    items: MemArray<Item>,
+    n: u256,
+}
+
+struct Link {
+    next: *Item,
+}
+
+fn first(_ orders: MemArray<Order>) -> *Order {
+    orders.ptr_at(0)
+}
+
+fn orders_with_one_item() -> MemArray<Order> {
+    let mut orders = MemArray<Order>::new_uninit(1)
+    let mut items = MemArray<Item>::new_uninit(1)
+    items[0] = Item { a: 1, b: 2 }
+    orders[0] = Order { items, n: 5 }
+    orders
+}
+
+#[test]
+fn read_field_of_temporary_pointer() {
+    let orders = orders_with_one_item()
+    assert(orders.ptr_at(0).n == 5)
+    assert(first(orders).n == 5)
+    assert(orders.ptr_at(0).items.ptr_at(0).a == 1)
+    let o = orders.ptr_at(0)
+    assert(o.items.ptr_at(0).b == 2)
+}
+
+#[test]
+fn write_field_of_temporary_pointer() {
+    let orders = orders_with_one_item()
+    orders.ptr_at(0).n = 9
+    first(orders).items.ptr_at(0).b = 7
+    orders.ptr_at(0).items.ptr_at(0).a += 5
+    let o = orders.ptr_at(0)
+    assert(o.n == 9)
+    assert(o.items.ptr_at(0).a == 6)
+    assert(o.items.ptr_at(0).b == 7)
+}
+
+#[test]
+fn field_through_pointer_field_of_temporary_pointer() {
+    let mut items = MemArray<Item>::new_uninit(1)
+    items[0] = Item { a: 3, b: 4 }
+    let mut links = MemArray<Link>::new_uninit(1)
+    links[0] = Link { next: items.ptr_at(0) }
+    assert(links.ptr_at(0).next.a == 3)
+    links.ptr_at(0).next.b = 8
+    assert(items.ptr_at(0).b == 8)
+}
diff --git a/crates/fe/tests/fixtures/fe_test/text_dynamic.fe b/crates/fe/tests/fixtures/fe_test/text_dynamic.fe
new file mode 100644
index 000000000..defbc0489
--- /dev/null
+++ b/crates/fe/tests/fixtures/fe_test/text_dynamic.fe
@@ -0,0 +1,71 @@
+use core::num::IntDowncast
+use core::ptr::{self, MemArray, MemSlice}
+use std::abi::DynString
+use std::text::{concat_slice, TextBuilder}
+
+#[test]
+fn runtime_slice_and_empty() {
+    assert!(concat_slice(MemSlice::empty()) == "")
+    let mut parts = MemArray<DynString>::new_uninit(4)
+    *parts.ptr_at(0) = "ab"
+    *parts.ptr_at(1) = ""
+    *parts.ptr_at(2) = "cde"
+    *parts.ptr_at(3) = "f"
+    assert!(concat_slice(parts.as_slice()) == "abcdef")
+    assert!(
+        concat_slice(parts.as_slice().slice(offset: 1, len: 2)) == "cde",
+    )
+    assert!(*parts.ptr_at(0) == "ab")
+}
+
+#[test]
+fn builder_empty_and_capacity() {
+    assert!(TextBuilder::new().finish() == "")
+    let mut b = TextBuilder::with_capacity(1)
+    assert!(b.is_empty())
+    b = b.push("")
+    b = b.push("a")
+    b = b.push("bc")
+    assert!(b.len() == 3)
+    assert!(!b.is_empty())
+    assert!(b.finish() == "abc")
+}
+
+#[test]
+fn growth_and_arbitrary_bytes() {
+    let input = ptr::MemBuffer::alloc(65)
+    let mut i = 0
+    while i < 65 {
+        *ptr::offset_bytes(input.ptr(), i) = i.downcast_truncate()
+        i += 1
+    }
+    *ptr::offset_bytes(input.ptr(), 64) = 255
+    let mut b = TextBuilder::new()
+    b = b.push_bytes(input.slice(offset: 0, len: 31))
+    b = b.push_bytes(input.slice(offset: 31, len: 1))
+    b = b.push_bytes(input.slice(offset: 32, len: 33))
+    let output = b.finish()
+    assert!(output.len() == 65)
+    i = 0
+    while i < 65 {
+        assert!(output.byte_at(i) == input.span().byte_at(i))
+        i += 1
+    }
+}
+
+#[test]
+fn many_fragments() {
+    let mut b = TextBuilder::new()
+    let mut i = 0
+    while i < 100 {
+        b = b.push("abcd")
+        i += 1
+    }
+    let output = b.finish()
+    assert!(output.len() == 400)
+    i = 0
+    while i < 100 {
+        assert!(output.slice(start: i * 4, len: 4) == "abcd")
+        i += 1
+    }
+}
diff --git a/crates/fe/tests/fixtures/fe_test/tuple_return_abi_params.fe b/crates/fe/tests/fixtures/fe_test/tuple_return_abi_params.fe
new file mode 100644
index 000000000..67ab63bdd
--- /dev/null
+++ b/crates/fe/tests/fixtures/fe_test/tuple_return_abi_params.fe
@@ -0,0 +1,113 @@
+// A recv arm returning a tuple is encoded like Solidity's multi-value
+// `returns (string, bytes32, address)`: a parameter list without a leading
+// offset word. A single dynamic return keeps its offset word, matching
+// Solidity's `returns (string)`.
+
+use std::abi::{Bytes32, DynString}
+use core::abi::ByteInput
+use std::evm::decode_returndata
+
+msg InfoMsg {
+    #[selector = sol("information()")]
+    Information {} -> (DynString, Bytes32, Address),
+    #[selector = sol("name()")]
+    Name {} -> DynString,
+    #[selector = sol("nested()")]
+    Nested {} -> (u256, (DynString, bool)),
+}
+
+fn version() -> DynString {
+    // "1.6"
+    DynString::from_word_prefix(word: 0x312e36 << 232, len: 3)
+}
+
+pub contract Info {
+    recv InfoMsg {
+        Information {} -> (DynString, Bytes32, Address) {
+            (version(), Bytes32 { val: 0xabcd }, Address { inner: 0x1234 })
+        }
+
+        Name {} -> DynString {
+            version()
+        }
+
+        Nested {} -> (u256, (DynString, bool)) {
+            (7, (version(), true))
+        }
+    }
+}
+
+#[test]
+fn test_tuple_return_is_encoded_as_param_list()
+uses (evm: mut Evm, call: mut Call)
+{
+    let info = evm.create2<Info>(value: 0, args: (), salt: 0)
+    let outcome = info.try_call(InfoMsg::Information {})
+    assert!(outcome.success())
+
+    // Same bytes as `cast abi-encode "f(string,bytes32,address)" "1.6" <0xabcd> <0x1234>`.
+    assert!(outcome.returndata_len() == 160)
+    let ret = outcome.returndata()
+    assert!(ret.word_at(0) == 0x60)
+    assert!(ret.word_at(32) == 0xabcd)
+    assert!(ret.word_at(64) == 0x1234)
+    assert!(ret.word_at(96) == 3)
+    assert!(ret.word_at(128) == 0x312e36 << 232)
+
+    let decoded: (DynString, Bytes32, Address) = decode_returndata(ret)
+    assert!(decoded.0 == version())
+    assert!(decoded.1.val == 0xabcd)
+    assert!(decoded.2.inner == 0x1234)
+}
+
+#[test]
+fn test_tuple_return_typed_call_round_trips()
+uses (evm: mut Evm, call: mut Call)
+{
+    let info = evm.create2<Info>(value: 0, args: (), salt: 0)
+    let (name, tag, owner) = info.call(InfoMsg::Information {})
+    assert!(name == version())
+    assert!(tag.val == 0xabcd)
+    assert!(owner.inner == 0x1234)
+
+    let (n, (s, flag)) = info.call(InfoMsg::Nested {})
+    assert!(n == 7)
+    assert!(s == version())
+    assert!(flag)
+}
+
+#[test]
+fn test_nested_tuple_return_layout() uses (evm: mut Evm, call: mut Call) {
+    let info = evm.create2<Info>(value: 0, args: (), salt: 0)
+    let outcome = info.try_call(InfoMsg::Nested {})
+    assert!(outcome.success())
+
+    // Same bytes as `cast abi-encode "f(uint256,(string,bool))" 7 '("1.6",true)'`.
+    assert!(outcome.returndata_len() == 192)
+    let ret = outcome.returndata()
+    assert!(ret.word_at(0) == 7)
+    assert!(ret.word_at(32) == 0x40)
+    assert!(ret.word_at(64) == 0x40)
+    assert!(ret.word_at(96) == 1)
+    assert!(ret.word_at(128) == 3)
+    assert!(ret.word_at(160) == 0x312e36 << 232)
+}
+
+#[test]
+fn test_single_dynamic_return_keeps_offset_word()
+uses (evm: mut Evm, call: mut Call)
+{
+    let info = evm.create2<Info>(value: 0, args: (), salt: 0)
+    let outcome = info.try_call(InfoMsg::Name {})
+    assert!(outcome.success())
+
+    // Same bytes as `cast abi-encode "f(string)" "1.6"`.
+    assert!(outcome.returndata_len() == 96)
+    let ret = outcome.returndata()
+    assert!(ret.word_at(0) == 0x20)
+    assert!(ret.word_at(32) == 3)
+    assert!(ret.word_at(64) == 0x312e36 << 232)
+
+    let name: DynString = info.call(InfoMsg::Name {})
+    assert!(name == version())
+}
diff --git a/crates/fe/tests/fixtures/fe_test/typed_calls.fe b/crates/fe/tests/fixtures/fe_test/typed_calls.fe
new file mode 100644
index 000000000..aa1aade27
--- /dev/null
+++ b/crates/fe/tests/fixtures/fe_test/typed_calls.fe
@@ -0,0 +1,93 @@
+// Bounded typed calls, value sends, raw calls and ERC-165 probes.
+use core::abi::ByteInput
+use core::ptr::{MemBuffer, MemSpan}
+use std::abi::{Bytes4, sol}
+use std::evm::{Address, Call, Ctx, Evm, erc165, encode_msg_calldata}
+
+msg TargetMsg {
+    #[selector = sol("words(uint256)")]
+    Words { n: u256 } -> u256,
+    #[selector = sol("fail()")]
+    Fail {} -> u256,
+    #[selector = sol("supportsInterface(bytes4)")]
+    Supports { id: Bytes4 } -> bool,
+}
+
+pub contract Target {
+    recv TargetMsg {
+        // Returns `n` (a single word) as the ABI result.
+        Words { n } -> u256 { n }
+        Fail {} -> u256 {
+            assert!(false, "no")
+            0
+        }
+        Supports { id } -> bool { id.val == 0x01ffc9a7 || id.val == 0x12345678 }
+    }
+}
+
+pub contract Plain {
+    recv TargetMsg {
+        Words { n } -> u256 { n }
+        Fail {} -> u256 { 0 }
+        Supports { id } -> bool { false }
+    }
+}
+
+#[test]
+fn bounded_calls_copy_at_most_capacity() uses (evm: mut Evm) {
+    let target = evm.create2<Target>(value: 0, args: (), salt: 0)
+    with (Call = evm, Ctx = evm) {
+        let mut ret = MemBuffer::with_capacity(0)
+        let outcome = evm.try_call_into(addr: target, gas: 100000, value: 0, message: TargetMsg::Words { n: 7 }, ret: mut ret)
+        assert(outcome.success())
+        assert(outcome.returndata_len() == 32)
+        assert(ret.len() == 0)
+
+        let mut word = MemBuffer::with_capacity(32)
+        let outcome = evm.try_static_into(addr: target, gas: 100000, message: TargetMsg::Words { n: 9 }, ret: mut word)
+        assert(outcome.success())
+        assert(word.span().word_at(0) == 9)
+
+        let mut ignored = MemBuffer::with_capacity(0)
+        let failed = evm.try_call_into(addr: target, gas: 100000, value: 0, message: TargetMsg::Fail {}, ret: mut ignored)
+        assert(!failed.success())
+
+        let raw = evm.try_call_raw(addr: target, gas: 100000, value: 0, args: encode_msg_calldata(TargetMsg::Words { n: 3 }).span())
+        assert(raw.success())
+        assert(raw.returndata().word_at(0) == 3)
+
+        // A read-only `Call` is enough for a typed static call.
+        let n: u256 = target.static(TargetMsg::Words { n: 11 })
+        assert(n == 11)
+    }
+}
+
+#[test]
+fn send_value_transfers_ether() uses (evm: mut Evm) {
+    let receiver = Address { inner: 0xbeef }
+    with (Call = evm, Ctx = evm) {
+        let outcome = evm.send_value(addr: receiver, gas: 100000, value: 0)
+        assert(outcome.success())
+        assert(outcome.returndata_len() == 0)
+    }
+}
+
+#[test]
+fn erc165_probes() uses (evm: mut Evm) {
+    let target = evm.create2<Target>(value: 0, args: (), salt: 1)
+    let plain = evm.create2<Plain>(value: 0, args: (), salt: 2)
+    with (Call = evm) {
+        assert(erc165::supports_erc165(target))
+        assert(erc165::supports_interface(target, interface_id: 0x12345678))
+        assert(!erc165::supports_interface(target, interface_id: 0xffffffff))
+        assert(!erc165::supports_erc165(plain))
+        assert(!erc165::supports_interface(plain, interface_id: 0x12345678))
+        assert(!erc165::supports_erc165(Address { inner: 0x1234 }))
+    }
+}
