// CriteriaResolution: resolve criteria-based items to concrete identifiers
// with Merkle proofs.
use std::evm::{keccak_words, revert_error}
use super::arr::Arr
use super::errors::{
    ConsiderationCriteriaResolverOutOfRange,
    CriteriaNotEnabledForItem,
    InvalidProof,
    OfferCriteriaResolverOutOfRange,
    OrderCriteriaResolverOutOfRange,
    UnresolvedConsiderationCriteria,
    UnresolvedOfferCriteria,
}
use super::model::{Item, OrderState, Resolver}
use super::types::{CONTRACT, OFFER}

/// `_applyCriteriaResolvers`
pub fn apply_criteria_resolvers(_ orders: Arr<OrderState>, _ resolvers: Arr<Resolver>) {
    let total_orders = orders.len()
    let mut i: u256 = 0
    while i < resolvers.len() {
        let resolver = *resolvers.at(i)
        if resolver.order_index >= total_orders {
            revert_error(OrderCriteriaResolverOutOfRange { side: resolver.side.downcast_truncate() })
        }
        let order = orders.at(resolver.order_index)
        if order.numerator != 0 {
            if resolver.side != OFFER as u256 {
                if resolver.index >= order.consideration.len() {
                    revert_error(ConsiderationCriteriaResolverOutOfRange {})
                }
                update_criteria_item(order.consideration, resolver)
            } else {
                if resolver.index >= order.offer.len() {
                    revert_error(OfferCriteriaResolverOutOfRange {})
                }
                update_criteria_item(order.offer, resolver)
            }
        }
        i += 1
    }
    i = 0
    while i < total_orders {
        let order = orders.at(i)
        if order.numerator != 0 {
            let consideration = order.consideration
            let mut j: u256 = 0
            while j < consideration.len() {
                if requires_resolution(consideration.at(j), order.order_type) {
                    revert_error(UnresolvedConsiderationCriteria { orderIndex: i, considerationIndex: j })
                }
                j += 1
            }
            let offer = order.offer
            j = 0
            while j < offer.len() {
                if requires_resolution(offer.at(j), order.order_type) {
                    revert_error(UnresolvedOfferCriteria { orderIndex: i, offerIndex: j })
                }
                j += 1
            }
        }
        i += 1
    }
}

/// Criteria items stay unresolved only as wildcards of contract orders.
fn requires_resolution(_ item: *Item, _ order_type: u256) -> bool {
    item.item_type > 3 && (order_type != CONTRACT as u256 || item.identifier != 0)
}

fn update_criteria_item(_ items: Arr<Item>, _ resolver: Resolver) {
    let item = items.at(resolver.index)
    if item.item_type <= 3 {
        revert_error(CriteriaNotEnabledForItem {})
    }
    if item.identifier != 0 {
        verify_proof(leaf: resolver.identifier, root: item.identifier, proof: resolver.proof)
    } else if resolver.proof.len() != 0 {
        revert_error(InvalidProof {})
    }
    item.item_type = item.item_type - 2
    item.identifier = resolver.identifier
}

/// `_verifyProof`: sorted-pair Merkle proof of `keccak256(leaf)`.
pub fn verify_proof(leaf: u256, root: u256, proof: Arr<u256>) {
    let mut computed = keccak_words([leaf])
    let mut i: u256 = 0
    while i < proof.len() {
        let element = *proof.at(i)
        computed = if computed > element {
            keccak_words([element, computed])
        } else {
            keccak_words([computed, element])
        }
        i += 1
    }
    if computed != root {
        revert_error(InvalidProof {})
    }
}
