// SPDX-License-Identifier: MIT
// CriteriaResolution: resolve criteria-based items to concrete identifiers
// with Merkle proofs.
use std::evm::keccak_words
use super::abi_view::CalldataView
use super::error_data::{error_selector, revert_with0, revert_with1, revert_with2}
use super::errors::{
    ConsiderationCriteriaResolverOutOfRange,
    CriteriaNotEnabledForItem,
    InvalidProof,
    OfferCriteriaResolverOutOfRange,
    OrderCriteriaResolverOutOfRange,
    UnresolvedConsiderationCriteria,
    UnresolvedOfferCriteria,
}
use super::model::{Book, Item, Resolver, Resolvers, checked_enum}
use super::types::{CONTRACT, OFFER}

/// `_applyCriteriaResolvers`
#[arithmetic(unchecked)]
pub fn apply_criteria_resolvers(_ book: mut Book, _ resolvers: Resolvers) {
    let total_orders = book.orders.len() as u256
    var i: u256 = 0
    while i < resolvers.len() {
        let resolver = resolvers.get(i)
        if resolver.order_index() >= total_orders {
            revert_with1(
                error_selector<OrderCriteriaResolverOutOfRange>(),
                checked_enum(resolver.side(), variants: 2),
            )
        }
        let order = ref book.orders[(resolver.order_index()) as usize]
        if order.numerator != 0 {
            if checked_enum(resolver.side(), variants: 2) != OFFER as u256 {
                if resolver.index() >= order.consideration_len {
                    revert_with0(error_selector<ConsiderationCriteriaResolverOutOfRange>())
                }
                update_criteria_item(
                    mut book.items[(order.consideration_start + resolver.index()) as usize],
                    resolver,
                )
            } else {
                if resolver.index() >= order.offer_len {
                    revert_with0(error_selector<OfferCriteriaResolverOutOfRange>())
                }
                update_criteria_item(
                    mut book.items[(order.offer_start + resolver.index()) as usize],
                    resolver,
                )
            }
        }
        i += 1
    }
    i = 0
    while i < total_orders {
        let order = ref book.orders[(i) as usize]
        if order.numerator != 0 {
            var j: u256 = 0
            while j < order.consideration_len {
                if requires_resolution(
                    ref book.items[(order.consideration_start + j) as usize],
                    order.order_type,
                ) {
                    revert_with2(error_selector<UnresolvedConsiderationCriteria>(), i, j)
                }
                j += 1
            }
            j = 0
            while j < order.offer_len {
                if requires_resolution(
                    ref book.items[(order.offer_start + j) as usize],
                    order.order_type,
                ) {
                    revert_with2(error_selector<UnresolvedOfferCriteria>(), i, j)
                }
                j += 1
            }
        }
        i += 1
    }
}

/// Criteria items stay unresolved only as wildcards of contract orders.
fn requires_resolution(_ item: Item, _ order_type: u256) -> bool {
    checked_enum(item.item_type, variants: 6) > 3
        && (order_type != CONTRACT as u256 || item.identifier != 0)
}

fn update_criteria_item(_ item: mut Item, _ resolver: Resolver) {
    if checked_enum(item.item_type, variants: 6) <= 3 {
        revert_with0(error_selector<CriteriaNotEnabledForItem>())
    }
    if item.identifier != 0 {
        verify_proof(
            leaf: resolver.identifier(),
            root: item.identifier,
            proof: resolver.proof(),
        )
    } else if resolver.proof().word(0) != 0 {
        revert_with0(error_selector<InvalidProof>())
    }
    item.item_type = item.item_type - 2
    item.identifier = resolver.identifier()
}

/// `_verifyProof`: sorted-pair Merkle proof of `keccak256(leaf)`.
#[arithmetic(unchecked)]
fn verify_proof(leaf: u256, root: u256, proof: CalldataView) {
    var computed = keccak_words([leaf])
    // Seaport's verifier walks `len << 5` bytes of its proof copy with the
    // raw length word: its five high bits vanish, and a length beyond the
    // copied elements reads on until gas runs out, as reading on in calldata
    // does.
    let words = (proof.word(0) << 5) >> 5
    var i: u256 = 0
    while i < words {
        let element = proof.element(index: i, stride: 32).word(0)
        computed = if computed > element {
            keccak_words([element, computed])
        } else {
            keccak_words([computed, element])
        }
        i += 1
    }
    if computed != root {
        revert_with0(error_selector<InvalidProof>())
    }
}
