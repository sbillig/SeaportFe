// SPDX-License-Identifier: MIT
// Hand-encoded custom error revert data, shared by all error types
// instead of one generic encoder each.
use core::ErrorVariant
use core::ptr::{self, MemSpan}
use std::abi::Sol
use std::evm::{RawOps, revert_bytes}
use super::buffer::Buffer

/// The selector of the custom error `E`.
#[inline(always)]
pub fn error_selector<E>() -> u256 where E: ErrorVariant<Sol> {
    <E as ErrorVariant<Sol>>::SELECTOR as u256
}

/// Revert with custom error data: the 4-byte `selector`, then the first
/// `words` (at most three) of the argument words `a` to `c`. For an error
/// whose fields are all static this is exactly what `revert_error` reverts
/// with; the shared encoding avoids an encoder per error type. Callers use
/// the `revert_with` wrappers, which fix `words`.
fn revert_custom(_ selector: u256, words: u256, a: u256, b: u256, c: u256) -> ! {
    let data = ptr::alloc_bytes(0x64)
    // The allocation holds the selector and all three words.
    unsafe {
        *ptr::cast<u8, u256>(data) = selector << 224
        *ptr::cast<u8, u256>(ptr::offset_bytes(data, 4)) = a
        *ptr::cast<u8, u256>(ptr::offset_bytes(data, 0x24)) = b
        *ptr::cast<u8, u256>(ptr::offset_bytes(data, 0x44)) = c
        revert_bytes(
            MemSpan::from_raw_parts(ptr: data, len: (4 + words * 32) as usize),
        )
    }
}

/// Like `revert_custom`, for errors with four or five static words.
fn revert_custom5(_ selector: u256, words: u256, a: u256, b: u256, c: u256, d: u256, e: u256) -> ! {
    let data = ptr::alloc_bytes(0xa4)
    // The allocation holds the selector and all five words.
    unsafe {
        *ptr::cast<u8, u256>(data) = selector << 224
        *ptr::cast<u8, u256>(ptr::offset_bytes(data, 4)) = a
        *ptr::cast<u8, u256>(ptr::offset_bytes(data, 0x24)) = b
        *ptr::cast<u8, u256>(ptr::offset_bytes(data, 0x44)) = c
        *ptr::cast<u8, u256>(ptr::offset_bytes(data, 0x64)) = d
        *ptr::cast<u8, u256>(ptr::offset_bytes(data, 0x84)) = e
        revert_bytes(
            MemSpan::from_raw_parts(ptr: data, len: (4 + words * 32) as usize),
        )
    }
}

#[inline(always)]
pub fn revert_with0(_ selector: u256) -> ! {
    revert_custom(selector, words: 0, a: 0, b: 0, c: 0)
}

#[inline(always)]
pub fn revert_with1(_ selector: u256, _ a: u256) -> ! {
    revert_custom(selector, words: 1, a, b: 0, c: 0)
}

#[inline(always)]
pub fn revert_with2(_ selector: u256, _ a: u256, _ b: u256) -> ! {
    revert_custom(selector, words: 2, a, b, c: 0)
}

#[inline(always)]
pub fn revert_with3(_ selector: u256, _ a: u256, _ b: u256, _ c: u256) -> ! {
    revert_custom(selector, words: 3, a, b, c)
}

#[inline(always)]
pub fn revert_with4(_ selector: u256, _ a: u256, _ b: u256, _ c: u256, _ d: u256) -> ! {
    revert_custom5(selector, words: 4, a, b, c, d, e: 0)
}

#[inline(always)]
pub fn revert_with5(_ selector: u256, _ a: u256, _ b: u256, _ c: u256, _ d: u256, _ e: u256) -> ! {
    revert_custom5(selector, words: 5, a, b, c, d, e)
}

/// Revert with a custom error whose first field is the `bytes` or `string`
/// `reason`, followed by `words` (two or three) static words of `a` to `c`.
fn revert_with_reason(
    _ selector: u256,
    reason: MemSpan,
    words: u256,
    a: u256,
    b: u256,
    c: u256,
) -> ! {
    // The reason's offset, behind its own head and the static words.
    let tail = 32 + words * 32
    let length = reason.len() as u256
    var data = Buffer::new(4 + tail + 32 + ((length + 31) & !(31 as u256)))
    // The zeroed buffer holds the head words and the reason length; a word
    // past the static fields is the length word, written after them.
    unsafe {
        data.put(offset: 0, value: selector << 224)
        data.put(offset: 4, value: tail)
        data.put(offset: 0x24, value: a)
        data.put(offset: 0x44, value: b)
        data.put(offset: 0x64, value: c)
        data.put(offset: 4 + tail, value: length)
    }
    data.copy_from(offset: 4 + tail + 32, source: reason)
    revert_bytes(data.span())
}

#[inline(always)]
pub fn revert_with_reason2(_ selector: u256, reason: MemSpan, a: u256, b: u256) -> ! {
    revert_with_reason(selector, reason, words: 2, a, b, c: 0)
}

#[inline(always)]
pub fn revert_with_reason3(_ selector: u256, reason: MemSpan, a: u256, b: u256, c: u256) -> ! {
    revert_with_reason(selector, reason, words: 3, a, b, c)
}

/// Return `name` ABI-encoded as a `string`, as Seaport's `_name()` does: the
/// offset, length and left-aligned bytes go into one terminal buffer instead
/// of a `DynString` that is then copied into the return data.
pub fn return_name<const N: usize>(_ name: String<N>) -> ! uses (ops: RawOps) {
    let word = (name as u256) << (((32 - N) * 8) as u256)
    let data = ptr::alloc_bytes(0x60)
    // The allocation holds the offset, the length and the one data word.
    unsafe {
        *ptr::cast<u8, u256>(data) = 0x20
        *ptr::cast<u8, u256>(ptr::offset_bytes(data, 0x20)) = N as u256
        *ptr::cast<u8, u256>(ptr::offset_bytes(data, 0x40)) = word
        ops.return_data(data: MemSpan::from_raw_parts(ptr: data, len: 0x60))
    }
}
