// LowLevelHelpers and raw word access.
use core::ptr
use std::evm::{Ctx, RawOps, bubble_last_revert}

/// `at` must point to 32 initialized bytes in a live allocation.
pub unsafe fn load_word(_ at: *u8) -> u256 {
    *ptr::cast<u8, u256>(at)
}

/// `at` must point to 32 writable bytes in a live allocation.
pub unsafe fn store_word(_ at: *u8, _ value: u256) {
    *ptr::cast<u8, u256>(at) = value
}

/// `_revertWithReasonIfOneIsReturned`: bubble returndata when there is some
/// and copying it into memory leaves at least 32 gas.
pub fn revert_with_reason_if_one_is_returned() uses (ctx: Ctx, ops: RawOps) {
    // Fe exposes neither msize nor pointer addresses (ISSUES.md #5), so the
    // expansion cost is computed from an empty memory, which overestimates it.
    bubble_revert_if_affordable(msize_words: 0)
}

/// Bubble up the returned revert data when copying it into memory of
/// `msize_words` words leaves enough gas.
pub fn bubble_revert_if_affordable(msize_words: u256) uses (ctx: Ctx, ops: RawOps) {
    let size = ops.returndatasize()
    if size == 0 { return }
    let return_data_words = (size + 31) >> 5
    let mut cost = 3 * return_data_words
    if return_data_words > msize_words {
        cost = cost
            + (return_data_words - msize_words) * 3
            + ((return_data_words * return_data_words - msize_words * msize_words) >> 9)
    }
    if cost + 0x20 < ctx.gas() {
        bubble_last_revert()
    }
}
