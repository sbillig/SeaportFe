// Copyable handles to memory arrays and byte payloads.
//
// Seaport mutates orders in place across many phases (fraction application,
// criteria resolution, fulfillment aggregation), like Solidity memory
// references. `core::ptr::MemArray` is not `Copy`, and nesting it inside
// other arrays runs into move restrictions, so the port uses these small
// handles over `*T` instead (ISSUES.md #2).
use core::ptr
use core::size_of
use std::abi::Bytes
use std::evm::{revert_error, Panic, PANIC_INDEX_OUT_OF_BOUNDS}

pub struct Arr<T> {
    ptr: *T,
    len: u256,
}

impl<T> Copy for Arr<T> {}

impl<T> Arr<T> {
    /// `len` uninitialized elements; every element must be written before use.
    pub fn alloc(_ len: u256) -> Self {
        Arr { ptr: ptr::cast<u8, T>(ptr::alloc_bytes(len * size_of<T>())), len }
    }

    pub fn empty() -> Self {
        Arr::alloc(0)
    }

    pub fn len(self) -> u256 {
        self.len
    }

    /// Pointer to element `i`; reverts with `Panic(0x32)` when out of range.
    pub fn at(self, _ i: u256) -> *T {
        if i >= self.len {
            revert_error(Panic::from(PANIC_INDEX_OUT_OF_BOUNDS))
        }
        ptr::offset(self.ptr, i)
    }
}

/// A copyable reference to an ABI `bytes` tail (length word + padded data).
pub struct ByteRef {
    pub data: *u8,
    pub len: u256,
    pub size: u256,
}

impl Copy for ByteRef {}

impl ByteRef {
    pub fn of(_ bytes: Bytes) -> Self {
        ByteRef { data: bytes.encoded_span().ptr(), len: bytes.len(), size: bytes.encoded_size() }
    }

    pub fn empty() -> Self {
        ByteRef::of(Bytes::empty())
    }

    pub fn to_bytes(self) -> Bytes {
        Bytes::from_abi_tail(data: self.data, len: self.len, size: self.size)
    }

    pub fn payload(self) -> *u8 {
        ptr::offset_bytes(self.data, 32)
    }
}
