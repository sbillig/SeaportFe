    assert_restricted_advanced_order_validity,
    check_restricted_advanced_order_authorization,
    generate_order,
    install_generated_order,
}

/// Current amount of `item` for the fraction; rounds up for consideration.
fn prepare_item(
    _ item: *Item,
    numerator: u256,
    denominator: u256,
    start_time: u256,
    end_time: u256,
    round_up: bool,
)
uses (ctx: Ctx)
{
    let end_amount = get_fraction(numerator, denominator, value: item.original)
    let start_amount = if item.amount == item.original {
        end_amount
    } else {
        get_fraction(numerator, denominator, value: item.amount)
    }
    let current = locate_current_amount(start_amount, end_amount, start_time, end_time, round_up)
    item.amount = current
    item.original = current
}

#[test]
fn prepared_item_amounts_survive_aggregation_and_settlement()
uses (ctx: Ctx)
{
    let items = Arr<Item>::alloc(2)
    let recipient = Address { inner: (1 << 200) | 23 }
    *items.at(0) = Item {
        item_type: 1,
        token: Address { inner: 17 },
        identifier: 0,
        amount: (1 << 200) + 6,
        original: (1 << 200) + 14,
        recipient,
    }
    *items.at(1) = *items.at(0)
    let mut i: u256 = 0
    while i < 2 {
        prepare_item(
            items.at(i),
            numerator: 1,
            denominator: 2,
            start_time: ctx.timestamp(),
            end_time: ctx.timestamp() + 1,
            round_up: i != 0,
        )
        i += 1
    }
    let orders = Arr<OrderState>::alloc(1)
    *orders.at(0) = OrderState {
        offerer: Address { inner: 19 },
        zone: Address::zero(),
        offer_start: 0,
        offer_len: 1,
        consideration_start: 1,
        consideration_len: 1,
        order_type: 1,
        start_time: 0,
        end_time: 0,
        zone_hash: 0,
        salt: 0,
        conduit_key: 0,
        total_original: 1,
        numerator: 1,
        denominator: 2,
        signature: 0,
        extra_data: 0,
    }
    let book = Book { orders, items, used: 2, blob: ptr::alloc_bytes(0) }
    let components = Arr<Component>::alloc(1)
    *components.at(0) = Component { order_index: 0, item_index: 0 }
    let groups = Groups { list: Arr<Group>::empty(), components }
    let group = Group { start: 0, len: 1 }
    let (offered, _) = aggregate_offer_items(ref book, groups, group, recipient)
    let (received, _) = aggregate_consideration_items(
        ref book,
        groups,
        group,
        offerer: Address::zero(),
        conduit_key: 0,
    )
    let filled = (1 << 199) + 3
    assert(offered.amount == filled && received.amount == filled)
    assert(received.recipient == recipient)
    assert(items.at(0).amount == 0 && items.at(1).amount == 0)
    restore_offer_amounts(ref book, order: orders.at(0))
    check_consideration_item(ref book, order: orders.at(0), order_index: 0, index: 0)
    assert(
        items.at(0).amount == filled && items.at(1).amount == filled,
    )
    assert(
        items.at(0).original == filled && items.at(1).original == filled,
    )
    assert(items.at(1).recipient == recipient)
}

/// `_validateOrdersAndPrepareToFulfill`: validate every order, derive the
/// current amounts, resolve criteria, authorize with zones or generate
/// contract orders, update statuses and emit `OrderFulfilled`. Returns the
/// book, the order hashes (zero for skipped orders) and whether any order is
/// restricted or a contract order.
pub fn validate_orders_and_prepare_to_fulfill(
    _ env: Env,
    book: ref Book,
    resolvers: Resolvers,
    revert_on_invalid: bool,
    maximum_fulfilled: u256,
    recipient: Address,
    non_match: bool,
) -> (Book, Arr<u256>, bool)
uses (ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    set_reentrancy_guard(env, accept_native_tokens: true)
    let total_orders = book.orders.len()
    let order_hashes = Arr<u256>::alloc(total_orders)
    let mut contains_non_open = false
    let mut invalid_native_offer_item = false
    let mut i: u256 = 0
    while i < total_orders {
        let (order_is_non_open, order_has_native_offer) = validate_and_prepare_order(
            env,
            book,
            order_hashes,
            index: i,
            revert_on_invalid,
        )
        if order_is_non_open {
            contains_non_open = true
        }
        if order_has_native_offer {
            invalid_native_offer_item = true
        }
        i += 1
    }
    // Native offer items are only rejected when not matching orders.
    if non_match && invalid_native_offer_item {
        revert_error(InvalidNativeOfferItem {})
    }

    apply_criteria_resolvers(book, resolvers)

    let prepared = prepare_available_orders(
        env,
        book,
        order_hashes,
        maximum_fulfilled,
        revert_on_invalid,
        recipient,
    )
    (prepared, order_hashes, contains_non_open)
}

/// Second pass of `_validateOrdersAndPrepareToFulfill`: authorize, record and
/// emit for up to `maximum_fulfilled` orders.
fn prepare_available_orders(
    _ env: Env,
    book: ref Book,
    order_hashes: Arr<u256>,
    maximum_fulfilled: u256,
    revert_on_invalid: bool,
    recipient: Address,
) -> Book
uses (ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    let total_orders = book.orders.len()
    let mut current: Book = book
    let mut remaining = maximum_fulfilled
    let mut some_order_available = false
    let mut i: u256 = 0
    while i < total_orders {
        if *order_hashes.at(i) != 0 {
            let (updated, available) = prepare_available_order(
                env,
                book: ref current,
                order_hashes,
                index: i,
                remaining,
                revert_on_invalid,
                recipient,
            )
            current = updated
            if available {
                remaining = remaining - 1
                some_order_available = true
            }
        }
        i += 1
    }
    if !some_order_available {
        revert_error(NoSpecifiedOrdersAvailable {})
    }
    current
}

/// Validate order `index` and derive its current amounts. Returns whether it
/// is restricted or a contract order, and whether a non-contract order
/// offers native tokens. Unavailable orders get a zero hash and numerator.
fn validate_and_prepare_order(
    _ env: Env,
    book: ref Book,
    order_hashes: Arr<u256>,
    index: u256,
    revert_on_invalid: bool,
) -> (bool, bool)
uses (ctx: Ctx, call: Call, ops: RawOps)
{
    *order_hashes.at(index) = 0
    let order = book.order(index)
    let (order_hash, numerator, denominator) = validate_order(env, book, order, revert_on_invalid)
    order.numerator = numerator
    if numerator == 0 {
        return (false, false)
    }
    order.denominator = denominator
    *order_hashes.at(index) = order_hash
    let is_non_contract = order.order_type < 4
    let mut native_offer = false
    let mut j: u256 = 0
    while j < order.offer_len {
        let item = book.offer_item(order, j)
        if item.item_type == NATIVE as u256 && is_non_contract {
            native_offer = true
        }
        prepare_item(
            item,
            numerator,
            denominator,
            start_time: order.start_time,
            end_time: order.end_time,
            round_up: false,
        )
        j += 1
    }
    j = 0
    while j < order.consideration_len {
        let item = book.consideration_item(order, j)
        prepare_item(
            item,
            numerator,
            denominator,
            start_time: order.start_time,
            end_time: order.end_time,
            round_up: true,
        )
        j += 1
    }
    (order.order_type > 1, native_offer)
}

/// Authorize and record, or generate, order `index` if fulfillments remain.
/// Returns the book (a generated order moves the item pool) and whether the
/// order is available.
fn prepare_available_order(
    _ env: Env,
    book: ref Book,
    order_hashes: Arr<u256>,
    index: u256,
    remaining: u256,
    revert_on_invalid: bool,
    recipient: Address,
) -> (Book, bool)
uses (ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    if remaining == 0 {
        skip_available_order(book, order_hashes, index)
        (book, false)
    } else if book.order(index).order_type != CONTRACT as u256 {
        let available = prepare_standard_available_order(
            book,
            order_hashes,
            index,
            revert_on_invalid,
            recipient,
        )
        (book, available)
    } else {
        prepare_contract_available_order(book, order_hashes, index, revert_on_invalid, recipient)
    }
}

fn skip_available_order(_ book: ref Book, order_hashes: Arr<u256>, index: u256) {
    *order_hashes.at(index) = 0
    book.order(index).numerator = 0
}

fn prepare_standard_available_order(
    _ book: ref Book,
    order_hashes: Arr<u256>,
    index: u256,
    revert_on_invalid: bool,
    recipient: Address,
) -> bool
uses (ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    let order_hash = *order_hashes.at(index)
    let available = authorize_and_record(book, order_hashes, order_hash, index, revert_on_invalid)
    if available {
        emit_order_fulfilled(order_hash, book, order: book.order(index), recipient)
    }
    available
}

fn prepare_contract_available_order(
    _ book: ref Book,
    order_hashes: Arr<u256>,
    index: u256,
    revert_on_invalid: bool,
    recipient: Address,
) -> (Book, bool)
uses (ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    let generated = generate_order(book, order_index: index, revert_on_invalid)
    *order_hashes.at(index) = generated.order_hash
    if generated.order_hash == 0 {
        book.order(index).numerator = 0
        (book, false)
    } else {
        let installed = install_generated_order(book, order_index: index, generated)
        emit_order_fulfilled(
            order_hash: generated.order_hash,
            book: ref installed,
            order: installed.order(index),
            recipient,
        )
        (installed, true)
    }
}

/// Authorize a restricted order with its zone and record the fill; false if
/// the order gets skipped.
fn authorize_and_record(
    _ book: ref Book,
    order_hashes: Arr<u256>,
    order_hash: u256,
    index: u256,
    revert_on_invalid: bool,
) -> bool
uses (ctx: Ctx, call: mut Call, ops: mut RawOps)
{
    let order = book.order(index)
    let authorized = check_restricted_advanced_order_authorization(
        book,
        order,
        order_hashes,
        order_hash,
        order_index: index,
        revert_on_invalid,
    )
    if !authorized
        || !update_status(
            order_hash,
            numerator: order.numerator,
            denominator: order.denominator,
            revert_on_invalid: revert_on_failed_update(order, revert_on_invalid),
        ) {
        *order_hashes.at(index) = 0
        order.numerator = 0
        return false
    }
    true
}

/// `_revertOnFailedUpdate`: restricted orders fulfilled by someone other
/// than the zone must not be skipped silently.
fn revert_on_failed_update(_ order: *OrderState, _ revert_on_invalid: bool) -> bool
uses (ctx: Ctx)
{
    revert_on_invalid
        || (order.order_type > 1 && ctx.caller() != Address::from_word_truncate(order.zone.inner))
}

/// `_fulfillAvailableAdvancedOrders`
pub fn fulfill_available_advanced_orders(
    _ env: ref Env,
    book: ref Book,
    resolvers: Resolvers,
    offer_fulfillments: Groups,
    consideration_fulfillments: Groups,
    fulfiller_conduit_key: u256,
    recipient: Address,
    maximum_fulfilled: u256,
) -> (DynArray<bool>, DynArray<Execution>)
uses (ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    let (prepared, order_hashes, contains_non_open) = validate_orders_and_prepare_to_fulfill(
        env,
        book,
        resolvers,
        revert_on_invalid: false,
        maximum_fulfilled,
        recipient,
        non_match: true,
    )
    let total_offer = offer_fulfillments.list.len()
    let executions = Arr<ExecutionState>::alloc(total_offer + consideration_fulfillments.list.len())
    let mut i: u256 = 0
    while i < total_offer {
        aggregate_into(
            ref prepared,
            executions,
            slot: i,
            side: OFFER,
            groups: offer_fulfillments,
            index: i,
            fulfiller_conduit_key,
            recipient,
        )
        i += 1
    }
    i = 0
    while i < consideration_fulfillments.list.len() {
        aggregate_into(
            ref prepared,
            executions,
            slot: total_offer + i,
            side: CONSIDERATION,
            groups: consideration_fulfillments,
            index: i,
            fulfiller_conduit_key,
            recipient: Address::zero(),
        )
        i += 1
    }
    let available = perform_final_checks_and_execute_orders(
        env,
        book: ref prepared,
        executions,
        order_hashes,
        recipient,
        contains_non_open,
    )
    (bool_array(available), execution_array(executions))
}

fn aggregate_into(
    _ book: ref Book,
    executions: Arr<ExecutionState>,
    slot: u256,
    side: u8,
    groups: Groups,
    index: u256,
    fulfiller_conduit_key: u256,
    recipient: Address,
)
uses (ctx: Ctx)
{
    *executions.at(slot) = aggregate_available(
        book,
        side,
        groups,
        index,
        fulfiller_conduit_key,
        recipient,
    )
}

/// `_matchAdvancedOrders`
pub fn match_advanced_orders(
    _ env: ref Env,
    book: ref Book,
    resolvers: Resolvers,
    fulfillments: Groups,
    recipient: Address,
) -> DynArray<Execution>
uses (ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    let (prepared, order_hashes, contains_non_open) = validate_orders_and_prepare_to_fulfill(
        env,
        book,
        resolvers,
        revert_on_invalid: true,
        maximum_fulfilled: book.orders.len(),
        recipient,
        non_match: false,
    )
    log.emit(OrdersMatched { orderHashes: hash_array(order_hashes) })
    let total_fulfillments = fulfillments.list.len() / 2
    let executions = Arr<ExecutionState>::alloc(total_fulfillments)
    let mut i: u256 = 0
    while i < total_fulfillments {
        apply_fulfillment_into(ref prepared, executions, groups: fulfillments, index: i)
        i += 1
    }
    let _ = perform_final_checks_and_execute_orders(
        env,
        book: ref prepared,
        executions,
        order_hashes,
        recipient,
        contains_non_open,
    )
    execution_array(executions)
}

fn apply_fulfillment_into(
    _ book: ref Book,
    executions: Arr<ExecutionState>,
    groups: Groups,
    index: u256,
) {
    *executions.at(index) = apply_fulfillment(book, groups, fulfillment_index: index)
}

/// `_performFinalChecksAndExecuteOrders`: run the executions, transfer
/// unspent offer items to the recipient, require all consideration to be
/// met, refund native tokens and call zones and contract offerers.
///
/// Loop bodies are separate functions throughout: Fe's borrow checker is
/// much cheaper on a loop that makes one call than on the same work inline
/// (ISSUES.md #9).
fn perform_final_checks_and_execute_orders(
    _ env: Env,
    book: ref Book,
    executions: Arr<ExecutionState>,
    order_hashes: Arr<u256>,
    recipient: Address,
    contains_non_open: bool,
) -> Arr<bool>
uses (ctx: Ctx, call: mut Call, ops: mut RawOps)
{
    let total_orders = book.orders.len()
    let available = Arr<bool>::alloc(total_orders)
    // Executions plus unspent offer items bound the number of transfers.
    let buf = transfer_buffer(executions.len() + book.used)
    let mut acc = new_accumulator()
    let mut i: u256 = 0
    while i < executions.len() {
        acc = run_execution(env, executions, index: i, acc, buf)
        i += 1
    }
    i = 0
    while i < total_orders {
        acc = settle_order(env, book, available, index: i, recipient, acc, buf)
        i += 1
    }
    let _ = trigger_if_armed(acc, buf, env)
    let balance = ctx.selfbalance()
    if balance != 0 {
        transfer_native_tokens(to: ctx.caller(), amount: balance)
    }
    if contains_non_open {
        i = 0
        while i < total_orders {
            validate_available_order(book, available, order_hashes, index: i)
            i += 1
        }
    }
    clear_reentrancy_guard(env)
    available
}

fn run_execution(
    _ env: Env,
    executions: Arr<ExecutionState>,
    index: u256,
    acc: Accumulator,
    buf: *u8,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let execution = *executions.at(index)
    if execution.amount == 0 {
        return acc
    }
    if execution.item_type == NATIVE as u256 && execution.amount > ctx.selfbalance() {
        revert_error(InsufficientNativeTokensSupplied {})
    }
    let item = Transfer {
        item_type: execution.item_type,
        token: execution.token,
        identifier: execution.identifier,
        amount: execution.amount,
        recipient: execution.recipient,
    }
    transfer(
        item,
        from: execution.offerer,
        conduit_key: execution.conduit_key,
        acc,
        buf,
        env,
    )
}

/// Transfer the unspent offer items of an available order to the recipient
/// and require its consideration to be met; restores the original amounts.
/// Transfers and restores are separate loops so that each loop writes
/// through a single pointer (ISSUES.md #9).
fn settle_order(
    _ env: Env,
    book: ref Book,
    available: Arr<bool>,
    index: u256,
    recipient: Address,
    acc: Accumulator,
    buf: *u8,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let order = book.order(index)
    *available.at(index) = order.numerator != 0
    if order.numerator == 0 {
        return acc
    }
    let settled = transfer_unspent_offer(env, book, order, recipient, acc, buf)
    restore_offer_amounts(book, order)
    check_consideration(book, order, order_index: index)
    settled
}

fn transfer_unspent_offer(
    _ env: Env,
    book: ref Book,
    order: *OrderState,
    recipient: Address,
    acc: Accumulator,
    buf: *u8,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let mut current = acc
    let mut j: u256 = 0
    while j < order.offer_len {
        current = transfer_unspent_offer_item(
            env,
            book,
            order,
            index: j,
            recipient,
            acc: current,
            buf,
        )
        j += 1
    }
    current
}

fn transfer_unspent_offer_item(
    _ env: Env,
    book: ref Book,
    order: *OrderState,
    index: u256,
    recipient: Address,
    acc: Accumulator,
    buf: *u8,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let item = book.offer_item(order, index)
    if item.amount == 0 {
        return acc
    }
    let unspent = Transfer {
        item_type: item.item_type,
        token: item.token,
        identifier: item.identifier,
        amount: item.amount,
        recipient,
    }
    transfer(
        unspent,
        from: order.offerer,
        conduit_key: order.conduit_key,
        acc,
        buf,
        env,
    )
}

fn restore_offer_amounts(_ book: ref Book, order: *OrderState) {
    let mut j: u256 = 0
    while j < order.offer_len {
        let item = book.offer_item(order, j)
        item.amount = item.original
        j += 1
    }
}

fn check_consideration(_ book: ref Book, order: *OrderState, order_index: u256) {
    let mut j: u256 = 0
    while j < order.consideration_len {
        check_consideration_item(book, order, order_index, index: j)
        j += 1
    }
}

fn check_consideration_item(_ book: ref Book, order: *OrderState, order_index: u256, index: u256) {
    let item = book.consideration_item(order, index)
    if item.amount != 0 {
        revert_error(
            ConsiderationNotMet {
                orderIndex: order_index,
                considerationIndex: index,
                shortfallAmount: item.amount,
            },
        )
    }
    item.amount = item.original
}

fn validate_available_order(
    _ book: ref Book,
    available: Arr<bool>,
    order_hashes: Arr<u256>,
    index: u256,
)
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    if *available.at(index) {
        assert_restricted_advanced_order_validity(
            book,
            order: book.order(index),
            order_hashes,
            order_hash: *order_hashes.at(index),
        )
    }
}

fn bool_array(_ values: Arr<bool>) -> DynArray<bool> {
    let count = values.len()
    let (data, size) = array_tail(count, item_size: bool::HEAD_SIZE)
    let mut i: u256 = 0
    while i < count {
        (*values.at(i)).encode(ptr::offset_bytes(data, 32 + i * bool::HEAD_SIZE))
        i += 1
    }
    DynArray::from_abi_tail(data, len: count, size)
}

pub fn hash_array(_ values: Arr<u256>) -> DynArray<Bytes32> {
    let count = values.len()
    let (data, size) = array_tail(count, item_size: Bytes32::HEAD_SIZE)
    let mut i: u256 = 0
    while i < count {
        Bytes32 { val: *values.at(i) }.encode(ptr::offset_bytes(data, 32 + i * Bytes32::HEAD_SIZE))
        i += 1
    }
    DynArray::from_abi_tail(data, len: count, size)
}

fn execution_array(_ executions: Arr<ExecutionState>) -> DynArray<Execution> {
    let count = executions.len()
    let (data, size) = array_tail(count, item_size: Execution::HEAD_SIZE)
    let mut i: u256 = 0
    while i < count {
        let e = *executions.at(i)
        Execution {
            item: ReceivedItem {
                itemType: e.item_type.downcast_truncate(),
                token: e.token,
                identifier: e.identifier,
                amount: e.amount,
                recipient: e.recipient,
            },
            offerer: e.offerer,
            conduitKey: Bytes32 { val: e.conduit_key },
        }
            .encode(ptr::offset_bytes(data, 32 + i * Execution::HEAD_SIZE))
        i += 1
    }
    DynArray::from_abi_tail(data, len: count, size)
}
