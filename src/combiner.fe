// OrderCombiner: fulfillAvailable* and match* over groups of orders.
use core::abi::{AbiSize, Encode}
use core::ptr
use std::abi::{Bytes32, DynArray}
use std::evm::{Address, Call, Ctx, Log, RawOps, revert_error}
use super::amount::{get_fraction, locate_current_amount}
use super::applier::{
    ExecutionState,
    aggregate_available,
    aggregate_consideration_items,
    aggregate_offer_items,
    apply_fulfillment,
}
use super::arr::{Arr, array_tail}
use super::criteria::apply_criteria_resolvers
use super::errors::{
    ConsiderationNotMet,
    InsufficientNativeTokensSupplied,
    InvalidNativeOfferItem,
    NoSpecifiedOrdersAvailable,
    OrdersMatched,
}
use super::executor::{
    Accumulator,
    Transfer,
    new_accumulator,
    transfer,
    transfer_buffer,
    transfer_native_tokens,
    trigger_if_armed,
}
