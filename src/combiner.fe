// OrderCombiner: fulfillAvailable* and match* over groups of orders.
use std::abi::DynArray
use std::evm::{TSlot, Address, Call, Ctx, Event, Log, RawOps, revert_error}
use super::raw_abi::{error_selector, revert_custom, revert_with0}
use super::buffer::{Buffer, store_at}
use super::amount::{get_fraction, locate_current_amount}
use super::applier::{ExecutionState, aggregate_available, apply_fulfillment}
use core::ptr::MemArray
use super::criteria::apply_criteria_resolvers
use super::errors::{
    ConsiderationNotMet,
    InsufficientNativeTokensSupplied,
    InvalidNativeOfferItem,
    NoSpecifiedOrdersAvailable,
    OrdersMatched,
}
use super::executor::{
    Accumulator,
    Transfer,
    new_accumulator,
    transfer,
    transfer_buffer,
    transfer_native_tokens,
    trigger_if_armed,
}
use super::fulfill::{emit_order_fulfilled, validate_order}
use super::hashing::Env
use super::model::{Book, Groups, Item, OrderState, Resolvers, elem}
use super::status::{OrderStore, clear_reentrancy_guard, set_reentrancy_guard, update_status}
use super::types::{CONSIDERATION, CONTRACT, Execution, NATIVE, OFFER}
use super::zone::{
    assert_restricted_advanced_order_validity,
    check_restricted_advanced_order_authorization,
    generate_order,
    install_generated_order,
}

/// Current amount of `item` for the fraction; rounds up for consideration.
fn prepare_item(
    _ item: mut Item,
    numerator: u256,
    denominator: u256,
    start_time: u256,
    end_time: u256,
    round_up: bool,
)
uses (ctx: Ctx)
{
    let end_amount = get_fraction(numerator, denominator, value: item.end_amount)
    let start_amount = if item.start_amount == item.end_amount {
        end_amount
    } else {
        get_fraction(numerator, denominator, value: item.start_amount)
    }
    let current = locate_current_amount(start_amount, end_amount, start_time, end_time, round_up)
    item.amount = current
    item.original = current
}

/// `_validateOrdersAndPrepareToFulfill`: validate every order, derive the
/// current amounts, resolve criteria, authorize with zones or generate
/// contract orders, update statuses and emit `OrderFulfilled`. Returns the
/// book, the order hashes (zero for skipped orders) and whether any order is
/// restricted or a contract order.
#[arithmetic(unchecked)]
pub fn validate_orders_and_prepare_to_fulfill(
    _ env: Env,
    book: mut Book,
    resolvers: Resolvers,
    revert_on_invalid: bool,
    maximum_fulfilled: u256,
    recipient: Address,
    non_match: bool,
) -> (MemArray<u256>, bool)
uses (
    store: mut OrderStore,
    guard_state: mut u256,
    transient_guard: mut TSlot<u256>,
    ctx: Ctx,
    call: mut Call,
    ops: mut RawOps,
    log: mut Log,
)
{
    set_reentrancy_guard(env, accept_native_tokens: true)
    let total_orders = book.orders.len() as u256
    var order_hashes = MemArray<u256>::new_zeroed(book.orders.len())
    var contains_non_open = false
    var invalid_native_offer_item = false
    var i: u256 = 0
    while i < total_orders {
        let (order_is_non_open, order_has_native_offer) = validate_and_prepare_order(
            env,
            mut book,
            mut order_hashes,
            index: i,
            revert_on_invalid,
        )
        if order_is_non_open {
            contains_non_open = true
        }
        if order_has_native_offer {
            invalid_native_offer_item = true
        }
        i += 1
    }
    // Native offer items are only rejected when not matching orders.
    if non_match && invalid_native_offer_item {
        revert_with0(error_selector<InvalidNativeOfferItem>())
    }

    apply_criteria_resolvers(mut book, resolvers)

    prepare_available_orders(
        env,
        mut book,
        mut order_hashes,
        maximum_fulfilled,
        revert_on_invalid,
        recipient,
    )
    (order_hashes, contains_non_open)
}

/// Second pass of `_validateOrdersAndPrepareToFulfill`: authorize, record and
/// emit for up to `maximum_fulfilled` orders.
#[arithmetic(unchecked)]
fn prepare_available_orders(
    _ env: Env,
    book: mut Book,
    order_hashes: mut MemArray<u256>,
    maximum_fulfilled: u256,
    revert_on_invalid: bool,
    recipient: Address,
)
uses (store: mut OrderStore, ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    let total_orders = book.orders.len() as u256
    var remaining = maximum_fulfilled
    var some_order_available = false
    var i: u256 = 0
    while i < total_orders {
        if order_hashes[(i) as usize] != 0 {
            let available = prepare_available_order(
                env,
                mut book,
                mut order_hashes,
                index: i,
                remaining,
                revert_on_invalid,
                recipient,
            )
            if available {
                remaining = remaining - 1
                some_order_available = true
            }
        }
        i += 1
    }
    if !some_order_available {
        revert_with0(error_selector<NoSpecifiedOrdersAvailable>())
    }
}

/// Validate order `index` and derive its current amounts. Returns whether it
/// is restricted or a contract order, and whether a non-contract order
/// offers native tokens. Unavailable orders get a zero hash and numerator.
/// Kept out of line so its frame does not join its caller's.
#[arithmetic(unchecked)]
#[inline(never)]
fn validate_and_prepare_order(
    _ env: Env,
    book: mut Book,
    order_hashes: mut MemArray<u256>,
    index: u256,
    revert_on_invalid: bool,
) -> (bool, bool)
uses (store: OrderStore, ctx: Ctx, call: Call, ops: RawOps)
{
    order_hashes[(index) as usize] = 0
    let (order_hash, numerator, denominator) = validate_order(
        env,
        order: book.orders[index as usize],
        revert_on_invalid,
    )
    unsafe {
        (*elem(book.orders.ptr(), index)).numerator = numerator
    }
    if numerator == 0 {
        return (false, false)
    }
    unsafe {
        (*elem(book.orders.ptr(), index)).denominator = denominator
    }
    let order = unsafe {
        ref *elem(book.orders.ptr(), index)
    }
    order_hashes[(index) as usize] = order_hash
    let is_non_contract = order.order_type < 4
    var native_offer = false
    // Offer items, then consideration items, which round up.
    var j: u256 = 0
    while j < order.offer_len + order.consideration_len {
        let consideration = j >= order.offer_len
        let at = if consideration {
            order.consideration_start + (j - order.offer_len)
        } else {
            order.offer_start + j
        }
        let item = unsafe {
            mut *elem(book.items.ptr(), at)
        }
        if !consideration && item.item_type == NATIVE as u256 && is_non_contract {
            native_offer = true
        }
        prepare_item(
            mut item,
            numerator,
            denominator,
            start_time: order.start_time,
            end_time: order.end_time,
            round_up: consideration,
        )
        j += 1
    }
    (order.order_type > 1, native_offer)
}

/// Authorize and record, or generate, order `index` if fulfillments remain.
/// Returns the book (a generated order moves the item pool) and whether the
/// order is available.
fn prepare_available_order(
    _ env: Env,
    book: mut Book,
    order_hashes: mut MemArray<u256>,
    index: u256,
    remaining: u256,
    revert_on_invalid: bool,
    recipient: Address,
) -> bool
uses (store: mut OrderStore, ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    if remaining == 0 {
        skip_available_order(mut book, mut order_hashes, index)
        false
    } else if unsafe { (*elem(book.orders.ptr(), index)).order_type } != CONTRACT as u256 {
        let available = prepare_standard_available_order(
            mut book,
            mut order_hashes,
            index,
            revert_on_invalid,
            recipient,
        )
        available
    } else {
        prepare_contract_available_order(
            mut book,
            mut order_hashes,
            index,
            revert_on_invalid,
            recipient,
        )
    }
}

fn skip_available_order(_ book: mut Book, order_hashes: mut MemArray<u256>, index: u256) {
    order_hashes[(index) as usize] = 0
    unsafe {
        (*elem(book.orders.ptr(), index)).numerator = 0
    }
}

fn prepare_standard_available_order(
    _ book: mut Book,
    order_hashes: mut MemArray<u256>,
    index: u256,
    revert_on_invalid: bool,
    recipient: Address,
) -> bool
uses (store: mut OrderStore, ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    let order_hash_slot = ref order_hashes[index as usize]
    let order_hash = order_hash_slot
    let available = authorize_and_record(
        mut book,
        mut order_hashes,
        order_hash,
        index,
        revert_on_invalid,
    )
    if available {
        emit_order_fulfilled(
            order_hash,
            book,
            order: unsafe {
                ref *elem(book.orders.ptr(), index)
            },
            recipient,
        )
    }
    available
}

fn prepare_contract_available_order(
    _ book: mut Book,
    order_hashes: mut MemArray<u256>,
    index: u256,
    revert_on_invalid: bool,
    recipient: Address,
) -> bool
uses (store: mut OrderStore, ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    let order_hash = generate_order(book, order_index: index, revert_on_invalid)
    order_hashes[(index) as usize] = order_hash
    if order_hash == 0 {
        unsafe {
            (*elem(book.orders.ptr(), index)).numerator = 0
        }
        false
    } else {
        install_generated_order(mut book, order_index: index)
        emit_order_fulfilled(
            order_hash,
            book,
            order: unsafe {
                ref *elem(book.orders.ptr(), index)
            },
            recipient,
        )
        true
    }
}

/// Authorize a restricted order with its zone and record the fill; false if
/// the order gets skipped.
fn authorize_and_record(
    _ book: mut Book,
    order_hashes: mut MemArray<u256>,
    order_hash: u256,
    index: u256,
    revert_on_invalid: bool,
) -> bool
uses (store: mut OrderStore, ctx: Ctx, call: mut Call, ops: mut RawOps)
{
    let order = unsafe {
        ref *elem(book.orders.ptr(), index)
    }
    let authorized = check_restricted_advanced_order_authorization(
        book,
        order,
        order_hashes,
        order_hash,
        order_index: index,
        revert_on_invalid,
    )
    if !authorized
        || !update_status(
            order_hash,
            numerator: order.numerator,
            denominator: order.denominator,
            revert_on_invalid: revert_on_failed_update(order, revert_on_invalid),
        ) {
        order_hashes[(index) as usize] = 0
        unsafe {
            (*elem(book.orders.ptr(), index)).numerator = 0
        }
        return false
    }
    true
}

/// `_revertOnFailedUpdate`: restricted orders fulfilled by someone other
/// than the zone must not be skipped silently.
fn revert_on_failed_update(_ order: OrderState, _ revert_on_invalid: bool) -> bool
uses (ctx: Ctx)
{
    revert_on_invalid || (order.order_type > 1 && ctx.caller() != order.zone)
}

/// `_fulfillAvailableAdvancedOrders`, which returns its result to the caller
/// of the contract itself.
#[arithmetic(unchecked)]
pub fn fulfill_available_advanced_orders(
    _ env: Env,
    book: mut Book,
    resolvers: Resolvers,
    offer_fulfillments: Groups,
    consideration_fulfillments: Groups,
    fulfiller_conduit_key: u256,
    recipient: Address,
    maximum_fulfilled: u256,
) -> !
uses (
    store: mut OrderStore,
    guard_state: mut u256,
    transient_guard: mut TSlot<u256>,
    ctx: Ctx,
    call: mut Call,
    ops: mut RawOps,
    log: mut Log,
)
{
    let (order_hashes, contains_non_open) = validate_orders_and_prepare_to_fulfill(
        env,
        mut book,
        resolvers,
        revert_on_invalid: false,
        maximum_fulfilled,
        recipient,
        non_match: true,
    )
    let total_offer = offer_fulfillments.len()
    var executions = MemArray<ExecutionState>::new_zeroed(
        (offer_fulfillments.len() + consideration_fulfillments.len()) as usize,
    )
    var i: u256 = 0
    while i < total_offer {
        aggregate_into(
            mut book,
            mut executions,
            slot: i,
            side: OFFER,
            groups: offer_fulfillments,
            index: i,
            fulfiller_conduit_key,
            recipient,
        )
        i += 1
    }
    i = 0
    while i < consideration_fulfillments.len() {
        aggregate_into(
            mut book,
            mut executions,
            slot: total_offer + i,
            side: CONSIDERATION,
            groups: consideration_fulfillments,
            index: i,
            fulfiller_conduit_key,
            recipient: Address::zero(),
        )
        i += 1
    }
    let available = perform_final_checks_and_execute_orders(
        env,
        mut book,
        executions,
        order_hashes,
        recipient,
        contains_non_open,
    )
    // Returning here keeps the six-word pair of arrays out of the entry
    // points' frame, which lies below every heap allocation.
    ops.return_data(data: encode_available(available, executions).span())
}

fn aggregate_into(
    _ book: mut Book,
    executions: mut MemArray<ExecutionState>,
    slot: u256,
    side: u8,
    groups: Groups,
    index: u256,
    fulfiller_conduit_key: u256,
    recipient: Address,
)
uses (ctx: Ctx)
{
    aggregate_available(
        mut book,
        execution: mut executions[(slot) as usize],
        side,
        groups,
        index,
        fulfiller_conduit_key,
        recipient,
    )
}

/// `_matchAdvancedOrders`
#[arithmetic(unchecked)]
pub fn match_advanced_orders(
    _ env: Env,
    book: mut Book,
    resolvers: Resolvers,
    fulfillments: Groups,
    recipient: Address,
) -> DynArray<Execution>
uses (
    store: mut OrderStore,
    guard_state: mut u256,
    transient_guard: mut TSlot<u256>,
    ctx: Ctx,
    call: mut Call,
    ops: mut RawOps,
    log: mut Log,
)
{
    let maximum_fulfilled = book.orders.len() as u256
    let (order_hashes, contains_non_open) = validate_orders_and_prepare_to_fulfill(
        env,
        mut book,
        resolvers,
        revert_on_invalid: true,
        maximum_fulfilled,
        recipient,
        non_match: false,
    )
    emit_orders_matched(order_hashes)
    let total_fulfillments = fulfillments.len() / 2
    var executions = MemArray<ExecutionState>::new_zeroed(total_fulfillments as usize)
    var i: u256 = 0
    while i < total_fulfillments {
        apply_fulfillment_into(mut book, mut executions, groups: fulfillments, index: i)
        i += 1
    }
    let _ = perform_final_checks_and_execute_orders(
        env,
        mut book,
        executions,
        order_hashes,
        recipient,
        contains_non_open,
    )
    execution_array(executions)
}

/// Kept out of line, like `validate_and_prepare_order`, so that the values
/// it keeps across calls take a frame of its own instead of its caller's,
/// which lies below every heap allocation.
#[inline(never)]
fn apply_fulfillment_into(
    _ book: mut Book,
    executions: mut MemArray<ExecutionState>,
    groups: Groups,
    index: u256,
) {
    apply_fulfillment(
        mut book,
        execution: mut executions[(index) as usize],
        groups,
        fulfillment_index: index,
    )
}

/// `_performFinalChecksAndExecuteOrders`: run the executions, transfer
/// unspent offer items to the recipient, require all consideration to be
/// met, refund native tokens and call zones and contract offerers.
///
/// Each phase holds only the pool access it needs.
#[arithmetic(unchecked)]
fn perform_final_checks_and_execute_orders(
    _ env: Env,
    book: mut Book,
    executions: MemArray<ExecutionState>,
    order_hashes: MemArray<u256>,
    recipient: Address,
    contains_non_open: bool,
) -> MemArray<bool>
uses (
    guard_state: mut u256,
    transient_guard: mut TSlot<u256>,
    ctx: Ctx,
    call: mut Call,
    ops: mut RawOps,
)
{
    let total_orders = book.orders.len() as u256
    var available = MemArray<bool>::new_zeroed(book.orders.len())
    // Executions plus unspent offer items bound the number of transfers.
    var buf = transfer_buffer(executions.len() as u256 + book.used)
    var acc = run_executions(env, executions, mut buf)
    var i: u256 = 0
    while i < total_orders {
        acc = settle_order(
            env,
            mut book,
            mut available,
            index: i,
            recipient,
            acc,
            mut buf,
        )
        i += 1
    }
    let _ = trigger_if_armed(acc, mut buf, env)
    let balance = ctx.selfbalance()
    if balance != 0 {
        transfer_native_tokens(to: ctx.caller(), amount: balance)
    }
    if contains_non_open {
        i = 0
        while i < total_orders {
            validate_available_order(book, available, order_hashes, index: i)
            i += 1
        }
    }
    clear_reentrancy_guard(env)
    available
}

/// Run every execution, out of line so that the values its loop keeps live
/// take a frame of its own.
#[arithmetic(unchecked)]
#[inline(never)]
fn run_executions(_ env: Env, executions: MemArray<ExecutionState>, buf: mut Buffer) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    var acc = new_accumulator()
    var i: u256 = 0
    while i < executions.len() as u256 {
        acc = run_execution(env, executions, index: i, acc, mut buf)
        i += 1
    }
    acc
}

fn run_execution(
    _ env: Env,
    executions: MemArray<ExecutionState>,
    index: u256,
    acc: Accumulator,
    buf: mut Buffer,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let execution = executions[(index) as usize]
    if execution.amount == 0 {
        return acc
    }
    if execution.item_type == NATIVE as u256 && execution.amount > ctx.selfbalance() {
        revert_with0(error_selector<InsufficientNativeTokensSupplied>())
    }
    let item = Transfer {
        item_type: execution.item_type,
        token: execution.token,
        identifier: execution.identifier,
        amount: execution.amount,
        recipient: execution.recipient,
    }
    transfer(
        item,
        from: execution.offerer,
        conduit_key: execution.conduit_key,
        acc,
        mut buf,
        env,
    )
}

/// Transfer the unspent offer items of an available order to the recipient
/// and require its consideration to be met, restoring the original amounts.
#[arithmetic(unchecked)]
fn settle_order(
    _ env: Env,
    book: mut Book,
    available: mut MemArray<bool>,
    index: u256,
    recipient: Address,
    acc: Accumulator,
    buf: mut Buffer,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let order = unsafe {
        ref *elem(book.orders.ptr(), index)
    }
    if order.numerator == 0 {
        return acc
    }
    available[(index) as usize] = true
    var current = acc
    var j: u256 = 0
    while j < order.offer_len {
        let item = unsafe {
            mut *elem(book.items.ptr(), order.offer_start + j)
        }
        let unspent = item.amount
        item.amount = item.original
        if unspent != 0 {
            current = transfer(
                Transfer {
                    item_type: item.item_type,
                    token: item.token,
                    identifier: item.identifier,
                    amount: unspent,
                    recipient,
                },
                from: order.offerer,
                conduit_key: order.conduit_key,
                acc: current,
                mut buf,
                env,
            )
        }
        j += 1
    }
    j = 0
    while j < order.consideration_len {
        let item = unsafe {
            mut *elem(book.items.ptr(), order.consideration_start + j)
        }
        if item.amount != 0 {
            revert_custom(
                error_selector<ConsiderationNotMet>(),
                words: 3,
                a: index,
                b: j,
                c: item.amount,
            )
        }
        item.amount = item.original
        j += 1
    }
    current
}

fn validate_available_order(
    _ book: Book,
    available: MemArray<bool>,
    order_hashes: MemArray<u256>,
    index: u256,
)
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    if available[(index) as usize] {
        assert_restricted_advanced_order_validity(
            book,
            order: unsafe {
                ref *elem(book.orders.ptr(), index)
            },
            order_hashes: ref order_hashes,
            order_hash: order_hashes[(index) as usize],
        )
    }
}

/// `OrdersMatched(orderHashes)`, encoded directly into the log data.
fn emit_orders_matched(_ order_hashes: MemArray<u256>) uses (log: mut Log) {
    let count = order_hashes.len() as u256
    // The offset and length words and the copied hashes fill the buffer.
    var data = unsafe {
        Buffer::uninit(64 + count * 32)
    }
    // The buffer holds the offset and length words.
    unsafe {
        data.put(offset: 0, value: 32)
        data.put(offset: 32, value: count)
    }
    data.copy_from(offset: 64, source: order_hashes.span())
    log.log1(data: data.span(), topic0: OrdersMatched::TOPIC0)
}

#[arithmetic(unchecked)]
pub fn execution_array(_ executions: MemArray<ExecutionState>) -> DynArray<Execution> {
    let count = executions.len() as u256
    // The tail holds seven words per execution, all written below, so no
    // offset overflows.
    var out = unsafe {
        Buffer::uninit_array(count, stride: 224)
    }
    unsafe {
        write_executions(out.at(32), executions)
    }
    out.into_dyn_array(len: count)
}

/// `(bool[] availableOrders, Execution[] executions)`, ABI-encoded as the
/// typed return of the fulfillAvailable entry points.
#[arithmetic(unchecked)]
pub fn encode_available(
    _ available: MemArray<bool>,
    executions: MemArray<ExecutionState>,
) -> Buffer {
    let orders = available.len() as u256
    let count = executions.len() as u256
    let executions_at = 0x60 + orders * 32
    // The heads, both length words and every element are written below, so
    // no offset overflows.
    var out = unsafe {
        Buffer::uninit(executions_at + 32 + count * 224)
    }
    unsafe {
        out.put(offset: 0, value: 0x40)
        out.put(offset: 32, value: executions_at)
        out.put(offset: 0x40, value: orders)
        out.put(offset: executions_at, value: count)
    }
    var i: u256 = 0
    while i < orders {
        unsafe {
            out.put(
                offset: 0x60 + i * 32,
                value: if available[i as usize] { 1 } else { 0 },
            )
        }
        i += 1
    }
    unsafe {
        write_executions(out.at(executions_at + 32), executions)
    }
    out
}

/// The seven words of each execution from `base`: the item type truncated
/// to `uint8`, then the remaining fields. The caller provides the room.
#[arithmetic(unchecked)]
unsafe fn write_executions(_ base: *u8, _ executions: MemArray<ExecutionState>) {
    let count = executions.len() as u256
    var i: u256 = 0
    while i < count {
        let e = ref executions[i as usize]
        let at = i * 224
        unsafe {
            store_at(base, offset: at, value: e.item_type & 0xff)
            store_at(base, offset: at + 32, value: e.token.word())
            store_at(base, offset: at + 64, value: e.identifier)
            store_at(base, offset: at + 96, value: e.amount)
            store_at(base, offset: at + 128, value: e.recipient.word())
            store_at(base, offset: at + 160, value: e.offerer.word())
            store_at(base, offset: at + 192, value: e.conduit_key)
        }
        i += 1
    }
}
