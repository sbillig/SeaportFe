// OrderCombiner: fulfillAvailable* and match* over groups of orders.
use std::abi::{Bytes32, DynArray}
use std::evm::{TSlot, Address, Call, Ctx, Log, RawOps, revert_error}
use super::buffer::Buffer
use super::amount::{get_fraction, locate_current_amount}
use super::applier::{ExecutionState, aggregate_available, apply_fulfillment}
use core::ptr::MemArray
use super::criteria::apply_criteria_resolvers
use super::errors::{
    ConsiderationNotMet,
    InsufficientNativeTokensSupplied,
    InvalidNativeOfferItem,
    NoSpecifiedOrdersAvailable,
    OrdersMatched,
}
use super::executor::{
    Accumulator,
    Transfer,
    new_accumulator,
    transfer,
    transfer_buffer,
    transfer_native_tokens,
    trigger_if_armed,
}
use super::fulfill::{emit_order_fulfilled, validate_order}
use super::hashing::Env
use super::model::{Book, Groups, Item, OrderState, Resolvers}
use super::status::{OrderStore, clear_reentrancy_guard, set_reentrancy_guard, update_status}
use super::types::{CONSIDERATION, CONTRACT, Execution, NATIVE, OFFER, ReceivedItem}
use super::zone::{
    assert_restricted_advanced_order_validity,
    check_restricted_advanced_order_authorization,
    generate_order,
    install_generated_order,
}

/// Current amount of `item` for the fraction; rounds up for consideration.
fn prepare_item(
    _ item: mut Item,
    numerator: u256,
    denominator: u256,
    start_time: u256,
    end_time: u256,
    round_up: bool,
)
uses (ctx: Ctx)
{
    let end_amount = get_fraction(numerator, denominator, value: item.end_amount)
    let start_amount = if item.start_amount == item.end_amount {
        end_amount
    } else {
        get_fraction(numerator, denominator, value: item.start_amount)
    }
    let current = locate_current_amount(start_amount, end_amount, start_time, end_time, round_up)
    item.amount = current
    item.original = current
}

/// `_validateOrdersAndPrepareToFulfill`: validate every order, derive the
/// current amounts, resolve criteria, authorize with zones or generate
/// contract orders, update statuses and emit `OrderFulfilled`. Returns the
/// book, the order hashes (zero for skipped orders) and whether any order is
/// restricted or a contract order.
pub fn validate_orders_and_prepare_to_fulfill(
    _ env: Env,
    book: mut Book,
    resolvers: Resolvers,
    revert_on_invalid: bool,
    maximum_fulfilled: u256,
    recipient: Address,
    non_match: bool,
) -> (MemArray<u256>, bool)
uses (
    store: mut OrderStore,
    guard_state: mut u256,
    transient_guard: mut TSlot<u256>,
    ctx: Ctx,
    call: mut Call,
    ops: mut RawOps,
    log: mut Log,
)
{
    set_reentrancy_guard(env, accept_native_tokens: true)
    let total_orders = book.orders.len() as u256
    var order_hashes = MemArray<u256>::new_zeroed(book.orders.len())
    var contains_non_open = false
    var invalid_native_offer_item = false
    var i: u256 = 0
    while i < total_orders {
        let (order_is_non_open, order_has_native_offer) = validate_and_prepare_order(
            env,
            mut book,
            mut order_hashes,
            index: i,
            revert_on_invalid,
        )
        if order_is_non_open {
            contains_non_open = true
        }
        if order_has_native_offer {
            invalid_native_offer_item = true
        }
        i += 1
    }
    // Native offer items are only rejected when not matching orders.
    if non_match && invalid_native_offer_item {
        revert_error(InvalidNativeOfferItem {})
    }

    apply_criteria_resolvers(mut book, resolvers)

    prepare_available_orders(
        env,
        mut book,
        mut order_hashes,
        maximum_fulfilled,
        revert_on_invalid,
        recipient,
    )
    (order_hashes, contains_non_open)
}

/// Second pass of `_validateOrdersAndPrepareToFulfill`: authorize, record and
/// emit for up to `maximum_fulfilled` orders.
fn prepare_available_orders(
    _ env: Env,
    book: mut Book,
    order_hashes: mut MemArray<u256>,
    maximum_fulfilled: u256,
    revert_on_invalid: bool,
    recipient: Address,
)
uses (store: mut OrderStore, ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    let total_orders = book.orders.len() as u256
    var remaining = maximum_fulfilled
    var some_order_available = false
    var i: u256 = 0
    while i < total_orders {
        if order_hashes[(i) as usize] != 0 {
            let available = prepare_available_order(
                env,
                mut book,
                mut order_hashes,
                index: i,
                remaining,
                revert_on_invalid,
                recipient,
            )
            if available {
                remaining = remaining - 1
                some_order_available = true
            }
        }
        i += 1
    }
    if !some_order_available {
        revert_error(NoSpecifiedOrdersAvailable {})
    }
}

/// Validate order `index` and derive its current amounts. Returns whether it
/// is restricted or a contract order, and whether a non-contract order
/// offers native tokens. Unavailable orders get a zero hash and numerator.
fn validate_and_prepare_order(
    _ env: Env,
    book: mut Book,
    order_hashes: mut MemArray<u256>,
    index: u256,
    revert_on_invalid: bool,
) -> (bool, bool)
uses (store: OrderStore, ctx: Ctx, call: Call, ops: RawOps)
{
    order_hashes[(index) as usize] = 0
    let (order_hash, numerator, denominator) = validate_order(
        env,
        book,
        order: book.orders[index as usize],
        revert_on_invalid,
    )
    book.orders[index as usize].numerator = numerator
    if numerator == 0 {
        return (false, false)
    }
    book.orders[index as usize].denominator = denominator
    let order = ref book.orders[index as usize]
    order_hashes[(index) as usize] = order_hash
    let is_non_contract = order.order_type < 4
    var native_offer = false
    var j: u256 = 0
    while j < order.offer_len {
        let item = mut book.items[(order.offer_start + j) as usize]
        if item.item_type == NATIVE as u256 && is_non_contract {
            native_offer = true
        }
        prepare_item(
            mut item,
            numerator,
            denominator,
            start_time: order.start_time,
            end_time: order.end_time,
            round_up: false,
        )
        j += 1
    }
    j = 0
    while j < order.consideration_len {
        let item = mut book.items[(order.consideration_start + j) as usize]
        prepare_item(
            mut item,
            numerator,
            denominator,
            start_time: order.start_time,
            end_time: order.end_time,
            round_up: true,
        )
        j += 1
    }
    (order.order_type > 1, native_offer)
}

/// Authorize and record, or generate, order `index` if fulfillments remain.
/// Returns the book (a generated order moves the item pool) and whether the
/// order is available.
fn prepare_available_order(
    _ env: Env,
    book: mut Book,
    order_hashes: mut MemArray<u256>,
    index: u256,
    remaining: u256,
    revert_on_invalid: bool,
    recipient: Address,
) -> bool
uses (store: mut OrderStore, ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    if remaining == 0 {
        skip_available_order(mut book, mut order_hashes, index)
        false
    } else if book.orders[(index) as usize].order_type != CONTRACT as u256 {
        let available = prepare_standard_available_order(
            mut book,
            mut order_hashes,
            index,
            revert_on_invalid,
            recipient,
        )
        available
    } else {
        prepare_contract_available_order(
            mut book,
            mut order_hashes,
            index,
            revert_on_invalid,
            recipient,
        )
    }
}

fn skip_available_order(_ book: mut Book, order_hashes: mut MemArray<u256>, index: u256) {
    order_hashes[(index) as usize] = 0
    book.orders[(index) as usize].numerator = 0
}

fn prepare_standard_available_order(
    _ book: mut Book,
    order_hashes: mut MemArray<u256>,
    index: u256,
    revert_on_invalid: bool,
    recipient: Address,
) -> bool
uses (store: mut OrderStore, ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    let order_hash_slot = ref order_hashes[index as usize]
    let order_hash = order_hash_slot
    let available = authorize_and_record(
        mut book,
        mut order_hashes,
        order_hash,
        index,
        revert_on_invalid,
    )
    if available {
        emit_order_fulfilled(
            order_hash,
            book,
            order: ref book.orders[(index) as usize],
            recipient,
        )
    }
    available
}

fn prepare_contract_available_order(
    _ book: mut Book,
    order_hashes: mut MemArray<u256>,
    index: u256,
    revert_on_invalid: bool,
    recipient: Address,
) -> bool
uses (store: mut OrderStore, ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    let generated = generate_order(book, order_index: index, revert_on_invalid)
    order_hashes[(index) as usize] = generated.order_hash
    if generated.order_hash == 0 {
        book.orders[(index) as usize].numerator = 0
        false
    } else {
        install_generated_order(mut book, order_index: index, generated)
        emit_order_fulfilled(
            order_hash: generated.order_hash,
            book,
            order: ref book.orders[(index) as usize],
            recipient,
        )
        true
    }
}

/// Authorize a restricted order with its zone and record the fill; false if
/// the order gets skipped.
fn authorize_and_record(
    _ book: mut Book,
    order_hashes: mut MemArray<u256>,
    order_hash: u256,
    index: u256,
    revert_on_invalid: bool,
) -> bool
uses (store: mut OrderStore, ctx: Ctx, call: mut Call, ops: mut RawOps)
{
    let order = ref book.orders[(index) as usize]
    let authorized = check_restricted_advanced_order_authorization(
        book,
        order,
        order_hashes,
        order_hash,
        order_index: index,
        revert_on_invalid,
    )
    if !authorized
        || !update_status(
            order_hash,
            numerator: order.numerator,
            denominator: order.denominator,
            revert_on_invalid: revert_on_failed_update(order, revert_on_invalid),
        ) {
        order_hashes[(index) as usize] = 0
        book.orders[index as usize].numerator = 0
        return false
    }
    true
}

/// `_revertOnFailedUpdate`: restricted orders fulfilled by someone other
/// than the zone must not be skipped silently.
fn revert_on_failed_update(_ order: OrderState, _ revert_on_invalid: bool) -> bool
uses (ctx: Ctx)
{
    revert_on_invalid || (order.order_type > 1 && ctx.caller() != order.zone)
}

/// `_fulfillAvailableAdvancedOrders`
pub fn fulfill_available_advanced_orders(
    _ env: Env,
    book: mut Book,
    resolvers: Resolvers,
    offer_fulfillments: Groups,
    consideration_fulfillments: Groups,
    fulfiller_conduit_key: u256,
    recipient: Address,
    maximum_fulfilled: u256,
) -> (DynArray<bool>, DynArray<Execution>)
uses (
    store: mut OrderStore,
    guard_state: mut u256,
    transient_guard: mut TSlot<u256>,
    ctx: Ctx,
    call: mut Call,
    ops: mut RawOps,
    log: mut Log,
)
{
    let (order_hashes, contains_non_open) = validate_orders_and_prepare_to_fulfill(
        env,
        mut book,
        resolvers,
        revert_on_invalid: false,
        maximum_fulfilled,
        recipient,
        non_match: true,
    )
    let total_offer = offer_fulfillments.list.len() as u256
    var executions = MemArray<ExecutionState>::new_zeroed(
        offer_fulfillments.list.len() + consideration_fulfillments.list.len(),
    )
    var i: u256 = 0
    while i < total_offer {
        aggregate_into(
            mut book,
            mut executions,
            slot: i,
            side: OFFER,
            groups: offer_fulfillments,
            index: i,
            fulfiller_conduit_key,
            recipient,
        )
        i += 1
    }
    i = 0
    while i < consideration_fulfillments.list.len() as u256 {
        aggregate_into(
            mut book,
            mut executions,
            slot: total_offer + i,
            side: CONSIDERATION,
            groups: consideration_fulfillments,
            index: i,
            fulfiller_conduit_key,
            recipient: Address::zero(),
        )
        i += 1
    }
    let available = perform_final_checks_and_execute_orders(
        env,
        mut book,
        executions,
        order_hashes,
        recipient,
        contains_non_open,
    )
    (bool_array(available), execution_array(executions))
}

fn aggregate_into(
    _ book: mut Book,
    executions: mut MemArray<ExecutionState>,
    slot: u256,
    side: u8,
    groups: Groups,
    index: u256,
    fulfiller_conduit_key: u256,
    recipient: Address,
)
uses (ctx: Ctx)
{
    executions[(slot) as usize] = aggregate_available(
        mut book,
        side,
        groups,
        index,
        fulfiller_conduit_key,
        recipient,
    )
}

/// `_matchAdvancedOrders`
pub fn match_advanced_orders(
    _ env: Env,
    book: mut Book,
    resolvers: Resolvers,
    fulfillments: Groups,
    recipient: Address,
) -> DynArray<Execution>
uses (
    store: mut OrderStore,
    guard_state: mut u256,
    transient_guard: mut TSlot<u256>,
    ctx: Ctx,
    call: mut Call,
    ops: mut RawOps,
    log: mut Log,
)
{
    let maximum_fulfilled = book.orders.len() as u256
    let (order_hashes, contains_non_open) = validate_orders_and_prepare_to_fulfill(
        env,
        mut book,
        resolvers,
        revert_on_invalid: true,
        maximum_fulfilled,
        recipient,
        non_match: false,
    )
    log.emit(OrdersMatched { orderHashes: hash_array(order_hashes) })
    let total_fulfillments = fulfillments.list.len() / 2
    var executions = MemArray<ExecutionState>::new_zeroed(total_fulfillments)
    var i: u256 = 0
    while i < total_fulfillments as u256 {
        apply_fulfillment_into(mut book, mut executions, groups: fulfillments, index: i)
        i += 1
    }
    let _ = perform_final_checks_and_execute_orders(
        env,
        mut book,
        executions,
        order_hashes,
        recipient,
        contains_non_open,
    )
    execution_array(executions)
}

fn apply_fulfillment_into(
    _ book: mut Book,
    executions: mut MemArray<ExecutionState>,
    groups: Groups,
    index: u256,
) {
    executions[(index) as usize] = apply_fulfillment(mut book, groups, fulfillment_index: index)
}

/// `_performFinalChecksAndExecuteOrders`: run the executions, transfer
/// unspent offer items to the recipient, require all consideration to be
/// met, refund native tokens and call zones and contract offerers.
///
/// Each phase holds only the pool access it needs.
fn perform_final_checks_and_execute_orders(
    _ env: Env,
    book: mut Book,
    executions: MemArray<ExecutionState>,
    order_hashes: MemArray<u256>,
    recipient: Address,
    contains_non_open: bool,
) -> MemArray<bool>
uses (
    guard_state: mut u256,
    transient_guard: mut TSlot<u256>,
    ctx: Ctx,
    call: mut Call,
    ops: mut RawOps,
)
{
    let total_orders = book.orders.len() as u256
    var available = MemArray<bool>::new_zeroed(book.orders.len())
    // Executions plus unspent offer items bound the number of transfers.
    var buf = transfer_buffer(executions.len() as u256 + book.used)
    var acc = new_accumulator()
    var i: u256 = 0
    while i < executions.len() as u256 {
        acc = run_execution(env, executions, index: i, acc, mut buf)
        i += 1
    }
    i = 0
    while i < total_orders {
        acc = settle_order(
            env,
            mut book,
            mut available,
            index: i,
            recipient,
            acc,
            mut buf,
        )
        i += 1
    }
    let _ = trigger_if_armed(acc, mut buf, env)
    let balance = ctx.selfbalance()
    if balance != 0 {
        transfer_native_tokens(to: ctx.caller(), amount: balance)
    }
    if contains_non_open {
        i = 0
        while i < total_orders {
            validate_available_order(book, available, order_hashes, index: i)
            i += 1
        }
    }
    clear_reentrancy_guard(env)
    available
}

fn run_execution(
    _ env: Env,
    executions: MemArray<ExecutionState>,
    index: u256,
    acc: Accumulator,
    buf: mut Buffer,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let execution = executions[(index) as usize]
    if execution.amount == 0 {
        return acc
    }
    if execution.item_type == NATIVE as u256 && execution.amount > ctx.selfbalance() {
        revert_error(InsufficientNativeTokensSupplied {})
    }
    let item = Transfer {
        item_type: execution.item_type,
        token: execution.token,
        identifier: execution.identifier,
        amount: execution.amount,
        recipient: execution.recipient,
    }
    transfer(
        item,
        from: execution.offerer,
        conduit_key: execution.conduit_key,
        acc,
        mut buf,
        env,
    )
}

/// Transfer the unspent offer items of an available order to the recipient
/// and require its consideration to be met; restores the original amounts.
/// Transfers and restores use separate loops over the owned item pool.
fn settle_order(
    _ env: Env,
    book: mut Book,
    available: mut MemArray<bool>,
    index: u256,
    recipient: Address,
    acc: Accumulator,
    buf: mut Buffer,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let order = ref book.orders[(index) as usize]
    available[(index) as usize] = order.numerator != 0
    if order.numerator == 0 {
        return acc
    }
    let settled = transfer_unspent_offer(env, book, order, recipient, acc, mut buf)
    restore_offer_amounts(mut book.items, order)
    check_consideration(mut book.items, order, order_index: index)
    settled
}

fn transfer_unspent_offer(
    _ env: Env,
    book: Book,
    order: OrderState,
    recipient: Address,
    acc: Accumulator,
    buf: mut Buffer,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    var current = acc
    var j: u256 = 0
    while j < order.offer_len {
        current = transfer_unspent_offer_item(
            env,
            book,
            order,
            index: j,
            recipient,
            acc: current,
            mut buf,
        )
        j += 1
    }
    current
}

fn transfer_unspent_offer_item(
    _ env: Env,
    book: Book,
    order: OrderState,
    index: u256,
    recipient: Address,
    acc: Accumulator,
    buf: mut Buffer,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let item = ref book.items[(order.offer_start + index) as usize]
    if item.amount == 0 {
        return acc
    }
    let unspent = Transfer {
        item_type: item.item_type,
        token: item.token,
        identifier: item.identifier,
        amount: item.amount,
        recipient,
    }
    transfer(
        unspent,
        from: order.offerer,
        conduit_key: order.conduit_key,
        acc,
        mut buf,
        env,
    )
}

fn restore_offer_amounts(_ items: mut MemArray<Item>, order: OrderState) {
    var j: u256 = 0
    while j < order.offer_len {
        let item = mut items[(order.offer_start + j) as usize]
        item.amount = item.original
        j += 1
    }
}

fn check_consideration(_ items: mut MemArray<Item>, order: OrderState, order_index: u256) {
    var j: u256 = 0
    while j < order.consideration_len {
        check_consideration_item(mut items, order, order_index, index: j)
        j += 1
    }
}

fn check_consideration_item(
    _ items: mut MemArray<Item>,
    order: OrderState,
    order_index: u256,
    index: u256,
) {
    let item = mut items[(order.consideration_start + index) as usize]
    if item.amount != 0 {
        revert_error(
            ConsiderationNotMet {
                orderIndex: order_index,
                considerationIndex: index,
                shortfallAmount: item.amount,
            },
        )
    }
    item.amount = item.original
}

fn validate_available_order(
    _ book: Book,
    available: MemArray<bool>,
    order_hashes: MemArray<u256>,
    index: u256,
)
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    if available[(index) as usize] {
        assert_restricted_advanced_order_validity(
            book,
            order: ref book.orders[(index) as usize],
            order_hashes,
            order_hash: order_hashes[(index) as usize],
        )
    }
}

fn bool_array(_ values: MemArray<bool>) -> DynArray<bool> {
    DynArray::from_slice(values.as_slice())
}

pub fn hash_array(_ values: MemArray<u256>) -> DynArray<Bytes32> {
    var out = MemArray<Bytes32>::new_zeroed(values.len())
    var i: usize = 0
    while i < values.len() {
        out[i] = Bytes32 { val: values[i] }
        i += 1
    }
    DynArray::from_slice(out.as_slice())
}

fn execution_array(_ executions: MemArray<ExecutionState>) -> DynArray<Execution> {
    var out = MemArray<Execution>::new_zeroed(executions.len())
    var i: usize = 0
    while i < executions.len() {
        let e = executions[i]
        out[i] = Execution {
            item: ReceivedItem {
                itemType: e.item_type.downcast_truncate(),
                token: e.token,
                identifier: e.identifier,
                amount: e.amount,
                recipient: e.recipient,
            },
            offerer: e.offerer,
            conduitKey: Bytes32 { val: e.conduit_key },
        }
        i += 1
    }
    DynArray::from_slice(out.as_slice())
}
