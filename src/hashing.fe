// EIP-712 typehashes and derivations of ConsiderationBase and
// GettersAndDerivers.
use std::evm::{Address, keccak256, keccak_words, create2_address}
use core::abi::store_word
use core::ptr::{self, MemArray, MemSpan}
use super::abi_view::CalldataView
use super::buffer::Buffer

/// keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)")
pub const EIP712_DOMAIN_TYPEHASH: u256 = 0x8b73c3c69bb8fe3d512ecc4cf759cc79239f7b179b0ffacaa9a75d522b39400f
/// keccak256("1.6")
pub const VERSION_HASH: u256 = 0x95f740a33d720b7cd93c75d515ac95ca3bbaa2594cce46ea48e00974ea8fcd14
/// keccak256("OfferItem(uint8 itemType,address token,uint256 identifierOrCriteria,uint256 startAmount,uint256 endAmount)")
pub const OFFER_ITEM_TYPEHASH: u256 = 0xa66999307ad1bb4fde44d13a5d710bd7718e0c87c1eef68a571629fbf5b93d02
/// keccak256("ConsiderationItem(uint8 itemType,address token,uint256 identifierOrCriteria,uint256 startAmount,uint256 endAmount,address recipient)")
pub const CONSIDERATION_ITEM_TYPEHASH: u256 = 0x42d81c6929ffdc4eb27a0808e40e82516ad42296c166065de7f812492304ff6e
/// keccak256 of the OrderComponents type string followed by the
/// ConsiderationItem and OfferItem type strings.
pub const ORDER_TYPEHASH: u256 = 0xfa445660b7e21515a59617fcd68910b487aa5808b8abda3d78bc85df364b2c2f

/// Immutable values that seaport-core keeps in `immutable` variables.
pub struct Env {
    pub name_hash: u256,
    pub chain_id: u256,
    pub domain_separator: u256,
    pub conduit_controller: Address,
    pub conduit_creation_code_hash: u256,
    pub tstore_initial_support: bool,
    pub tload_test_contract: Address,
}

impl Copy for Env {}

pub fn derive_domain_separator(name_hash: u256, chain_id: u256, this: Address) -> u256 {
    keccak_words(
        [EIP712_DOMAIN_TYPEHASH, name_hash, VERSION_HASH, chain_id, this.word()],
    )
}

/// `_deriveOrderHash`: the EIP-712 hash of the raw `OrderParameters` words
/// at `params` (Seaport hashes its raw calldata copy), covering the first
/// `consideration_count` consideration items, with `counter`.
pub fn derive_order_hash(_ params: CalldataView, consideration_count: u256, counter: u256) -> u256 {
    let offer = params.child(64)
    let offer_hash = hash_items(offer, count: offer.len(), consideration: false)
    let consideration_hash = hash_items(
        params.child(96),
        count: consideration_count,
        consideration: true,
    )
    keccak_words(
        [
            ORDER_TYPEHASH,
            params.word(0),
            params.word(32),
            offer_hash,
            consideration_hash,
            params.word(128),
            params.word(160),
            params.word(192),
            params.word(224),
            params.word(256),
            params.word(288),
            counter,
        ],
    )
}

/// The hash of the `OrderComponents` at `order`, whose counter replaces
/// `totalOriginalConsiderationItems` (`_decodeOrderComponentsAsOrderParameters`).
pub fn derive_components_hash(_ order: CalldataView) -> u256 {
    derive_order_hash(
        order,
        consideration_count: order.child(96).len(),
        counter: order.word(320),
    )
}

/// The hash of the first `count` raw items of the offer (or consideration)
/// array at `items`.
fn hash_items(_ items: CalldataView, count: u256, consideration: bool) -> u256 {
    let stride: u256 = if consideration { 192 } else { 160 }
    let scratch = ptr::alloc_bytes(224)
    var hashes = unsafe {
        MemArray<u256>::new_uninit(count as usize)
    }
    // `scratch` holds the typehash and one item.
    unsafe {
        store_word(
            ptr: scratch,
            value: if consideration {
                CONSIDERATION_ITEM_TYPEHASH
            } else {
                OFFER_ITEM_TYPEHASH
            },
        )
    }
    var i: u256 = 0
    while i < count {
        unsafe {
            items.element(index: i, stride).copy_to(ptr::offset_bytes(scratch, 32), len: stride)
        }
        hashes[i as usize] = keccak256(
            unsafe {
                MemSpan::from_raw_parts(ptr: scratch, len: (32 + stride) as usize)
            },
        )
        i += 1
    }
    keccak256(hashes.span())
}

/// keccak256(0x1901 ++ domainSeparator ++ orderHash)
pub fn derive_eip712_digest(domain_separator: u256, order_hash: u256) -> u256 {
    var buf = Buffer::new(66)
    buf.write(offset: 0, value: 0x1901 << 240)
    buf.write(offset: 2, value: domain_separator)
    buf.write(offset: 34, value: order_hash)
    keccak256(buf.span())
}

/// CREATE2 address of the conduit for `conduit_key`.
pub fn derive_conduit(_ env: Env, conduit_key: u256) -> Address {
    create2_address(
        deployer: env.conduit_controller,
        salt: conduit_key,
        init_code_hash: env.conduit_creation_code_hash,
    )
}

