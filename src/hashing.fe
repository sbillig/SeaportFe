// EIP-712 typehashes and derivations of ConsiderationBase and
// GettersAndDerivers.
use core::ptr
use std::evm::{Address, keccak256, keccak_words, create2_address}
use super::arr::Arr
use super::model::{Book, Item, OrderState}
use super::abi_view::ComponentsView

/// keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)")
pub const EIP712_DOMAIN_TYPEHASH: u256 = 0x8b73c3c69bb8fe3d512ecc4cf759cc79239f7b179b0ffacaa9a75d522b39400f
/// keccak256("1.6")
pub const VERSION_HASH: u256 = 0x95f740a33d720b7cd93c75d515ac95ca3bbaa2594cce46ea48e00974ea8fcd14
/// keccak256("OfferItem(uint8 itemType,address token,uint256 identifierOrCriteria,uint256 startAmount,uint256 endAmount)")
pub const OFFER_ITEM_TYPEHASH: u256 = 0xa66999307ad1bb4fde44d13a5d710bd7718e0c87c1eef68a571629fbf5b93d02
/// keccak256("ConsiderationItem(uint8 itemType,address token,uint256 identifierOrCriteria,uint256 startAmount,uint256 endAmount,address recipient)")
pub const CONSIDERATION_ITEM_TYPEHASH: u256 = 0x42d81c6929ffdc4eb27a0808e40e82516ad42296c166065de7f812492304ff6e
/// keccak256 of the OrderComponents type string followed by the
/// ConsiderationItem and OfferItem type strings.
pub const ORDER_TYPEHASH: u256 = 0xfa445660b7e21515a59617fcd68910b487aa5808b8abda3d78bc85df364b2c2f

/// Immutable values that seaport-core keeps in `immutable` variables.
pub struct Env {
    pub name_hash: u256,
    pub chain_id: u256,
    pub domain_separator: u256,
    pub conduit_controller: Address,
    pub conduit_creation_code_hash: u256,
    pub tstore_initial_support: bool,
    pub tload_test_contract: Address,
}

impl Copy for Env {}

pub fn derive_domain_separator(name_hash: u256, chain_id: u256, this: Address) -> u256 {
    keccak_words(
        [EIP712_DOMAIN_TYPEHASH, name_hash, VERSION_HASH, chain_id, this.inner],
    )
}

/// The EIP-712 hash of `order` with `counter`; only the first
/// `total_original` consideration items are included.
pub fn derive_order_hash(_ book: ref Book, order: *OrderState, counter: u256) -> u256 {
    let offer_hash = hash_items(
        book.items,
        start: order.offer_start,
        count: order.offer_len,
        consideration: false,
    )
    let consideration_hash = hash_items(
        book.items,
        start: order.consideration_start,
        count: order.total_original,
        consideration: true,
    )
    keccak_words(
        [
            ORDER_TYPEHASH,
            order.offerer.inner,
            order.zone.inner,
            offer_hash,
            consideration_hash,
            order.order_type,
            order.start_time,
            order.end_time,
            order.zone_hash,
            order.salt,
            order.conduit_key,
            counter,
        ],
    )
}

/// Hash an order's ABI fields without building the mutable fulfillment model.
pub fn derive_components_hash(_ order: ComponentsView) -> u256 {
    let offer = order.items(head_pos: 64, stride: 160)
    let offer_hashes = ptr::alloc_bytes(offer.len() * 32)
    let mut i: u256 = 0
    while i < offer.len() {
        store(
            ptr::offset_bytes(offer_hashes, i * 32),
            keccak_words(
                [
                    OFFER_ITEM_TYPEHASH,
                    offer.word(index: i, offset: 0),
                    offer.word(index: i, offset: 32),
                    offer.word(index: i, offset: 64),
                    offer.word(index: i, offset: 96),
                    offer.word(index: i, offset: 128),
                ],
            ),
        )
        i += 1
    }
    let consideration = order.items(head_pos: 96, stride: 192)
    let consideration_hashes = ptr::alloc_bytes(consideration.len() * 32)
    i = 0
    while i < consideration.len() {
        store(
            ptr::offset_bytes(consideration_hashes, i * 32),
            keccak_words(
                [
                    CONSIDERATION_ITEM_TYPEHASH,
                    consideration.word(index: i, offset: 0),
                    consideration.word(index: i, offset: 32),
                    consideration.word(index: i, offset: 64),
                    consideration.word(index: i, offset: 96),
                    consideration.word(index: i, offset: 128),
                    consideration.word(index: i, offset: 160),
                ],
            ),
        )
        i += 1
    }
    let offer_hash = keccak256(
        ptr::MemSpan::from_raw_parts(ptr: offer_hashes, len: offer.len() * 32),
    )
    let consideration_hash = keccak256(
        ptr::MemSpan::from_raw_parts(ptr: consideration_hashes, len: consideration.len() * 32),
    )
    keccak_words(
        [
            ORDER_TYPEHASH,
            order.word(0),
            order.word(32),
            offer_hash,
            consideration_hash,
            order.word(128),
            order.word(160),
            order.word(192),
            order.word(224),
            order.word(256),
            order.word(288),
            order.word(320),
        ],
    )
}

fn hash_items(_ items: Arr<Item>, start: u256, count: u256, consideration: bool) -> u256 {
    let hashes = ptr::alloc_bytes(count * 32)
    let mut i: u256 = 0
    while i < count {
        let item = items.at(start + i)
        let hash = if consideration {
            keccak_words(
                [
                    CONSIDERATION_ITEM_TYPEHASH,
                    item.item_type,
                    item.token.inner,
                    item.identifier,
                    item.amount,
                    item.original,
                    item.recipient.inner,
                ],
            )
        } else {
            keccak_words(
                [
                    OFFER_ITEM_TYPEHASH,
                    item.item_type,
                    item.token.inner,
                    item.identifier,
                    item.amount,
                    item.original,
                ],
            )
        }
        store(ptr::offset_bytes(hashes, i * 32), hash)
        i += 1
    }
    keccak256(
        core::ptr::MemSpan::from_raw_parts(ptr: hashes, len: count * 32),
    )
}

fn store(_ at: *u8, _ value: u256) {
    let word = ptr::cast<u8, u256>(at)
    *word = value
}

/// keccak256(0x1901 ++ domainSeparator ++ orderHash)
pub fn derive_eip712_digest(domain_separator: u256, order_hash: u256) -> u256 {
    let buf = ptr::alloc_bytes(96)
    store(buf, 0x1901 << 240)
    store(ptr::offset_bytes(buf, 2), domain_separator)
    store(ptr::offset_bytes(buf, 34), order_hash)
    keccak256(core::ptr::MemSpan::from_raw_parts(ptr: buf, len: 66))
}

/// CREATE2 address of the conduit for `conduit_key`.
pub fn derive_conduit(_ env: Env, conduit_key: u256) -> Address {
    create2_address(
        deployer: env.conduit_controller,
        salt: conduit_key,
        init_code_hash: env.conduit_creation_code_hash,
    )
}

