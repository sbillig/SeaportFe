/// `BulkOrder` typehash for heights 1 through 24. Other inputs retain the
/// height-24 fallback used by the original match.
pub fn bulk_order_typehash(_ height: u256) -> u256 {
    let index = height.wrapping_sub(1)
    let bounded = if index < 23 { index } else { 23 }
    BULK_ORDER_TYPEHASHES[bounded as usize]
}
