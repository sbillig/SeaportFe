// SPDX-License-Identifier: MIT
// SeaportRouter (contracts/helpers/SeaportRouter.sol): fulfill available
// orders across Seaport 1.5 and 1.6 in one call.
use core::ptr::{MemArray, MemSpan}
use std::abi::{Bytes, Bytes32, DynArray, dyn_array_from, sol}
use std::abi::sol::decode_output
use std::evm::{Address, Call, Create, Ctx, RawOps, TSlot, revert_error, wei}
use super::hashing::Env
use super::buffer::return_word
use super::seaport::SeaportMsg
use super::status::{
    REENTRANCY_GUARD_SLOT,
    activate_tstore,
    clear_reentrancy_guard,
    set_reentrancy_guard,
    setup_reentrancy_guard,
}
use super::errors::{NoSpecifiedOrdersAvailable}
use super::types::{AdvancedOrder, CriteriaResolver, Execution, FulfillmentComponent}

#[abi]
pub struct AdvancedOrderParams {
    pub advancedOrders: DynArray<AdvancedOrder>,
    pub criteriaResolvers: DynArray<CriteriaResolver>,
    pub offerFulfillments: DynArray<DynArray<FulfillmentComponent>>,
    pub considerationFulfillments: DynArray<DynArray<FulfillmentComponent>>,
    pub etherValue: u256,
}

#[abi]
pub struct FulfillAvailableAdvancedOrdersParams {
    pub seaportContracts: DynArray<Address>,
    pub advancedOrderParams: DynArray<AdvancedOrderParams>,
    pub fulfillerConduitKey: Bytes32,
    pub recipient: Address,
    pub maximumFulfilled: u256,
}

#[error]
pub struct SeaportNotAllowed { pub seaport: Address }
#[error]
pub struct EtherReturnTransferFailed {
    pub recipient: Address,
    pub amount: u256,
    pub returnData: Bytes,
}

pub msg SeaportRouterMsg {
    #[selector = sol(
        "fulfillAvailableAdvancedOrders((address[],(((address,address,(uint8,address,uint256,uint256,uint256)[],(uint8,address,uint256,uint256,uint256,address)[],uint8,uint256,uint256,bytes32,uint256,bytes32,uint256),uint120,uint120,bytes,bytes)[],(uint256,uint8,uint256,uint256,bytes32[])[],(uint256,uint256)[][],(uint256,uint256)[][],uint256)[],bytes32,address,uint256))",
    )]
    FulfillAvailableAdvancedOrders { params: FulfillAvailableAdvancedOrdersParams } -> (
        DynArray<DynArray<bool>>,
        DynArray<DynArray<Execution>>,
    ),
    #[selector = sol("getAllowedSeaportContracts()")]
    GetAllowedSeaportContracts {} -> DynArray<Address>,
    #[selector = sol("__activateTstore()")]
    ActivateTstore {},
}

/// NoSpecifiedOrdersAvailable()
const NO_SPECIFIED_ORDERS_AVAILABLE_SELECTOR: u256 = 0xd5da9a1b

pub struct RouterEnv { pub seaport_v1_5: Address, pub seaport_v1_6: Address, pub guard: Env }

impl Copy for RouterEnv {}

/// Constructor, including the inherited ReentrancyGuard constructor.
pub fn setup(seaport_v1_5: Address, seaport_v1_6: Address) -> RouterEnv
uses (guard_state: mut u256, ctx: Ctx, call: Call, create: mut Create)
{
    let (tstore_initial_support, tload_test_contract) = setup_reentrancy_guard()
    RouterEnv {
        seaport_v1_5,
        seaport_v1_6,
        guard: Env {
            name_hash: 0,
            chain_id: 0,
            domain_separator: 0,
            conduit_controller: Address::zero(),
            conduit_creation_code_hash: 0,
            tstore_initial_support,
            tload_test_contract,
        },
    }
}

fn assert_seaport_allowed(_ env: RouterEnv, seaport: Address) {
    if seaport != env.seaport_v1_5 && seaport != env.seaport_v1_6 {
        revert_error(SeaportNotAllowed { seaport })
    }
}

/// `fulfillAvailableAdvancedOrders`: forward each group of orders to its
/// Seaport, skipping groups that revert with `NoSpecifiedOrdersAvailable`.
pub fn fulfill_available_advanced_orders(
    _ env: RouterEnv,
    params: FulfillAvailableAdvancedOrdersParams,
) -> (DynArray<DynArray<bool>>, DynArray<DynArray<Execution>>)
uses (
    guard_state: mut u256,
    transient_guard: mut TSlot<u256>,
    ctx: Ctx,
    call: mut Call,
    ops: mut RawOps,
)
{
    set_reentrancy_guard(env.guard, accept_native_tokens: true)
    let seaports = params.seaportContracts
    let order_params = params.advancedOrderParams
    let count = seaports.len()
    // Unavailable groups share one empty array of each kind.
    let no_available = DynArray<bool>::empty()
    let no_executions = DynArray<Execution>::empty()
    var available_parts = MemArray<DynArray<bool>>::from_fn(count, |_| no_available)
    var execution_parts = MemArray<DynArray<Execution>>::from_fn(count, |_| no_executions)
    var i: usize = 0
    let maximum_fulfilled = params.maximumFulfilled
    var fulfillments_left = maximum_fulfilled
    let recipient = if params.recipient.word() == 0 {
        ctx.caller()
    } else {
        params.recipient
    }
    while i < count {
        let seaport = seaports.get(i)
        assert_seaport_allowed(env, seaport)
        let group = order_params.get(i)
        let ether_value = group.etherValue
        let message = SeaportMsg::FulfillAvailableAdvancedOrders {
            advancedOrders: group.advancedOrders,
            criteriaResolvers: group.criteriaResolvers,
            offerFulfillments: group.offerFulfillments,
            considerationFulfillments: group.considerationFulfillments,
            fulfillerConduitKey: params.fulfillerConduitKey,
            recipient,
            maximumFulfilled: fulfillments_left,
        }
        let outcome = call.try_call(
                addr: seaport,
                gas: ctx.gas(),
                value: wei(ether_value),
                message,
            )
        let returned = outcome.returndata()
        if outcome.success() {
            let (available, executions): (DynArray<bool>, DynArray<Execution>) = decode_output(
                returned,
            )
            available_parts[i] = available
            execution_parts[i] = executions
            // Upstream only advances `j` for available orders, so an
            // unavailable order loops until the call runs out of gas.
            var j: usize = 0
            while j < available.len() {
                if available.get(j) {
                    fulfillments_left = fulfillments_left.wrapping_sub(1)
                    j += 1
                }
            }
            if fulfillments_left == 0 {
                break
            }
        } else {
            let selector = if returned.len() >= 4 {
                return_word(returned, initial: 0) >> 224
            } else {
                0
            }
            if selector != NO_SPECIFIED_ORDERS_AVAILABLE_SELECTOR {
                ops.revert(data: returned)
            }
        }
        i += 1
    }
    if fulfillments_left == maximum_fulfilled {
        revert_error(NoSpecifiedOrdersAvailable {})
    }
    if ctx.selfbalance().as_wei() > 0 {
        return_excess_ether()
    }
    clear_reentrancy_guard(env.guard)
    (
        DynArray::from_slice(available_parts.as_slice()),
        DynArray::from_slice(execution_parts.as_slice()),
    )
}

/// `_returnExcessEther`
fn return_excess_ether() uses (ctx: Ctx, call: mut Call) {
    let outcome = call
        .try_call_raw(
            addr: ctx.caller(),
            gas: ctx.gas(),
            value: ctx.selfbalance(),
            args: MemSpan::empty(),
        )
    if !outcome.success() {
        revert_error(
            EtherReturnTransferFailed {
                recipient: ctx.caller(),
                amount: ctx.selfbalance().as_wei(),
                returnData: Bytes::from_payload(source: outcome.returndata()),
            },
        )
    }
}

pub fn get_allowed_seaport_contracts(_ env: RouterEnv) -> DynArray<Address> {
    dyn_array_from([env.seaport_v1_5, env.seaport_v1_6])
}

pub contract SeaportRouter {
    env: RouterEnv,
    #[slot(REENTRANCY_GUARD_SLOT)]
    mut guard_state: u256,
    #[slot(REENTRANCY_GUARD_SLOT)]
    mut transient_guard: TSlot<u256>,

    init(seaportV1point5: Address, seaportV1point6: Address)
    uses (mut guard_state, mut env, ctx: Ctx, call: Call, create: mut Create)
    {
        env = setup(
            seaport_v1_5: seaportV1point5,
            seaport_v1_6: seaportV1point6,
        )
    }

    recv {
        #[payable]
        SeaportRouterMsg::FulfillAvailableAdvancedOrders { params } -> (
            DynArray<DynArray<bool>>,
            DynArray<DynArray<Execution>>,
        )
        uses (mut guard_state, mut transient_guard, env, ctx: Ctx, call: mut Call, ops: mut RawOps)
        {
            fulfill_available_advanced_orders(env, params)
        }
        SeaportRouterMsg::GetAllowedSeaportContracts {} -> DynArray<Address>
        uses (env)
        {
            get_allowed_seaport_contracts(env)
        }
        SeaportRouterMsg::ActivateTstore {} uses (mut guard_state, env, ctx: Ctx, call: Call) {
            activate_tstore(env.guard)
        }
        #[payable]
        _ uses (env, ctx: Ctx, ops: RawOps) {
            if ops.calldatasize() != 0 {
                std::evm::revert(())
            }
            assert_seaport_allowed(env, seaport: ctx.caller())
        }
    }
}
