// SPDX-License-Identifier: MIT
// Executor and TokenTransferrer: native, ERC20, ERC721 and ERC1155 transfers,
// either directly or batched into one `Conduit.execute` call through the
// accumulator.
#![arithmetic(unchecked)]
use core::ptr::{MemBuffer, MemSpan}
use std::abi::Bytes32
use std::evm::{Address, Call, Ctx, RawOps, revert_error}
use super::errors::{
    BadReturnValueFromERC20OnTransfer,
    InvalidCallToConduit,
    InvalidConduit,
    InvalidERC721TransferAmount,
    MissingItemAmount,
    NoContract,
    TokenTransferGenericFailure,
    UnusedItemParameters,
}
use super::hashing::{Env, derive_conduit}
use super::lowlevel::revert_with_reason_if_one_is_returned
use super::buffer::{Buffer, return_word}
use super::types::{ERC20, NATIVE}

/// transferFrom(address,address,uint256), shared by ERC20 and ERC721.
const TRANSFER_FROM_SELECTOR: u256 = 0x23b872dd
/// safeTransferFrom(address,address,uint256,uint256,bytes)
const ERC1155_SAFE_TRANSFER_FROM_SELECTOR: u256 = 0xf242432a
/// execute((uint8,address,address,address,uint256,uint256)[])
pub const CONDUIT_EXECUTE_SELECTOR: u256 = 0x4ce34aa2

// ConduitItemType
pub const CONDUIT_ERC20: u256 = 1
pub const CONDUIT_ERC721: u256 = 2
pub const CONDUIT_ERC1155: u256 = 3

/// A `ReceivedItem` in transfer position.
pub struct Transfer {
    pub item_type: u256,
    pub token: Address,
    pub identifier: u256,
    pub amount: u256,
    pub recipient: Address,
}

impl Copy for Transfer {}

/// Metadata for conduit transfers in a separately owned, checked Buffer.
/// Copying this scalar record grants no access to the transfer buffer.
pub struct Accumulator { pub armed: bool, pub conduit_key: u256, pub count: u256 }

impl Copy for Accumulator {}

pub fn new_accumulator() -> Accumulator {
    Accumulator { armed: false, conduit_key: 0, count: 0 }
}

/// The `execute` selector, array offset and length in front of the
/// accumulated transfers.
const ACCUMULATOR_HEAD: u256 = 0x44

/// A transfer buffer for up to `transfers` conduit transfers, laid out as
/// the `execute` call data like seaport-core's accumulator. While the
/// accumulator is disarmed its contents are dead, and direct token transfers
/// write their call data to it.
pub fn transfer_buffer(_ transfers: u256) -> Buffer {
    Buffer::new(ACCUMULATOR_HEAD + transfers * 0xc0)
}

/// `_transfer`: move one item from `from` to its recipient.
pub fn transfer(
    _ item: Transfer,
    from: Address,
    conduit_key: u256,
    acc: Accumulator,
    buf: mut Buffer,
    env: Env,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    if item.item_type == NATIVE as u256 {
        if (item.token.word() | item.identifier) != 0 {
            revert_error(UnusedItemParameters {})
        }
        transfer_native_tokens(to: item.recipient, amount: item.amount)
        return acc
    }
    if item.item_type == ERC20 as u256 && item.identifier != 0 {
        revert_error(UnusedItemParameters {})
    }
    // ERC20 and ERC721 keep their numbers as conduit item types; every other
    // item type is transferred as ERC1155.
    transfer_token(
        kind: if item.item_type < CONDUIT_ERC1155 {
            item.item_type
        } else {
            CONDUIT_ERC1155
        },
        token: item.token,
        from,
        to: item.recipient,
        identifier: item.identifier,
        amount: item.amount,
        conduit_key,
        acc,
        mut buf,
        env,
    )
}

pub fn assert_non_zero_amount(_ amount: u256) {
    if amount == 0 {
        revert_error(MissingItemAmount {})
    }
}

/// `_transferNativeTokens`
pub fn transfer_native_tokens(to: Address, amount: u256)
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    assert_non_zero_amount(amount)
    // The failure payload is written before the call: a recipient may burn
    // all forwarded gas, and seaport-core still reverts with the custom error
    // from the remaining 1/64. Encoding it after the call does not fit into
    // that budget.
    var failure = Buffer::new(0x44)
    failure.write(
            offset: 0,
            value: NATIVE_TOKEN_TRANSFER_GENERIC_FAILURE_SELECTOR << 224,
        )
    failure.write(offset: 0x04, value: to.word())
    failure.write(offset: 0x24, value: amount)
    var ret = MemBuffer::empty()
    let outcome = call
        .raw_call(
            addr: to,
            gas: ctx.gas(),
            value: amount,
            args: MemSpan::empty(),
            ret: mut ret,
        )
    if !outcome.success() {
        revert_with_reason_if_one_is_returned()
        ops.revert(data: failure.span())
    }
}

/// NativeTokenTransferGenericFailure(address,uint256)
const NATIVE_TOKEN_TRANSFER_GENERIC_FAILURE_SELECTOR: u256 = 0xbc806b96

/// `_transferERC20`, `_transferERC721` or `_transferERC1155`, selected by
/// the conduit item type `kind`: transfer directly or add the transfer to the
/// accumulator, executing it first if it targets another conduit.
pub fn transfer_token(
    kind: u256,
    token: Address,
    from: Address,
    to: Address,
    identifier: u256,
    amount: u256,
    conduit_key: u256,
    acc: Accumulator,
    buf: mut Buffer,
    env: Env,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    if kind != CONDUIT_ERC721 {
        assert_non_zero_amount(amount)
    }
    let current = if acc.conduit_key != conduit_key {
        trigger_if_armed(acc, mut buf, env)
    } else {
        acc
    }
    if conduit_key != 0 {
        return insert(
            current,
            mut buf,
            conduit_key,
            item_type: kind,
            token,
            from,
            to,
            identifier,
            amount,
        )
    }
    // `current` is disarmed here, so the buffer is free.
    perform_transfer(
        kind,
        token,
        from,
        to,
        identifier,
        amount,
        scratch: mut buf,
    )
    current
}

/// Execute the accumulated conduit transfers, if any.
pub fn trigger_if_armed(_ acc: Accumulator, _ buf: mut Buffer, _ env: Env) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    if !acc.armed { return acc }
    buf.write(offset: 0, value: CONDUIT_EXECUTE_SELECTOR << 224)
    buf.write(offset: 4, value: 0x20)
    buf.write(offset: 0x24, value: acc.count)
    call_conduit(
        env,
        conduit_key: acc.conduit_key,
        args: buf.slice(offset: 0, len: ACCUMULATOR_HEAD + acc.count * 0xc0),
    )
    var disarmed = acc
    disarmed.armed = false
    disarmed
}

/// `_callConduitUsingOffsets`: call the conduit and require the `execute`
/// magic value.
pub fn call_conduit(_ env: Env, conduit_key: u256, args: MemSpan)
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let conduit = derive_conduit(env, conduit_key)
    var ret = MemBuffer::with_capacity(32)
    let outcome = call.raw_call(
            addr: conduit,
            gas: ctx.gas(),
            value: 0,
            args,
            ret: mut ret,
        )
    if !outcome.success() {
        revert_with_reason_if_one_is_returned()
        revert_error(InvalidCallToConduit { conduit })
    }
    if return_word(ret.span(), initial: 0) >> 224 != CONDUIT_EXECUTE_SELECTOR {
        revert_error(
            InvalidConduit { conduitKey: Bytes32 { val: conduit_key }, conduit },
        )
    }
}

pub fn insert(
    _ previous: Accumulator,
    _ buf: mut Buffer,
    _ conduit_key: u256,
    item_type: u256,
    token: Address,
    from: Address,
    to: Address,
    identifier: u256,
    amount: u256,
) -> Accumulator {
    var acc = previous
    if !acc.armed {
        acc.armed = true
        acc.conduit_key = conduit_key
        acc.count = 0
    }
    let at = ACCUMULATOR_HEAD + acc.count * 0xc0
    buf.write(offset: at, value: item_type)
    buf.write(offset: at + 0x20, value: token.word())
    buf.write(offset: at + 0x40, value: from.word())
    buf.write(offset: at + 0x60, value: to.word())
    buf.write(offset: at + 0x80, value: identifier)
    buf.write(offset: at + 0xa0, value: amount)
    acc.count = acc.count + 1
    acc
}

/// `_performERC20Transfer`, `_performERC721Transfer` (preceded by the amount
/// check all its callers make) or `_performERC1155Transfer`, by conduit item
/// type, with the call data written to the start of `scratch`. ERC20
/// transfers succeed on `true` or on empty returndata from a contract.
pub fn perform_transfer(
    kind: u256,
    token: Address,
    from: Address,
    to: Address,
    identifier: u256,
    amount: u256,
    scratch: mut Buffer,
)
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let erc20 = kind == CONDUIT_ERC20
    let erc1155 = kind == CONDUIT_ERC1155
    if kind == CONDUIT_ERC721 && amount != 1 {
        revert_error(InvalidERC721TransferAmount { amount })
    }
    if !erc20 && ctx.extcodesize(token) == 0 {
        revert_error(NoContract { account: token })
    }
    // transferFrom(from, to, amount or identifier), or
    // safeTransferFrom(from, to, identifier, amount, "").
    scratch
        .write(
            offset: 0,
            value: (if erc1155 {
                    ERC1155_SAFE_TRANSFER_FROM_SELECTOR
                } else {
                    TRANSFER_FROM_SELECTOR
                })
                << 224,
        )
    scratch.write(offset: 0x04, value: from.word())
    scratch.write(offset: 0x24, value: to.word())
    scratch.write(
            offset: 0x44,
            value: if erc20 { amount } else { identifier },
        )
    if erc1155 {
        scratch.write(offset: 0x64, value: amount)
        scratch.write(offset: 0x84, value: 0xa0)
        scratch.write(offset: 0xa4, value: 0)
    }
    var ret = MemBuffer::with_capacity(32)
    let outcome = call
        .raw_call(
            addr: token,
            gas: ctx.gas(),
            value: 0,
            args: scratch.slice(offset: 0, len: if erc1155 { 0xc4 } else { 0x64 }),
            ret: mut ret,
        )
    if !outcome.success() {
        revert_with_reason_if_one_is_returned()
        revert_error(
            TokenTransferGenericFailure {
                token,
                from,
                to,
                identifier: if erc20 { 0 } else { identifier },
                amount,
            },
        )
    }
    if !erc20 { return }
    let size = outcome.returndata_len()
    if size == 0 {
        if ctx.extcodesize(token) == 0 {
            revert_error(NoContract { account: token })
        }
        return
    }
    if size < 32 || return_word(ret.span(), initial: 0) != 1 {
        revert_error(
            BadReturnValueFromERC20OnTransfer { token, from, to, amount },
        )
    }
}
