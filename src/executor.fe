// SPDX-License-Identifier: MIT
// Executor and TokenTransferrer: native, ERC20, ERC721 and ERC1155 transfers,
// either directly or batched into one `Conduit.execute` call through the
// accumulator.
use core::ptr::{MemBuffer, MemSpan}
use std::abi::Bytes32
use std::evm::{Address, Call, Ctx, RawOps, revert_error}
use super::errors::{
    BadReturnValueFromERC20OnTransfer,
    InvalidCallToConduit,
    InvalidConduit,
    InvalidERC721TransferAmount,
    MissingItemAmount,
    NoContract,
    TokenTransferGenericFailure,
    UnusedItemParameters,
}
use super::hashing::{Env, derive_conduit}
use super::lowlevel::revert_with_reason_if_one_is_returned
use super::buffer::{Buffer, return_word}
use super::types::{ERC20, ERC721, NATIVE}

/// transferFrom(address,address,uint256), shared by ERC20 and ERC721.
const TRANSFER_FROM_SELECTOR: u256 = 0x23b872dd
/// safeTransferFrom(address,address,uint256,uint256,bytes)
const ERC1155_SAFE_TRANSFER_FROM_SELECTOR: u256 = 0xf242432a
/// execute((uint8,address,address,address,uint256,uint256)[])
pub const CONDUIT_EXECUTE_SELECTOR: u256 = 0x4ce34aa2

// ConduitItemType
const CONDUIT_ERC20: u256 = 1
const CONDUIT_ERC721: u256 = 2
const CONDUIT_ERC1155: u256 = 3

/// A `ReceivedItem` in transfer position.
pub struct Transfer {
    pub item_type: u256,
    pub token: Address,
    pub identifier: u256,
    pub amount: u256,
    pub recipient: Address,
}

impl Copy for Transfer {}

/// Metadata for conduit transfers in a separately owned, checked Buffer.
/// Copying this scalar record grants no access to the transfer buffer.
pub struct Accumulator { pub armed: bool, pub conduit_key: u256, pub count: u256 }

impl Copy for Accumulator {}

pub fn new_accumulator() -> Accumulator {
    Accumulator { armed: false, conduit_key: 0, count: 0 }
}

/// A transfer buffer for up to `transfers` conduit transfers.
pub fn transfer_buffer(_ transfers: u256) -> Buffer {
    Buffer::new(transfers * 0xc0)
}

fn calldata_with_selector(_ selector: u256, _ words: u256) -> Buffer {
    var data = Buffer::new(4 + words * 32)
    data.write(offset: 0, value: selector << 224)
    data
}

fn set_arg(_ data: mut Buffer, _ index: u256, _ value: u256) {
    data.write(offset: 4 + index * 32, value)
}

/// `_transfer`: move one item from `from` to its recipient.
pub fn transfer(
    _ item: Transfer,
    from: Address,
    conduit_key: u256,
    acc: Accumulator,
    buf: mut Buffer,
    env: Env,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    if item.item_type == NATIVE as u256 {
        if (item.token.inner | item.identifier) != 0 {
            revert_error(UnusedItemParameters {})
        }
        transfer_native_tokens(to: item.recipient, amount: item.amount)
        return acc
    }
    if item.item_type == ERC20 as u256 {
        if item.identifier != 0 {
            revert_error(UnusedItemParameters {})
        }
        return transfer_erc20(
            token: item.token,
            from,
            to: item.recipient,
            amount: item.amount,
            conduit_key,
            acc,
            mut buf,
            env,
        )
    }
    if item.item_type == ERC721 as u256 {
        return transfer_erc721(
            token: item.token,
            from,
            to: item.recipient,
            identifier: item.identifier,
            amount: item.amount,
            conduit_key,
            acc,
            mut buf,
            env,
        )
    }
    transfer_erc1155(
        token: item.token,
        from,
        to: item.recipient,
        identifier: item.identifier,
        amount: item.amount,
        conduit_key,
        acc,
        mut buf,
        env,
    )
}

pub fn assert_non_zero_amount(_ amount: u256) {
    if amount == 0 {
        revert_error(MissingItemAmount {})
    }
}

/// `_transferNativeTokens`
pub fn transfer_native_tokens(to: Address, amount: u256)
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    assert_non_zero_amount(amount)
    // The failure payload is written before the call: a recipient may burn
    // all forwarded gas, and seaport-core still reverts with the custom error
    // from the remaining 1/64. Encoding it after the call does not fit into
    // that budget.
    var failure = Buffer::new(0x44)
    failure.write(
            offset: 0,
            value: NATIVE_TOKEN_TRANSFER_GENERIC_FAILURE_SELECTOR << 224,
        )
    failure.write(offset: 0x04, value: to.inner)
    failure.write(offset: 0x24, value: amount)
    var ret = MemBuffer::empty()
    let outcome = call
        .raw_call(
            addr: to,
            gas: ctx.gas(),
            value: amount,
            args: MemSpan::empty(),
            ret: mut ret,
        )
    if !outcome.success() {
        revert_with_reason_if_one_is_returned()
        ops.revert(data: failure.span())
    }
}

/// NativeTokenTransferGenericFailure(address,uint256)
const NATIVE_TOKEN_TRANSFER_GENERIC_FAILURE_SELECTOR: u256 = 0xbc806b96

pub fn transfer_erc20(
    token: Address,
    from: Address,
    to: Address,
    amount: u256,
    conduit_key: u256,
    acc: Accumulator,
    buf: mut Buffer,
    env: Env,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    assert_non_zero_amount(amount)
    let acc = trigger_if_armed_and_not_accumulatable(acc, mut buf, conduit_key, env)
    if conduit_key == 0 {
        perform_erc20_transfer(token, from, to, amount)
        return acc
    }
    insert(
        acc,
        mut buf,
        conduit_key,
        item_type: CONDUIT_ERC20,
        token,
        from,
        to,
        identifier: 0,
        amount,
    )
}

pub fn transfer_erc721(
    token: Address,
    from: Address,
    to: Address,
    identifier: u256,
    amount: u256,
    conduit_key: u256,
    acc: Accumulator,
    buf: mut Buffer,
    env: Env,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let acc = trigger_if_armed_and_not_accumulatable(acc, mut buf, conduit_key, env)
    if conduit_key == 0 {
        if amount != 1 {
            revert_error(InvalidERC721TransferAmount { amount })
        }
        perform_erc721_transfer(token, from, to, identifier)
        return acc
    }
    insert(
        acc,
        mut buf,
        conduit_key,
        item_type: CONDUIT_ERC721,
        token,
        from,
        to,
        identifier,
        amount,
    )
}

pub fn transfer_erc1155(
    token: Address,
    from: Address,
    to: Address,
    identifier: u256,
    amount: u256,
    conduit_key: u256,
    acc: Accumulator,
    buf: mut Buffer,
    env: Env,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    assert_non_zero_amount(amount)
    let acc = trigger_if_armed_and_not_accumulatable(acc, mut buf, conduit_key, env)
    if conduit_key == 0 {
        perform_erc1155_transfer(token, from, to, identifier, amount)
        return acc
    }
    insert(
        acc,
        mut buf,
        conduit_key,
        item_type: CONDUIT_ERC1155,
        token,
        from,
        to,
        identifier,
        amount,
    )
}

fn trigger_if_armed_and_not_accumulatable(
    _ acc: Accumulator,
    _ buf: mut Buffer,
    _ conduit_key: u256,
    _ env: Env,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    if acc.conduit_key != conduit_key {
        return trigger_if_armed(acc, mut buf, env)
    }
    acc
}

/// Execute the accumulated conduit transfers, if any.
pub fn trigger_if_armed(_ acc: Accumulator, _ buf: mut Buffer, _ env: Env) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    if !acc.armed { return acc }
    let count = acc.count
    let size = 0x44 + count * 0xc0
    var data = Buffer::new(size)
    data.write(offset: 0, value: CONDUIT_EXECUTE_SELECTOR << 224)
    data.write(offset: 4, value: 0x20)
    data.write(offset: 0x24, value: count)
    data.copy_from(
        offset: 0x44,
        source: buf.slice(offset: 0, len: count * 0xc0),
    )
    call_conduit(env, conduit_key: acc.conduit_key, args: data.span())
    var disarmed = acc
    disarmed.armed = false
    disarmed
}

/// `_callConduitUsingOffsets`: call the conduit and require the `execute`
/// magic value.
pub fn call_conduit(_ env: Env, conduit_key: u256, args: MemSpan)
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let conduit = derive_conduit(env, conduit_key)
    var ret = MemBuffer::with_capacity(32)
    let outcome = call.raw_call(
            addr: conduit,
            gas: ctx.gas(),
            value: 0,
            args,
            ret: mut ret,
        )
    if !outcome.success() {
        revert_with_reason_if_one_is_returned()
        revert_error(InvalidCallToConduit { conduit })
    }
    if return_word(ret.span(), initial: 0) >> 224 != CONDUIT_EXECUTE_SELECTOR {
        revert_error(
            InvalidConduit { conduitKey: Bytes32 { val: conduit_key }, conduit },
        )
    }
}

fn insert(
    _ previous: Accumulator,
    _ buf: mut Buffer,
    _ conduit_key: u256,
    item_type: u256,
    token: Address,
    from: Address,
    to: Address,
    identifier: u256,
    amount: u256,
) -> Accumulator {
    var acc = previous
    if !acc.armed {
        acc.armed = true
        acc.conduit_key = conduit_key
        acc.count = 0
    }
    let at = acc.count * 0xc0
    buf.write(offset: at, value: item_type)
    buf.write(offset: at + 0x20, value: token.inner)
    buf.write(offset: at + 0x40, value: from.inner)
    buf.write(offset: at + 0x60, value: to.inner)
    buf.write(offset: at + 0x80, value: identifier)
    buf.write(offset: at + 0xa0, value: amount)
    acc.count = acc.count + 1
    acc
}

/// `_performERC20Transfer`: succeed on `true` or on empty returndata from a
/// contract.
pub fn perform_erc20_transfer(token: Address, from: Address, to: Address, amount: u256)
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    var args = calldata_with_selector(TRANSFER_FROM_SELECTOR, 3)
    set_arg(mut args, 0, from.inner)
    set_arg(mut args, 1, to.inner)
    set_arg(mut args, 2, amount)
    var ret = MemBuffer::with_capacity(32)
    let outcome = call
        .raw_call(
            addr: token,
            gas: ctx.gas(),
            value: 0,
            args: args.span(),
            ret: mut ret,
        )
    let call_status = outcome.success()
    let size = outcome.returndata_len()
    let success = call_status
        && ((return_word(ret.span(), initial: 0) == 1 && size > 31) || size == 0)
    if success && size != 0 {
        return
    }
    if ctx.extcodesize(token) != 0 && success {
        return
    }
    if !success {
        if !call_status {
            revert_with_reason_if_one_is_returned()
            revert_error(
                TokenTransferGenericFailure { token, from, to, identifier: 0, amount },
            )
        }
        revert_error(
            BadReturnValueFromERC20OnTransfer { token, from, to, amount },
        )
    }
    revert_error(NoContract { account: token })
}

pub fn perform_erc721_transfer(token: Address, from: Address, to: Address, identifier: u256)
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    if ctx.extcodesize(token) == 0 {
        revert_error(NoContract { account: token })
    }
    var args = calldata_with_selector(TRANSFER_FROM_SELECTOR, 3)
    set_arg(mut args, 0, from.inner)
    set_arg(mut args, 1, to.inner)
    set_arg(mut args, 2, identifier)
    var ret = MemBuffer::empty()
    let outcome = call
        .raw_call(
            addr: token,
            gas: ctx.gas(),
            value: 0,
            args: args.span(),
            ret: mut ret,
        )
    if !outcome.success() {
        revert_with_reason_if_one_is_returned()
        revert_error(
            TokenTransferGenericFailure { token, from, to, identifier, amount: 1 },
        )
    }
}

pub fn perform_erc1155_transfer(
    token: Address,
    from: Address,
    to: Address,
    identifier: u256,
    amount: u256,
)
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    if ctx.extcodesize(token) == 0 {
        revert_error(NoContract { account: token })
    }
    var args = calldata_with_selector(ERC1155_SAFE_TRANSFER_FROM_SELECTOR, 6)
    set_arg(mut args, 0, from.inner)
    set_arg(mut args, 1, to.inner)
    set_arg(mut args, 2, identifier)
    set_arg(mut args, 3, amount)
    set_arg(mut args, 4, 0xa0)
    set_arg(mut args, 5, 0)
    var ret = MemBuffer::empty()
    let outcome = call
        .raw_call(
            addr: token,
            gas: ctx.gas(),
            value: 0,
            args: args.span(),
            ret: mut ret,
        )
    if !outcome.success() {
        revert_with_reason_if_one_is_returned()
        revert_error(
            TokenTransferGenericFailure { token, from, to, identifier, amount },
        )
    }
}
