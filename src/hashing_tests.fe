use core::abi::ByteInput
use core::ptr::{self, MemBuffer, MemSpan}
use std::abi::{Bytes32, DynArray, dyn_array_from}
use super::abi_view::ComponentsView
use std::evm::{Address, Call, CallData, Evm}
use super::hashing::{bulk_order_typehash, derive_components_hash}
use super::types::{ConsiderationItem, OfferItem, OrderComponents}

msg HashMsg {
    #[selector = sol(
        "getOrderHash((address,address,(uint8,address,uint256,uint256,uint256)[],(uint8,address,uint256,uint256,uint256,address)[],uint8,uint256,uint256,bytes32,uint256,bytes32,uint256))",
    )]
    Hash { order: OrderComponents } -> Bytes32,
    #[selector = 0x00000001]
    CancelFields { order: OrderComponents } -> u256,
    #[selector = 0x00000002]
    CancelArrayHash { orders: DynArray<OrderComponents> } -> u256,
}

contract HashHarness {
    recv HashMsg {
        #[decode(manual)]
        CancelArrayHash { .. } -> u256 {
            let orders = CallData::with_base(4).array_view<OrderComponents>(0)
            let order = ComponentsView::element(orders, index: 0)
            let _ = order.offerer()
            let _ = order.zone()
            let _ = order.order_type()
            derive_components_hash(order)
        }

        #[decode(manual)]
        CancelFields { .. } -> u256 {
            let order = ComponentsView::argument(CallData::with_base(4))
            order.offerer().inner + order.zone().inner + order.order_type()
        }

        #[decode(manual)]
        Hash { .. } -> Bytes32 {
            Bytes32 {
                val: derive_components_hash(ComponentsView::argument(CallData::with_base(4))),
            }
        }
    }
}

fn hash_components(
    offer: DynArray<OfferItem>,
    consideration: DynArray<ConsiderationItem>,
    counter: u256,
) -> u256
uses (evm: mut Evm)
{
    let addr = evm.create2<HashHarness>(value: 0, args: (), salt: 0)
    let result = evm
        .call(
            addr,
            gas: 100000,
            value: 0,
            message: HashMsg::Hash {
                order: OrderComponents {
                    offerer: Address { inner: 0xabc },
                    zone: Address { inner: 0xdef },
                    offer,
                    consideration,
                    orderType: 1,
                    startTime: 7,
                    endTime: 123,
                    zoneHash: Bytes32 { val: 0x42 },
                    salt: 9,
                    conduitKey: Bytes32 { val: 0x99 },
                    counter,
                },
            },
        )
    result.val
}

// Expected hashes come from the deployed, pinned Solidity Seaport reference.
#[test]
fn components_hash_empty_item_arrays() uses (evm: mut Evm) {
    assert(
        hash_components(
                offer: DynArray<OfferItem>::empty(),
                consideration: DynArray<ConsiderationItem>::empty(),
                counter: 0,
            )
            == 0x5550392b8abc641298481c4eef6a7c124628b7fa5795743525f4c55d794fe933,
    )
}

#[test]
fn components_hash_distinct_item_types_and_full_width_counter()
uses (evm: mut Evm)
{
    let offer = dyn_array_from(
        [
            OfferItem {
                itemType: 2,
                token: Address { inner: 0x123 },
                identifierOrCriteria: 4,
                startAmount: 1,
                endAmount: 1,
            },
        ],
    )
    let consideration = dyn_array_from(
        [
            ConsiderationItem {
                itemType: 0,
                token: Address { inner: 0 },
                identifierOrCriteria: 0,
                startAmount: 200,
                endAmount: 200,
                recipient: Address { inner: 0x456 },
            },
        ],
    )
    assert(
        hash_components(
                offer,
                consideration,
                counter: 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff,
            )
            == 0x0ca9e35ff00c5532a165ee1148dc749e93994bd0b52dca5fff0077c0e13b8af4,
    )
}

