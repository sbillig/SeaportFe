// SPDX-License-Identifier: MIT
// ZoneInteraction, the contract order parts of OrderValidator and the zone
// and contract offerer calldata encodings of ConsiderationEncoder and
// ConsiderationDecoder.
#![arithmetic(unchecked)]
use super::raw_abi::{error_selector, revert_with0, revert_with1}
use super::status::OrderStore
use core::abi::store_word
use core::ptr::{self, MemArray, MemBuffer}
use std::evm::{Address, Call, Ctx, RawOps, Wei}
use super::errors::{
    ConsiderationLengthNotEqualToTotalOriginal,
    InvalidContractOrder,
    InvalidRestrictedOrder,
}
use super::lowlevel::revert_with_reason_if_one_is_returned
use super::abi_view::CalldataView
use super::buffer::Buffer
use super::model::{Book, Item, OrderState, elem}
use super::status::take_contract_nonce
use super::types::CONTRACT

/// authorizeOrder((bytes32,address,address,(uint8,address,uint256,uint256)[],(uint8,address,uint256,uint256,address)[],bytes,bytes32[],uint256,uint256,bytes32))
pub const AUTHORIZE_ORDER_SELECTOR: u256 = 0x01e4d72a
/// validateOrder(...) with the same ZoneParameters argument.
pub const VALIDATE_ORDER_SELECTOR: u256 = 0x17b1f942
/// generateOrder(address,(uint8,address,uint256,uint256)[],(uint8,address,uint256,uint256)[],bytes)
pub const GENERATE_ORDER_SELECTOR: u256 = 0x98919765
/// ratifyOrder((uint8,address,uint256,uint256)[],(uint8,address,uint256,uint256,address)[],bytes,bytes32[],uint256)
pub const RATIFY_ORDER_SELECTOR: u256 = 0xf4dd92ce

const MAX_RETURNED_ARRAY_LENGTH: u256 = 0xffff

/// Restricted orders (types 2 and 3) consult the zone unless it is the caller.
pub fn is_restricted_and_caller_not_zone(_ order_type: u256, _ zone: Address) -> bool
uses (ctx: Ctx)
{
    order_type < 4 && order_type > 1 && ctx.caller() != zone
}

/// `Buffer::check_range` for the encoders of the cold zone and basic order
/// paths, kept out of line so the hot paths keep inlining the check.
#[inline(never)]
pub fn ensure_range(_ buf: Buffer, offset: u256, len: u256) {
    buf.check_range(offset, len)
}

/// The current amount, or the amount saved before fulfillment aggregation.
fn item_amount(_ item: Item, _ use_original: bool) -> u256 {
    if use_original {
        item.original
    } else {
        item.amount
    }
}

fn write_spent_items(
    _ dst: mut Buffer,
    offset: u256,
    _ book: Book,
    start: u256,
    count: u256,
    use_original: bool,
) -> u256 {
    let size = 32 + count * 128
    ensure_range(dst, offset, len: size)
    // The checked range holds the length word and every item.
    unsafe {
        dst.put(offset, value: count)
        var i: u256 = 0
        while i < count {
            let item = unsafe {
                ref *elem(book.items.ptr(), start + i)
            }
            let out = offset + 32 + i * 128
            dst.put(offset: out, value: item.item_type)
            dst.put(offset: out + 32, value: item.token.word())
            dst.put(offset: out + 64, value: item.identifier)
            dst.put(offset: out + 96, value: item_amount(item, use_original))
            i += 1
        }
    }
    size
}

fn write_received_items(
    _ dst: mut Buffer,
    offset: u256,
    _ book: Book,
    start: u256,
    count: u256,
) -> u256 {
    let size = 32 + count * 160
    ensure_range(dst, offset, len: size)
    // The checked range holds the length word and every item.
    unsafe {
        dst.put(offset, value: count)
        var i: u256 = 0
        while i < count {
            let item = unsafe {
                ref *elem(book.items.ptr(), start + i)
            }
            let out = offset + 32 + i * 160
            dst.put(offset: out, value: item.item_type)
            dst.put(offset: out + 32, value: item.token.word())
            dst.put(offset: out + 64, value: item.identifier)
            dst.put(offset: out + 96, value: item.original)
            dst.put(offset: out + 128, value: item.receiver.word())
            i += 1
        }
    }
    size
}

fn padded(_ len: u256) -> u256 {
    (len + 31) & !(31 as u256)
}

fn write_bytes(_ dst: mut Buffer, offset: u256, _ bytes: CalldataView) -> u256 {
    let len = bytes.len()
    dst.write(offset, value: len)
    dst.copy_calldata(offset: offset + 32, source: bytes.offset(32), len)
    32 + padded(len)
}

fn write_hashes(_ dst: mut Buffer, offset: u256, _ hashes: MemArray<u256>, count: u256) -> u256 {
    let size = 32 + count * 32
    ensure_range(dst, offset, len: size)
    // The checked range holds the length word and every hash.
    unsafe {
        dst.put(offset, value: count)
        var i: u256 = 0
        while i < count {
            dst.put(offset: offset + 32 + i * 32, value: hashes[(i) as usize])
            i += 1
        }
    }
    size
}

/// Size of the order's offer as `SpentItem[]`, its consideration as
/// `ReceivedItem[]`, its extra data and `hashes_count` order hashes.
fn order_tails_size(_ order: OrderState, hashes_count: u256) -> u256 {
    32
        + order.offer_len * 128
        + 32
        + order.consideration_len * 160
        + 32
        + padded(order.extra_data.len() as u256)
        + 32
        + hashes_count * 32
}

/// Write the tails measured by `order_tails_size` from `tail` on, relative to
/// `head`, and their offsets to the four words at `slots`.
fn write_order_tails(
    _ data: mut Buffer,
    head: u256,
    slots: u256,
    tail: u256,
    book: Book,
    order: OrderState,
    order_hashes: MemArray<u256>,
    hashes_count: u256,
) {
    ensure_range(data, offset: slots, len: 0x80)
    var at = tail
    // The checked range holds the four offset words.
    unsafe {
        data.put(offset: slots, value: at)
    }
    at = at
        + write_spent_items(
            mut data,
            offset: head + at,
            book,
            start: order.offer_start,
            count: order.offer_len,
            use_original: true,
        )
    unsafe {
        data.put(offset: slots + 0x20, value: at)
    }
    at = at
        + write_received_items(
            mut data,
            offset: head + at,
            book,
            start: order.consideration_start,
            count: order.consideration_len,
        )
    unsafe {
        data.put(offset: slots + 0x40, value: at)
    }
    at = at + write_bytes(mut data, offset: head + at, order.extra_data)
    unsafe {
        data.put(offset: slots + 0x60, value: at)
    }
    write_hashes(
        mut data,
        offset: head + at,
        order_hashes,
        count: hashes_count,
    )
}

/// `authorizeOrder(ZoneParameters)` or `validateOrder(ZoneParameters)` with
/// the first `hashes_count` order hashes, or `_encodeRatifyOrder` for
/// `RATIFY_ORDER_SELECTOR`. seaport-core encodes the zone parameters once,
/// before transfers, and reuses them for `validateOrder`; the amounts then
/// still equal the saved `original` amounts used here.
fn encode_zone_call(
    _ book: Book,
    order: OrderState,
    order_hash: u256,
    order_hashes: MemArray<u256>,
    hashes_count: u256,
    selector: u256,
) -> Buffer
uses (ctx: Ctx)
{
    let ratify = selector == RATIFY_ORDER_SELECTOR
    let head: u256 = if ratify { 4 } else { 0x24 }
    let tail: u256 = if ratify { 0xa0 } else { 0x140 }
    var data = Buffer::new(head + tail + order_tails_size(order, hashes_count))
    // The buffer holds the selector and the head.
    unsafe {
        data.put(offset: 0, value: selector << 224)
        if ratify {
            data.put(
                offset: 4 + 0x80,
                value: order_hash ^ (order.offerer.word() << 96),
            )
        } else {
            data.put(offset: 4, value: 0x20)
            data.put(offset: head, value: order_hash)
            data.put(offset: head + 0x20, value: ctx.caller().word())
            data.put(offset: head + 0x40, value: order.offerer.word())
            data.put(offset: head + 0xe0, value: order.start_time)
            data.put(offset: head + 0x100, value: order.end_time)
            data.put(offset: head + 0x120, value: order.zone_hash)
        }
    }
    write_order_tails(
        mut data,
        head,
        slots: if ratify { head } else { head + 0x60 },
        tail,
        book,
        order,
        order_hashes,
        hashes_count,
    )
    data
}

fn revert_invalid_order(_ order_hash: u256, _ contract_order: bool) -> ! {
    if contract_order {
        revert_with1(error_selector<InvalidContractOrder>(), order_hash)
    }
    revert_with1(error_selector<InvalidRestrictedOrder>(), order_hash)
}

/// `_callAndCheckStatusWithSkip`: a failed call returns false unless
/// `revert_on_invalid`; a wrong magic value always reverts. With
/// `revert_on_invalid` this is `_callAndCheckStatus`.
pub fn call_and_check_status_with_skip(
    _ target: Address,
    order_hash: u256,
    data: Buffer,
    contract_order: bool,
    revert_on_invalid: bool,
) -> bool
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let magic = data.word(0) & 0xffffffff00000000000000000000000000000000000000000000000000000000
    var ret = MemBuffer::with_capacity(32)
    // Short returndata overwrites only a prefix of this zero word, as
    // `return_word` with a zero initial word reads it.
    unsafe {
        store_word(ptr: ret.ptr(), value: 0)
    }
    let outcome = call
        .raw_call(
            addr: target,
            gas: ctx.gas(),
            value: Wei::zero(),
            args: data.span(),
            ret: mut ret,
        )
    if !outcome.success() {
        if !revert_on_invalid {
            return false
        }
        revert_with_reason_if_one_is_returned()
        revert_invalid_order(order_hash, contract_order)
    }
    // The call wrote at most the 32 bytes of `ret`'s capacity.
    if unsafe { *ptr::cast<u8, u256>(ret.ptr()) } != magic {
        revert_invalid_order(order_hash, contract_order)
    }
    true
}

/// `_checkRestrictedAdvancedOrderAuthorization`, or with `revert_on_invalid`
/// `_assertRestrictedAdvancedOrderAuthorization`.
pub fn check_restricted_advanced_order_authorization(
    _ book: Book,
    order: OrderState,
    order_hashes: MemArray<u256>,
    order_hash: u256,
    order_index: u256,
    revert_on_invalid: bool,
) -> bool
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    if is_restricted_and_caller_not_zone(order.order_type, order.zone) {
        let data = encode_zone_call(
            book,
            order,
            order_hash,
            order_hashes,
            hashes_count: order_index,
            selector: AUTHORIZE_ORDER_SELECTOR,
        )
        return call_and_check_status_with_skip(
            order.zone,
            order_hash,
            data,
            contract_order: false,
            revert_on_invalid,
        )
    }
    true
}

/// `_assertRestrictedAdvancedOrderValidity`: `validateOrder` for restricted
/// orders and `ratifyOrder` for contract orders. One encoding and call site
/// for both keeps a single call buffer in the frame.
pub fn assert_restricted_advanced_order_validity(
    _ book: Book,
    order: OrderState,
    order_hashes: MemArray<u256>,
    order_hash: u256,
)
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    // Contract orders are never restricted.
    let restricted = is_restricted_and_caller_not_zone(order.order_type, order.zone)
    if !restricted && order.order_type != CONTRACT as u256 {
        return
    }
    let data = encode_zone_call(
        book,
        order,
        order_hash,
        order_hashes,
        hashes_count: order_hashes.len() as u256,
        selector: if restricted {
            VALIDATE_ORDER_SELECTOR
        } else {
            RATIFY_ORDER_SELECTOR
        },
    )
    let _ = call_and_check_status_with_skip(
        if restricted {
            order.zone
        } else {
            order.offerer
        },
        order_hash,
        data,
        contract_order: !restricted,
        revert_on_invalid: true,
    )
}

/// `_encodeGenerateOrder`: offer and consideration both as `SpentItem[]`.
fn encode_generate_order(_ book: Book, order: OrderState) -> Buffer
uses (ctx: Ctx)
{
    let offer_tail: u256 = 0x80
    let consideration_tail = offer_tail + 32 + order.offer_len * 128
    let context_tail = consideration_tail + 32 + order.consideration_len * 128
    var data = Buffer::new(4 + context_tail + 32 + padded(order.extra_data.len()))
    // The buffer holds the selector and the head.
    unsafe {
        data.put(offset: 0, value: GENERATE_ORDER_SELECTOR << 224)
        data.put(offset: 4, value: ctx.caller().word())
        data.put(offset: 0x24, value: offer_tail)
        data.put(offset: 0x44, value: consideration_tail)
        data.put(offset: 0x64, value: context_tail)
    }
    let _ = write_spent_items(
        mut data,
        offset: 4 + offer_tail,
        book,
        start: order.offer_start,
        count: order.offer_len,
        use_original: false,
    )
    let _ = write_spent_items(
        mut data,
        offset: 4 + consideration_tail,
        book,
        start: order.consideration_start,
        count: order.consideration_len,
        use_original: false,
    )
    let _ = write_bytes(mut data, offset: 4 + context_tail, order.extra_data)
    data
}

/// One word of returndata at `offset`. One shared copy keeps the many call
/// sites small; reading the word directly keeps it free of calls and of a
/// frame.
#[inline(never)]
fn returndata_word(_ offset: u256) -> u256 uses (ops: mut RawOps) {
    var buf = MemBuffer::with_capacity(32)
    ops.returndatacopy(dest: mut buf, dest_offset: 0, src_offset: offset, len: 32)
    // The copy filled the 32 bytes of the buffer.
    unsafe {
        *ptr::cast<u8, u256>(buf.ptr())
    }
}

/// `_getGeneratedOrder`, first half: ask the contract offerer for the order
/// and validate the returned items against the requested ones. The items
/// are installed by `install_generated_order`, which must follow before any
/// other call replaces the returndata.
///
/// Validation reads the current pool; installation then replaces the owned
/// item allocation and updates this order's ranges under exclusive Book access.
/// Returns the contract order hash, or zero if the order was skipped. The
/// validated layout stays in the returndata instead of a returned record,
/// which would take five words of every caller's frame.
pub fn generate_order(_ book: Book, order_index: u256, revert_on_invalid: bool) -> u256
uses (store: mut OrderStore, ctx: Ctx, call: mut Call, ops: mut RawOps)
{
    let order = unsafe {
        ref *elem(book.orders.ptr(), order_index)
    }
    if order.consideration_len != order.total_original {
        revert_with0(
            error_selector<ConsiderationLengthNotEqualToTotalOriginal>(),
        )
    }
    let offerer = order.offerer
    let data = encode_generate_order(book, order)
    var ret = MemBuffer::empty()
    let success = call
        .raw_call(
            addr: offerer,
            gas: ctx.gas(),
            value: Wei::zero(),
            args: data.span(),
            ret: mut ret,
        )
        .success()
    let contract_nonce = take_contract_nonce(offerer)
    let order_hash = contract_nonce ^ (offerer.word() << 96)
    if !success {
        if revert_on_invalid {
            revert_with_reason_if_one_is_returned()
            revert_with1(error_selector<InvalidContractOrder>(), order_hash)
        }
        return 0
    }
    if !valid_generate_order_returndata(book, order) {
        revert_with1(error_selector<InvalidContractOrder>(), order_hash)
    }
    order_hash
}

/// `_decodeGenerateOrderReturndata` checks: the returned
/// `(SpentItem[], ReceivedItem[])` must be well formed and may not reduce
/// the offer or increase the consideration. Kept out of line so its frame
/// does not join `generate_order`'s.
#[inline(never)]
fn valid_generate_order_returndata(_ book: Book, order: OrderState) -> bool
uses (ops: mut RawOps)
{
    let size = ops.returndatasize()
    if size < 0x60 {
        return false
    }
    // seaport-core adds these without overflow checks; out of range offsets
    // then fault in RETURNDATACOPY exactly as there.
    let offer_offset = returndata_word(0)
    let consideration_offset = returndata_word(32)
    if offer_offset.wrapping_add(32) > size || consideration_offset.wrapping_add(32) > size {
        return false
    }
    let offer_length = returndata_word(offer_offset)
    let consideration_length = returndata_word(consideration_offset)
    let offer_end = offer_offset.wrapping_add(32).wrapping_add(offer_length << 7)
    let consideration_end = consideration_offset
        .wrapping_add(32)
        .wrapping_add(consideration_length.wrapping_mul(160))
    if (offer_length | consideration_length) > MAX_RETURNED_ARRAY_LENGTH
        || size < offer_end
        || size < consideration_end {
        return false
    }

    var bad = order.offer_len > offer_length
    var i: u256 = 0
    while i < offer_length && i < order.offer_len {
        let base = offer_offset + 32 + i * 128
        let original = unsafe {
            ref *elem(book.items.ptr(), order.offer_start + i)
        }
        bad = bad
            || items_differ(
                original,
                item_type: returndata_word(base),
                token: returndata_word(base + 32),
                identifier: returndata_word(base + 64),
            )
            || original.amount > returndata_word(base + 96)
        i += 1
    }
    if consideration_length > order.consideration_len {
        bad = true
    }
    i = 0
    while i < consideration_length && i < order.consideration_len {
        let base = consideration_offset + 32 + i * 160
        let original = unsafe {
            ref *elem(book.items.ptr(), order.consideration_start + i)
        }
        let recipient = returndata_word(base + 128)
        let recipient_mismatch = original.receiver.word() != 0
            && recipient != original.receiver.word()
        bad = bad
            || items_differ(
                original,
                item_type: returndata_word(base),
                token: returndata_word(base + 32),
                identifier: returndata_word(base + 64),
            )
            || returndata_word(base + 96) > original.amount
            || recipient_mismatch
        i += 1
    }
    !bad
}

/// `_getGeneratedOrder`, second half: copy the items of the returndata that
/// `generate_order` validated into a new pool and point the order at them.
/// Consideration items beyond the original ones are dropped.
///
/// Returned tokens and recipients become the addresses in their low 160 bits.
/// Validation compares the full words of items with an original counterpart,
/// so this differs from seaport-core, which keeps the words unchanged, only for
/// extra offer items and for recipients the original order leaves open.
pub fn install_generated_order(_ book: mut Book, order_index: u256)
uses (ops: mut RawOps)
{
    let start = book.used
    let offer_offset = returndata_word(0)
    let consideration_offset = returndata_word(32)
    let offer_length = returndata_word(offer_offset)
    let returned_consideration = returndata_word(consideration_offset)
    let original_consideration = unsafe {
        (*elem(book.orders.ptr(), order_index)).consideration_len
    }
    let consideration_length = if returned_consideration < original_consideration {
        returned_consideration
    } else {
        original_consideration
    }
    let used = start + offer_length + consideration_length
    var items = MemArray<Item>::new_zeroed(used as usize)
    var i: u256 = 0
    while i < start {
        items[(i) as usize] = book.items[(i) as usize]
        i += 1
    }
    // Offer items, then consideration items; returned tokens and recipients
    // become the addresses in their low 160 bits.
    i = 0
    while i < offer_length + consideration_length {
        let consideration = i >= offer_length
        let base = if consideration {
            consideration_offset + 32 + (i - offer_length) * 160
        } else {
            offer_offset + 32 + i * 128
        }
        let amount = returndata_word(base + 96)
        let recipient = if consideration {
            Address::from_word_truncate(returndata_word(base + 128))
        } else {
            Address::zero()
        }
        items[(start + i) as usize] = Item {
            item_type: returndata_word(base),
            token: Address::from_word_truncate(returndata_word(base + 32)),
            identifier: returndata_word(base + 64),
            start_amount: amount,
            end_amount: amount,
            recipient,
            amount,
            receiver: recipient,
            original: amount,
        }
        i += 1
    }
    let consideration_start = start + offer_length
    let order = unsafe {
        mut *elem(book.orders.ptr(), order_index)
    }
    order.offer_start = start
    order.offer_len = offer_length
    order.consideration_start = consideration_start
    order.consideration_len = consideration_length
    book.items = items
    book.used = used
}

/// `compareItems`: a wildcard criteria item matches any identifier of the
/// corresponding non-criteria type.
fn items_differ(_ original: Item, item_type: u256, token: u256, identifier: u256) -> bool {
    var expected_type = original.item_type
    var expected_identifier = original.identifier
    if expected_type > 3 && expected_identifier == 0 {
        expected_type = expected_type - 2
        expected_identifier = identifier
    }
    !(original.token.word() == token
        && expected_type == item_type
        && expected_identifier == identifier)
}
