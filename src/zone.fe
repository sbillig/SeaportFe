// SPDX-License-Identifier: MIT
// ZoneInteraction, the contract order parts of OrderValidator and the zone
// and contract offerer calldata encodings of ConsiderationEncoder and
// ConsiderationDecoder.
use core::ptr::{self, MemBuffer, MemSpan}
use std::abi::Bytes32
use std::evm::{Address, Call, Ctx, RawOps, RawStorage, revert_error}
use super::arr::{Arr, ByteRef}
use super::errors::{
    ConsiderationLengthNotEqualToTotalOriginal,
    InvalidContractOrder,
    InvalidRestrictedOrder,
}
use super::lowlevel::{load_word, revert_with_reason_if_one_is_returned, store_word}
use super::model::{Book, Item, OrderState}
use super::status::take_contract_nonce
use super::types::CONTRACT

/// authorizeOrder((bytes32,address,address,(uint8,address,uint256,uint256)[],(uint8,address,uint256,uint256,address)[],bytes,bytes32[],uint256,uint256,bytes32))
pub const AUTHORIZE_ORDER_SELECTOR: u256 = 0x01e4d72a
/// validateOrder(...) with the same ZoneParameters argument.
pub const VALIDATE_ORDER_SELECTOR: u256 = 0x17b1f942
/// generateOrder(address,(uint8,address,uint256,uint256)[],(uint8,address,uint256,uint256)[],bytes)
pub const GENERATE_ORDER_SELECTOR: u256 = 0x98919765
/// ratifyOrder((uint8,address,uint256,uint256)[],(uint8,address,uint256,uint256,address)[],bytes,bytes32[],uint256)
pub const RATIFY_ORDER_SELECTOR: u256 = 0xf4dd92ce

const MAX_RETURNED_ARRAY_LENGTH: u256 = 0xffff

/// Restricted orders (types 2 and 3) consult the zone unless it is the caller.
pub fn is_restricted_and_caller_not_zone(_ order_type: u256, _ zone: Address) -> bool
uses (ctx: Ctx)
{
    order_type < 4 && order_type > 1 && ctx.caller() != Address::from_word_truncate(zone.inner)
}

fn at(_ base: *u8, _ offset: u256) -> *u8 {
    ptr::offset_bytes(base, offset)
}

/// The current amount, or the amount saved before fulfillment aggregation.
fn item_amount(_ item: *Item, _ use_original: bool) -> u256 {
    if use_original {
        item.original
    } else {
        item.amount
    }
}

fn write_spent_items(
    _ dst: *u8,
    _ book: ref Book,
    start: u256,
    count: u256,
    use_original: bool,
) -> u256 {
    store_word(dst, count)
    let mut i: u256 = 0
    while i < count {
        let item = book.items.at(start + i)
        let out = at(dst, 32 + i * 128)
        store_word(out, item.item_type)
        store_word(at(out, 32), item.token.inner)
        store_word(at(out, 64), item.identifier)
        store_word(at(out, 96), item_amount(item, use_original))
        i += 1
    }
    32 + count * 128
}

fn write_received_items(_ dst: *u8, _ book: ref Book, start: u256, count: u256) -> u256 {
    store_word(dst, count)
    let mut i: u256 = 0
    while i < count {
        let item = book.items.at(start + i)
        let out = at(dst, 32 + i * 160)
        store_word(out, item.item_type)
        store_word(at(out, 32), item.token.inner)
        store_word(at(out, 64), item.identifier)
        store_word(at(out, 96), item.original)
        store_word(at(out, 128), item.recipient.inner)
        i += 1
    }
    32 + count * 160
}

fn padded(_ len: u256) -> u256 {
    (len + 31) & !(31 as u256)
}

fn write_bytes(_ dst: *u8, _ bytes: ByteRef) -> u256 {
    let size = 32 + padded(bytes.len)
    ptr::zero_bytes(dst, size)
    store_word(dst, bytes.len)
    ptr::copy_raw(dest: at(dst, 32), source: bytes.payload(), len: bytes.len)
    size
}

fn write_hashes(_ dst: *u8, _ hashes: Arr<u256>, count: u256) -> u256 {
    store_word(dst, count)
    let mut i: u256 = 0
    while i < count {
        store_word(at(dst, 32 + i * 32), *hashes.at(i))
        i += 1
    }
    32 + count * 32
}

/// `authorizeOrder(ZoneParameters)` or `validateOrder(ZoneParameters)` with
/// the first `hashes_count` order hashes. seaport-core encodes the zone
/// parameters once, before transfers, and reuses them for `validateOrder`;
/// the amounts then still equal the saved `original` amounts used here.
fn encode_zone_call(
    _ book: ref Book,
    order: *OrderState,
    order_hash: u256,
    order_hashes: Arr<u256>,
    hashes_count: u256,
    selector: u256,
) -> (*u8, u256)
uses (ctx: Ctx)
{
    let params_size = 0x140
        + 32
        + order.offer_len * 128
        + 32
        + order.consideration_len * 160
        + 32
        + padded(book.bytes(order.extra_data).len)
        + 32
        + hashes_count * 32
    let size = 0x24 + params_size
    let data = ptr::alloc_bytes(size + 28)
    store_word(data, selector << 224)
    store_word(at(data, 4), 0x20)
    let head = at(data, 0x24)
    store_word(head, order_hash)
    store_word(at(head, 0x20), ctx.caller().inner)
    store_word(at(head, 0x40), order.offerer.inner)
    let mut tail: u256 = 0x140
    store_word(at(head, 0x60), tail)
    tail = tail
        + write_spent_items(
            at(head, tail),
            book,
            start: order.offer_start,
            count: order.offer_len,
            use_original: true,
        )
    store_word(at(head, 0x80), tail)
    tail = tail
        + write_received_items(
            at(head, tail),
            book,
            start: order.consideration_start,
            count: order.consideration_len,
        )
    store_word(at(head, 0xa0), tail)
    tail = tail + write_bytes(at(head, tail), book.bytes(order.extra_data))
    store_word(at(head, 0xc0), tail)
    write_hashes(at(head, tail), order_hashes, count: hashes_count)
    store_word(at(head, 0xe0), order.start_time)
    store_word(at(head, 0x100), order.end_time)
    store_word(at(head, 0x120), order.zone_hash)
    (data, size)
}

/// `_callAndCheckStatus`: call and require the selector as return value,
/// reverting with `InvalidRestrictedOrder` or `InvalidContractOrder`.
fn call_and_check_status(
    _ target: Address,
    order_hash: u256,
    data: *u8,
    size: u256,
    contract_order: bool,
)
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    if !call_and_check_status_with_skip(
        target,
        order_hash,
        data,
        size,
        contract_order,
        revert_on_invalid: true,
    ) {
        revert_invalid_order(order_hash, contract_order)
    }
}

fn revert_invalid_order(_ order_hash: u256, _ contract_order: bool) -> ! {
    if contract_order {
        revert_error(
            InvalidContractOrder { orderHash: Bytes32 { val: order_hash } },
        )
    }
    revert_error(
        InvalidRestrictedOrder { orderHash: Bytes32 { val: order_hash } },
    )
}

/// `_callAndCheckStatusWithSkip`: a failed call returns false unless
/// `revert_on_invalid`; a wrong magic value always reverts.
fn call_and_check_status_with_skip(
    _ target: Address,
    order_hash: u256,
    data: *u8,
    size: u256,
    contract_order: bool,
    revert_on_invalid: bool,
) -> bool
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let magic = load_word(data) & 0xffffffff00000000000000000000000000000000000000000000000000000000
    let mut ret = MemBuffer::with_capacity(32)
    store_word(ret.ptr(), 0)
    let outcome = call
        .raw_call(
            addr: target,
            gas: ctx.gas(),
            value: 0,
            args: MemSpan::from_raw_parts(ptr: data, len: size),
            ret: mut ret,
        )
    if !outcome.success() {
        if !revert_on_invalid {
            return false
        }
        revert_with_reason_if_one_is_returned()
        revert_invalid_order(order_hash, contract_order)
    }
    if load_word(ret.ptr()) != magic {
        revert_invalid_order(order_hash, contract_order)
    }
    true
}

/// `_assertRestrictedAdvancedOrderAuthorization`
pub fn assert_restricted_advanced_order_authorization(
    _ book: ref Book,
    order: *OrderState,
    order_hashes: Arr<u256>,
    order_hash: u256,
    order_index: u256,
)
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    if is_restricted_and_caller_not_zone(order.order_type, order.zone) {
        let (data, size) = encode_zone_call(
            book,
            order,
            order_hash,
            order_hashes,
            hashes_count: order_index,
            selector: AUTHORIZE_ORDER_SELECTOR,
        )
        call_and_check_status(order.zone, order_hash, data, size, contract_order: false)
    }
}

/// `_checkRestrictedAdvancedOrderAuthorization`
pub fn check_restricted_advanced_order_authorization(
    _ book: ref Book,
    order: *OrderState,
    order_hashes: Arr<u256>,
    order_hash: u256,
    order_index: u256,
    revert_on_invalid: bool,
) -> bool
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    if is_restricted_and_caller_not_zone(order.order_type, order.zone) {
        let (data, size) = encode_zone_call(
            book,
            order,
            order_hash,
            order_hashes,
            hashes_count: order_index,
            selector: AUTHORIZE_ORDER_SELECTOR,
        )
        return call_and_check_status_with_skip(
            order.zone,
            order_hash,
            data,
            size,
            contract_order: false,
            revert_on_invalid,
        )
    }
    true
}

/// `_assertRestrictedAdvancedOrderValidity`: `validateOrder` for restricted
/// orders and `ratifyOrder` for contract orders.
pub fn assert_restricted_advanced_order_validity(
    _ book: ref Book,
    order: *OrderState,
    order_hashes: Arr<u256>,
    order_hash: u256,
)
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    if is_restricted_and_caller_not_zone(order.order_type, order.zone) {
        let (data, size) = encode_zone_call(
            book,
            order,
            order_hash,
            order_hashes,
            hashes_count: order_hashes.len(),
            selector: VALIDATE_ORDER_SELECTOR,
        )
        call_and_check_status(order.zone, order_hash, data, size, contract_order: false)
    } else if order.order_type == CONTRACT as u256 {
        let (data, size) = encode_ratify_order(book, order, order_hash, order_hashes)
        call_and_check_status(
            order.offerer,
            order_hash,
            data,
            size,
            contract_order: true,
        )
    }
}

/// `_encodeRatifyOrder`
fn encode_ratify_order(
    _ book: ref Book,
    order: *OrderState,
    order_hash: u256,
    order_hashes: Arr<u256>,
) -> (*u8, u256) {
    let size = 4
        + 0xa0
        + 32
        + order.offer_len * 128
        + 32
        + order.consideration_len * 160
        + 32
        + padded(book.bytes(order.extra_data).len)
        + 32
        + order_hashes.len() * 32
    let data = ptr::alloc_bytes(size + 28)
    store_word(data, RATIFY_ORDER_SELECTOR << 224)
    let head = at(data, 4)
    store_word(at(head, 0x80), order_hash ^ (order.offerer.inner << 96))
    let mut tail: u256 = 0xa0
    store_word(head, tail)
    tail = tail
        + write_spent_items(
            at(head, tail),
            book,
            start: order.offer_start,
            count: order.offer_len,
            use_original: true,
        )
    store_word(at(head, 0x20), tail)
    tail = tail
        + write_received_items(
            at(head, tail),
            book,
            start: order.consideration_start,
            count: order.consideration_len,
        )
    store_word(at(head, 0x40), tail)
    tail = tail + write_bytes(at(head, tail), book.bytes(order.extra_data))
    store_word(at(head, 0x60), tail)
    write_hashes(at(head, tail), order_hashes, count: order_hashes.len())
    (data, size)
}

/// `_encodeGenerateOrder`: offer and consideration both as `SpentItem[]`.
fn encode_generate_order(_ book: ref Book, order: *OrderState) -> (*u8, u256)
uses (ctx: Ctx)
{
    let size = 4
        + 0x80
        + 32
        + order.offer_len * 128
        + 32
        + order.consideration_len * 128
        + 32
        + padded(book.bytes(order.extra_data).len)
    let data = ptr::alloc_bytes(size + 28)
    store_word(data, GENERATE_ORDER_SELECTOR << 224)
    let head = at(data, 4)
    store_word(head, ctx.caller().inner)
    let mut tail: u256 = 0x80
    store_word(at(head, 0x20), tail)
    tail = tail
        + write_spent_items(
            at(head, tail),
            book,
            start: order.offer_start,
            count: order.offer_len,
            use_original: false,
        )
    store_word(at(head, 0x40), tail)
    tail = tail
        + write_spent_items(
            at(head, tail),
            book,
            start: order.consideration_start,
            count: order.consideration_len,
            use_original: false,
        )
    store_word(at(head, 0x60), tail)
    write_bytes(at(head, tail), book.bytes(order.extra_data))
    (data, size)
}

/// One word of returndata at `offset`.
fn returndata_word(_ offset: u256) -> u256 uses (ops: mut RawOps) {
    let mut buf = MemBuffer::with_capacity(32)
    ops.returndatacopy(dest: mut buf, dest_offset: 0, src_offset: offset, len: 32)
    load_word(buf.ptr())
}

/// The layout of valid `generateOrder` returndata.
pub struct GeneratedOrder {
    /// The contract order hash, or zero if the order was skipped.
    pub order_hash: u256,
    pub offer_offset: u256,
    pub offer_length: u256,
    pub consideration_offset: u256,
    pub consideration_length: u256,
}

impl Copy for GeneratedOrder {}

/// `_getGeneratedOrder`, first half: ask the contract offerer for the order
/// and validate the returned items against the requested ones. The items
/// are installed by `install_generated_order`, which must follow before any
/// other call replaces the returndata.
///
/// seaport-core replaces the arrays in place; the port splits validation
/// (reads only) from installation (one fresh pool), because every extra path
/// returning an item pool multiplies the states Fe's borrow checker tracks
/// in the calling loop (ISSUES.md #9).
pub fn generate_order(
    _ book: ref Book,
    order_index: u256,
    revert_on_invalid: bool,
) -> GeneratedOrder
uses (ctx: Ctx, call: mut Call, ops: mut RawOps)
{
    let order = book.order(order_index)
    if order.consideration_len != order.total_original {
        revert_error(ConsiderationLengthNotEqualToTotalOriginal {})
    }
    let offerer = order.offerer
    let (data, size) = encode_generate_order(book, order)
    let mut ret = MemBuffer::empty()
    let success = call
        .raw_call(
            addr: offerer,
            gas: ctx.gas(),
            value: 0,
            args: MemSpan::from_raw_parts(ptr: data, len: size),
            ret: mut ret,
        )
        .success()
    let contract_nonce = take_contract_nonce(offerer)
    let order_hash = contract_nonce ^ (offerer.inner << 96)
    if !success {
        if revert_on_invalid {
            revert_with_reason_if_one_is_returned()
            revert_error(
                InvalidContractOrder { orderHash: Bytes32 { val: order_hash } },
            )
        }
        return GeneratedOrder {
            order_hash: 0,
            offer_offset: 0,
            offer_length: 0,
            consideration_offset: 0,
            consideration_length: 0,
        }
    }
    let generated = validate_generate_order_returndata(book, order, order_hash)
    if generated.order_hash == 0 {
        revert_error(
            InvalidContractOrder { orderHash: Bytes32 { val: order_hash } },
        )
    }
    generated
}

/// `_decodeGenerateOrderReturndata` checks: the returned
/// `(SpentItem[], ReceivedItem[])` must be well formed and may not reduce
/// the offer or increase the consideration. Returns a zero order hash for
/// invalid returndata.
fn validate_generate_order_returndata(
    _ book: ref Book,
    order: *OrderState,
    order_hash: u256,
) -> GeneratedOrder
uses (ops: mut RawOps)
{
    let invalid = GeneratedOrder {
        order_hash: 0,
        offer_offset: 0,
        offer_length: 0,
        consideration_offset: 0,
        consideration_length: 0,
    }
    let size = ops.returndatasize()
    if size < 0x60 {
        return invalid
    }
    // seaport-core adds these without overflow checks; out of range offsets
    // then fault in RETURNDATACOPY exactly as there.
    let offer_offset = returndata_word(0)
    let consideration_offset = returndata_word(32)
    if offer_offset.wrapping_add(32) > size || consideration_offset.wrapping_add(32) > size {
        return invalid
    }
    let offer_length = returndata_word(offer_offset)
    let consideration_length = returndata_word(consideration_offset)
    let offer_end = offer_offset.wrapping_add(32).wrapping_add(offer_length << 7)
    let consideration_end = consideration_offset
        .wrapping_add(32)
        .wrapping_add(consideration_length.wrapping_mul(160))
    if (offer_length | consideration_length) > MAX_RETURNED_ARRAY_LENGTH
        || size < offer_end
        || size < consideration_end {
        return invalid
    }

    let mut bad = order.offer_len > offer_length
    let mut i: u256 = 0
    while i < offer_length && i < order.offer_len {
        let base = offer_offset + 32 + i * 128
        let original = book.offer_item(order, i)
        bad = bad
            || items_differ(
                original,
                item_type: returndata_word(base),
                token: returndata_word(base + 32),
                identifier: returndata_word(base + 64),
            )
            || original.amount > returndata_word(base + 96)
        i += 1
    }
    if consideration_length > order.consideration_len {
        bad = true
    }
    i = 0
    while i < consideration_length && i < order.consideration_len {
        let base = consideration_offset + 32 + i * 160
        let original = book.consideration_item(order, i)
        let recipient = returndata_word(base + 128)
        let recipient_mismatch = original.recipient.inner != 0
            && recipient != original.recipient.inner
        bad = bad
            || items_differ(
                original,
                item_type: returndata_word(base),
                token: returndata_word(base + 32),
                identifier: returndata_word(base + 64),
            )
            || returndata_word(base + 96) > original.amount
            || recipient_mismatch
        i += 1
    }
    if bad { return invalid }
    let kept = if consideration_length < order.consideration_len {
        consideration_length
    } else {
        order.consideration_len
    }
    GeneratedOrder {
        order_hash,
        offer_offset,
        offer_length,
        consideration_offset,
        consideration_length: kept,
    }
}

/// `_getGeneratedOrder`, second half: copy the validated items from the
/// returndata into a new pool and point the order at them.
pub fn install_generated_order(
    _ book: ref Book,
    order_index: u256,
    generated: GeneratedOrder,
) -> Book
uses (ops: mut RawOps)
{
    let start = book.used
    let offer_length = generated.offer_length
    let consideration_length = generated.consideration_length
    let used = start + offer_length + consideration_length
    let items = Arr<Item>::alloc(used)
    let mut i: u256 = 0
    while i < start {
        copy_item(items, source: book.items, index: i)
        i += 1
    }
    i = 0
    while i < offer_length {
        write_generated_offer_item(
            items,
            slot: start + i,
            base: generated.offer_offset + 32 + i * 128,
        )
        i += 1
    }
    let consideration_start = start + offer_length
    i = 0
    while i < consideration_length {
        write_generated_consideration_item(
            items,
            slot: consideration_start + i,
            base: generated.consideration_offset + 32 + i * 160,
        )
        i += 1
    }
    let order = book.order(order_index)
    order.offer_start = start
    order.offer_len = offer_length
    order.consideration_start = consideration_start
    order.consideration_len = consideration_length
    Book { orders: book.orders, items, used, blob: book.blob }
}

fn copy_item(_ items: Arr<Item>, source: Arr<Item>, index: u256) {
    *items.at(index) = *source.at(index)
}

fn write_generated_offer_item(_ items: Arr<Item>, slot: u256, base: u256)
uses (ops: mut RawOps)
{
    let amount = returndata_word(base + 96)
    *items.at(slot) = Item {
        item_type: returndata_word(base),
        token: Address { inner: returndata_word(base + 32) },
        identifier: returndata_word(base + 64),
        recipient: Address::zero(),
        amount,
        original: amount,
    }
}

fn write_generated_consideration_item(_ items: Arr<Item>, slot: u256, base: u256)
uses (ops: mut RawOps)
{
    let amount = returndata_word(base + 96)
    let recipient = Address { inner: returndata_word(base + 128) }
    *items.at(slot) = Item {
        item_type: returndata_word(base),
        token: Address { inner: returndata_word(base + 32) },
        identifier: returndata_word(base + 64),
        recipient,
        amount,
        original: amount,
    }
}

/// `compareItems`: a wildcard criteria item matches any identifier of the
/// corresponding non-criteria type.
fn items_differ(_ original: *Item, item_type: u256, token: u256, identifier: u256) -> bool {
    let mut expected_type = original.item_type
    let mut expected_identifier = original.identifier
    if expected_type > 3 && expected_identifier == 0 {
        expected_type = expected_type - 2
        expected_identifier = identifier
    }
    !(original.token.inner == token
        && expected_type == item_type
        && expected_identifier == identifier)
}
