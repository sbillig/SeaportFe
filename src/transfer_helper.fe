// SPDX-License-Identifier: MIT
// TransferHelper (contracts/helpers/TransferHelper.sol): bulk transfers of
// ERC20/721/1155 tokens through a conduit.
use core::option::Option
use core::ptr::MemSpan
use std::abi::{Bytes, Bytes4, Bytes32, DynArray, DynString, sol}
use std::evm::{Address, Call, CallOutcome, Ctx, RawOps, Wei, create2_address, revert_error}
use super::raw_abi::{error_selector, revert_with_reason2, revert_with_reason3}
use super::buffer::{Buffer, read_word, return_word}

#[abi]
pub struct TransferHelperItem {
    pub itemType: u8,
    pub token: Address,
    pub identifier: u256,
    pub amount: u256,
}
impl Copy for TransferHelperItem {}

#[abi]
pub struct TransferHelperItemsWithRecipient {
    pub items: DynArray<TransferHelperItem>,
    pub recipient: Address,
    pub validateERC721Receiver: bool,
}

#[error]
pub struct InvalidItemType {}
#[error]
pub struct InvalidERC721TransferAmount { pub amount: u256 }
#[error]
pub struct InvalidERC721Recipient { pub recipient: Address }
#[error]
pub struct ERC721ReceiverErrorRevertBytes {
    pub reason: Bytes,
    pub receiver: Address,
    pub sender: Address,
    pub identifier: u256,
}
#[error]
pub struct ERC721ReceiverErrorRevertString {
    pub reason: DynString,
    pub receiver: Address,
    pub sender: Address,
    pub identifier: u256,
}
#[error]
pub struct InvalidERC20Identifier {}
#[error]
pub struct RecipientCannotBeZeroAddress {}
#[error]
pub struct InvalidConduit { pub conduitKey: Bytes32, pub conduit: Address }
#[error]
pub struct ConduitErrorRevertString {
    pub reason: DynString,
    pub conduitKey: Bytes32,
    pub conduit: Address,
}
#[error]
pub struct ConduitErrorRevertBytes {
    pub reason: Bytes,
    pub conduitKey: Bytes32,
    pub conduit: Address,
}

pub msg TransferHelperMsg {
    #[selector = sol(
        "bulkTransfer(((uint8,address,uint256,uint256)[],address,bool)[],bytes32)",
    )]
    BulkTransfer {
        items: DynArray<TransferHelperItemsWithRecipient>,
        conduitKey: Bytes32,
    } -> Bytes4,
}

msg ERC721ReceiverMsg {
    #[selector = sol("onERC721Received(address,address,uint256,bytes)")]
    OnERC721Received { operator: Address, from: Address, tokenId: u256, data: Bytes } -> Bytes4,
}

msg ConduitControllerCodeHashes {
    #[selector = sol("getConduitCodeHashes()")]
    GetConduitCodeHashes {} -> (Bytes32, Bytes32),
}

const BULK_TRANSFER_SELECTOR: u256 = 0x32389b71
const ON_ERC721_RECEIVED_SELECTOR: u256 = 0x150b7a02
const CONDUIT_EXECUTE_SELECTOR: u256 = 0x4ce34aa2
const ERROR_STRING_SELECTOR: u256 = 0x08c379a0
const INVALID_ITEM_TYPE_SELECTOR: u256 = 0x7932f1fc
const INVALID_ERC721_TRANSFER_AMOUNT_SELECTOR: u256 = 0x69f95827

pub struct TransferHelperEnv {
    pub conduit_controller: Address,
    pub conduit_creation_code_hash: u256,
    pub conduit_runtime_code_hash: u256,
}

impl Copy for TransferHelperEnv {}

pub fn setup(_ controller: Address) -> TransferHelperEnv uses (call: Call) {
    let (creation, runtime) = controller
        .static(ConduitControllerCodeHashes::GetConduitCodeHashes {})
    TransferHelperEnv {
        conduit_controller: controller,
        conduit_creation_code_hash: creation.val,
        conduit_runtime_code_hash: runtime.val,
    }
}

/// The message of a Solidity `Error(string)` revert, decoded like the
/// `catch Error(string memory)` clause does, as its offset and length in
/// `data`; `None` when the returndata is something else.
pub fn try_decode_error_string(_ data: MemSpan) -> Option<(u256, u256)> {
    let size = data.len() as u256
    if size < 0x44 || return_word(data, initial: 0) >> 224 != ERROR_STRING_SELECTOR {
        return Option::None
    }
    let offset = read_word(data, offset: 4)
    if offset > 0xffffffffffffffff || offset + 0x24 > size {
        return Option::None
    }
    let length = read_word(data, offset: 4 + offset)
    if length > 0xffffffffffffffff || offset + 0x20 + length > size - 4 {
        return Option::None
    }
    Option::Some((4 + offset + 0x20, length))
}

/// A Solidity `returns (bytes4)` value: at least one word whose low 28 bytes
/// are zero; anything else reverts without data like Solidity's decoder.
fn decode_bytes4(_ data: MemSpan) -> u256 {
    if data.len() < 32 {
        std::evm::revert(())
    }
    let word = read_word(data, offset: 0)
    if word << 32 != 0 {
        std::evm::revert(())
    }
    word >> 224
}

/// `_checkERC721Receiver`
fn check_erc721_receiver(_ conduit: Address, recipient: Address, token_id: u256)
uses (ctx: Ctx, call: mut Call)
{
    let message = ERC721ReceiverMsg::OnERC721Received {
        operator: conduit,
        from: ctx.caller(),
        tokenId: token_id,
        data: Bytes::empty(),
    }
    let outcome = call.try_call(
            addr: recipient,
            gas: ctx.gas(),
            value: Wei::zero(),
            message,
        )
    if outcome.success() {
        if decode_bytes4(outcome.returndata()) != ON_ERC721_RECEIVED_SELECTOR {
            revert_error(InvalidERC721Recipient { recipient })
        }
        return
    }
    // ERC721ReceiverErrorRevertString with an `Error(string)` message,
    // ERC721ReceiverErrorRevertBytes with the whole returndata otherwise.
    let returned = outcome.returndata()
    var selector = error_selector<ERC721ReceiverErrorRevertBytes>()
    var start: u256 = 0
    var length = returned.len() as u256
    match try_decode_error_string(returned) {
        Option::Some((at, len)) => {
            selector = error_selector<ERC721ReceiverErrorRevertString>()
            start = at
            length = len
        },
        Option::None => {},
    }
    revert_with_reason3(
        selector,
        reason: returned.slice(offset: start as usize, len: length as usize),
        a: recipient.word(),
        b: ctx.caller().word(),
        c: token_id,
    )
}

/// `bulkTransfer`
pub fn bulk_transfer(
    _ env: TransferHelperEnv,
    transfers: DynArray<TransferHelperItemsWithRecipient>,
    conduit_key: u256,
) -> Bytes4
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    if conduit_key == 0 {
        revert_error(
            InvalidConduit { conduitKey: Bytes32 { val: conduit_key }, conduit: Address::zero() },
        )
    }
    let conduit = create2_address(
        deployer: env.conduit_controller,
        salt: conduit_key,
        init_code_hash: env.conduit_creation_code_hash,
    )
    var total: usize = 0
    var i: usize = 0
    while i < transfers.len() {
        total = total + transfers.get(i).items.len()
        i += 1
    }
    // `execute(ConduitTransfer[])` calldata: the selector, the array offset
    // and length, then six words per transfer.
    var data = Buffer::new(0x44 + total as u256 * 0xc0)
    unsafe {
        data.put(offset: 0, value: CONDUIT_EXECUTE_SELECTOR << 224)
        data.put(offset: 4, value: 0x20)
        data.put(offset: 0x24, value: total as u256)
    }
    var at: u256 = 0x44
    i = 0
    while i < transfers.len() {
        let transfer = transfers.get(i)
        let recipient = transfer.recipient
        if recipient.word() == 0 {
            revert_error(RecipientCannotBeZeroAddress {})
        }
        let call_erc721_receiver = transfer.validateERC721Receiver
            && ctx.extcodesize(recipient) != 0
        let items = transfer.items
        var j: usize = 0
        while j < items.len() {
            let item = items.get(j)
            if item.itemType > 3 {
                // Out of range enum value read from calldata.
                std::evm::revert(())
            }
            if item.itemType == 1 && item.identifier != 0 {
                revert_error(InvalidERC20Identifier {})
            }
            if item.itemType == 2 && call_erc721_receiver {
                check_erc721_receiver(conduit, recipient, token_id: item.identifier)
            }
            // `total` counts this transfer, so its words lie in the buffer.
            unsafe {
                data.put(offset: at, value: item.itemType as u256)
                data.put(offset: at + 0x20, value: item.token.word())
                data.put(offset: at + 0x40, value: ctx.caller().word())
                data.put(offset: at + 0x60, value: recipient.word())
                data.put(offset: at + 0x80, value: item.identifier)
                data.put(offset: at + 0xa0, value: item.amount)
            }
            at += 0xc0
            j += 1
        }
        i += 1
    }
    let outcome = call
        .try_call_raw(
            addr: conduit,
            gas: ctx.gas(),
            value: Wei::zero(),
            args: data.span(),
        )
    if outcome.success() {
        if decode_bytes4(outcome.returndata()) != CONDUIT_EXECUTE_SELECTOR {
            revert_error(
                InvalidConduit { conduitKey: Bytes32 { val: conduit_key }, conduit },
            )
        }
        return Bytes4 { val: BULK_TRANSFER_SELECTOR }
    }
    let data = outcome.returndata()
    match try_decode_error_string(data) {
        Option::Some((at, len)) => revert_with_reason2(
            error_selector<ConduitErrorRevertString>(),
            reason: data.slice(offset: at as usize, len: len as usize),
            a: conduit_key,
            b: conduit.word(),
        ),
        Option::None => {},
    }
    let selector = if data.len() >= 4 {
        return_word(data, initial: 0) >> 224
    } else {
        0
    }
    if (data.len() == 4 && selector == INVALID_ITEM_TYPE_SELECTOR)
        || (data.len() == 36 && selector == INVALID_ERC721_TRANSFER_AMOUNT_SELECTOR) {
        ops.revert(data)
    }
    revert_with_reason2(
        error_selector<ConduitErrorRevertBytes>(),
        reason: data,
        a: conduit_key,
        b: conduit.word(),
    )
}

pub contract TransferHelper {
    env: TransferHelperEnv,

    init(conduitController: Address) uses (mut env, call: Call) { env = setup(conduitController) }

    recv TransferHelperMsg {
        BulkTransfer { items, conduitKey } -> Bytes4
        uses (env, ctx: Ctx, call: mut Call, ops: RawOps)
        {
            bulk_transfer(env, transfers: items, conduit_key: conduitKey.val)
        }
    }
}
