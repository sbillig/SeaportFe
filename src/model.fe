// SPDX-License-Identifier: MIT
// Mutable in-memory order model.
//
// Seaport (seaport-core 1.6) decodes calldata into memory structs and then
// reuses struct slots for derived values: after fractions are applied an
// item's `startAmount` slot holds the current amount, its `endAmount` slot the
// recipient, and a consideration item's `recipient` slot the original amount.
// The port gives each of those meanings its own field instead:
//
// - `amount`:   the `startAmount` slot after fraction application (the
//               current, and later the remaining unspent/unmet amount).
// - `receiver`: the `endAmount` slot read as `ReceivedItem.recipient`.
// - `original`: the current amount before fulfillment aggregation.
//
// All items of all orders live in one pool (`Book.items`); an order refers
// to its offer and consideration by index ranges, and to its signature and
// extra data by offsets into a byte pool (`Book.blob`). Resolver proofs and
// fulfillment components use pools as well. Fe's borrow checker tracks
// pointers stored in raw memory through every raw write, which explodes for
// code like this (ISSUES.md #9), so no pointer is ever stored in raw memory:
// pools are reached through handles passed as values.
use std::abi::DynArray
use std::evm::Address
use super::arr::{Arr, ByteRef}
use super::types::{
    AdvancedOrder,
    ConsiderationItem,
    CriteriaResolver,
    Fulfillment,
    FulfillmentComponent,
    OfferItem,
    Order,
    OrderComponents,
    OrderParameters,
}

pub struct Item {
    /// Raw ItemType word (contract offerers can return any word).
    pub item_type: u256,
    pub token: Address,
    pub identifier: u256,
    pub start_amount: u256,
    pub end_amount: u256,
    /// `ConsiderationItem.recipient` (zero for offer items).
    pub recipient: Address,
    pub amount: u256,
    pub receiver: Address,
    pub original: u256,
}

impl Copy for Item {}

pub struct OrderState {
    pub offerer: Address,
    pub zone: Address,
    pub offer_start: u256,
    pub offer_len: u256,
    pub consideration_start: u256,
    pub consideration_len: u256,
    pub order_type: u256,
    pub start_time: u256,
    pub end_time: u256,
    pub zone_hash: u256,
    pub salt: u256,
    pub conduit_key: u256,
    pub total_original: u256,
    pub numerator: u256,
    pub denominator: u256,
    /// Offset of the signature's ABI tail in `Book.blob`.
    pub signature: u256,
    /// Offset of the extra data's ABI tail in `Book.blob`.
    pub extra_data: u256,
}

impl Copy for OrderState {}

/// The orders being fulfilled and the pool of their items.
pub struct Book {
    pub orders: Arr<OrderState>,
    pub items: Arr<Item>,
    /// Items in use; the pool beyond `used` is spare capacity.
    pub used: u256,
    /// Signatures and extra data as consecutive ABI `bytes` tails.
    pub blob: *u8,
}

impl Copy for Book {}

impl Book {
    pub fn order(self, _ index: u256) -> *OrderState {
        self.orders.at(index)
    }

    pub fn offer_item(self, _ order: *OrderState, _ index: u256) -> *Item {
        self.items.at(order.offer_start + index)
    }

    pub fn consideration_item(self, _ order: *OrderState, _ index: u256) -> *Item {
        self.items.at(order.consideration_start + index)
    }

    /// The `bytes` at `offset` in the byte pool.
    pub fn bytes(self, _ offset: u256) -> ByteRef {
        let data = core::ptr::offset_bytes(self.blob, offset)
        let len = *core::ptr::cast<u8, u256>(data)
        ByteRef { data, len, size: 32 + ((len + 31) & !(31 as u256)) }
    }
}

/// Copies `bytes` values into one allocation, in order.
struct BlobWriter { base: *u8, offset: u256 }

impl Copy for BlobWriter {}

fn tail_size(_ len: u256) -> u256 {
    32 + ((len + 31) & !(31 as u256))
}

fn blob_writer(_ size: u256) -> BlobWriter {
    BlobWriter { base: core::ptr::alloc_bytes(size), offset: 0 }
}

/// Append `bytes`; returns its offset and the advanced writer.
fn append_bytes(_ writer: BlobWriter, _ bytes: ByteRef) -> (BlobWriter, u256) {
    let size = tail_size(bytes.len)
    let at = core::ptr::offset_bytes(writer.base, writer.offset)
    core::ptr::zero_bytes(at, size)
    *core::ptr::cast<u8, u256>(at) = bytes.len
    core::ptr::copy_raw(
        dest: core::ptr::offset_bytes(at, 32),
        source: bytes.payload(),
        len: bytes.len,
    )
    (BlobWriter { base: writer.base, offset: writer.offset + size }, writer.offset)
}

pub struct Resolver {
    pub order_index: u256,
    pub side: u256,
    pub index: u256,
    pub identifier: u256,
    /// Range of the proof in `Resolvers.proofs`.
    pub proof_start: u256,
    pub proof_len: u256,
}

impl Copy for Resolver {}

pub struct Resolvers { pub list: Arr<Resolver>, pub proofs: Arr<u256> }

impl Copy for Resolvers {}

pub struct Component { pub order_index: u256, pub item_index: u256 }

impl Copy for Component {}

/// A range of `Groups.components`.
pub struct Group { pub start: u256, pub len: u256 }

impl Copy for Group {}

/// `FulfillmentComponent[][]`
pub struct Groups { pub list: Arr<Group>, pub components: Arr<Component> }

impl Copy for Groups {}

fn offer_item_state(_ item: OfferItem) -> Item {
    Item {
        item_type: item.itemType as u256,
        token: item.token,
        identifier: item.identifierOrCriteria,
        start_amount: item.startAmount,
        end_amount: item.endAmount,
        recipient: Address::zero(),
        amount: item.startAmount,
        receiver: Address::zero(),
        original: 0,
    }
}

fn consideration_item_state(_ item: ConsiderationItem) -> Item {
    Item {
        item_type: item.itemType as u256,
        token: item.token,
        identifier: item.identifierOrCriteria,
        start_amount: item.startAmount,
        end_amount: item.endAmount,
        recipient: item.recipient,
        amount: item.startAmount,
        receiver: item.recipient,
        original: 0,
    }
}

/// Copy an offer and consideration into the pool at `start`.
fn fill_items(
    _ items: Arr<Item>,
    start: u256,
    offer: DynArray<OfferItem>,
    consideration: DynArray<ConsiderationItem>,
) {
    let mut i: u256 = 0
    while i < offer.len() {
        *items.at(start + i) = offer_item_state(offer.get(i))
        i += 1
    }
    let consideration_start = start + offer.len()
    i = 0
    while i < consideration.len() {
        *items.at(consideration_start + i) = consideration_item_state(consideration.get(i))
        i += 1
    }
}

fn order_state(
    _ p: OrderParameters,
    items_start: u256,
    numerator: u256,
    denominator: u256,
    signature: u256,
    extra_data: u256,
) -> OrderState {
    OrderState {
        offerer: p.offerer,
        zone: p.zone,
        offer_start: items_start,
        offer_len: p.offer.len(),
        consideration_start: items_start + p.offer.len(),
        consideration_len: p.consideration.len(),
        order_type: p.orderType as u256,
        start_time: p.startTime,
        end_time: p.endTime,
        zone_hash: p.zoneHash.val,
        salt: p.salt,
        conduit_key: p.conduitKey.val,
        total_original: p.totalOriginalConsiderationItems,
        numerator,
        denominator,
        signature,
        extra_data,
    }
}

fn parameters_items(_ p: OrderParameters) -> u256 {
    p.offer.len() + p.consideration.len()
}

pub fn advanced_orders(_ orders: DynArray<AdvancedOrder>) -> Book {
    let n = orders.len()
    let mut total: u256 = 0
    let mut blob_size: u256 = 0
    let mut i: u256 = 0
    while i < n {
        let order = orders.get(i)
        total = total + parameters_items(orders.get(i).parameters)
        blob_size = blob_size + tail_size(order.signature.len()) + tail_size(order.extraData.len())
        i += 1
    }
    let mut writer = blob_writer(blob_size)
    let book = Book {
        orders: Arr<OrderState>::alloc(n),
        items: Arr<Item>::alloc(total),
        used: total,
        blob: writer.base,
    }
    let mut start: u256 = 0
    i = 0
    while i < n {
        let order = orders.get(i)
        let p = order.parameters
        fill_items(
            book.items,
            start,
            offer: p.offer,
            consideration: p.consideration,
        )
        let (after_signature, signature) = append_bytes(writer, ByteRef::of(order.signature))
        let (after_extra_data, extra_data) = append_bytes(
            after_signature,
            ByteRef::of(order.extraData),
        )
        writer = after_extra_data
        *book.orders.at(i) = order_state(
            orders.get(i).parameters,
            items_start: start,
            numerator: order.numerator.val as u256,
            denominator: order.denominator.val as u256,
            signature,
            extra_data,
        )
        start = start + parameters_items(orders.get(i).parameters)
        i += 1
    }
    book
}

pub fn orders_as_advanced(_ orders: DynArray<Order>) -> Book {
    let n = orders.len()
    let mut total: u256 = 0
    let mut blob_size: u256 = 32
    let mut i: u256 = 0
    while i < n {
        let order = orders.get(i)
        total = total + parameters_items(orders.get(i).parameters)
        blob_size = blob_size + tail_size(order.signature.len())
        i += 1
    }
    // Offset 0 holds the empty extra data shared by all orders.
    let (first, empty) = append_bytes(blob_writer(blob_size), ByteRef::empty())
    let mut writer = first
    let book = Book {
        orders: Arr<OrderState>::alloc(n),
        items: Arr<Item>::alloc(total),
        used: total,
        blob: writer.base,
    }
    let mut start: u256 = 0
    i = 0
    while i < n {
        let order = orders.get(i)
        let p = order.parameters
        fill_items(
            book.items,
            start,
            offer: p.offer,
            consideration: p.consideration,
        )
        let (after_signature, signature) = append_bytes(writer, ByteRef::of(order.signature))
        writer = after_signature
        *book.orders.at(i) = order_state(
            orders.get(i).parameters,
            items_start: start,
            numerator: 1,
            denominator: 1,
            signature,
            extra_data: empty,
        )
        start = start + parameters_items(orders.get(i).parameters)
        i += 1
    }
    book
}

pub fn single_advanced(_ order: AdvancedOrder) -> Book {
    let numerator = order.numerator.val as u256
    let denominator = order.denominator.val as u256
    let signature = ByteRef::of(order.signature)
    let extra_data = ByteRef::of(order.extraData)
    let writer = blob_writer(tail_size(signature.len) + tail_size(extra_data.len))
    let (after_signature, signature_offset) = append_bytes(writer, signature)
    let (_, extra_data_offset) = append_bytes(after_signature, extra_data)
    single_book(
        order.parameters,
        numerator,
        denominator,
        blob: writer.base,
        signature: signature_offset,
        extra_data: extra_data_offset,
    )
}

pub fn single_order(_ order: Order) -> Book {
    let signature = ByteRef::of(order.signature)
    let writer = blob_writer(32 + tail_size(signature.len))
    let (after_empty, empty) = append_bytes(writer, ByteRef::empty())
    let (_, signature_offset) = append_bytes(after_empty, signature)
    single_book(
        order.parameters,
        numerator: 1,
        denominator: 1,
        blob: writer.base,
        signature: signature_offset,
        extra_data: empty,
    )
}

fn single_book(
    _ p: OrderParameters,
    numerator: u256,
    denominator: u256,
    blob: *u8,
    signature: u256,
    extra_data: u256,
) -> Book {
    let offer = p.offer
    let consideration = p.consideration
    let offer_len = offer.len()
    let consideration_len = consideration.len()
    let book = Book {
        orders: Arr<OrderState>::alloc(1),
        items: Arr<Item>::alloc(offer_len + consideration_len),
        used: offer_len + consideration_len,
        blob,
    }
    fill_items(book.items, start: 0, offer, consideration)
    *book.orders.at(0) = OrderState {
        offerer: p.offerer,
        zone: p.zone,
        offer_start: 0,
        offer_len,
        consideration_start: offer_len,
        consideration_len,
        order_type: p.orderType as u256,
        start_time: p.startTime,
        end_time: p.endTime,
        zone_hash: p.zoneHash.val,
        salt: p.salt,
        conduit_key: p.conduitKey.val,
        total_original: p.totalOriginalConsiderationItems,
        numerator,
        denominator,
        signature,
        extra_data,
    }
    book
}

/// `OrderComponents` as a one-order book: `totalOriginalConsiderationItems`
/// is the supplied consideration length. Returns the counter too.
pub fn components_book(_ c: OrderComponents) -> (Book, u256) {
    let offer = c.offer
    let consideration = c.consideration
    let total = offer.len() + consideration.len()
    let (writer, _) = append_bytes(blob_writer(32), ByteRef::empty())
    let book = Book {
        orders: Arr<OrderState>::alloc(1),
        items: Arr<Item>::alloc(total),
        used: total,
        blob: writer.base,
    }
    fill_items(
        book.items,
        start: 0,
        offer: c.offer,
        consideration: c.consideration,
    )
    *book.orders.at(0) = OrderState {
        offerer: c.offerer,
        zone: c.zone,
        offer_start: 0,
        offer_len: offer.len(),
        consideration_start: offer.len(),
        consideration_len: consideration.len(),
        order_type: c.orderType as u256,
        start_time: c.startTime,
        end_time: c.endTime,
        zone_hash: c.zoneHash.val,
        salt: c.salt,
        conduit_key: c.conduitKey.val,
        total_original: consideration.len(),
        numerator: 1,
        denominator: 1,
        signature: 0,
        extra_data: 0,
    }
    (book, c.counter)
}

pub fn resolvers(_ resolvers: DynArray<CriteriaResolver>) -> Resolvers {
    let n = resolvers.len()
    let mut total: u256 = 0
    let mut i: u256 = 0
    while i < n {
        total = total + resolvers.get(i).criteriaProof.len()
        i += 1
    }
    let out = Resolvers { list: Arr<Resolver>::alloc(n), proofs: Arr<u256>::alloc(total) }
    let mut start: u256 = 0
    i = 0
    while i < n {
        let r = resolvers.get(i)
        let proof = r.criteriaProof
        let mut j: u256 = 0
        while j < proof.len() {
            *out.proofs.at(start + j) = proof.get(j).val
            j += 1
        }
        *out.list.at(i) = Resolver {
            order_index: r.orderIndex,
            side: r.side as u256,
            index: r.index,
            identifier: r.identifier,
            proof_start: start,
            proof_len: proof.len(),
        }
        start = start + proof.len()
        i += 1
    }
    out
}

pub fn no_resolvers() -> Resolvers {
    Resolvers { list: Arr<Resolver>::empty(), proofs: Arr<u256>::empty() }
}

fn group_components(
    _ groups: Groups,
    index: u256,
    start: u256,
    items: DynArray<FulfillmentComponent>,
) -> u256 {
    let mut i: u256 = 0
    while i < items.len() {
        let c = items.get(i)
        *groups.components.at(start + i) = Component {
            order_index: c.orderIndex,
            item_index: c.itemIndex,
        }
        i += 1
    }
    *groups.list.at(index) = Group { start, len: items.len() }
    start + items.len()
}

/// `FulfillmentComponent[][]` as groups of one component pool.
pub fn nested_components(_ nested: DynArray<DynArray<FulfillmentComponent>>) -> Groups {
    let n = nested.len()
    let mut total: u256 = 0
    let mut i: u256 = 0
    while i < n {
        total = total + nested.get(i).len()
        i += 1
    }
    let groups = Groups { list: Arr<Group>::alloc(n), components: Arr<Component>::alloc(total) }
    let mut start: u256 = 0
    i = 0
    while i < n {
        start = group_components(groups, index: i, start, items: nested.get(i))
        i += 1
    }
    groups
}

/// `Fulfillment[]` as pairs of groups (offer at `2 * i`, consideration at
/// `2 * i + 1`).
pub fn fulfillments(_ items: DynArray<Fulfillment>) -> Groups {
    let n = items.len()
    let mut total: u256 = 0
    let mut i: u256 = 0
    while i < n {
        let f = items.get(i)
        total = total + f.offerComponents.len() + items.get(i).considerationComponents.len()
        i += 1
    }
    let groups = Groups { list: Arr<Group>::alloc(2 * n), components: Arr<Component>::alloc(total) }
    let mut start: u256 = 0
    i = 0
    while i < n {
        start = group_components(
            groups,
            index: 2 * i,
            start,
            items: items.get(i).offerComponents,
        )
        start = group_components(
            groups,
            index: 2 * i + 1,
            start,
            items: items.get(i).considerationComponents,
        )
        i += 1
    }
    groups
}
