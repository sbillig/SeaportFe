// SPDX-License-Identifier: MIT
// Mutable in-memory order model.
//
// Items have two phases. Before preparation, `amount` and `original` hold
// the signed start and end amounts. Hashing and OrderValidated emission read
// these unchanged words. Preparation runs once, after hashing, and replaces
// both with the interpolated fill amount. Aggregation then changes `amount`
// while `original` preserves the amount for settlement and zone calls.
// The recipient stays in its own field throughout; offer preparation or
// transfer assigns it when needed. Generated items start already prepared.
//
// All items of all orders live in one pool (`Book.items`); an order refers
// to its offer and consideration by index ranges, and to its signature and
// extra data by offsets into a byte pool (`Book.blob`). Resolver proofs and
// fulfillment components use pools as well. Fe's borrow checker tracks
// pointers stored in raw memory through every raw write, which explodes for
// code like this (ISSUES.md #9), so no pointer is ever stored in raw memory:
// pools are reached through native Book references and copyable Arr handles.
use core::ptr
use std::evm::{Address, Panic, PANIC_ENUM_CONVERSION, revert_error}
use super::abi_view::CalldataView
use super::arr::{Arr, ByteRef}

pub struct Item {
    /// Raw ItemType word (contract offerers can return any word).
    pub item_type: u256,
    pub token: Address,
    pub identifier: u256,
    /// Signed start amount before preparation; remaining amount afterward.
    pub amount: u256,
    /// Signed end amount before preparation; saved fill amount afterward.
    pub original: u256,
    /// Raw consideration recipient, or the assigned offer recipient.
    pub recipient: Address,
}

impl Copy for Item {}

pub struct OrderState {
    pub offerer: Address,
    pub zone: Address,
    pub offer_start: u256,
    pub offer_len: u256,
    pub consideration_start: u256,
    pub consideration_len: u256,
    pub order_type: u256,
    pub start_time: u256,
    pub end_time: u256,
    pub zone_hash: u256,
    pub salt: u256,
    pub conduit_key: u256,
    pub total_original: u256,
    pub numerator: u256,
    pub denominator: u256,
    /// Offset of the signature's ABI tail in `Book.blob`.
    pub signature: u256,
    /// Offset of the extra data's ABI tail in `Book.blob`.
    pub extra_data: u256,
}

impl Copy for OrderState {}

/// Solidity validates protocol enums when their words are read as enums.
pub fn checked_enum(_ value: u256, variants: u256) -> u256 {
    if value >= variants {
        revert_error(Panic::from(PANIC_ENUM_CONVERSION))
    }
    value
}

/// The orders being fulfilled and the pool of their items.
pub struct Book {
    pub orders: Arr<OrderState>,
    pub items: Arr<Item>,
    /// Items in use; the pool beyond `used` is spare capacity.
    pub used: u256,
    /// Signatures and extra data as consecutive ABI `bytes` tails.
    pub blob: *u8,
}

impl Copy for Book {}

impl Book {
    pub fn order(ref self, _ index: u256) -> *OrderState {
        self.orders.at(index)
    }
    pub fn offer_item(ref self, _ order: *OrderState, _ index: u256) -> *Item {
        self.items.at(order.offer_start + index)
    }
    pub fn consideration_item(ref self, _ order: *OrderState, _ index: u256) -> *Item {
        self.items.at(order.consideration_start + index)
    }

    /// The `bytes` at `offset` in the byte pool.
    pub fn bytes(ref self, _ offset: u256) -> ByteRef {
        let data = core::ptr::offset_bytes(self.blob, offset)
        let len = *core::ptr::cast<u8, u256>(data)
        ByteRef { data, len, size: 32 + ((len + 31) & !(31 as u256)) }
    }
}

pub struct Resolver {
    pub order_index: u256,
    pub side: u256,
    pub index: u256,
    pub identifier: u256,
    /// Range of the proof in `Resolvers.proofs`.
    pub proof_start: u256,
    pub proof_len: u256,
}

impl Copy for Resolver {}

pub struct Resolvers { pub list: Arr<Resolver>, pub proofs: Arr<u256> }

impl Copy for Resolvers {}

pub struct Component { pub order_index: u256, pub item_index: u256 }

impl Copy for Component {}

/// A range of `Groups.components`.
pub struct Group { pub start: u256, pub len: u256 }

impl Copy for Group {}

/// `FulfillmentComponent[][]`
pub struct Groups { pub list: Arr<Group>, pub components: Arr<Component> }

impl Copy for Groups {}

/// Keep the raw words until consumers perform Solidity's typed reads. In
/// particular, EIP-712 hashing observes the unmasked address and enum words.
fn fill_items(_ items: Arr<Item>, start: u256, input: CalldataView, consideration: bool) {
    let stride = if consideration { 192 } else { 160 }
    let mut i: u256 = 0
    while i < input.len() {
        let item = input.element(index: i, stride)
        let recipient = Address { inner: if consideration { item.word(160) } else { 0 } }
        *items.at(start + i) = Item {
            item_type: item.word(0),
            token: Address { inner: item.word(32) },
            identifier: item.word(64),
            amount: item.word(96),
            original: item.word(128),
            recipient,
        }
        i += 1
    }
}

struct OrderViews { input: CalldataView, len: u256, advanced: bool, single: bool }
impl Copy for OrderViews {}
impl OrderViews {
    fn get(self, _ index: u256) -> CalldataView {
        if self.single {
            self.input
        } else {
            self.input.dynamic_element(index)
        }
    }
}

/// Read the immutable calldata twice for sizing and construction, copying
/// each item and byte tail only into its final mutable pool.
fn build_book(_ orders: OrderViews) -> Book {
    let signature_head = if orders.advanced { 96 } else { 32 }
    let mut total: u256 = 0
    // Ordinary orders share one empty extra-data tail at offset zero.
    let mut blob_size: u256 = if orders.advanced { 0 } else { 32 }
    let mut i: u256 = 0
    while i < orders.len {
        let order = orders.get(i)
        let p = order.child(0)
        total += p.child(64).len() + p.child(96).len()
        blob_size += order.child(signature_head).byte_size()
        if orders.advanced {
            blob_size += order.child(128).byte_size()
        }
        i += 1
    }
    let book = Book {
        orders: Arr<OrderState>::alloc(orders.len),
        items: Arr<Item>::alloc(total),
        used: total,
        blob: ptr::alloc_bytes(blob_size),
    }
    let mut offset: u256 = 0
    if !orders.advanced {
        *ptr::cast<u8, u256>(book.blob) = 0
        offset = 32
    }
    let mut start: u256 = 0
    i = 0
    while i < orders.len {
        let input = orders.get(i)
        let p = input.child(0)
        let offer = p.child(64)
        let consideration = p.child(96)
        let offer_len = offer.len()
        let consideration_len = consideration.len()
        let consideration_start = start + offer_len
        fill_items(book.items, start, input: offer, consideration: false)
        fill_items(
            book.items,
            start: consideration_start,
            input: consideration,
            consideration: true,
        )
        let signature = offset
        let signature_view = input.child(signature_head)
        // The sizing pass reserved this exact tail in the immutable calldata.
        unsafe {
            signature_view.copy_bytes(ptr::offset_bytes(book.blob, offset))
        }
        offset += signature_view.byte_size()
        let mut extra_data: u256 = 0
        let mut numerator: u256 = 1
        let mut denominator: u256 = 1
        if orders.advanced {
            extra_data = offset
            let extra = input.child(128)
            unsafe {
                extra.copy_bytes(ptr::offset_bytes(book.blob, offset))
            }
            offset += extra.byte_size()
            numerator = input.word(32) & 0xffffffffffffffffffffffffffffff
            denominator = input.word(64) & 0xffffffffffffffffffffffffffffff
        }
        *book.orders.at(i) = OrderState {
            offerer: Address { inner: p.word(0) },
            zone: Address { inner: p.word(32) },
            offer_start: start,
            offer_len,
            consideration_start,
            consideration_len,
            order_type: p.word(128),
            start_time: p.word(160),
            end_time: p.word(192),
            zone_hash: p.word(224),
            salt: p.word(256),
            conduit_key: p.word(288),
            total_original: p.word(320),
            numerator,
            denominator,
            signature,
            extra_data,
        }
        start = consideration_start + consideration_len
        i += 1
    }
    book
}

pub fn orders_book(_ input: CalldataView, advanced: bool) -> Book {
    build_book(
        OrderViews { input, len: input.len(), advanced, single: false },
    )
}

pub fn single_order(_ input: CalldataView, advanced: bool) -> Book {
    build_book(OrderViews { input, len: 1, advanced, single: true })
}

pub fn resolvers(_ input: CalldataView) -> Resolvers {
    let n = input.len()
    let mut total: u256 = 0
    let mut i: u256 = 0
    while i < n {
        total += input.dynamic_element(i).child(128).len()
        i += 1
    }
    let out = Resolvers { list: Arr<Resolver>::alloc(n), proofs: Arr<u256>::alloc(total) }
    let mut start: u256 = 0
    i = 0
    while i < n {
        let r = input.dynamic_element(i)
        let proof = r.child(128)
        let mut j: u256 = 0
        while j < proof.len() {
            *out.proofs.at(start + j) = proof.element(index: j, stride: 32).word(0)
            j += 1
        }
        *out.list.at(i) = Resolver {
            order_index: r.word(0),
            side: r.word(32),
            index: r.word(64),
            identifier: r.word(96),
            proof_start: start,
            // The custom Solidity proof decoder preserves the raw length word.
            proof_len: proof.word(0),
        }
        start += proof.len()
        i += 1
    }
    out
}

pub fn no_resolvers() -> Resolvers {
    Resolvers { list: Arr<Resolver>::empty(), proofs: Arr<u256>::empty() }
}

fn group_components(_ groups: Groups, index: u256, start: u256, items: CalldataView) -> u256 {
    let mut i: u256 = 0
    while i < items.len() {
        let c = items.element(index: i, stride: 64)
        *groups.components.at(start + i) = Component {
            order_index: c.word(0),
            item_index: c.word(32),
        }
        i += 1
    }
    *groups.list.at(index) = Group { start, len: items.len() }
    start + items.len()
}

/// `FulfillmentComponent[][]` as groups of one component pool.
pub fn nested_components(_ nested: CalldataView) -> Groups {
    let n = nested.len()
    let mut total: u256 = 0
    let mut i: u256 = 0
    while i < n {
        total += nested.dynamic_element(i).len()
        i += 1
    }
    let groups = Groups { list: Arr<Group>::alloc(n), components: Arr<Component>::alloc(total) }
    let mut start: u256 = 0
    i = 0
    while i < n {
        start = group_components(groups, index: i, start, items: nested.dynamic_element(i))
        i += 1
    }
    groups
}

/// `Fulfillment[]` as pairs of groups (offer at `2 * i`, consideration at
/// `2 * i + 1`).
pub fn fulfillments(_ items: CalldataView) -> Groups {
    let n = items.len()
    let mut total: u256 = 0
    let mut i: u256 = 0
    while i < n {
        let f = items.dynamic_element(i)
        total += f.child(0).len() + f.child(32).len()
        i += 1
    }
    let groups = Groups { list: Arr<Group>::alloc(2 * n), components: Arr<Component>::alloc(total) }
    let mut start: u256 = 0
    i = 0
    while i < n {
        let f = items.dynamic_element(i)
        start = group_components(groups, index: 2 * i, start, items: f.child(0))
        start = group_components(groups, index: 2 * i + 1, start, items: f.child(32))
        i += 1
    }
    groups
}
