// SPDX-License-Identifier: MIT
// Mutable in-memory order model.
//
// Seaport (seaport-core 1.6) decodes calldata into memory structs and then
// reuses struct slots for derived values: after fractions are applied an
// item's `startAmount` slot holds the current amount, its `endAmount` slot the
// recipient, and a consideration item's `recipient` slot the original amount.
// The port gives each of those meanings its own field instead:
//
// - `amount`:   the `startAmount` slot after fraction application (the
//               current, and later the remaining unspent/unmet amount).
// - `receiver`: the `endAmount` slot read as `ReceivedItem.recipient`.
// - `original`: the current amount before fulfillment aggregation.
//
// All items of all orders live in one owned pool (`Book.items`); orders
// describe their offer and consideration as index ranges. Signatures, extra
// data, criteria resolvers and fulfillment components stay in calldata.
// Separate order and item fields allow scoped views of descriptors during item
// mutation; replacing an item pool requires exclusive access to its Book.
//
// The model is built straight from calldata with seaport-core's decoder
// semantics (see `abi_view`). Addresses are cleaned and enum words kept raw,
// as Solidity's typed memory reads see them: consumers check enums where
// Seaport reads them. The order hash reads the raw words from calldata.
use std::evm::{Address, Panic, PANIC_ENUM_CONVERSION}
use core::size_of
use core::ptr::{self, MemArray}
use super::raw_abi::{error_selector, revert_with1}
use super::abi_view::CalldataView

pub struct Item {
    /// Raw ItemType word (contract offerers can return any word).
    pub item_type: u256,
    pub token: Address,
    pub identifier: u256,
    pub start_amount: u256,
    pub end_amount: u256,
    /// `ConsiderationItem.recipient` (zero for offer items).
    pub recipient: Address,
    pub amount: u256,
    pub receiver: Address,
    pub original: u256,
}

impl Copy for Item {}

pub struct OrderState {
    pub offerer: Address,
    pub zone: Address,
    pub offer_start: u256,
    pub offer_len: u256,
    pub consideration_start: u256,
    pub consideration_len: u256,
    pub order_type: u256,
    pub start_time: u256,
    pub end_time: u256,
    pub zone_hash: u256,
    pub salt: u256,
    pub conduit_key: u256,
    pub total_original: u256,
    pub numerator: u256,
    pub denominator: u256,
    /// Calldata `bytes`.
    pub signature: CalldataView,
    pub extra_data: CalldataView,
    /// Calldata position of the order's `OrderParameters`, whose raw words
    /// the order hash covers.
    pub params: CalldataView,
}

impl Copy for OrderState {}

/// The orders being fulfilled and the pool of their items.
pub struct Book {
    pub orders: MemArray<OrderState>,
    pub items: MemArray<Item>,
    /// Items in use; the pool beyond `used` is spare capacity.
    pub used: u256,
}

/// A `CriteriaResolver` in calldata.
pub struct Resolver { input: CalldataView }

impl Copy for Resolver {}

impl Resolver {
    pub fn order_index(self) -> u256 {
        self.input.word(0)
    }

    pub fn side(self) -> u256 {
        self.input.word(32)
    }

    pub fn index(self) -> u256 {
        self.input.word(64)
    }

    pub fn identifier(self) -> u256 {
        self.input.word(96)
    }

    /// The `bytes32[]` proof, whose raw length word Seaport's copy keeps.
    pub fn proof(self) -> CalldataView {
        self.input.child(128)
    }
}

/// `CriteriaResolver[]` in calldata. Seaport's memory copies of resolvers,
/// fulfillment components and fulfillments are never written, so reading
/// them in place agrees with them.
pub struct Resolvers { input: CalldataView }

impl Copy for Resolvers {}

impl Resolvers {
    pub fn len(self) -> u256 {
        self.input.len()
    }

    pub fn get(self, _ index: u256) -> Resolver {
        Resolver { input: self.input.dynamic_element(index) }
    }
}

pub struct Component { pub order_index: u256, pub item_index: u256 }

impl Copy for Component {}

/// A `FulfillmentComponent[]` in calldata.
pub struct Group { input: CalldataView }

impl Copy for Group {}

impl Group {
    pub fn len(self) -> u256 {
        self.input.len()
    }

    pub fn component(self, _ index: u256) -> Component {
        let c = self.input.element(index, stride: 64)
        Component { order_index: c.word(0), item_index: c.word(32) }
    }
}

/// `FulfillmentComponent[][]`, or the component arrays of `Fulfillment[]`
/// (`paired`: offer at `2 * i`, consideration at `2 * i + 1`), in calldata.
pub struct Groups { input: CalldataView, paired: bool }

impl Copy for Groups {}

impl Groups {
    pub fn len(self) -> u256 {
        if self.paired {
            2 * self.input.len()
        } else {
            self.input.len()
        }
    }

    pub fn group(self, _ index: u256) -> Group {
        Group {
            input: if self.paired {
                self.input.dynamic_element(index >> 1).child((index & 1) * 32)
            } else {
                self.input.dynamic_element(index)
            },
        }
    }
}

/// Element `index` of the array at `base`: `ptr::offset` without its
/// overflow check. The caller must ensure that the array holds the element,
/// whose offset then lies in the allocation.
#[arithmetic(unchecked)]
pub fn element<T>(_ base: *T, _ index: u256) -> *T {
    ptr::offset_bytes(base, index * size_of<T>())
}

/// Solidity validates protocol enums when their words are read as enums.
pub fn checked_enum(_ value: u256, variants: u256) -> u256 {
    if value >= variants {
        revert_with1(error_selector<Panic>(), PANIC_ENUM_CONVERSION)
    }
    value
}

/// Copy an offer (`consideration: false`) or consideration array into the
/// pool at `start`.
#[arithmetic(unchecked)]
fn fill_items(_ items: mut MemArray<Item>, start: usize, input: CalldataView, consideration: bool) {
    let stride: u256 = if consideration { 192 } else { 160 }
    var i: usize = 0
    let len = input.len() as usize
    while i < len {
        let item = input.element(index: i as u256, stride)
        let recipient = if consideration {
            item.address(160)
        } else {
            Address::zero()
        }
        // `start + i` lies in the pool, which the caller sized for these items.
        let slot = element(items.ptr(), (start + i) as u256)
        unsafe {
            (*slot).item_type = item.word(0)
            (*slot).token = item.address(32)
            (*slot).identifier = item.word(64)
            (*slot).start_amount = item.word(96)
            (*slot).end_amount = item.word(128)
            (*slot).recipient = recipient
            (*slot).amount = item.word(96)
            (*slot).receiver = recipient
            (*slot).original = 0
        }
        i += 1
    }
}

/// `_decodeAdvancedOrders`, `_decodeOrdersAsAdvancedOrders` and their
/// single-order forms: the first `count` elements of the array `input`, as
/// `AdvancedOrder`s (`advanced`) or `Order`s.
#[arithmetic(unchecked)]
fn build_book(_ input: CalldataView, count: usize, advanced: bool) -> Book {
    var total: usize = 0
    var i: usize = 0
    while i < count {
        let order = input.dynamic_element(i as u256)
        let p = order.child(0)
        total += (p.child(64).len() + p.child(96).len()) as usize
        i += 1
    }
    // Every order and item is assigned below before the Book is returned.
    var states = unsafe {
        MemArray<OrderState>::new_uninit(count)
    }
    var items = unsafe {
        MemArray<Item>::new_uninit(total)
    }
    var start: usize = 0
    i = 0
    while i < count {
        let order = input.dynamic_element(i as u256)
        let p = order.child(0)
        let offer = p.child(64)
        let consideration = p.child(96)
        let consideration_start = start + offer.len() as usize
        fill_items(mut items, start, input: offer, consideration: false)
        fill_items(
            mut items,
            start: consideration_start,
            input: consideration,
            consideration: true,
        )
        // Fields are stored one by one, which keeps few values live, into
        // order `i` of the `count` the pool holds.
        let state = element(states.ptr(), i as u256)
        unsafe {
            (*state).offerer = p.address(0)
            (*state).zone = p.address(32)
            (*state).offer_start = start as u256
            (*state).offer_len = offer.len()
            (*state).consideration_start = consideration_start as u256
            (*state).consideration_len = consideration.len()
            (*state).order_type = p.word(128)
            (*state).start_time = p.word(160)
            (*state).end_time = p.word(192)
            (*state).zone_hash = p.word(224)
            (*state).salt = p.word(256)
            (*state).conduit_key = p.word(288)
            (*state).total_original = p.word(320)
            (*state).numerator = if advanced {
                order.word(32) & 0xffffffffffffffffffffffffffffff
            } else {
                1
            }
            (*state).denominator = if advanced {
                order.word(64) & 0xffffffffffffffffffffffffffffff
            } else {
                1
            }
            (*state).signature = order.child(if advanced { 96 } else { 32 })
            (*state).extra_data = if advanced {
                order.child(128)
            } else {
                CalldataView::empty()
            }
            (*state).params = p
        }
        start = consideration_start + consideration.len() as usize
        i += 1
    }
    Book { orders: states, items, used: total as u256 }
}

/// The orders of the `AdvancedOrder[]` (`advanced`) or `Order[]` at `input`.
pub fn orders_book(_ input: CalldataView, advanced: bool) -> Book {
    build_book(input, count: input.len() as usize, advanced)
}

/// The `AdvancedOrder` (`advanced`) or `Order` that is the first of `args`.
pub fn single_order(_ args: CalldataView, advanced: bool) -> Book {
    build_book(args.heads(), count: 1, advanced)
}

/// `_decodeCriteriaResolvers`
pub fn resolvers(_ input: CalldataView) -> Resolvers {
    Resolvers { input }
}

pub fn no_resolvers() -> Resolvers {
    Resolvers { input: CalldataView::empty() }
}

/// `_decodeNestedFulfillmentComponents`
pub fn nested_components(_ input: CalldataView) -> Groups {
    Groups { input, paired: false }
}

/// `_decodeFulfillments`
pub fn fulfillments(_ input: CalldataView) -> Groups {
    Groups { input, paired: true }
}
