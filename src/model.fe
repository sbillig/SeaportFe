// SPDX-License-Identifier: MIT
// Mutable in-memory order model.
//
// Seaport (seaport-core 1.6) decodes calldata into memory structs and then
// reuses struct slots for derived values: after fractions are applied an
// item's `startAmount` slot holds the current amount, its `endAmount` slot the
// recipient, and a consideration item's `recipient` slot the original amount.
// The port gives each of those meanings its own field instead:
//
// - `amount`:   the `startAmount` slot after fraction application (the
//               current, and later the remaining unspent/unmet amount).
// - `receiver`: the `endAmount` slot read as `ReceivedItem.recipient`.
// - `original`: the current amount before fulfillment aggregation.
//
// All items of all orders live in one owned pool (`Book.items`); orders
// describe their offer and consideration as index ranges. Immutable ABI Bytes
// retain signatures and extra data without copying them into a raw byte pool.
// Resolver proofs and fulfillment components also have non-Copy owners.
// Separate order and item fields allow scoped views of descriptors during item
// mutation; replacing an item pool requires exclusive access to its Book.
use std::abi::{Bytes, DynArray}
use std::evm::Address
use core::ptr::MemArray
use super::types::{
    AdvancedOrder,
    ConsiderationItem,
    CriteriaResolver,
    Fulfillment,
    FulfillmentComponent,
    OfferItem,
    Order,
    OrderParameters,
}

pub struct Item {
    /// Raw ItemType word (contract offerers can return any word).
    pub item_type: u256,
    pub token: Address,
    pub identifier: u256,
    pub start_amount: u256,
    pub end_amount: u256,
    /// `ConsiderationItem.recipient` (zero for offer items).
    pub recipient: Address,
    pub amount: u256,
    pub receiver: Address,
    pub original: u256,
}

impl Copy for Item {}

pub struct OrderState {
    pub offerer: Address,
    pub zone: Address,
    pub offer_start: u256,
    pub offer_len: u256,
    pub consideration_start: u256,
    pub consideration_len: u256,
    pub order_type: u256,
    pub start_time: u256,
    pub end_time: u256,
    pub zone_hash: u256,
    pub salt: u256,
    pub conduit_key: u256,
    pub total_original: u256,
    pub numerator: u256,
    pub denominator: u256,
    pub signature: Bytes,
    pub extra_data: Bytes,
}

impl Copy for OrderState {}

/// The orders being fulfilled and the pool of their items.
pub struct Book {
    pub orders: MemArray<OrderState>,
    pub items: MemArray<Item>,
    /// Items in use; the pool beyond `used` is spare capacity.
    pub used: u256,
}

pub struct Resolver {
    pub order_index: u256,
    pub side: u256,
    pub index: u256,
    pub identifier: u256,
    /// Range of the proof in `Resolvers.proofs`.
    pub proof_start: u256,
    pub proof_len: u256,
}

impl Copy for Resolver {}

pub struct Resolvers { pub list: MemArray<Resolver>, pub proofs: MemArray<u256> }

pub struct Component { pub order_index: u256, pub item_index: u256 }

impl Copy for Component {}

/// A range of `Groups.components`.
pub struct Group { pub start: u256, pub len: u256 }

impl Copy for Group {}

/// `FulfillmentComponent[][]`
pub struct Groups { pub list: MemArray<Group>, pub components: MemArray<Component> }

fn offer_item_state(_ item: OfferItem) -> Item {
    Item {
        item_type: item.itemType as u256,
        token: item.token,
        identifier: item.identifierOrCriteria,
        start_amount: item.startAmount,
        end_amount: item.endAmount,
        recipient: Address::zero(),
        amount: item.startAmount,
        receiver: Address::zero(),
        original: 0,
    }
}

fn consideration_item_state(_ item: ConsiderationItem) -> Item {
    Item {
        item_type: item.itemType as u256,
        token: item.token,
        identifier: item.identifierOrCriteria,
        start_amount: item.startAmount,
        end_amount: item.endAmount,
        recipient: item.recipient,
        amount: item.startAmount,
        receiver: item.recipient,
        original: 0,
    }
}

/// Copy an offer and consideration into the pool at `start`.
fn fill_items(
    _ items: mut MemArray<Item>,
    start: u256,
    offer: DynArray<OfferItem>,
    consideration: DynArray<ConsiderationItem>,
) {
    var i: u256 = 0
    while i < offer.len() {
        items[(start + i) as usize] = offer_item_state(offer.get(i))
        i += 1
    }
    let consideration_start = start + offer.len()
    i = 0
    while i < consideration.len() {
        items[(consideration_start + i) as usize] = consideration_item_state(consideration.get(i))
        i += 1
    }
}

fn order_state(
    _ p: OrderParameters,
    items_start: u256,
    numerator: u256,
    denominator: u256,
    signature: Bytes,
    extra_data: Bytes,
) -> OrderState {
    OrderState {
        offerer: p.offerer,
        zone: p.zone,
        offer_start: items_start,
        offer_len: p.offer.len(),
        consideration_start: items_start + p.offer.len(),
        consideration_len: p.consideration.len(),
        order_type: p.orderType as u256,
        start_time: p.startTime,
        end_time: p.endTime,
        zone_hash: p.zoneHash.val,
        salt: p.salt,
        conduit_key: p.conduitKey.val,
        total_original: p.totalOriginalConsiderationItems,
        numerator,
        denominator,
        signature,
        extra_data,
    }
}

fn parameters_items(_ p: OrderParameters) -> u256 {
    p.offer.len() + p.consideration.len()
}

pub fn advanced_orders(_ orders: DynArray<AdvancedOrder>) -> Book {
    let n = orders.len()
    var total: u256 = 0
    var i: u256 = 0
    while i < n {
        total = total + parameters_items(orders.get(i).parameters)
        i += 1
    }
    var book = Book {
        orders: MemArray<OrderState>::new_zeroed(n),
        items: MemArray<Item>::new_zeroed(total),
        used: total,
    }
    var start: u256 = 0
    i = 0
    while i < n {
        let order = orders.get(i)
        let p = order.parameters
        fill_items(
            mut book.items,
            start,
            offer: p.offer,
            consideration: p.consideration,
        )
        book.orders[(i) as usize] = order_state(
            orders.get(i).parameters,
            items_start: start,
            numerator: order.numerator.val as u256,
            denominator: order.denominator.val as u256,
            signature: order.signature,
            extra_data: order.extraData,
        )
        start = start + parameters_items(orders.get(i).parameters)
        i += 1
    }
    book
}

pub fn orders_as_advanced(_ orders: DynArray<Order>) -> Book {
    let n = orders.len()
    var total: u256 = 0
    var i: u256 = 0
    while i < n {
        total = total + parameters_items(orders.get(i).parameters)
        i += 1
    }
    var book = Book {
        orders: MemArray<OrderState>::new_zeroed(n),
        items: MemArray<Item>::new_zeroed(total),
        used: total,
    }
    var start: u256 = 0
    i = 0
    while i < n {
        let order = orders.get(i)
        let p = order.parameters
        fill_items(
            mut book.items,
            start,
            offer: p.offer,
            consideration: p.consideration,
        )
        book.orders[(i) as usize] = order_state(
            orders.get(i).parameters,
            items_start: start,
            numerator: 1,
            denominator: 1,
            signature: order.signature,
            extra_data: Bytes::empty(),
        )
        start = start + parameters_items(orders.get(i).parameters)
        i += 1
    }
    book
}

pub fn single_advanced(_ order: AdvancedOrder) -> Book {
    single_book(
        order.parameters,
        numerator: order.numerator.val as u256,
        denominator: order.denominator.val as u256,
        signature: order.signature,
        extra_data: order.extraData,
    )
}

pub fn single_order(_ order: Order) -> Book {
    single_book(
        order.parameters,
        numerator: 1,
        denominator: 1,
        signature: order.signature,
        extra_data: Bytes::empty(),
    )
}

fn single_book(
    _ p: OrderParameters,
    numerator: u256,
    denominator: u256,
    signature: Bytes,
    extra_data: Bytes,
) -> Book {
    let offer = p.offer
    let consideration = p.consideration
    let offer_len = offer.len()
    let consideration_len = consideration.len()
    var book = Book {
        orders: MemArray<OrderState>::new_zeroed(1),
        items: MemArray<Item>::new_zeroed(offer_len + consideration_len),
        used: offer_len + consideration_len,
    }
    fill_items(mut book.items, start: 0, offer, consideration)
    book.orders[(0) as usize] = OrderState {
        offerer: p.offerer,
        zone: p.zone,
        offer_start: 0,
        offer_len,
        consideration_start: offer_len,
        consideration_len,
        order_type: p.orderType as u256,
        start_time: p.startTime,
        end_time: p.endTime,
        zone_hash: p.zoneHash.val,
        salt: p.salt,
        conduit_key: p.conduitKey.val,
        total_original: p.totalOriginalConsiderationItems,
        numerator,
        denominator,
        signature,
        extra_data,
    }
    book
}

pub fn resolvers(_ resolvers: DynArray<CriteriaResolver>) -> Resolvers {
    let n = resolvers.len()
    var total: u256 = 0
    var i: u256 = 0
    while i < n {
        total = total + resolvers.get(i).criteriaProof.len()
        i += 1
    }
    var out = Resolvers {
        list: MemArray<Resolver>::new_zeroed(n),
        proofs: MemArray<u256>::new_zeroed(total),
    }
    var start: u256 = 0
    i = 0
    while i < n {
        let r = resolvers.get(i)
        let proof = r.criteriaProof
        var j: u256 = 0
        while j < proof.len() {
            out.proofs[(start + j) as usize] = proof.get(j).val
            j += 1
        }
        out.list[(i) as usize] = Resolver {
            order_index: r.orderIndex,
            side: r.side as u256,
            index: r.index,
            identifier: r.identifier,
            proof_start: start,
            proof_len: proof.len(),
        }
        start = start + proof.len()
        i += 1
    }
    out
}

pub fn no_resolvers() -> Resolvers {
    Resolvers { list: MemArray<Resolver>::new_zeroed(0), proofs: MemArray<u256>::new_zeroed(0) }
}

fn group_components(
    _ groups: mut Groups,
    index: u256,
    start: u256,
    items: DynArray<FulfillmentComponent>,
) -> u256 {
    var i: u256 = 0
    while i < items.len() {
        let c = items.get(i)
        groups.components[(start + i) as usize] = Component {
            order_index: c.orderIndex,
            item_index: c.itemIndex,
        }
        i += 1
    }
    groups.list[(index) as usize] = Group { start, len: items.len() }
    start + items.len()
}

/// `FulfillmentComponent[][]` as groups of one component pool.
pub fn nested_components(_ nested: DynArray<DynArray<FulfillmentComponent>>) -> Groups {
    let n = nested.len()
    var total: u256 = 0
    var i: u256 = 0
    while i < n {
        total = total + nested.get(i).len()
        i += 1
    }
    var groups = Groups {
        list: MemArray<Group>::new_zeroed(n),
        components: MemArray<Component>::new_zeroed(total),
    }
    var start: u256 = 0
    i = 0
    while i < n {
        start = group_components(mut groups, index: i, start, items: nested.get(i))
        i += 1
    }
    groups
}

/// `Fulfillment[]` as pairs of groups (offer at `2 * i`, consideration at
/// `2 * i + 1`).
pub fn fulfillments(_ items: DynArray<Fulfillment>) -> Groups {
    let n = items.len()
    var total: u256 = 0
    var i: u256 = 0
    while i < n {
        let f = items.get(i)
        total = total + f.offerComponents.len() + items.get(i).considerationComponents.len()
        i += 1
    }
    var groups = Groups {
        list: MemArray<Group>::new_zeroed(2 * n),
        components: MemArray<Component>::new_zeroed(total),
    }
    var start: u256 = 0
    i = 0
    while i < n {
        start = group_components(
            mut groups,
            index: 2 * i,
            start,
            items: items.get(i).offerComponents,
        )
        start = group_components(
            mut groups,
            index: 2 * i + 1,
            start,
            items: items.get(i).considerationComponents,
        )
        i += 1
    }
    groups
}
