// SPDX-License-Identifier: MIT
// Mutable in-memory order model.
//
// Seaport (seaport-core 1.6) decodes calldata into memory structs and then
// reuses struct slots for derived values: after fractions are applied an
// item's `startAmount` slot holds the current amount, its `endAmount` slot the
// recipient, and a consideration item's `recipient` slot the original amount.
// The port gives each of those meanings its own field instead:
//
// - `amount`:   the `startAmount` slot after fraction application (the
//               current, and later the remaining unspent/unmet amount).
// - `receiver`: the `endAmount` slot read as `ReceivedItem.recipient`.
// - `original`: the current amount before fulfillment aggregation.
//
// All items of all orders live in one owned pool (`Book.items`); orders
// describe their offer and consideration as index ranges. Signatures and
// extra data stay in calldata.
// Resolver proofs and fulfillment components also have non-Copy owners.
// Separate order and item fields allow scoped views of descriptors during item
// mutation; replacing an item pool requires exclusive access to its Book.
//
// The model is built straight from calldata with seaport-core's decoder
// semantics (see `abi_view`). Addresses are cleaned and enum words kept raw,
// as Solidity's typed memory reads see them: consumers check enums where
// Seaport reads them. The order hash reads the raw words from calldata.
use std::evm::{Address, Panic, PANIC_ENUM_CONVERSION, revert_error}
use core::ptr::MemArray
use super::abi_view::CalldataView

pub struct Item {
    /// Raw ItemType word (contract offerers can return any word).
    pub item_type: u256,
    pub token: Address,
    pub identifier: u256,
    pub start_amount: u256,
    pub end_amount: u256,
    /// `ConsiderationItem.recipient` (zero for offer items).
    pub recipient: Address,
    pub amount: u256,
    pub receiver: Address,
    pub original: u256,
}

impl Copy for Item {}

pub struct OrderState {
    pub offerer: Address,
    pub zone: Address,
    pub offer_start: u256,
    pub offer_len: u256,
    pub consideration_start: u256,
    pub consideration_len: u256,
    pub order_type: u256,
    pub start_time: u256,
    pub end_time: u256,
    pub zone_hash: u256,
    pub salt: u256,
    pub conduit_key: u256,
    pub total_original: u256,
    pub numerator: u256,
    pub denominator: u256,
    /// Calldata `bytes`.
    pub signature: CalldataView,
    pub extra_data: CalldataView,
    /// Calldata position of the order's `OrderParameters`, whose raw words
    /// the order hash covers.
    pub params: CalldataView,
}

impl Copy for OrderState {}

/// The orders being fulfilled and the pool of their items.
pub struct Book {
    pub orders: MemArray<OrderState>,
    pub items: MemArray<Item>,
    /// Items in use; the pool beyond `used` is spare capacity.
    pub used: u256,
}

pub struct Resolver {
    pub order_index: u256,
    pub side: u256,
    pub index: u256,
    pub identifier: u256,
    /// Range of the proof in `Resolvers.proofs`.
    pub proof_start: u256,
    pub proof_len: u256,
}

impl Copy for Resolver {}

pub struct Resolvers { pub list: MemArray<Resolver>, pub proofs: MemArray<u256> }

pub struct Component { pub order_index: u256, pub item_index: u256 }

impl Copy for Component {}

/// A range of `Groups.components`.
pub struct Group { pub start: u256, pub len: u256 }

impl Copy for Group {}

/// `FulfillmentComponent[][]`
pub struct Groups { pub list: MemArray<Group>, pub components: MemArray<Component> }

/// Solidity validates protocol enums when their words are read as enums.
pub fn checked_enum(_ value: u256, variants: u256) -> u256 {
    if value >= variants {
        revert_error(Panic::from(PANIC_ENUM_CONVERSION))
    }
    value
}

/// Copy an offer (`consideration: false`) or consideration array into the
/// pool at `start`.
fn fill_items(_ items: mut MemArray<Item>, start: usize, input: CalldataView, consideration: bool) {
    let stride: u256 = if consideration { 192 } else { 160 }
    var i: usize = 0
    let len = input.len() as usize
    while i < len {
        let item = input.element(index: i as u256, stride)
        let recipient = if consideration {
            item.address(160)
        } else {
            Address::zero()
        }
        items[start + i] = Item {
            item_type: item.word(0),
            token: item.address(32),
            identifier: item.word(64),
            start_amount: item.word(96),
            end_amount: item.word(128),
            recipient,
            amount: item.word(96),
            receiver: recipient,
            original: 0,
        }
        i += 1
    }
}

/// `_decodeAdvancedOrders`, `_decodeOrdersAsAdvancedOrders` and their
/// single-order forms: `count` orders, element `i` of the array `input` (or
/// `input` itself when `single`), as `AdvancedOrder`s (`advanced`) or
/// `Order`s.
fn build_book(_ input: CalldataView, count: usize, advanced: bool, single: bool) -> Book {
    var total: usize = 0
    var i: usize = 0
    while i < count {
        let order = if single {
            input
        } else {
            input.dynamic_element(i as u256)
        }
        let p = order.child(0)
        total += (p.child(64).len() + p.child(96).len()) as usize
        i += 1
    }
    // Every order and item is assigned below before the Book is returned.
    var states = unsafe {
        MemArray<OrderState>::new_uninit(count)
    }
    var items = unsafe {
        MemArray<Item>::new_uninit(total)
    }
    var start: usize = 0
    i = 0
    while i < count {
        let order = if single {
            input
        } else {
            input.dynamic_element(i as u256)
        }
        let p = order.child(0)
        let offer = p.child(64)
        let consideration = p.child(96)
        let consideration_start = start + offer.len() as usize
        fill_items(mut items, start, input: offer, consideration: false)
        fill_items(
            mut items,
            start: consideration_start,
            input: consideration,
            consideration: true,
        )
        states[i] = OrderState {
            offerer: p.address(0),
            zone: p.address(32),
            offer_start: start as u256,
            offer_len: offer.len(),
            consideration_start: consideration_start as u256,
            consideration_len: consideration.len(),
            order_type: p.word(128),
            start_time: p.word(160),
            end_time: p.word(192),
            zone_hash: p.word(224),
            salt: p.word(256),
            conduit_key: p.word(288),
            total_original: p.word(320),
            numerator: if advanced {
                order.word(32) & 0xffffffffffffffffffffffffffffff
            } else {
                1
            },
            denominator: if advanced {
                order.word(64) & 0xffffffffffffffffffffffffffffff
            } else {
                1
            },
            signature: order.child(if advanced { 96 } else { 32 }),
            extra_data: if advanced {
                order.child(128)
            } else {
                CalldataView::empty()
            },
            params: p,
        }
        start = consideration_start + consideration.len() as usize
        i += 1
    }
    Book { orders: states, items, used: total as u256 }
}

/// The orders of the `AdvancedOrder[]` (`advanced`) or `Order[]` at `input`.
pub fn orders_book(_ input: CalldataView, advanced: bool) -> Book {
    build_book(
        input,
        count: input.len() as usize,
        advanced,
        single: false,
    )
}

/// The `AdvancedOrder` (`advanced`) or `Order` at `input`.
pub fn single_order(_ input: CalldataView, advanced: bool) -> Book {
    build_book(input, count: 1, advanced, single: true)
}

/// `_decodeCriteriaResolvers`
pub fn resolvers(_ input: CalldataView) -> Resolvers {
    let n = input.len() as usize
    var total: usize = 0
    var i: usize = 0
    while i < n {
        total += input.dynamic_element(i as u256).child(128).len() as usize
        i += 1
    }
    var out = Resolvers {
        list: unsafe {
            MemArray<Resolver>::new_uninit(n)
        },
        proofs: unsafe {
            MemArray<u256>::new_uninit(total)
        },
    }
    var start: usize = 0
    i = 0
    while i < n {
        let r = input.dynamic_element(i as u256)
        let proof = r.child(128)
        let len = proof.len() as usize
        var j: usize = 0
        while j < len {
            out.proofs[start + j] = proof.element(index: j as u256, stride: 32).word(0)
            j += 1
        }
        out.list[i] = Resolver {
            order_index: r.word(0),
            side: r.word(32),
            index: r.word(64),
            identifier: r.word(96),
            proof_start: start as u256,
            // `_decodeCriteriaProof` copies the raw length word.
            proof_len: proof.word(0),
        }
        start += len
        i += 1
    }
    out
}

pub fn no_resolvers() -> Resolvers {
    Resolvers { list: MemArray<Resolver>::new_zeroed(0), proofs: MemArray<u256>::new_zeroed(0) }
}

/// `_decodeFulfillmentComponents` into group `index` at `start`.
fn group_components(
    _ groups: mut Groups,
    index: usize,
    start: usize,
    items: CalldataView,
) -> usize {
    let len = items.len() as usize
    var i: usize = 0
    while i < len {
        let c = items.element(index: i as u256, stride: 64)
        groups.components[start + i] = Component { order_index: c.word(0), item_index: c.word(32) }
        i += 1
    }
    groups.list[index] = Group { start: start as u256, len: len as u256 }
    start + len
}

/// `FulfillmentComponent[][]` as groups of one component pool.
pub fn nested_components(_ nested: CalldataView) -> Groups {
    let n = nested.len() as usize
    var total: usize = 0
    var i: usize = 0
    while i < n {
        total += nested.dynamic_element(i as u256).len() as usize
        i += 1
    }
    var groups = Groups {
        list: unsafe {
            MemArray<Group>::new_uninit(n)
        },
        components: unsafe {
            MemArray<Component>::new_uninit(total)
        },
    }
    var start: usize = 0
    i = 0
    while i < n {
        start = group_components(
            mut groups,
            index: i,
            start,
            items: nested.dynamic_element(i as u256),
        )
        i += 1
    }
    groups
}

/// `Fulfillment[]` as pairs of groups (offer at `2 * i`, consideration at
/// `2 * i + 1`).
pub fn fulfillments(_ input: CalldataView) -> Groups {
    let n = input.len() as usize
    var total: usize = 0
    var i: usize = 0
    while i < n {
        let f = input.dynamic_element(i as u256)
        total += (f.child(0).len() + f.child(32).len()) as usize
        i += 1
    }
    var groups = Groups {
        list: unsafe {
            MemArray<Group>::new_uninit(2 * n)
        },
        components: unsafe {
            MemArray<Component>::new_uninit(total)
        },
    }
    var start: usize = 0
    i = 0
    while i < n {
        let f = input.dynamic_element(i as u256)
        start = group_components(mut groups, index: 2 * i, start, items: f.child(0))
        start = group_components(mut groups, index: 2 * i + 1, start, items: f.child(32))
        i += 1
    }
    groups
}
