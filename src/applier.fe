// FulfillmentApplier: aggregate fulfillment components into executions.
use std::evm::{Address, Ctx, Panic, PANIC_OVERFLOW, revert_error}
use std::evm::keccak_words
use super::arr::Arr
use super::errors::{
    InvalidFulfillmentComponentData,
    MismatchedFulfillmentOfferAndConsiderationComponents,
    MissingFulfillmentComponentOnAggregation,
    MissingItemAmount,
    OfferAndConsiderationRequiredOnFulfillment,
}
use super::model::{Book, Component, Group, Groups, Item, OrderState}
use super::types::OFFER

/// An `Execution`: a `ReceivedItem` plus the source and conduit key.
pub struct ExecutionState {
    pub item_type: u256,
    pub token: Address,
    pub identifier: u256,
    pub amount: u256,
    pub recipient: Address,
    pub offerer: Address,
    pub conduit_key: u256,
}

impl Copy for ExecutionState {}

pub fn empty_execution() -> ExecutionState {
    ExecutionState {
        item_type: 0,
        token: Address::zero(),
        identifier: 0,
        amount: 0,
        recipient: Address::zero(),
        offerer: Address::zero(),
        conduit_key: 0,
    }
}

fn raise_aggregation_errors(_ error_buffer: u256) {
    if error_buffer != 0 {
        if error_buffer == 1 {
            revert_error(MissingItemAmount {})
        }
        revert_error(Panic::from(PANIC_OVERFLOW))
    }
}

/// `_aggregateValidFulfillmentOfferItems`: sum the referenced offer items of
/// available orders, zeroing them. All of them must share type, token,
/// identifier, offerer and conduit key. Also returns the index of the first
/// used component, which seaport-core moves to the front of the array.
pub fn aggregate_offer_items(_ book: Book, groups: Groups, group: Group, recipient: Address) -> (
    ExecutionState,
    u256,
) {
    let mut execution = empty_execution()
    let mut first_used: u256 = 0
    let mut amount: u256 = 0
    let mut error_buffer: u256 = 0
    let mut data_hash: u256 = 0
    let mut k: u256 = 0
    while k < group.len {
        let component = unsafe {
            *groups.components.at(group.start + k)
        }
        if component.order_index >= book.orders.len() {
            revert_error(InvalidFulfillmentComponentData {})
        }
        let order = unsafe {
            ref *book.order(component.order_index)
        }
        if component.item_index < order.offer_len && order.numerator != 0 {
            let item = unsafe {
                mut *book.offer_item(order, component.item_index)
            }
            let new_amount = amount.wrapping_add(item.amount)
            if new_amount < amount {
                error_buffer = error_buffer | 2
            }
            if item.amount == 0 {
                error_buffer = error_buffer | 1
            }
            amount = new_amount
            item.amount = 0
            if data_hash == 0 {
                execution.item_type = item.item_type
                execution.token = item.token
                execution.identifier = item.identifier
                execution.recipient = recipient
                execution.offerer = order.offerer
                execution.conduit_key = order.conduit_key
                data_hash = keccak_words([item.item_type, item.token.inner, item.identifier])
                first_used = k
            } else if order.offerer != execution.offerer
                || order.conduit_key != execution.conduit_key
                || data_hash != keccak_words([item.item_type, item.token.inner, item.identifier]) {
                revert_error(InvalidFulfillmentComponentData {})
            }
        }
        k += 1
    }
    execution.amount = amount
    raise_aggregation_errors(error_buffer)
    (execution, first_used)
}

/// `_aggregateValidFulfillmentConsiderationItems`: like the offer side, but
/// items must also share the recipient; offerer and conduit key are given.
pub fn aggregate_consideration_items(
    _ book: Book,
    groups: Groups,
    group: Group,
    offerer: Address,
    conduit_key: u256,
) -> (ExecutionState, u256) {
    let mut execution = empty_execution()
    let mut first_used: u256 = 0
    let mut amount: u256 = 0
    let mut error_buffer: u256 = 0
    let mut data_hash: u256 = 0
    let mut k: u256 = 0
    while k < group.len {
        let component = unsafe {
            *groups.components.at(group.start + k)
        }
        if component.order_index >= book.orders.len() {
            revert_error(InvalidFulfillmentComponentData {})
        }
        let order = unsafe {
            ref *book.order(component.order_index)
        }
        if component.item_index < order.consideration_len && order.numerator != 0 {
            let item = unsafe {
                mut *book.consideration_item(order, component.item_index)
            }
            let new_amount = amount.wrapping_add(item.amount)
            if new_amount < amount {
                error_buffer = error_buffer | 2
            }
            if item.amount == 0 {
                error_buffer = error_buffer | 1
            }
            amount = new_amount
            item.amount = 0
            let item_hash = keccak_words(
                [item.item_type, item.token.inner, item.identifier, 0, item.receiver.inner],
            )
            if data_hash == 0 {
                execution.item_type = item.item_type
                execution.token = item.token
                execution.identifier = item.identifier
                execution.recipient = item.receiver
                execution.offerer = offerer
                execution.conduit_key = conduit_key
                data_hash = item_hash
                first_used = k
            } else if data_hash != item_hash {
                revert_error(InvalidFulfillmentComponentData {})
            }
        }
        k += 1
    }
    execution.amount = amount
    raise_aggregation_errors(error_buffer)
    (execution, first_used)
}

/// `_applyFulfillment`: match aggregated offer items against aggregated
/// consideration items; the unmatched rest stays on the first used
/// component.
pub fn apply_fulfillment(_ book: Book, groups: Groups, fulfillment_index: u256) -> ExecutionState {
    let offer_group = unsafe {
        *groups.list.at(2 * fulfillment_index)
    }
    let consideration_group = unsafe {
        *groups.list.at(2 * fulfillment_index + 1)
    }
    if offer_group.len == 0 || consideration_group.len == 0 {
        revert_error(OfferAndConsiderationRequiredOnFulfillment {})
    }
    let (consideration, consideration_first) = aggregate_consideration_items(
        book,
        groups,
        group: consideration_group,
        offerer: Address::zero(),
        conduit_key: 0,
    )
    if consideration.amount == 0 {
        return consideration
    }
    let (offered, offer_first) = aggregate_offer_items(
        book,
        groups,
        group: offer_group,
        recipient: consideration.recipient,
    )
    let mut execution = offered
    if execution.item_type != consideration.item_type
        || execution.token != consideration.token
        || execution.identifier != consideration.identifier {
        revert_error(
            MismatchedFulfillmentOfferAndConsiderationComponents {
                fulfillmentIndex: fulfillment_index,
            },
        )
    }
    if consideration.amount > execution.amount {
        let target = unsafe {
            *groups.components.at(consideration_group.start + consideration_first)
        }
        let order = unsafe {
            ref *book.order(target.order_index)
        }
        let item = unsafe {
            mut *book.consideration_item(order, target.item_index)
        }
        item.amount = consideration.amount - execution.amount
    } else {
        let target = unsafe {
            *groups.components.at(offer_group.start + offer_first)
        }
        let order = unsafe {
            ref *book.order(target.order_index)
        }
        let item = unsafe {
            mut *book.offer_item(order, target.item_index)
        }
        item.amount = execution.amount - consideration.amount
        execution.amount = consideration.amount
    }
    execution
}

/// `_aggregateAvailable`
pub fn aggregate_available(
    _ book: Book,
    side: u8,
    groups: Groups,
    index: u256,
    fulfiller_conduit_key: u256,
    recipient: Address,
) -> ExecutionState
uses (ctx: Ctx)
{
    let group = unsafe {
        *groups.list.at(index)
    }
    if group.len == 0 {
        revert_error(MissingFulfillmentComponentOnAggregation { side })
    }
    if side == OFFER {
        let (execution, _) = aggregate_offer_items(book, groups, group, recipient)
        return execution
    }
    let (execution, _) = aggregate_consideration_items(
        book,
        groups,
        group,
        offerer: ctx.caller(),
        conduit_key: fulfiller_conduit_key,
    )
    execution
}
