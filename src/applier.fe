// SPDX-License-Identifier: MIT
// FulfillmentApplier: aggregate fulfillment components into executions.
#![arithmetic(unchecked)]
use std::evm::{Address, Ctx, Panic, PANIC_OVERFLOW}
use super::raw_abi::{error_selector, revert_with0, revert_with1}
use super::errors::{
    InvalidFulfillmentComponentData,
    MismatchedFulfillmentOfferAndConsiderationComponents,
    MissingFulfillmentComponentOnAggregation,
    MissingItemAmount,
    OfferAndConsiderationRequiredOnFulfillment,
}
use super::model::{Book, Group, Groups, elem}
use super::types::OFFER

/// An `Execution`: a `ReceivedItem` plus the source and conduit key.
pub struct ExecutionState {
    pub item_type: u256,
    pub token: Address,
    pub identifier: u256,
    pub amount: u256,
    pub recipient: Address,
    pub offerer: Address,
    pub conduit_key: u256,
}

impl Copy for ExecutionState {}

pub fn empty_execution() -> ExecutionState {
    ExecutionState {
        item_type: 0,
        token: Address::zero(),
        identifier: 0,
        amount: 0,
        recipient: Address::zero(),
        offerer: Address::zero(),
        conduit_key: 0,
    }
}

fn raise_aggregation_errors(_ error_buffer: u256) {
    if error_buffer != 0 {
        if error_buffer == 1 {
            revert_with0(error_selector<MissingItemAmount>())
        }
        revert_with1(error_selector<Panic>(), PANIC_OVERFLOW)
    }
}

/// `_aggregateValidFulfillmentOfferItems` or, for `consideration`,
/// `_aggregateValidFulfillmentConsiderationItems`: sum the referenced items of
/// available orders, zeroing them. All of them must share type, token and
/// identifier, offer items also offerer and conduit key, and consideration
/// items also the recipient; the other execution fields are given. Comparing
/// these fields is equivalent to comparing seaport-core's hashes of them. Also
/// returns the index of the first used component, which seaport-core moves to
/// the front of the array.
pub fn aggregate_items(
    _ book: mut Book,
    group: Group,
    consideration: bool,
    offerer: Address,
    conduit_key: u256,
    recipient: Address,
) -> (ExecutionState, u256) {
    var execution = empty_execution()
    var found = false
    var first_used: u256 = 0
    var amount: u256 = 0
    var error_buffer: u256 = 0
    var k: u256 = 0
    while k < group.len() {
        let component = group.component(k)
        if component.order_index >= book.orders.len() as u256 {
            revert_with0(error_selector<InvalidFulfillmentComponentData>())
        }
        // The order index was checked above.
        let order = unsafe {
            ref *elem(book.orders.ptr(), component.order_index)
        }
        let (start, len) = if consideration {
            (order.consideration_start, order.consideration_len)
        } else {
            (order.offer_start, order.offer_len)
        }
        if component.item_index < len && order.numerator != 0 {
            // The item index lies in the order's range of the pool.
            let item = unsafe {
                mut *elem(book.items.ptr(), start + component.item_index)
            }
            let new_amount = amount + item.amount
            if new_amount < amount {
                error_buffer = error_buffer | 2
            }
            if item.amount == 0 {
                error_buffer = error_buffer | 1
            }
            amount = new_amount
            item.amount = 0
            let next = ExecutionState {
                item_type: item.item_type,
                token: item.token,
                identifier: item.identifier,
                amount: 0,
                recipient: if consideration {
                    item.receiver
                } else {
                    recipient
                },
                offerer: if consideration {
                    offerer
                } else {
                    order.offerer
                },
                conduit_key: if consideration {
                    conduit_key
                } else {
                    order.conduit_key
                },
            }
            if !found {
                execution = next
                found = true
                first_used = k
            } else if next.item_type != execution.item_type
                || next.token != execution.token
                || next.identifier != execution.identifier
                || next.recipient != execution.recipient
                || next.offerer != execution.offerer
                || next.conduit_key != execution.conduit_key {
                revert_with0(error_selector<InvalidFulfillmentComponentData>())
            }
        }
        k += 1
    }
    execution.amount = amount
    raise_aggregation_errors(error_buffer)
    (execution, first_used)
}

/// `_applyFulfillment`: match aggregated offer items against aggregated
/// consideration items; the unmatched rest stays on the first used
/// component.
pub fn apply_fulfillment(
    _ book: mut Book,
    groups: Groups,
    fulfillment_index: u256,
) -> ExecutionState {
    let offer_group = groups.group(2 * fulfillment_index)
    let consideration_group = groups.group(2 * fulfillment_index + 1)
    if offer_group.len() == 0 || consideration_group.len() == 0 {
        revert_with0(
            error_selector<OfferAndConsiderationRequiredOnFulfillment>(),
        )
    }
    let (consideration, consideration_first) = aggregate_items(
        mut book,
        group: consideration_group,
        consideration: true,
        offerer: Address::zero(),
        conduit_key: 0,
        recipient: Address::zero(),
    )
    if consideration.amount == 0 {
        return consideration
    }
    let (offered, offer_first) = aggregate_items(
        mut book,
        group: offer_group,
        consideration: false,
        offerer: Address::zero(),
        conduit_key: 0,
        recipient: consideration.recipient,
    )
    var execution = offered
    if execution.item_type != consideration.item_type
        || execution.token != consideration.token
        || execution.identifier != consideration.identifier {
        revert_with1(
            error_selector<MismatchedFulfillmentOfferAndConsiderationComponents>(),
            fulfillment_index,
        )
    }
    // The unmatched rest stays on the first used item of the larger side.
    let consideration_left = consideration.amount > execution.amount
    let target = if consideration_left {
        consideration_group.component(consideration_first)
    } else {
        offer_group.component(offer_first)
    }
    // Aggregation checked both indexes of the first used component.
    let order = unsafe {
        ref *elem(book.orders.ptr(), target.order_index)
    }
    let start = if consideration_left {
        order.consideration_start
    } else {
        order.offer_start
    }
    let item = unsafe {
        mut *elem(book.items.ptr(), start + target.item_index)
    }
    if consideration_left {
        item.amount = consideration.amount - execution.amount
    } else {
        item.amount = execution.amount - consideration.amount
        execution.amount = consideration.amount
    }
    execution
}

/// `_aggregateAvailable`
pub fn aggregate_available(
    _ book: mut Book,
    side: u8,
    groups: Groups,
    index: u256,
    fulfiller_conduit_key: u256,
    recipient: Address,
) -> ExecutionState
uses (ctx: Ctx)
{
    let group = groups.group(index)
    if group.len() == 0 {
        revert_with1(
            error_selector<MissingFulfillmentComponentOnAggregation>(),
            side as u256,
        )
    }
    let (execution, _) = aggregate_items(
        mut book,
        group,
        consideration: side != OFFER,
        offerer: ctx.caller(),
        conduit_key: fulfiller_conduit_key,
        recipient,
    )
    execution
}
