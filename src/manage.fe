// OrderValidator._cancel and _validate.
use core::abi::store_word
use core::ptr
use std::abi::Bytes32
use std::evm::{TSlot, Call, Ctx, Event, Log, RawOps, revert_empty, revert_error}
use super::abi_view::CalldataView
use super::errors::{
    CannotCancelOrder,
    ConsiderationLengthNotEqualToTotalOriginal,
    OrderCancelled,
    OrderValidated,
}
use super::fulfill::consideration_length_checked_order_hash
use super::hashing::{Env, derive_components_hash}
use super::model::{Book, OrderState, checked_enum, orders_book}
use super::signature::verify_signature
use super::status::{
    OrderStore,
    assert_non_reentrant,
    read_status,
    set_cancelled,
    set_validated,
    verify_order_status,
}
use super::types::CONTRACT

/// `_cancel`: only the offerer or the zone may cancel; contract orders
/// cannot be cancelled. The fields read through Solidity's typed calldata
/// accessors get their checks; the hash covers the raw words.
#[arithmetic(unchecked)]
pub fn cancel(_ env: Env, orders: CalldataView) -> bool
uses (
    store: mut OrderStore,
    guard_state: u256,
    transient_guard: TSlot<u256>,
    ctx: Ctx,
    log: mut Log,
)
{
    assert_non_reentrant(env)
    var any_invalid = false
    var i: u256 = 0
    let len = orders.len()
    while i < len {
        let order = orders.components_element(i)
        let offerer = order.checked_address(0)
        let zone = order.checked_address(32)
        let order_type = order.word(128)
        if order_type > 4 {
            revert_empty()
        }
        if order_type == CONTRACT as u256 || (ctx.caller() != offerer && ctx.caller() != zone) {
            any_invalid = true
        }
        let order_hash = derive_components_hash(order)
        set_cancelled(order_hash)
        log.emit(
            OrderCancelled { orderHash: Bytes32 { val: order_hash }, offerer, zone },
        )
        i += 1
    }
    if any_invalid {
        revert_error(CannotCancelOrder {})
    }
    true
}

/// `_validate`: mark signed orders as validated so that later fulfillments
/// skip signature verification. Seaport decodes all orders first.
pub fn validate(_ env: Env, orders: CalldataView) -> bool
uses (
    store: mut OrderStore,
    guard_state: u256,
    transient_guard: TSlot<u256>,
    ctx: Ctx,
    call: Call,
    ops: mut RawOps,
    log: mut Log,
)
{
    let book = orders_book(orders, advanced: false)
    assert_non_reentrant(env)
    var i: usize = 0
    while i < book.orders.len() {
        let order = ref book.orders[i]
        if checked_enum(order.order_type, variants: 5) != CONTRACT as u256 {
            let order_hash = consideration_length_checked_order_hash(order)
            let status = read_status(order_hash)
            verify_order_status(
                order_hash,
                status,
                only_allow_unused: false,
                revert_on_invalid: true,
            )
            if !status.is_validated {
                if order.consideration_len != order.total_original {
                    revert_error(ConsiderationLengthNotEqualToTotalOriginal {})
                }
                verify_signature(
                    env,
                    offerer: order.offerer,
                    order_hash,
                    signature: order.signature,
                )
                set_validated(order_hash)
                emit_order_validated(book, order, order_hash)
            }
        }
        i += 1
    }
    true
}

/// `OrderValidated(orderHash, orderParameters)` from the unchanged order, as
/// Solidity encodes Seaport's memory copy: addresses cleaned (the model holds
/// them so) and item types checked.
#[arithmetic(unchecked)]
fn emit_order_validated(_ book: Book, _ order: OrderState, order_hash: u256)
uses (log: mut Log)
{
    let consideration_at = 0x1c0 + order.offer_len * 160
    let size = consideration_at + 32 + order.consideration_len * 192
    let data = ptr::alloc_bytes(size)
    // Every word of the `size` bytes allocated above is written.
    unsafe {
        store_word(ptr: data, value: order_hash)
        store_word(ptr: ptr::offset_bytes(data, 0x20), value: 0x40)
        store_word(
            ptr: ptr::offset_bytes(data, 0x40),
            value: order.offerer.word(),
        )
        store_word(
            ptr: ptr::offset_bytes(data, 0x60),
            value: order.zone.word(),
        )
        store_word(ptr: ptr::offset_bytes(data, 0x80), value: 0x160)
        store_word(
            ptr: ptr::offset_bytes(data, 0xa0),
            value: consideration_at - 0x40,
        )
        store_word(
            ptr: ptr::offset_bytes(data, 0xc0),
            value: order.order_type,
        )
        store_word(
            ptr: ptr::offset_bytes(data, 0xe0),
            value: order.start_time,
        )
        store_word(ptr: ptr::offset_bytes(data, 0x100), value: order.end_time)
        store_word(
            ptr: ptr::offset_bytes(data, 0x120),
            value: order.zone_hash,
        )
        store_word(ptr: ptr::offset_bytes(data, 0x140), value: order.salt)
        store_word(
            ptr: ptr::offset_bytes(data, 0x160),
            value: order.conduit_key,
        )
        store_word(
            ptr: ptr::offset_bytes(data, 0x180),
            value: order.total_original,
        )
    }
    write_items(
        ptr::offset_bytes(data, 0x1a0),
        book,
        start: order.offer_start,
        count: order.offer_len,
        consideration: false,
    )
    write_items(
        ptr::offset_bytes(data, consideration_at),
        book,
        start: order.consideration_start,
        count: order.consideration_len,
        consideration: true,
    )
    log.log1(
        data: unsafe {
            ptr::MemSpan::from_raw_parts(ptr: data, len: size as usize)
        },
        topic0: OrderValidated::TOPIC0,
    )
}

/// The ABI array of `count` items of `book` from `start`, written to `out`,
/// which must have room for it.
#[arithmetic(unchecked)]
fn write_items(_ out: *u8, _ book: Book, start: u256, count: u256, consideration: bool) {
    let stride: u256 = if consideration { 192 } else { 160 }
    unsafe {
        store_word(ptr: out, value: count)
    }
    var i: u256 = 0
    while i < count {
        let item = ref book.items[(start + i) as usize]
        let at = ptr::offset_bytes(out, 32 + i * stride)
        unsafe {
            store_word(ptr: at, value: checked_enum(item.item_type, variants: 6))
            store_word(ptr: ptr::offset_bytes(at, 32), value: item.token.word())
            store_word(ptr: ptr::offset_bytes(at, 64), value: item.identifier)
            store_word(ptr: ptr::offset_bytes(at, 96), value: item.start_amount)
            store_word(ptr: ptr::offset_bytes(at, 128), value: item.end_amount)
            if consideration {
                store_word(
                    ptr: ptr::offset_bytes(at, 160),
                    value: item.recipient.word(),
                )
            }
        }
        i += 1
    }
}
