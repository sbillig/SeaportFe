// OrderValidator._cancel and _validate.
use std::abi::{Bytes32, DynArray}
use std::evm::{Call, Ctx, Log, RawOps, revert_error}
use super::errors::{CannotCancelOrder, ConsiderationLengthNotEqualToTotalOriginal, OrderCancelled, OrderValidated}
use super::fulfill::consideration_length_checked_order_hash
use super::hashing::{Env, derive_order_hash}
use super::model::{boxed, from_components, from_order}
use super::signature::verify_signature
use super::status::{assert_non_reentrant, read_status, set_cancelled, set_validated, verify_order_status}
use super::types::{CONTRACT, Order, OrderComponents}

/// `_cancel`: only the offerer or the zone may cancel; contract orders
/// cannot be cancelled.
pub fn cancel(_ env: Env, orders: DynArray<OrderComponents>) -> bool uses (ctx: Ctx, ops: mut RawOps, log: mut Log) {
    assert_non_reentrant(env)
    let mut any_invalid = false
    let mut i: u256 = 0
    while i < orders.len() {
        let (order, counter) = from_components(orders.get(i))
        if order.order_type == CONTRACT as u256 || (ctx.caller() != order.offerer && ctx.caller() != order.zone) {
            any_invalid = true
        }
        let order_hash = derive_order_hash(order, counter)
        set_cancelled(order_hash)
        log.emit(OrderCancelled { orderHash: Bytes32 { val: order_hash }, offerer: order.offerer, zone: order.zone })
        i += 1
    }
    if any_invalid {
        revert_error(CannotCancelOrder {})
    }
    true
}

/// `_validate`: mark signed orders as validated so that later fulfillments
/// skip signature verification.
pub fn validate(_ env: Env, orders: DynArray<Order>) -> bool uses (ctx: Ctx, call: Call, ops: mut RawOps, log: mut Log) {
    assert_non_reentrant(env)
    let mut i: u256 = 0
    while i < orders.len() {
        let order = boxed(from_order(orders.get(i)))
        if order.order_type != CONTRACT as u256 {
            let order_hash = consideration_length_checked_order_hash(order)
            let status = read_status(order_hash)
            verify_order_status(order_hash, status, only_allow_unused: false, revert_on_invalid: true)
            if !status.is_validated {
                if order.consideration.len() != order.total_original {
                    revert_error(ConsiderationLengthNotEqualToTotalOriginal {})
                }
                verify_signature(env, offerer: order.offerer, order_hash, signature: order.signature)
                set_validated(order_hash)
                log.emit(OrderValidated { orderHash: Bytes32 { val: order_hash }, orderParameters: orders.get(i).parameters })
            }
        }
        i += 1
    }
    true
}
