use core::abi::{AbiSize, Encode}
use core::ptr::MemBuffer
use std::abi::{Bytes, Bytes32, DynArray, Sol, dyn_array_from, sol::Uint120}
use std::evm::{Address, Evm, encode_abi_payload}
use super::abi_view::CalldataView
use super::applier::aggregate_offer_items
use super::model::{nested_components, orders_book, single_order}
use super::types::{
    AdvancedOrder,
    ConsiderationItem,
    FulfillmentComponent,
    OfferItem,
    Order,
    OrderParameters,
}

/// A two-element ABI array of non-Copy records. The tuple encoding of the
/// pair is exactly the element section of the array's ABI tail.
fn pair<T>(_ values: own (T, T)) -> DynArray<T> where T: Encode<Sol> + AbiSize {
    let elements = encode_abi_payload(values)
    var data = MemBuffer::alloc(32 + elements.len())
    data.write_word(offset: 0, value: 2)
    data.copy_from(dest_offset: 32, elements.span())
    // A complete ABI tail: the length word followed by the pair's encoding.
    unsafe {
        DynArray::from_abi_tail(data: data.ptr(), len: 2, size: data.len() as u256)
    }
}

fn order(_ identifier: u256, amount: u256) -> AdvancedOrder {
    AdvancedOrder {
        parameters: OrderParameters {
            offerer: Address::new(0xabc),
            zone: Address::zero(),
            offer: dyn_array_from(
                [
                    OfferItem {
                        itemType: 2,
                        token: Address::new(0x123),
                        identifierOrCriteria: identifier,
                        startAmount: amount,
                        endAmount: amount,
                    },
                ],
            ),
            consideration: DynArray<ConsiderationItem>::empty(),
            orderType: 0,
            startTime: 0,
            endTime: 123,
            zoneHash: Bytes32 { val: 0 },
            salt: 7,
            conduitKey: Bytes32 { val: 0 },
            totalOriginalConsiderationItems: 0,
        },
        numerator: Uint120 { val: 1 },
        denominator: Uint120 { val: 1 },
        signature: Bytes::from_word_prefix(word: identifier << 248, len: 1),
        extraData: Bytes::from_word_prefix(word: amount << 248, len: 1),
    }
}

/// The model builders read their call's arguments, so each case runs in a
/// harness call whose calldata the typed `ModelCalls` encode.
msg ModelCalls {
    #[selector = 0x01]
    Single { order: AdvancedOrder } -> bool,
    #[selector = 0x02]
    Advanced { orders: DynArray<AdvancedOrder> } -> bool,
    #[selector = 0x03]
    Repeated { order: AdvancedOrder, groups: DynArray<DynArray<FulfillmentComponent>> } -> bool,
    #[selector = 0x04]
    Empty { advanced: DynArray<AdvancedOrder>, regular: DynArray<Order> } -> bool,
    #[selector = 0x05]
    Regular { orders: DynArray<Order> } -> bool,
}

msg ModelHarnessMsg {
    #[selector = 0x01]
    Single {} -> bool,
    #[selector = 0x02]
    Advanced {} -> bool,
    #[selector = 0x03]
    Repeated {} -> bool,
    #[selector = 0x04]
    Empty {} -> bool,
    #[selector = 0x05]
    Regular {} -> bool,
}

pub contract ModelHarness {
    recv ModelHarnessMsg {
        Single {} -> bool {
            let args = CalldataView::arguments(32)
            var book = single_order(args.struct_argument(offset: 0, size: 160), advanced: true)
            let descriptor = ref book.orders[0]
            book.items[descriptor.offer_start as usize].amount = 11
            assert(descriptor.offer_len == 1)
            assert(descriptor.signature.byte_at(0) == 4)
            assert(descriptor.extra_data.byte_at(0) == 7)
            assert(book.items[0].amount == 11)
            assert(book.items[0].start_amount == 7)
            true
        }
        Advanced {} -> bool {
            var book = orders_book(
                CalldataView::arguments(32).array_argument(0),
                advanced: true,
            )
            assert(book.used == 2)
            assert(book.orders[0].offer_start == 0)
            assert(book.orders[1].offer_start == 1)
            let second = ref book.orders[1]
            book.items[second.offer_start as usize].identifier = 99
            assert(second.signature.byte_at(0) == 5)
            assert(second.extra_data.byte_at(0) == 13)
            assert(book.items[0].identifier == 4)
            assert(book.items[1].identifier == 99)
            true
        }
        Repeated {} -> bool {
            let args = CalldataView::arguments(64)
            var book = single_order(args.struct_argument(offset: 0, size: 160), advanced: true)
            let groups = nested_components(args.array_argument(32))
            let _ = aggregate_offer_items(
                mut book,
                groups,
                group: ref groups.list[0],
                recipient: Address::new(0xdef),
            )
            true
        }
        Empty {} -> bool {
            let args = CalldataView::arguments(64)
            let advanced = orders_book(args.array_argument(0), advanced: true)
            assert(advanced.orders.len() == 0)
            assert(advanced.items.len() == 0)
            assert(advanced.used == 0)
            let regular = orders_book(args.array_argument(32), advanced: false)
            assert(regular.orders.len() == 0)
            assert(regular.items.len() == 0)
            assert(regular.used == 0)
            true
        }
        Regular {} -> bool {
            let book = orders_book(
                CalldataView::arguments(32).array_argument(0),
                advanced: false,
            )
            assert(book.used == 2)
            assert(book.orders[0].offer_start == 0)
            assert(book.orders[1].offer_start == 1)
            assert(book.orders[0].signature.byte_at(0) == 4)
            assert(book.orders[1].signature.byte_at(0) == 5)
            assert(book.orders[0].extra_data.len() == 0)
            assert(book.orders[1].extra_data.len() == 0)
            assert(book.orders[0].numerator == 1)
            assert(book.orders[1].denominator == 1)
            assert(book.items[0].amount == 7)
            assert(book.items[1].amount == 13)
            true
        }
    }
}

fn harness() -> Address uses (evm: mut Evm) {
    evm.create2<ModelHarness>(value: 0, args: (), salt: 0)
}

#[test]
fn owned_items_mutate_independently_of_order_views() uses (evm: mut Evm) {
    let ok: bool = evm
        .call(
            addr: harness(),
            gas: 10000000,
            value: 0,
            message: ModelCalls::Single { order: order(4, amount: 7) },
        )
    assert(ok)
}

#[test]
fn multiple_orders_keep_their_item_and_byte_ranges() uses (evm: mut Evm) {
    let ok: bool = evm
        .call(
            addr: harness(),
            gas: 10000000,
            value: 0,
            message: ModelCalls::Advanced {
                orders: pair((order(4, amount: 7), order(5, amount: 13))),
            },
        )
    assert(ok)
}

#[test(should_revert, selector = 0x91b3e514)]
fn repeated_fulfillment_indices_observe_prior_mutation() uses (evm: mut Evm) {
    let components = dyn_array_from(
        [
            FulfillmentComponent { orderIndex: 0, itemIndex: 0 },
            FulfillmentComponent { orderIndex: 0, itemIndex: 0 },
        ],
    )
    let ok: bool = evm
        .call(
            addr: harness(),
            gas: 10000000,
            value: 0,
            message: ModelCalls::Repeated {
                order: order(4, amount: 7),
                groups: dyn_array_from([components]),
            },
        )
    assert(ok)
}

#[test]
fn empty_order_batches_have_initialized_empty_pools() uses (evm: mut Evm) {
    let ok: bool = evm
        .call(
            addr: harness(),
            gas: 10000000,
            value: 0,
            message: ModelCalls::Empty {
                advanced: DynArray<AdvancedOrder>::empty(),
                regular: DynArray<Order>::empty(),
            },
        )
    assert(ok)
}

#[test]
fn regular_orders_initialize_signature_and_empty_extra_data()
uses (evm: mut Evm)
{
    let first = order(4, amount: 7)
    let second = order(5, amount: 13)
    let ok: bool = evm
        .call(
            addr: harness(),
            gas: 10000000,
            value: 0,
            message: ModelCalls::Regular {
                orders: pair(
                    (
                        Order { parameters: first.parameters, signature: first.signature },
                        Order { parameters: second.parameters, signature: second.signature },
                    ),
                ),
            },
        )
    assert(ok)
}
