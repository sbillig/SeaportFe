// SPDX-License-Identifier: MIT
// Solidity ABI structs of seaport-types/src/lib/ConsiderationStructs.sol.
//
// Enum fields (`ItemType`, `OrderType`, `Side`, `BasicOrderType`) are
// `uint8` on the wire and are kept as `u8`; see the constants below.
use std::abi::{Bytes, Bytes32, DynArray, sol::Uint120}
use std::evm::Address

// ItemType
pub const NATIVE: u8 = 0
pub const ERC20: u8 = 1
pub const ERC721: u8 = 2
pub const ERC1155: u8 = 3
pub const ERC721_WITH_CRITERIA: u8 = 4
pub const ERC1155_WITH_CRITERIA: u8 = 5

// OrderType
pub const FULL_OPEN: u8 = 0
pub const PARTIAL_OPEN: u8 = 1
pub const FULL_RESTRICTED: u8 = 2
pub const PARTIAL_RESTRICTED: u8 = 3
pub const CONTRACT: u8 = 4

// Side
pub const OFFER: u8 = 0
pub const CONSIDERATION: u8 = 1

#[abi]
pub struct OfferItem {
    pub itemType: u8,
    pub token: Address,
    pub identifierOrCriteria: u256,
    pub startAmount: u256,
    pub endAmount: u256,
}
impl Copy for OfferItem {}

#[abi]
pub struct ConsiderationItem {
    pub itemType: u8,
    pub token: Address,
    pub identifierOrCriteria: u256,
    pub startAmount: u256,
    pub endAmount: u256,
    pub recipient: Address,
}
impl Copy for ConsiderationItem {}

/// Output-only (events, zone and offerer calls, return values). `itemType`
/// is `uint8` in the event signatures; an invalid type always reverts later
/// in the transfer, so truncating the stored word is not observable.
#[abi]
pub struct SpentItem {
    pub itemType: u8,
    pub token: Address,
    pub identifier: u256,
    pub amount: u256,
}
impl Copy for SpentItem {}

/// Output-only, see `SpentItem`.
#[abi]
pub struct ReceivedItem {
    pub itemType: u8,
    pub token: Address,
    pub identifier: u256,
    pub amount: u256,
    pub recipient: Address,
}
impl Copy for ReceivedItem {}

#[abi]
pub struct OrderParameters {
    pub offerer: Address,
    pub zone: Address,
    pub offer: DynArray<OfferItem>,
    pub consideration: DynArray<ConsiderationItem>,
    pub orderType: u8,
    pub startTime: u256,
    pub endTime: u256,
    pub zoneHash: Bytes32,
    pub salt: u256,
    pub conduitKey: Bytes32,
    pub totalOriginalConsiderationItems: u256,
}

/// `OrderComponents` has the same shape as `OrderParameters`, with `counter`
/// in place of `totalOriginalConsiderationItems`.
#[abi]
pub struct OrderComponents {
    pub offerer: Address,
    pub zone: Address,
    pub offer: DynArray<OfferItem>,
    pub consideration: DynArray<ConsiderationItem>,
    pub orderType: u8,
    pub startTime: u256,
    pub endTime: u256,
    pub zoneHash: Bytes32,
    pub salt: u256,
    pub conduitKey: Bytes32,
    pub counter: u256,
}

#[abi]
pub struct Order {
    pub parameters: OrderParameters,
    pub signature: Bytes,
}

#[abi]
pub struct AdvancedOrder {
    pub parameters: OrderParameters,
    pub numerator: Uint120,
    pub denominator: Uint120,
    pub signature: Bytes,
    pub extraData: Bytes,
}

#[abi]
pub struct CriteriaResolver {
    pub orderIndex: u256,
    pub side: u8,
    pub index: u256,
    pub identifier: u256,
    pub criteriaProof: DynArray<Bytes32>,
}

#[abi]
pub struct FulfillmentComponent {
    pub orderIndex: u256,
    pub itemIndex: u256,
}
impl Copy for FulfillmentComponent {}

#[abi]
pub struct Fulfillment {
    pub offerComponents: DynArray<FulfillmentComponent>,
    pub considerationComponents: DynArray<FulfillmentComponent>,
}

#[abi]
pub struct Execution {
    pub item: ReceivedItem,
    pub offerer: Address,
    pub conduitKey: Bytes32,
}
impl Copy for Execution {}

/// `SpentItem` as decoded by zones (strict `uint8` item type).
#[abi]
pub struct ZoneSpentItem {
    pub itemType: u8,
    pub token: Address,
    pub identifier: u256,
    pub amount: u256,
}
impl Copy for ZoneSpentItem {}

/// `ReceivedItem` as decoded by zones (strict `uint8` item type).
#[abi]
pub struct ZoneReceivedItem {
    pub itemType: u8,
    pub token: Address,
    pub identifier: u256,
    pub amount: u256,
    pub recipient: Address,
}
impl Copy for ZoneReceivedItem {}

/// Incoming `ZoneParameters`; Seaport itself encodes zone calls by hand.
#[abi]
pub struct ZoneParameters {
    pub orderHash: Bytes32,
    pub fulfiller: Address,
    pub offerer: Address,
    pub offer: DynArray<ZoneSpentItem>,
    pub consideration: DynArray<ZoneReceivedItem>,
    pub extraData: Bytes,
    pub orderHashes: DynArray<Bytes32>,
    pub startTime: u256,
    pub endTime: u256,
    pub zoneHash: Bytes32,
}

#[abi]
pub struct AdditionalRecipient {
    pub amount: u256,
    pub recipient: Address,
}
impl Copy for AdditionalRecipient {}
