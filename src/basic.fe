// SPDX-License-Identifier: MIT
// BasicOrderFulfiller: `fulfillBasicOrder` reads its parameters directly
// from calldata at fixed offsets, like seaport-core, so that non-canonical
// encodings are rejected with `InvalidBasicOrderParameterEncoding`.
use std::evm::{TSlot, Address, Call, Ctx, Event, Log, RawOps, keccak_words, keccak256}
use super::raw_abi::{error_selector, revert_with0, revert_with1, revert_with2}
use super::abi_view::CalldataView
use super::buffer::Buffer
use super::errors::{
    InsufficientNativeTokensSupplied,
    InvalidBasicOrderParameterEncoding,
    InvalidMsgValue,
    InvalidTime,
    MissingOriginalConsiderationItems,
    OrderFulfilled,
    UnusedItemParameters,
}
use super::executor::{
    CONDUIT_ERC20,
    CONDUIT_ERC721,
    insert,
    new_accumulator,
    transfer_buffer,
    perform_transfer,
    transfer_token,
    transfer_native_tokens,
    trigger_if_armed,
    Accumulator,
}
use super::hashing::{CONSIDERATION_ITEM_TYPEHASH, Env, OFFER_ITEM_TYPEHASH, ORDER_TYPEHASH}
use super::signature::verify_signature
use super::status::{
    OrderStore,
    clear_reentrancy_guard,
    get_counter,
    read_status,
    set_basic_order_filled,
    set_reentrancy_guard,
    verify_order_status,
}
use super::types::{ERC721, ReceivedItem, SpentItem}
use super::zone::{
    AUTHORIZE_ORDER_SELECTOR,
    VALIDATE_ORDER_SELECTOR,
    call_and_check_status_with_skip,
    ensure_range,
    is_restricted_and_caller_not_zone,
}

// Calldata offsets of BasicOrderParameters (behind the selector and the
// struct offset word).
const CONSIDERATION_TOKEN: u256 = 0x24
const CONSIDERATION_IDENTIFIER: u256 = 0x44
const CONSIDERATION_AMOUNT: u256 = 0x64
const OFFERER: u256 = 0x84
const ZONE: u256 = 0xa4
const OFFER_TOKEN: u256 = 0xc4
const OFFER_IDENTIFIER: u256 = 0xe4
const OFFER_AMOUNT: u256 = 0x104
const BASIC_ORDER_TYPE: u256 = 0x124
const START_TIME: u256 = 0x144
const END_TIME: u256 = 0x164
const ZONE_HASH: u256 = 0x184
const SALT: u256 = 0x1a4
const OFFERER_CONDUIT_KEY: u256 = 0x1c4
const FULFILLER_CONDUIT_KEY: u256 = 0x1e4
const TOTAL_ORIGINAL_ADDITIONAL_RECIPIENTS: u256 = 0x204
const ADDITIONAL_RECIPIENTS_HEAD: u256 = 0x224
const SIGNATURE_HEAD: u256 = 0x244
const ADDITIONAL_RECIPIENTS_LENGTH: u256 = 0x264
const ADDITIONAL_RECIPIENTS_DATA: u256 = 0x284

const RECEIVED_ITEM_BYTE_MAP: u256 = 0x0000010102030000000000000000000000000000000000000000000000000000
const OFFERED_ITEM_BYTE_MAP: u256 = 0x0203020301010000000000000000000000000000000000000000000000000000

fn cd(_ offset: u256) -> u256 uses (ops: RawOps) {
    ops.calldataload(offset)
}

/// The address at `offset`, truncated to 160 bits.
/// `assert_valid_basic_order_parameters` and the additional recipients check
/// reject words with higher bits before any address read here is used, so
/// truncation keeps seaport-core's error precedence.
fn cd_address(_ offset: u256) -> Address uses (ops: RawOps) {
    Address::from_word_truncate(ops.calldataload(offset))
}

/// The bytes of a basic order's `OrderFulfilled` data with
/// `total_recipients` additional recipients. Checked, because the event's
/// unchecked stores rely on it; seaport-core runs out of gas on any count
/// that would overflow it.
fn order_fulfilled_size(_ total_recipients: u256) -> u256 {
    0x140 + (total_recipients + 1) * 160
}

#[arithmetic(unchecked)]
fn byte_at(_ index: u256, _ word: u256) -> u256 {
    if index >= 32 { return 0 }
    (word >> (248 - index * 8)) & 0xff
}

/// The ABI checks Solidity performs before running `fulfillBasicOrder` with
/// its `BasicOrderParameters calldata` argument.
#[arithmetic(unchecked)]
pub fn assert_decodable_basic_order_calldata() uses (ops: RawOps) {
    let size = ops.calldatasize()
    if size < 0x24 {
        std::evm::revert(())
    }
    let offset = cd(4)
    if offset > 0xffffffffffffffff || size - 4 < offset || size - 4 - offset < 0x240 {
        std::evm::revert(())
    }
}

/// `_assertValidBasicOrderParameters`: canonical offsets, a valid order
/// type and clean addresses.
#[arithmetic(unchecked)]
fn assert_valid_basic_order_parameters() uses (ops: RawOps) {
    let valid_offsets = cd(4) == 0x20
        && cd(ADDITIONAL_RECIPIENTS_HEAD) == 0x240
        && cd(SIGNATURE_HEAD) == 0x260 + (cd(ADDITIONAL_RECIPIENTS_LENGTH) << 6)
    let valid_values = cd(BASIC_ORDER_TYPE) < 24
        && (cd(OFFERER) | cd(ZONE) | cd(OFFER_TOKEN) | cd(CONSIDERATION_TOKEN)) < (1 << 160)
    if !(valid_offsets && valid_values) {
        revert_with0(error_selector<InvalidBasicOrderParameterEncoding>())
    }
}

/// `_validateAndFulfillBasicOrder`
#[arithmetic(unchecked)]
pub fn validate_and_fulfill_basic_order(_ env: Env) -> bool
uses (
    store: mut OrderStore,
    guard_state: mut u256,
    transient_guard: mut TSlot<u256>,
    ctx: Ctx,
    call: mut Call,
    ops: mut RawOps,
    log: mut Log,
)
{
    let basic_order_type = cd(BASIC_ORDER_TYPE)
    let order_type = basic_order_type & 3
    let route = basic_order_type >> 2
    let additional_recipients_item_type: u256 = if route > 1 { 1 } else { 0 }
    let value_is_zero: u256 = if ctx.value() == 0 { 1 } else { 0 }
    if additional_recipients_item_type != value_is_zero {
        revert_with1(error_selector<InvalidMsgValue>(), ctx.value())
    }
    let offer_type_is_additional_recipients_type = route > 3
    let additional_recipients_token = if offer_type_is_additional_recipients_type {
        cd_address(OFFER_TOKEN)
    } else {
        cd_address(CONSIDERATION_TOKEN)
    }
    let received_item_type = byte_at(route, RECEIVED_ITEM_BYTE_MAP)
    let offered_item_type = byte_at(route, OFFERED_ITEM_BYTE_MAP)

    let order_hash = prepare_basic_fulfillment_from_calldata(
        env,
        order_type,
        received_item_type,
        additional_recipients_item_type,
        additional_recipients_token,
        offered_item_type,
    )

    let conduit_key = if offer_type_is_additional_recipients_type {
        cd(FULFILLER_CONDUIT_KEY)
    } else {
        cd(OFFERER_CONDUIT_KEY)
    }
    if additional_recipients_item_type == 0 {
        if cd(CONSIDERATION_TOKEN) | cd(CONSIDERATION_IDENTIFIER) != 0 {
            revert_with0(error_selector<UnusedItemParameters>())
        }
        transfer_individual_721_or_1155_item(env, item_type: offered_item_type, conduit_key)
        transfer_native_tokens_and_finalize()
    } else {
        var buf = transfer_buffer(2 + cd(ADDITIONAL_RECIPIENTS_LENGTH))
        // Routes 2 and 3 offer an ERC721 or ERC1155 item for ERC20 tokens,
        // routes 4 and 5 receive one; its token, identifier and amount are
        // consecutive words.
        let item = if offer_type_is_additional_recipients_type {
            CONSIDERATION_TOKEN
        } else {
            OFFER_TOKEN
        }
        let offerer = cd_address(OFFERER)
        let acc = transfer_token(
            kind: CONDUIT_ERC721 + (route & 1),
            token: cd_address(item),
            from: if offer_type_is_additional_recipients_type {
                ctx.caller()
            } else {
                offerer
            },
            to: if offer_type_is_additional_recipients_type {
                offerer
            } else {
                ctx.caller()
            },
            identifier: cd(item + 0x20),
            amount: cd(item + 0x40),
            conduit_key,
            acc: new_accumulator(),
            mut buf,
            env,
        )
        let finalized = transfer_erc20_and_finalize(
            env,
            from_offerer: offer_type_is_additional_recipients_type,
            acc,
            mut buf,
        )
        let _ = trigger_if_armed(finalized, mut buf, env)
    }
    if is_restricted_and_caller_not_zone(order_type, cd_address(ZONE)) {
        call_basic_order_zone(order_hash, selector: VALIDATE_ORDER_SELECTOR)
    }
    clear_reentrancy_guard(env)
    true
}

/// `_prepareBasicFulfillmentFromCalldata`: validate the parameters, derive
/// the order hash, emit `OrderFulfilled`, check the status and signature,
/// authorize with the zone and mark the order filled. Kept out of line so
/// its frame does not join `validate_and_fulfill_basic_order`'s.
#[arithmetic(unchecked)]
#[inline(never)]
fn prepare_basic_fulfillment_from_calldata(
    _ env: Env,
    order_type: u256,
    received_item_type: u256,
    additional_recipients_item_type: u256,
    additional_recipients_token: Address,
    offered_item_type: u256,
) -> u256
uses (
    store: mut OrderStore,
    guard_state: mut u256,
    transient_guard: mut TSlot<u256>,
    ctx: Ctx,
    call: mut Call,
    ops: mut RawOps,
    log: mut Log,
)
{
    set_reentrancy_guard(env, accept_native_tokens: false)
    assert_valid_basic_order_parameters()
    if cd(START_TIME) > ctx.timestamp() || cd(END_TIME) <= ctx.timestamp() {
        revert_with2(
            error_selector<InvalidTime>(),
            cd(START_TIME),
            cd(END_TIME),
        )
    }
    let total_recipients = cd(ADDITIONAL_RECIPIENTS_LENGTH)
    let total_original = cd(TOTAL_ORIGINAL_ADDITIONAL_RECIPIENTS)
    if total_recipients < total_original {
        revert_with0(error_selector<MissingOriginalConsiderationItems>())
    }

    // Consideration item hashes of the primary item and the original
    // additional recipients, and the ReceivedItems of all of them.
    let offerer = cd_address(OFFERER)
    var consideration_hashes = Buffer::new((total_original + 1) * 32)
    consideration_hashes
        .write(
            offset: 0,
            value: keccak_words(
                [
                    CONSIDERATION_ITEM_TYPEHASH,
                    received_item_type,
                    cd(CONSIDERATION_TOKEN),
                    cd(CONSIDERATION_IDENTIFIER),
                    cd(CONSIDERATION_AMOUNT),
                    cd(CONSIDERATION_AMOUNT),
                    offerer.word(),
                ],
            ),
        )
    // OrderFulfilled data: orderHash, recipient, the offer and consideration
    // offsets, the offer (one SpentItem) and the consideration (the primary
    // item and one ReceivedItem per additional recipient). Item types come
    // from byte maps, so they are their own `uint8` truncation.
    var event = Buffer::new(order_fulfilled_size(total_recipients))
    // The buffer holds every word written to it below.
    unsafe {
        event.put(offset: 0x120, value: total_recipients + 1)
        event.put(offset: 0x140, value: received_item_type)
        event.put(
                offset: 0x160,
                value: cd_address(CONSIDERATION_TOKEN).word(),
            )
        event.put(offset: 0x180, value: cd(CONSIDERATION_IDENTIFIER))
        event.put(offset: 0x1a0, value: cd(CONSIDERATION_AMOUNT))
        event.put(offset: 0x1c0, value: offerer.word())
    }
    var combined_recipients: u256 = 0
    var i: u256 = 0
    while i < total_recipients {
        let amount = cd(ADDITIONAL_RECIPIENTS_DATA + i * 0x40)
        let recipient = cd(ADDITIONAL_RECIPIENTS_DATA + i * 0x40 + 0x20)
        if i < total_original {
            consideration_hashes
                .write(
                    offset: (i + 1) * 32,
                    value: keccak_words(
                        [
                            CONSIDERATION_ITEM_TYPEHASH,
                            additional_recipients_item_type,
                            additional_recipients_token.word(),
                            0,
                            amount,
                            amount,
                            recipient,
                        ],
                    ),
                )
        }
        combined_recipients = combined_recipients | recipient
        // The identifier stays zero. Only clean recipient words pass the
        // check below, before the event is emitted.
        let out = 0x1e0 + i * 160
        unsafe {
            event.put(offset: out, value: additional_recipients_item_type)
            event.put(
                    offset: out + 32,
                    value: additional_recipients_token.word(),
                )
            event.put(offset: out + 96, value: amount)
            event.put(offset: out + 128, value: recipient)
        }
        i += 1
    }
    if combined_recipients >= (1 << 160) {
        revert_with0(error_selector<InvalidBasicOrderParameterEncoding>())
    }
    let received_items_hash = keccak256(consideration_hashes.span())

    let offer_item_hash = keccak_words(
        [
            OFFER_ITEM_TYPEHASH,
            offered_item_type,
            cd(OFFER_TOKEN),
            cd(OFFER_IDENTIFIER),
            cd(OFFER_AMOUNT),
            cd(OFFER_AMOUNT),
        ],
    )
    let order_hash = keccak_words(
        [
            ORDER_TYPEHASH,
            offerer.word(),
            cd(ZONE),
            keccak_words([offer_item_hash]),
            received_items_hash,
            order_type,
            cd(START_TIME),
            cd(END_TIME),
            cd(ZONE_HASH),
            cd(SALT),
            cd(OFFERER_CONDUIT_KEY),
            get_counter(offerer),
        ],
    )

    unsafe {
        event.put(offset: 0, value: order_hash)
        event.put(offset: 0x20, value: ctx.caller().word())
        event.put(offset: 0x40, value: 0x80)
        event.put(offset: 0x60, value: 0x120)
        event.put(offset: 0x80, value: 1)
        event.put(offset: 0xa0, value: offered_item_type)
        event.put(offset: 0xc0, value: cd_address(OFFER_TOKEN).word())
        event.put(offset: 0xe0, value: cd(OFFER_IDENTIFIER))
        event.put(offset: 0x100, value: cd(OFFER_AMOUNT))
    }
    log.log3(
        data: event.span(),
        topic0: OrderFulfilled::TOPIC0,
        topic1: offerer.word(),
        topic2: cd_address(ZONE).word(),
    )

    // _validateBasicOrder
    let status = read_status(order_hash)
    verify_order_status(
        order_hash,
        status,
        only_allow_unused: true,
        revert_on_invalid: true,
    )
    if !status.is_validated {
        verify_signature(
            env,
            offerer,
            order_hash,
            // Read in place with the length masked like seaport-core's decoder.
            signature: CalldataView::at(cd(SIGNATURE_HEAD) + 0x24),
        )
    }
    if is_restricted_and_caller_not_zone(order_type, cd_address(ZONE)) {
        call_basic_order_zone(order_hash, selector: AUTHORIZE_ORDER_SELECTOR)
    }
    set_basic_order_filled(order_hash)
    order_hash
}

/// `authorizeOrder` (with no order hashes) or `validateOrder` (with the
/// order hash) for a basic order; the ZoneParameters come from calldata.
#[arithmetic(unchecked)]
fn call_basic_order_zone(_ order_hash: u256, selector: u256)
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let total_recipients = cd(ADDITIONAL_RECIPIENTS_LENGTH)
    let consideration_size = 32 + (total_recipients + 1) * 160
    let hashes_count: u256 = if selector == VALIDATE_ORDER_SELECTOR {
        1
    } else {
        0
    }
    // head, offer (one SpentItem), consideration, empty extraData, hashes
    let params_size = 0x140 + 0xa0 + consideration_size + 32 + 32 + hashes_count * 32
    let size = 0x24 + params_size
    var data = Buffer::new(size)
    let head: u256 = 0x24
    let extra_data_offset = 0x1e0 + consideration_size
    let basic_order_type = cd(BASIC_ORDER_TYPE)
    let route = basic_order_type >> 2
    let offer = head + 0x140
    let consideration = head + 0x1e0
    let first = consideration + 0x20
    ensure_range(data, offset: 0, len: first + 0xa0)
    // The checked range holds the head, the offer and the primary
    // consideration item.
    unsafe {
        data.put(offset: 0, value: selector << 224)
        data.put(offset: 4, value: 0x20)
        data.put(offset: head, value: order_hash)
        data.put(offset: head + 0x20, value: ctx.caller().word())
        data.put(offset: head + 0x40, value: cd(OFFERER))
        data.put(offset: head + 0x60, value: 0x140)
        data.put(offset: head + 0x80, value: 0x1e0)
        data.put(offset: head + 0xa0, value: extra_data_offset)
        data.put(offset: head + 0xc0, value: extra_data_offset + 32)
        data.put(offset: head + 0xe0, value: cd(START_TIME))
        data.put(offset: head + 0x100, value: cd(END_TIME))
        data.put(offset: head + 0x120, value: cd(ZONE_HASH))
        // offer: [(offeredItemType, offerToken, offerIdentifier, offerAmount)]
        data.put(offset: offer, value: 1)
        data.put(
            offset: offer + 0x20,
            value: byte_at(route, OFFERED_ITEM_BYTE_MAP),
        )
        data.put(offset: offer + 0x40, value: cd(OFFER_TOKEN))
        data.put(offset: offer + 0x60, value: cd(OFFER_IDENTIFIER))
        data.put(offset: offer + 0x80, value: cd(OFFER_AMOUNT))
        // consideration: primary item, then all additional recipients
        data.put(offset: consideration, value: total_recipients + 1)
        data.put(
            offset: first,
            value: byte_at(route, RECEIVED_ITEM_BYTE_MAP),
        )
        data.put(offset: first + 0x20, value: cd(CONSIDERATION_TOKEN))
        data.put(offset: first + 0x40, value: cd(CONSIDERATION_IDENTIFIER))
        data.put(offset: first + 0x60, value: cd(CONSIDERATION_AMOUNT))
        data.put(offset: first + 0x80, value: cd(OFFERER))
    }
    let additional_recipients_item_type: u256 = if route > 1 { 1 } else { 0 }
    let additional_recipients_token = if route > 3 {
        cd(OFFER_TOKEN)
    } else {
        cd(CONSIDERATION_TOKEN)
    }
    var i: u256 = 0
    while i < total_recipients {
        let item = first + 0xa0 + i * 0xa0
        ensure_range(data, offset: item, len: 0xa0)
        // The checked range holds the item; its identifier stays zero.
        unsafe {
            data.put(offset: item, value: additional_recipients_item_type)
            data.put(offset: item + 0x20, value: additional_recipients_token)
            data.put(
                offset: item + 0x60,
                value: cd(ADDITIONAL_RECIPIENTS_DATA + i * 0x40),
            )
            data.put(
                offset: item + 0x80,
                value: cd(ADDITIONAL_RECIPIENTS_DATA + i * 0x40 + 0x20),
            )
        }
        i += 1
    }
    data.write(offset: head + extra_data_offset + 32, value: hashes_count)
    if hashes_count == 1 {
        data.write(offset: head + extra_data_offset + 64, value: order_hash)
    }
    let _ = call_and_check_status_with_skip(
        cd_address(ZONE),
        order_hash,
        data,
        contract_order: false,
        revert_on_invalid: true,
    )
}

/// `_transferIndividual721Or1155Item`: the offered token goes from the
/// offerer to the caller, directly or through a single-item conduit call.
#[arithmetic(unchecked)]
fn transfer_individual_721_or_1155_item(_ env: Env, item_type: u256, conduit_key: u256)
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let token = cd_address(OFFER_TOKEN)
    let from = cd_address(OFFERER)
    let identifier = cd(OFFER_IDENTIFIER)
    let amount = cd(OFFER_AMOUNT)
    var data = transfer_buffer(1)
    if conduit_key != 0 {
        // One accumulated transfer is exactly the single item `execute` call.
        let acc = insert(
            new_accumulator(),
            mut data,
            conduit_key,
            item_type,
            token,
            from,
            to: ctx.caller(),
            identifier,
            amount,
        )
        let _ = trigger_if_armed(acc, mut data, env)
    } else {
        perform_transfer(
            kind: item_type,
            token,
            from,
            to: ctx.caller(),
            identifier,
            amount,
            scratch: mut data,
        )
    }
}

/// `_transferNativeTokensAndFinalize`: pay additional recipients and the
/// offerer from `msg.value` and refund the rest.
#[arithmetic(unchecked)]
fn transfer_native_tokens_and_finalize()
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    var remaining = ctx.value()
    let amount = cd(CONSIDERATION_AMOUNT)
    let offerer = cd_address(OFFERER)
    let total_recipients = cd(ADDITIONAL_RECIPIENTS_LENGTH)
    var i: u256 = 0
    while i < total_recipients {
        let additional_amount = cd(ADDITIONAL_RECIPIENTS_DATA + i * 0x40)
        let recipient = cd_address(ADDITIONAL_RECIPIENTS_DATA + i * 0x40 + 0x20)
        if additional_amount > remaining {
            revert_with0(error_selector<InsufficientNativeTokensSupplied>())
        }
        remaining = remaining - additional_amount
        transfer_native_tokens(to: recipient, amount: additional_amount)
        i += 1
    }
    if amount > remaining {
        revert_with0(error_selector<InsufficientNativeTokensSupplied>())
    }
    transfer_native_tokens(to: offerer, amount)
    if remaining > amount {
        transfer_native_tokens(to: ctx.caller(), amount: remaining - amount)
    }
}

/// `_transferERC20AndFinalize`: the ERC20 side of the order, split between
/// the additional recipients and the counterparty.
fn transfer_erc20_and_finalize(
    _ env: Env,
    from_offerer: bool,
    acc: Accumulator,
    buf: mut Buffer,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    var from = ctx.caller()
    var to = cd_address(OFFERER)
    var token = cd_address(CONSIDERATION_TOKEN)
    var identifier = cd(CONSIDERATION_IDENTIFIER)
    var amount = cd(CONSIDERATION_AMOUNT)
    if from_offerer {
        from = cd_address(OFFERER)
        to = ctx.caller()
        token = cd_address(OFFER_TOKEN)
        identifier = cd(OFFER_IDENTIFIER)
        amount = cd(OFFER_AMOUNT)
    }
    if identifier != 0 {
        revert_with0(error_selector<UnusedItemParameters>())
    }
    let conduit_key = if from_offerer {
        cd(OFFERER_CONDUIT_KEY)
    } else {
        cd(FULFILLER_CONDUIT_KEY)
    }
    let total_recipients = cd(ADDITIONAL_RECIPIENTS_LENGTH)
    var current = acc
    var i: u256 = 0
    while i < total_recipients {
        let additional_amount = cd(ADDITIONAL_RECIPIENTS_DATA + (i << 6))
        let recipient = cd_address(ADDITIONAL_RECIPIENTS_DATA + 0x20 + (i << 6))
        // The only checked subtraction of seaport-core's basic order path.
        if from_offerer {
            amount = amount - additional_amount
        }
        current = transfer_token(
            kind: CONDUIT_ERC20,
            token,
            from,
            to: recipient,
            identifier: 0,
            amount: additional_amount,
            conduit_key,
            acc: current,
            mut buf,
            env,
        )
        i += 1
    }
    transfer_token(
        kind: CONDUIT_ERC20,
        token,
        from,
        to,
        identifier: 0,
        amount,
        conduit_key,
        acc: current,
        mut buf,
        env,
    )
}
