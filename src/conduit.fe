// SPDX-License-Identifier: MIT
// Conduit and ConduitController (seaport-core/src/conduit).
use core::ptr::{self, MemBuffer, MemSpan}
use std::abi::{Bytes4, Bytes32, DynArray, MemVec, sol}
use std::evm::{Address, Call, Contract, Create, Ctx, Log, RawOps, RawStorage, create2_address, keccak256, keccak_words, revert_error}
use super::errors::{InvalidERC721TransferAmount, NoContract, Invalid1155BatchTransferEncoding}
use super::executor::{perform_erc1155_transfer, perform_erc20_transfer, perform_erc721_transfer}
use super::lowlevel::{load_word, revert_with_reason_if_one_is_returned, store_word}

#[abi]
pub struct ConduitTransfer {
    pub itemType: u8,
    pub token: Address,
    pub from: Address,
    pub to: Address,
    pub identifier: u256,
    pub amount: u256,
}
impl Copy for ConduitTransfer {}

#[event]
pub struct ChannelUpdated {
    #[indexed]
    pub channel: Address,
    pub open: bool,
}

#[error]
pub struct ChannelClosed { pub channel: Address }
#[error]
pub struct ChannelStatusAlreadySet { pub channel: Address, pub isOpen: bool }
#[error]
pub struct InvalidItemType {}
#[error]
pub struct InvalidController {}

pub msg ConduitMsg {
    #[selector = sol("execute((uint8,address,address,address,uint256,uint256)[])")]
    Execute { transfers: DynArray<ConduitTransfer> } -> Bytes4,
    /// executeBatch1155((address,address,address,uint256[],uint256[])[]),
    /// read from raw calldata like seaport-core.
    #[selector = 0x8df25d92]
    ExecuteBatch1155 {} -> Bytes4,
    /// executeWithBatch1155((uint8,address,address,address,uint256,uint256)[],(address,address,address,uint256[],uint256[])[]),
    /// read from raw calldata.
    #[selector = 0x899e104c]
    ExecuteWithBatch1155 {} -> Bytes4,
    #[selector = sol("updateChannel(address,bool)")]
    UpdateChannel { channel: Address, isOpen: bool },
}

const EXECUTE_SELECTOR: u256 = 0x4ce34aa2
const EXECUTE_BATCH_1155_SELECTOR: u256 = 0x8df25d92
const EXECUTE_WITH_BATCH_1155_SELECTOR: u256 = 0x899e104c
/// safeBatchTransferFrom(address,address,uint256[],uint256[],bytes)
const SAFE_BATCH_TRANSFER_FROM_SELECTOR: u256 = 0x2eb2c2d6
/// ERC1155BatchTransferGenericFailure(address,address,address,uint256[],uint256[])
const ERC1155_BATCH_TRANSFER_GENERIC_FAILURE_SELECTOR: u256 = 0xafc445e2

fn channel_slot(_ channel: Address) -> u256 {
    keccak_words([channel.inner, 0])
}

/// `onlyOpenChannel`
fn assert_open_channel() uses (ctx: Ctx, ops: RawOps) {
    if ops.sload(channel_slot(ctx.caller())) == 0 {
        revert_error(ChannelClosed { channel: ctx.caller() })
    }
}

fn transfer_item(_ item: ConduitTransfer) uses (ctx: Ctx, call: mut Call, ops: RawOps) {
    if item.itemType > 3 {
        // Solidity rejects out of range enum values when reading the field.
        std::evm::revert(())
    }
    if item.itemType == 1 {
        perform_erc20_transfer(token: item.token, from: item.from, to: item.to, amount: item.amount)
    } else if item.itemType == 2 {
        if item.amount != 1 {
            revert_error(InvalidERC721TransferAmount { amount: item.amount })
        }
        perform_erc721_transfer(token: item.token, from: item.from, to: item.to, identifier: item.identifier)
    } else if item.itemType == 3 {
        perform_erc1155_transfer(token: item.token, from: item.from, to: item.to, identifier: item.identifier, amount: item.amount)
    } else {
        revert_error(InvalidItemType {})
    }
}

fn execute_transfers(_ transfers: DynArray<ConduitTransfer>) uses (ctx: Ctx, call: mut Call, ops: RawOps) {
    let mut i: u256 = 0
    while i < transfers.len() {
        transfer_item(transfers.get(i))
        i += 1
    }
}

/// The `ConduitTransfer[] calldata` at `array`, with the checks Solidity
/// applies when reading each field.
fn execute_raw_transfers(_ array: u256) uses (ctx: Ctx, call: mut Call, ops: RawOps) {
    let length = ops.calldataload(array)
    let mut i: u256 = 0
    while i < length {
        let at = array + 32 + i * 0xc0
        let item_type = ops.calldataload(at)
        let token = ops.calldataload(at + 0x20)
        let from = ops.calldataload(at + 0x40)
        let to = ops.calldataload(at + 0x60)
        if item_type > 0xff || (token | from | to) >= (1 << 160) {
            std::evm::revert(())
        }
        transfer_item(ConduitTransfer {
            itemType: item_type.downcast_truncate(),
            token: Address { inner: token },
            from: Address { inner: from },
            to: Address { inner: to },
            identifier: ops.calldataload(at + 0x80),
            amount: ops.calldataload(at + 0xa0),
        })
        i += 1
    }
}

/// Offset of a calldata array argument after the ABI checks Solidity
/// performs for `T[] calldata` parameters; reverts without data if invalid.
fn calldata_array(_ head: u256, element_head_size: u256) -> u256 uses (ops: RawOps) {
    let size = ops.calldatasize()
    if size < head + 32 {
        std::evm::revert(())
    }
    let offset = ops.calldataload(head)
    if offset > 0xffffffffffffffff || offset + 4 + 32 > size {
        std::evm::revert(())
    }
    let length = ops.calldataload(offset + 4)
    if length > 0xffffffffffffffff || offset + 4 + 32 + length * element_head_size > size {
        std::evm::revert(())
    }
    offset + 4
}

/// `_performERC1155BatchTransfers` over the `ConduitBatch1155Transfer[]` whose
/// length word is at calldata offset `array`.
fn perform_erc1155_batch_transfers(_ array: u256) uses (ctx: Ctx, call: mut Call, ops: RawOps) {
    let length = ops.calldataload(array)
    let heads = array + 32
    let mut i: u256 = 0
    while i < length {
        let element = heads + ops.calldataload(heads + i * 32)
        let token = Address { inner: ops.calldataload(element) }
        if ctx.extcodesize(token) == 0 {
            revert_error(NoContract { account: token })
        }
        let ids_length = ops.calldataload(element + 0xa0)
        let expected_amounts_offset = 0xc0 + (ids_length << 5)
        let valid = ids_length == ops.calldataload(element + expected_amounts_offset)
            && ops.calldataload(element + 0x60) == 0xa0
            && ops.calldataload(element + 0x80) == expected_amounts_offset
        if !valid {
            revert_error(Invalid1155BatchTransferEncoding {})
        }
        let ids_and_amounts_size = 0x40 + (ids_length << 6)
        let size = 0xc4 + ids_and_amounts_size
        // selector, from, to, ids head, amounts head, data head, ids, amounts,
        // empty data
        let data = ptr::alloc_bytes(size + 32)
        store_word(data, SAFE_BATCH_TRANSFER_FROM_SELECTOR << 224)
        let mut word: u256 = 0
        while word < 4 {
            store_word(ptr::offset_bytes(data, 4 + word * 32), ops.calldataload(element + 0x20 + word * 32))
            word += 1
        }
        store_word(ptr::offset_bytes(data, 0xa4), 0xa0 + ids_and_amounts_size)
        word = 0
        while word * 32 < ids_and_amounts_size {
            store_word(ptr::offset_bytes(data, 0xc4 + word * 32), ops.calldataload(element + 0xa0 + word * 32))
            word += 1
        }
        store_word(ptr::offset_bytes(data, 0xc4 + ids_and_amounts_size), 0)
        let mut ret = MemBuffer::empty()
        let outcome = call.raw_call(addr: token, gas: ctx.gas(), value: 0, args: MemSpan::from_raw_parts(ptr: data, len: size), ret: mut ret)
        if !outcome.success() {
            revert_with_reason_if_one_is_returned()
            // ERC1155BatchTransferGenericFailure(token, from, to, ids, amounts)
            // laid over the call data, as in seaport-core.
            let amounts_head = load_word(ptr::offset_bytes(data, 0x84))
            store_word(data, ERC1155_BATCH_TRANSFER_GENERIC_FAILURE_SELECTOR << 224)
            let from = load_word(ptr::offset_bytes(data, 0x04))
            let to = load_word(ptr::offset_bytes(data, 0x24))
            store_word(ptr::offset_bytes(data, 0x04), token.inner)
            store_word(ptr::offset_bytes(data, 0x24), from)
            store_word(ptr::offset_bytes(data, 0x44), to)
            store_word(ptr::offset_bytes(data, 0x64), 0xc0)
            store_word(ptr::offset_bytes(data, 0x84), amounts_head + 0x20)
            ops.revert(data: MemSpan::from_raw_parts(ptr: data, len: size))
        }
        i += 1
    }
}

pub contract Conduit {
    controller: Address,

    init() uses (mut controller, ctx: Ctx) {
        controller = ctx.caller()
    }

    recv ConduitMsg {
        Execute { transfers } -> Bytes4 uses (ctx: Ctx, call: mut Call, ops: RawOps) {
            assert_open_channel()
            execute_transfers(transfers)
            Bytes4 { val: EXECUTE_SELECTOR }
        }
        ExecuteBatch1155 {} -> Bytes4 uses (ctx: Ctx, call: mut Call, ops: RawOps) {
            let array = calldata_array(head: 4, element_head_size: 32)
            assert_open_channel()
            perform_erc1155_batch_transfers(array)
            Bytes4 { val: EXECUTE_BATCH_1155_SELECTOR }
        }
        ExecuteWithBatch1155 {} -> Bytes4 uses (ctx: Ctx, call: mut Call, ops: RawOps) {
            let standard = calldata_array(head: 4, element_head_size: 0xc0)
            let batch = calldata_array(head: 0x24, element_head_size: 32)
            assert_open_channel()
            execute_raw_transfers(standard)
            perform_erc1155_batch_transfers(batch)
            Bytes4 { val: EXECUTE_WITH_BATCH_1155_SELECTOR }
        }
        UpdateChannel { channel, isOpen } uses (controller, ctx: Ctx, storage: mut RawStorage, log: mut Log) {
            if ctx.caller() != controller {
                revert_error(InvalidController {})
            }
            let slot = channel_slot(channel)
            let current = storage.sload(slot) != 0
            if current == isOpen {
                revert_error(ChannelStatusAlreadySet { channel, isOpen })
            }
            storage.sstore(slot, value: if isOpen { 1 } else { 0 })
            log.emit(ChannelUpdated { channel, open: isOpen })
        }
    }
}
