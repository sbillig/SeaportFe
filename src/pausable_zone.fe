// SPDX-License-Identifier: MIT
// PausableZone and PausableZoneController (contracts/zones).
//
// Storage keeps Solidity's layout: PausableZone packs `operator` and
// `isPaused` into slot 0; the controller keeps `_owner`, `_potentialOwner`
// and `_pauser` in slots 0 to 2.
use core::ptr::MemBuffer
use std::abi::{Bytes, Bytes4, Bytes32, DynArray, DynString, dyn_array_from, sol}
use std::evm::{Address, Call, Contract, Create, Ctx, Log, RawOps, create2_address, keccak256}
use super::raw_abi::{error_selector, revert_with0, revert_with1}
use super::buffer::Buffer
use super::seaport::SeaportMsg
use super::types::{
    AdvancedOrder,
    CriteriaResolver,
    Execution,
    Fulfillment,
    Order,
    OrderComponents,
    ZoneParameters,
}

#[event]
pub struct Paused {}
#[event]
pub struct Unpaused {}
#[event]
pub struct PotentialOwnerUpdated { pub newPotentialOwner: Address }
#[event]
pub struct OwnershipTransferred { pub previousOwner: Address, pub newOwner: Address }
#[event]
pub struct ZoneCreated { pub zone: Address, pub salt: Bytes32 }
#[event]
pub struct PauserUpdated { pub newPauser: Address }
#[event]
pub struct OperatorUpdated { pub newOperator: Address }

#[error]
pub struct InvalidPauser {}
#[error]
pub struct InvalidOperator {}
#[error]
pub struct InvalidController {}
#[error]
pub struct ZoneAlreadyExists { pub zone: Address }
#[error]
pub struct CallerIsNotOwner {}
#[error]
pub struct CallerIsNotOperator {}
#[error]
pub struct OwnerCanNotBeSetAsZero {}
#[error]
pub struct PauserCanNotBeSetAsZero {}
#[error]
pub struct CallerIsNotPotentialOwner {}
#[error]
pub struct ZoneIsPaused {}

#[abi]
pub struct Schema { pub id: u256, pub metadata: Bytes }

impl Copy for Schema {}

const ZONE_INTERFACE_ID: u256 = 0x39dd6933
const ERC165_INTERFACE_ID: u256 = 0x01ffc9a7
const AUTHORIZE_ORDER_SELECTOR: u256 = 0x01e4d72a
const VALIDATE_ORDER_SELECTOR: u256 = 0x17b1f942

pub msg PausableZoneMsg {
    #[selector = sol(
        "cancelOrders(address,(address,address,(uint8,address,uint256,uint256,uint256)[],(uint8,address,uint256,uint256,uint256,address)[],uint8,uint256,uint256,bytes32,uint256,bytes32,uint256)[])",
    )]
    CancelOrders { seaport: Address, orders: DynArray<OrderComponents> } -> bool,
    #[selector = sol("pause()")]
    Pause {},
    #[selector = sol("assignOperator(address)")]
    AssignOperator { operatorToAssign: Address },
    #[selector = sol(
        "executeMatchOrders(address,((address,address,(uint8,address,uint256,uint256,uint256)[],(uint8,address,uint256,uint256,uint256,address)[],uint8,uint256,uint256,bytes32,uint256,bytes32,uint256),bytes)[],((uint256,uint256)[],(uint256,uint256)[])[])",
    )]
    ExecuteMatchOrders {
        seaport: Address,
        orders: DynArray<Order>,
        fulfillments: DynArray<Fulfillment>,
    } -> DynArray<Execution>,
    #[selector = sol(
        "executeMatchAdvancedOrders(address,((address,address,(uint8,address,uint256,uint256,uint256)[],(uint8,address,uint256,uint256,uint256,address)[],uint8,uint256,uint256,bytes32,uint256,bytes32,uint256),uint120,uint120,bytes,bytes)[],(uint256,uint8,uint256,uint256,bytes32[])[],((uint256,uint256)[],(uint256,uint256)[])[])",
    )]
    ExecuteMatchAdvancedOrders {
        seaport: Address,
        orders: DynArray<AdvancedOrder>,
        criteriaResolvers: DynArray<CriteriaResolver>,
        fulfillments: DynArray<Fulfillment>,
    } -> DynArray<Execution>,
    #[selector = sol(
        "authorizeOrder((bytes32,address,address,(uint8,address,uint256,uint256)[],(uint8,address,uint256,uint256,address)[],bytes,bytes32[],uint256,uint256,bytes32))",
    )]
    AuthorizeOrder { zoneParameters: ZoneParameters } -> Bytes4,
    #[selector = sol(
        "validateOrder((bytes32,address,address,(uint8,address,uint256,uint256)[],(uint8,address,uint256,uint256,address)[],bytes,bytes32[],uint256,uint256,bytes32))",
    )]
    ValidateOrder { zoneParameters: ZoneParameters } -> Bytes4,
    #[selector = sol("getSeaportMetadata()")]
    GetSeaportMetadata {} -> (DynString, DynArray<Schema>),
    #[selector = sol("supportsInterface(bytes4)")]
    SupportsInterface { interfaceId: Bytes4 } -> bool,
    #[selector = sol("operator()")]
    Operator {} -> Address,
    #[selector = sol("isPaused()")]
    IsPaused {} -> bool,
}

const OPERATOR_MASK: u256 = 0xffffffffffffffffffffffffffffffffffffffff

fn zone_operator(_ zone_state: u256) -> Address {
    Address::from_word_truncate(zone_state)
}

fn zone_is_paused(_ zone_state: u256) -> bool {
    (zone_state >> 160) & 0xff != 0
}

fn assert_operator(_ controller: Address, zone_state: u256) uses (ctx: Ctx) {
    if ctx.caller() != zone_operator(zone_state) && ctx.caller() != controller {
        revert_with0(error_selector<InvalidOperator>())
    }
}

fn assert_not_paused(_ zone_state: u256) {
    if zone_is_paused(zone_state) {
        revert_with0(error_selector<ZoneIsPaused>())
    }
}

/// `[Schema { id: 3003, metadata: "" }]`: the length, the element offset,
/// the id, the metadata offset and the empty metadata.
#[inline(always)]
fn metadata_schemas() -> DynArray<Schema> {
    var schemas = Buffer::new(0xa0)
    unsafe {
        schemas.put(offset: 0, value: 1)
        schemas.put(offset: 0x20, value: 0x20)
        schemas.put(offset: 0x40, value: 3003)
        schemas.put(offset: 0x60, value: 0x40)
        schemas.into_dyn_array_unvalidated(len: 1)
    }
}

#[test]
fn metadata_schemas_match_the_typed_encoding() {
    let schemas = metadata_schemas()
    let expected = dyn_array_from([Schema { id: 3003, metadata: Bytes::empty() }])
    assert(schemas.encoded_size() == expected.encoded_size())
    let actual = schemas.encoded_span()
    let typed = expected.encoded_span()
    var i: usize = 0
    while i < actual.len() {
        assert(actual.byte_at(i) == typed.byte_at(i))
        i += 1
    }
    let schema = schemas.get(0)
    assert(schema.id == 3003 && schema.metadata.len() == 0)
}

fn assert_controller(_ controller: Address) uses (ctx: Ctx) {
    if ctx.caller() != controller {
        revert_with0(error_selector<InvalidController>())
    }
}

pub contract PausableZone {
    controller: Address,
    #[slot(0)]
    mut zone_state: u256,

    init()
    uses (mut controller, ctx: Ctx, log: mut Log)
    {
        controller = ctx.caller()
        log.emit(Unpaused {})
    }

    recv PausableZoneMsg {
        CancelOrders { seaport, orders } -> bool uses (
            controller,
            ctx: Ctx,
            call: mut Call,
            zone_state,
        ) {
            assert_operator(controller, zone_state)
            seaport.call(SeaportMsg::Cancel { orders })
        }
        Pause {} uses (controller, ctx: Ctx, mut zone_state, log: mut Log) {
            assert_controller(controller)
            log.emit(Paused {})
            zone_state |= 1 << 160
        }
        AssignOperator { operatorToAssign } uses (
            controller,
            ctx: Ctx,
            mut zone_state,
            log: mut Log,
        ) {
            assert_controller(controller)
            if operatorToAssign.word() == 0 {
                revert_with0(error_selector<PauserCanNotBeSetAsZero>())
            }
            zone_state = (zone_state & !OPERATOR_MASK) | operatorToAssign.word()
            log.emit(OperatorUpdated { newOperator: operatorToAssign })
        }
        #[payable]
        ExecuteMatchOrders { seaport, orders, fulfillments } -> DynArray<Execution>
        uses (controller, ctx: Ctx, call: mut Call, zone_state)
        {
            assert_operator(controller, zone_state)
            assert_not_paused(zone_state)
            call.call(
                addr: seaport,
                gas: ctx.gas(),
                value: ctx.value(),
                message: SeaportMsg::MatchOrders { orders, fulfillments },
            )
        }
        #[payable]
        ExecuteMatchAdvancedOrders { seaport, orders, criteriaResolvers, fulfillments } -> DynArray<
            Execution,
        >
        uses (controller, ctx: Ctx, call: mut Call, zone_state)
        {
            assert_operator(controller, zone_state)
            assert_not_paused(zone_state)
            call.call(
                addr: seaport,
                gas: ctx.gas(),
                value: ctx.value(),
                message: SeaportMsg::MatchAdvancedOrders {
                    orders,
                    criteriaResolvers,
                    fulfillments,
                    recipient: ctx.caller(),
                },
            )
        }
        AuthorizeOrder { zoneParameters } -> Bytes4
        uses (zone_state)
        {
            assert_not_paused(zone_state)
            Bytes4 { val: AUTHORIZE_ORDER_SELECTOR }
        }
        ValidateOrder { zoneParameters } -> Bytes4
        uses (zone_state)
        {
            assert_not_paused(zone_state)
            Bytes4 { val: VALIDATE_ORDER_SELECTOR }
        }
        GetSeaportMetadata {} -> (DynString, DynArray<Schema>) {
            // "PausableZone"
            let name = DynString::from_word_prefix(word: 0x5061757361626c655a6f6e65 << 160, len: 12)
            (name, metadata_schemas())
        }
        SupportsInterface { interfaceId } -> bool {
            interfaceId.val == ZONE_INTERFACE_ID || interfaceId.val == ERC165_INTERFACE_ID
        }
        Operator {} -> Address uses (zone_state) {
            zone_operator(zone_state)
        }
        IsPaused {} -> bool uses (zone_state) {
            zone_is_paused(zone_state)
        }
    }
}

pub msg PausableZoneControllerMsg {
    #[selector = sol("createZone(bytes32)")]
    CreateZone { salt: Bytes32 } -> Address,
    #[selector = sol("pause(address)")]
    Pause { zone: Address } -> bool,
    #[selector = sol(
        "cancelOrders(address,address,(address,address,(uint8,address,uint256,uint256,uint256)[],(uint8,address,uint256,uint256,uint256,address)[],uint8,uint256,uint256,bytes32,uint256,bytes32,uint256)[])",
    )]
    CancelOrders {
        pausableZoneAddress: Address,
        seaportAddress: Address,
        orders: DynArray<OrderComponents>,
    },
    #[selector = sol(
        "executeMatchOrders(address,address,((address,address,(uint8,address,uint256,uint256,uint256)[],(uint8,address,uint256,uint256,uint256,address)[],uint8,uint256,uint256,bytes32,uint256,bytes32,uint256),bytes)[],((uint256,uint256)[],(uint256,uint256)[])[])",
    )]
    ExecuteMatchOrders {
        pausableZoneAddress: Address,
        seaportAddress: Address,
        orders: DynArray<Order>,
        fulfillments: DynArray<Fulfillment>,
    } -> DynArray<Execution>,
    #[selector = sol(
        "executeMatchAdvancedOrders(address,address,((address,address,(uint8,address,uint256,uint256,uint256)[],(uint8,address,uint256,uint256,uint256,address)[],uint8,uint256,uint256,bytes32,uint256,bytes32,uint256),uint120,uint120,bytes,bytes)[],(uint256,uint8,uint256,uint256,bytes32[])[],((uint256,uint256)[],(uint256,uint256)[])[])",
    )]
    ExecuteMatchAdvancedOrders {
        pausableZoneAddress: Address,
        seaportAddress: Address,
        orders: DynArray<AdvancedOrder>,
        criteriaResolvers: DynArray<CriteriaResolver>,
        fulfillments: DynArray<Fulfillment>,
    } -> DynArray<Execution>,
    #[selector = sol("transferOwnership(address)")]
    TransferOwnership { newPotentialOwner: Address },
    #[selector = sol("cancelOwnershipTransfer()")]
    CancelOwnershipTransfer {},
    #[selector = sol("acceptOwnership()")]
    AcceptOwnership {},
    #[selector = sol("assignPauser(address)")]
    AssignPauser { pauserToAssign: Address },
    #[selector = sol("assignOperator(address,address)")]
    AssignOperator { pausableZoneAddress: Address, operatorToAssign: Address },
    #[selector = sol("owner()")]
    Owner {} -> Address,
    #[selector = sol("potentialOwner()")]
    PotentialOwner {} -> Address,
    #[selector = sol("pauser()")]
    Pauser {} -> Address,
    #[selector = sol("zoneCreationCode()")]
    ZoneCreationCode {} -> Bytes32,
}

fn assert_owner(_ owner: u256) uses (ctx: Ctx) {
    if ctx.caller().word() != owner {
        revert_with0(error_selector<CallerIsNotOwner>())
    }
}

fn zone_init_code_hash() -> u256 uses (ops: mut RawOps) {
    let len = <PausableZone as Contract>::init_code_len()
    var code = MemBuffer::with_capacity(len as usize)
    ops.codecopy(
        dest: mut code,
        dest_offset: 0,
        src_offset: <PausableZone as Contract>::init_code_offset(),
        len,
    )
    keccak256(code.span())
}

pub contract PausableZoneController {
    zone_creation_code: u256,
    #[slot(0)]
    mut owner: u256,
    #[slot(1)]
    mut potential_owner: u256,
    #[slot(2)]
    mut pauser: u256,

    init(ownerAddress: Address)
    uses (mut zone_creation_code, mut owner, ops: mut RawOps)
    {
        owner = ownerAddress.word()
        zone_creation_code = zone_init_code_hash()
    }

    recv PausableZoneControllerMsg {
        CreateZone { salt } -> Address uses (
            zone_creation_code,
            ctx: Ctx,
            create: mut Create,
            owner,
            log: mut Log,
        ) {
            assert_owner(owner)
            let derived = create2_address(
                deployer: ctx.address(),
                salt: salt.val,
                init_code_hash: zone_creation_code,
            )
            if ctx.extcodesize(derived) != 0 {
                revert_with1(error_selector<ZoneAlreadyExists>(), derived.word())
            }
            create.create2<PausableZone>(value: 0, args: (), salt: salt.val)
            log.emit(ZoneCreated { zone: derived, salt })
            derived
        }
        Pause { zone } -> bool uses (owner, pauser, ctx: Ctx, call: mut Call) {
            if ctx.caller().word() != pauser && ctx.caller().word() != owner {
                revert_with0(error_selector<InvalidPauser>())
            }
            zone.call(PausableZoneMsg::Pause {})
            true
        }
        CancelOrders { pausableZoneAddress, seaportAddress, orders }
        uses (owner, ctx: Ctx, call: mut Call)
        {
            assert_owner(owner)
            let _: bool = pausableZoneAddress
                .call(
                    PausableZoneMsg::CancelOrders { seaport: seaportAddress, orders },
                )
        }
        #[payable]
        ExecuteMatchOrders {
            pausableZoneAddress,
            seaportAddress,
            orders,
            fulfillments,
        } -> DynArray<Execution>
        uses (owner, ctx: Ctx, call: mut Call)
        {
            assert_owner(owner)
            call.call(
                addr: pausableZoneAddress,
                gas: ctx.gas(),
                value: ctx.value(),
                message: PausableZoneMsg::ExecuteMatchOrders {
                    seaport: seaportAddress,
                    orders,
                    fulfillments,
                },
            )
        }
        #[payable]
        ExecuteMatchAdvancedOrders {
            pausableZoneAddress,
            seaportAddress,
            orders,
            criteriaResolvers,
            fulfillments,
        } -> DynArray<Execution>
        uses (owner, ctx: Ctx, call: mut Call)
        {
            assert_owner(owner)
            call.call(
                addr: pausableZoneAddress,
                gas: ctx.gas(),
                value: ctx.value(),
                message: PausableZoneMsg::ExecuteMatchAdvancedOrders {
                    seaport: seaportAddress,
                    orders,
                    criteriaResolvers,
                    fulfillments,
                },
            )
        }
        TransferOwnership { newPotentialOwner } uses (
            owner,
            mut potential_owner,
            ctx: Ctx,
            log: mut Log,
        ) {
            assert_owner(owner)
            if newPotentialOwner.word() == 0 {
                revert_with0(error_selector<OwnerCanNotBeSetAsZero>())
            }
            log.emit(PotentialOwnerUpdated { newPotentialOwner })
            potential_owner = newPotentialOwner.word()
        }
        CancelOwnershipTransfer {} uses (owner, mut potential_owner, ctx: Ctx, log: mut Log) {
            assert_owner(owner)
            log.emit(
                PotentialOwnerUpdated { newPotentialOwner: Address::zero() },
            )
            potential_owner = 0
        }
        AcceptOwnership {} uses (mut owner, mut potential_owner, ctx: Ctx, log: mut Log) {
            if ctx.caller().word() != potential_owner {
                revert_with0(error_selector<CallerIsNotPotentialOwner>())
            }
            log.emit(
                PotentialOwnerUpdated { newPotentialOwner: Address::zero() },
            )
            potential_owner = 0
            log.emit(
                OwnershipTransferred {
                    previousOwner: Address::from_word_truncate(owner),
                    newOwner: ctx.caller(),
                },
            )
            owner = ctx.caller().word()
        }
        AssignPauser { pauserToAssign } uses (owner, mut pauser, ctx: Ctx, log: mut Log) {
            assert_owner(owner)
            if pauserToAssign.word() == 0 {
                revert_with0(error_selector<PauserCanNotBeSetAsZero>())
            }
            pauser = pauserToAssign.word()
            log.emit(PauserUpdated { newPauser: pauserToAssign })
        }
        AssignOperator { pausableZoneAddress, operatorToAssign }
        uses (owner, ctx: Ctx, call: mut Call)
        {
            assert_owner(owner)
            pausableZoneAddress.call(PausableZoneMsg::AssignOperator { operatorToAssign })
        }
        Owner {} -> Address uses (owner) {
            Address::from_word_truncate(owner)
        }
        PotentialOwner {} -> Address uses (potential_owner) {
            Address::from_word_truncate(potential_owner)
        }
        Pauser {} -> Address uses (pauser) {
            Address::from_word_truncate(pauser)
        }
        ZoneCreationCode {} -> Bytes32 uses (zone_creation_code) {
            Bytes32 { val: zone_creation_code }
        }
    }
}
