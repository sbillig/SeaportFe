// SPDX-License-Identifier: MIT
// An initialized, exclusively owned byte buffer for exact protocol encodings.
use core::abi::AbiSize
use core::ptr::{self, MemArray, MemBuffer, MemSpan}
use std::abi::DynArray
use std::evm::{Panic, PANIC_INDEX_OUT_OF_BOUNDS, RawOps, revert_error}
use super::abi_view::CalldataView

pub struct Buffer { data: MemBuffer }

impl Buffer {
    pub fn new(_ len: u256) -> Self {
        var data = MemArray<u256>::new_zeroed(((len + 31) / 32) as usize).into_buffer()
        data.truncate(len as usize)
        Buffer { data }
    }
    pub fn len(self) -> u256 {
        self.data.len() as u256
    }
    pub fn span(self) -> ref MemSpan {
        self.data.span()
    }
    pub fn slice(self, offset: u256, len: u256) -> ref MemSpan {
        self.data.slice(offset: offset as usize, len: len as usize)
    }
    pub fn word(self, _ offset: u256) -> u256 {
        self.check_word(offset)
        // The complete word is initialized and lies in this owner's allocation.
        unsafe {
            *ptr::cast<u8, u256>(ptr::offset_bytes(self.data.ptr(), offset))
        }
    }
    // One shared copy of the checked store keeps each call site small.
    #[inline(never)]
    pub fn write(mut self, offset: u256, value: u256) {
        if offset > self.len() || self.len() - offset < 32 {
            revert_error(Panic::from(PANIC_INDEX_OUT_OF_BOUNDS))
        }
        // The complete word lies in this exclusively held owner's allocation.
        unsafe {
            *ptr::cast<u8, u256>(ptr::offset_bytes(self.data.ptr(), offset)) = value
        }
    }
    pub fn copy_from(mut self, offset: u256, source: MemSpan) {
        if offset > self.len() || source.len() as u256 > self.len() - offset {
            revert_error(Panic::from(PANIC_INDEX_OUT_OF_BOUNDS))
        }
        self.data.copy_from(dest_offset: offset as usize, source)
    }

    pub fn copy_calldata(mut self, offset: u256, source: CalldataView, len: u256) {
        if offset > self.len() || len > self.len() - offset {
            revert_error(Panic::from(PANIC_INDEX_OUT_OF_BOUNDS))
        }
        // The checked range lies in this exclusively held owner's allocation.
        unsafe {
            source.copy_to(ptr::offset_bytes(self.data.ptr(), offset), len)
        }
    }

    fn check_word(self, _ offset: u256) {
        if offset > self.len() || self.len() - offset < 32 {
            revert_error(Panic::from(PANIC_INDEX_OUT_OF_BOUNDS))
        }
    }

    // Exact output encodings: a buffer sized for the words written to it
    // checks its ranges once and then stores words unchecked.

    /// A buffer of `len` uninitialized bytes. The caller must write every
    /// byte before the buffer is read.
    pub unsafe fn uninit(_ len: u256) -> Self {
        unsafe {
            Buffer { data: MemBuffer::alloc_uninit(len as usize) }
        }
    }
    /// A zeroed ABI array tail for `count` elements of `stride` bytes, with
    /// its length word written.
    pub fn array(_ count: u256, stride: u256) -> Self {
        var data = Buffer::new(32 + count * stride)
        // The buffer holds the length word.
        unsafe {
            data.put(offset: 0, value: count)
        }
        data
    }
    /// An uninitialized ABI array tail for `count` elements of `stride`
    /// bytes, with its length word written. The caller must write every
    /// element byte before the buffer is read.
    pub unsafe fn uninit_array(_ count: u256, stride: u256) -> Self {
        var data = unsafe {
            Buffer::uninit(32 + count * stride)
        }
        // The buffer holds the length word.
        unsafe {
            data.put(offset: 0, value: count)
        }
        data
    }
    /// An unchecked `write`: the caller must ensure `offset + 32 <= len()`,
    /// typically because the buffer was sized for exactly these writes.
    pub unsafe fn put(mut self, offset: u256, value: u256) {
        // The complete word lies in this exclusively held owner's allocation.
        unsafe {
            *ptr::cast<u8, u256>(ptr::offset_bytes(self.data.ptr(), offset)) = value
        }
    }
    /// Fail with `Panic(0x32)` unless `offset..offset + len` lies in the
    /// buffer. One check can cover a run of `put`s.
    pub fn check_range(self, offset: u256, len: u256) {
        if offset > self.len() || len > self.len() - offset {
            revert_error(Panic::from(PANIC_INDEX_OUT_OF_BOUNDS))
        }
    }
    /// The size `32 + count * stride` of an array tail at `offset`, which
    /// must lie in the buffer (see `check_range`). Offsets within the tail
    /// can then be computed without overflow checks.
    pub fn check_array(self, offset: u256, count: u256, stride: u256) -> u256 {
        let size = 32 + count * stride
        self.check_range(offset, len: size)
        size
    }
    /// Copy `len` bytes of calldata from `source` to `offset`.
    pub fn copy_calldata_range(mut self, offset: u256, source: u256, len: u256)
    uses (ops: mut RawOps)
    {
        self.check_range(offset, len)
        ops.calldatacopy(
            dest: mut self.data,
            dest_offset: offset,
            src_offset: source,
            len,
        )
    }
    /// The buffer as the ABI tail of a `len` element array of static `T`.
    /// Fails unless the buffer is exactly the length word `len` and `len`
    /// element heads.
    pub fn into_dyn_array<T>(own self, len: u256) -> DynArray<T> where T: AbiSize {
        if T::IS_DYNAMIC {
            core::panic()
        }
        // `from_abi_tail` validates a static element array completely.
        unsafe {
            DynArray::from_abi_tail(data: self.data.ptr(), len: len as usize, size: self.len())
        }
    }
    /// The buffer as the ABI tail of a `len` element array of any `T`. The
    /// caller must ensure the buffer is the length word `len`, the element
    /// heads and valid tails ending at the buffer's end.
    pub unsafe fn into_dyn_array_unvalidated<T>(own self, len: u256) -> DynArray<T>
    where T: AbiSize
    {
        unsafe {
            DynArray::from_abi_tail(data: self.data.ptr(), len: len as usize, size: self.len())
        }
    }
}

#[test]
fn word_writes_preserve_unaligned_neighbors() {
    var data = Buffer::new(66)
    data.write(offset: 0, value: 0x1901 << 240)
    data.write(offset: 2, value: 7)
    data.write(offset: 34, value: 11)
    assert(data.word(2) == 7)
    assert(data.word(34) == 11)
    assert(data.span().byte_at(0) == 0x19)
    assert(data.span().byte_at(1) == 1)
}

/// Read a complete word from a checked byte range.
pub fn read_word(_ data: MemSpan, offset: u256) -> u256 {
    if offset > data.len() as u256 || data.len() as u256 - offset < 32 {
        revert_error(Panic::from(PANIC_INDEX_OUT_OF_BOUNDS))
    }
    unsafe {
        *ptr::cast<u8, u256>(ptr::offset_bytes(data.ptr(), offset))
    }
}

/// EVM output copying overwrites only the returned prefix of a scratch word.
/// Preserve its initial suffix without reading beyond the returned span.
pub fn return_word(_ returned: MemSpan, initial: u256) -> u256 {
    if returned.len() >= 32 {
        return read_word(returned, offset: 0)
    }
    var word = initial
    var i: usize = 0
    while i < returned.len() {
        let shift = (31 - i as u256) * 8
        word = (word & !((0xff as u256) << shift)) | ((returned.byte_at(i) as u256) << shift)
        i += 1
    }
    word
}

#[test]
fn short_returns_preserve_the_initial_suffix() {
    var data = Buffer::new(32)
    data.write(offset: 0, value: 0x1626ba7e << 224)
    assert(
        return_word(data.slice(offset: 0, len: 4), initial: 7) == (0x1626ba7e << 224) | 7,
    )
    assert(
        return_word(data.slice(offset: 0, len: 0), initial: 7) == 7,
    )
    assert(return_word(data.span(), initial: 7) == 0x1626ba7e << 224)
}

#[test(should_revert, panic = 0x32)]
fn word_write_cannot_cross_the_owned_extent() {
    var data = Buffer::new(33)
    data.write(offset: 2, value: 7)
}

#[test(should_revert, panic = 0x32)]
fn word_read_cannot_wrap_the_offset() {
    let data = Buffer::new(32)
    read_word(data.span(), offset: !(0 as u256))
}

#[test(should_revert, panic = 0x32)]
fn byte_copy_cannot_use_allocation_padding() {
    var data = Buffer::new(33)
    let source = Buffer::new(1)
    data.copy_from(offset: 33, source: source.span())
}
