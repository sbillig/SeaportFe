// OrderValidator._validateOrder, OrderFulfiller and the order event helpers.
use std::abi::{Bytes32, DynArray, MemVec}
use std::evm::{TSlot, Address, Call, Ctx, Log, RawOps, revert_error}
use super::buffer::Buffer
use super::amount::apply_fraction
use core::ptr::MemArray
use super::criteria::apply_criteria_resolvers
use super::errors::{
    BadFraction,
    InsufficientNativeTokensSupplied,
    InvalidNativeOfferItem,
    InvalidTime,
    MissingOriginalConsiderationItems,
    OrderFulfilled,
    PartialFillsNotEnabledForOrder,
}
use super::executor::{
    Accumulator,
    Transfer,
    new_accumulator,
    transfer,
    transfer_buffer,
    transfer_native_tokens,
    trigger_if_armed,
}
use super::hashing::{Env, derive_order_hash}
use super::model::{Book, Item, OrderState, Resolvers}
use super::signature::verify_signature
use super::status::{
    OrderStore,
    adjust_fill_fraction,
    clear_reentrancy_guard,
    get_counter,
    set_reentrancy_guard,
    raw_status,
    unpack_status,
    update_status,
    verify_order_status,
}
use super::types::{CONTRACT, NATIVE, ReceivedItem, SpentItem}
use super::zone::{
    assert_restricted_advanced_order_authorization,
    assert_restricted_advanced_order_validity,
    generate_order,
    install_generated_order,
}

/// `_verifyTime`: `start_time <= now < end_time`.
pub fn verify_time(start_time: u256, end_time: u256, revert_on_invalid: bool) -> bool
uses (ctx: Ctx)
{
    let valid = start_time <= ctx.timestamp() && end_time > ctx.timestamp()
    if revert_on_invalid && !valid {
        revert_error(InvalidTime { startTime: start_time, endTime: end_time })
    }
    valid
}

/// `_assertConsiderationLengthAndGetOrderHash`
pub fn consideration_length_checked_order_hash(_ book: Book, order: OrderState) -> u256
uses (store: OrderStore)
{
    if order.consideration_len < order.total_original {
        revert_error(MissingOriginalConsiderationItems {})
    }
    derive_order_hash(book, order, counter: get_counter(order.offerer))
}

/// `_validateOrder`: the order hash and the fraction that can be filled now,
/// or a zero fraction for an order that is not fillable (only when
/// `revert_on_invalid` is false). Contract orders yield `(1, 1, 1)`.
pub fn validate_order(_ env: Env, book: Book, order: OrderState, revert_on_invalid: bool) -> (
    u256,
    u256,
    u256,
)
uses (store: OrderStore, ctx: Ctx, call: Call, ops: RawOps)
{
    if !verify_time(
        start_time: order.start_time,
        end_time: order.end_time,
        revert_on_invalid,
    ) {
        return (0, 0, 0)
    }
    let numerator = order.numerator
    let denominator = order.denominator
    if order.order_type == CONTRACT as u256 {
        if numerator * denominator != 1 {
            revert_error(BadFraction {})
        }
        return (1, 1, 1)
    }
    if numerator > denominator || numerator == 0 {
        revert_error(BadFraction {})
    }
    if numerator < denominator && order.order_type & 1 == 0 {
        revert_error(PartialFillsNotEnabledForOrder {})
    }
    let order_hash = consideration_length_checked_order_hash(book, order)
    let raw_status = raw_status(order_hash)
    let status = unpack_status(raw_status)
    if !verify_order_status(
        order_hash,
        status,
        only_allow_unused: false,
        revert_on_invalid,
    ) {
        return (order_hash, 0, 0)
    }
    if !status.is_validated {
        verify_signature(
            env,
            offerer: order.offerer,
            order_hash,
            signature: order.signature,
        )
    }
    let (fill_numerator, fill_denominator) = adjust_fill_fraction(
        raw_status,
        numerator,
        denominator,
    )
    (order_hash, fill_numerator, fill_denominator)
}

/// `_applyFractions`: current amounts of the partial fill; offer items go to
/// `recipient`.
fn apply_fractions(
    _ items: mut MemArray<Item>,
    order: OrderState,
    numerator: u256,
    denominator: u256,
    recipient: Address,
)
uses (ctx: Ctx)
{
    var any_native = false
    var i: u256 = 0
    while i < order.offer_len {
        if apply_offer_fraction(
            mut items,
            order,
            index: i,
            numerator,
            denominator,
            recipient,
        ) {
            any_native = true
        }
        i += 1
    }
    if order.order_type < 4 && any_native {
        revert_error(InvalidNativeOfferItem {})
    }
    i = 0
    while i < order.consideration_len {
        apply_consideration_fraction(mut items, order, index: i, numerator, denominator)
        i += 1
    }
}

/// Returns whether the item is a native token item.
fn apply_offer_fraction(
    _ items: mut MemArray<Item>,
    order: OrderState,
    index: u256,
    numerator: u256,
    denominator: u256,
    recipient: Address,
) -> bool
uses (ctx: Ctx)
{
    let item = mut items[(order.offer_start + index) as usize]
    let amount = apply_fraction(
        start_amount: item.start_amount,
        end_amount: item.end_amount,
        numerator,
        denominator,
        start_time: order.start_time,
        end_time: order.end_time,
        round_up: false,
    )
    item.amount = amount
    item.original = amount
    item.receiver = recipient
    item.item_type == NATIVE as u256
}

fn apply_consideration_fraction(
    _ items: mut MemArray<Item>,
    order: OrderState,
    index: u256,
    numerator: u256,
    denominator: u256,
)
uses (ctx: Ctx)
{
    let item = mut items[(order.consideration_start + index) as usize]
    let amount = apply_fraction(
        start_amount: item.start_amount,
        end_amount: item.end_amount,
        numerator,
        denominator,
        start_time: order.start_time,
        end_time: order.end_time,
        round_up: true,
    )
    item.amount = amount
    item.original = amount
    item.receiver = item.recipient
}

pub fn item_transfer(_ item: Item) -> Transfer {
    Transfer {
        item_type: item.item_type,
        token: item.token,
        identifier: item.identifier,
        amount: item.amount,
        recipient: item.receiver,
    }
}

/// `_transferEach`: offer items from the offerer, consideration items from
/// the caller, then refund any native tokens left in the contract.
fn transfer_each(
    _ env: Env,
    items: mut MemArray<Item>,
    order: OrderState,
    fulfiller_conduit_key: u256,
    recipient: Address,
)
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    var i: u256 = 0
    while i < order.offer_len {
        let item = mut items[(order.offer_start + i) as usize]
        item.receiver = recipient
        i += 1
    }
    var buf = transfer_buffer(order.offer_len + order.consideration_len)
    var acc = new_accumulator()
    i = 0
    while i < order.offer_len {
        acc = transfer_offer_item(env, items, order, index: i, recipient, acc, mut buf)
        i += 1
    }
    i = 0
    while i < order.consideration_len {
        acc = transfer_consideration_item(
            env,
            items,
            order,
            index: i,
            fulfiller_conduit_key,
            acc,
            mut buf,
        )
        i += 1
    }
    let _ = trigger_if_armed(acc, mut buf, env)
    let balance = ctx.selfbalance()
    if balance != 0 {
        transfer_native_tokens(to: ctx.caller(), amount: balance)
    }
}

fn transfer_offer_item(
    _ env: Env,
    items: MemArray<Item>,
    order: OrderState,
    index: u256,
    recipient: Address,
    acc: Accumulator,
    buf: mut Buffer,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let item = ref items[(order.offer_start + index) as usize]
    transfer(
        item_transfer(item),
        from: order.offerer,
        conduit_key: order.conduit_key,
        acc,
        mut buf,
        env,
    )
}

fn transfer_consideration_item(
    _ env: Env,
    items: MemArray<Item>,
    order: OrderState,
    index: u256,
    fulfiller_conduit_key: u256,
    acc: Accumulator,
    buf: mut Buffer,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let item = ref items[(order.consideration_start + index) as usize]
    if item.item_type == NATIVE as u256 && item.amount > ctx.selfbalance() {
        revert_error(InsufficientNativeTokensSupplied {})
    }
    transfer(
        item_transfer(item),
        from: ctx.caller(),
        conduit_key: fulfiller_conduit_key,
        acc,
        mut buf,
        env,
    )
}

pub fn spent_items(_ book: Book, start: u256, count: u256) -> DynArray<SpentItem> {
    var out = MemVec<SpentItem>::zeroed(count)
    var i: u256 = 0
    while i < count {
        let item = ref book.items[(start + i) as usize]
        out.set(
            index: i,
            value: SpentItem {
                itemType: item.item_type.downcast_truncate(),
                token: item.token,
                identifier: item.identifier,
                amount: item.amount,
            },
        )
        i += 1
    }
    out.to_dyn_array()
}

pub fn received_items(_ book: Book, start: u256, count: u256) -> DynArray<ReceivedItem> {
    var out = MemVec<ReceivedItem>::zeroed(count)
    var i: u256 = 0
    while i < count {
        let item = ref book.items[(start + i) as usize]
        out.set(
            index: i,
            value: ReceivedItem {
                itemType: item.item_type.downcast_truncate(),
                token: item.token,
                identifier: item.identifier,
                amount: item.amount,
                recipient: item.receiver,
            },
        )
        i += 1
    }
    out.to_dyn_array()
}

pub fn emit_order_fulfilled(_ order_hash: u256, book: Book, order: OrderState, recipient: Address)
uses (log: mut Log)
{
    log.emit(
        OrderFulfilled {
            orderHash: Bytes32 { val: order_hash },
            offerer: order.offerer,
            zone: order.zone,
            recipient,
            offer: spent_items(book, start: order.offer_start, count: order.offer_len),
            consideration: received_items(
                book,
                start: order.consideration_start,
                count: order.consideration_len,
            ),
        },
    )
}

/// `_validateAndFulfillAdvancedOrder` for the single order of `book`.
///
/// Each phase uses scoped accesses to the order and item owners.
pub fn validate_and_fulfill_advanced_order(
    _ env: Env,
    book: mut Book,
    resolvers: Resolvers,
    fulfiller_conduit_key: u256,
    recipient: Address,
) -> bool
uses (
    store: mut OrderStore,
    guard_state: mut u256,
    transient_guard: mut TSlot<u256>,
    ctx: Ctx,
    call: mut Call,
    ops: mut RawOps,
    log: mut Log,
)
{
    let order_type = book.orders[(0) as usize].order_type
    set_reentrancy_guard(env, accept_native_tokens: order_type == CONTRACT as u256)
    if order_type != CONTRACT as u256 {
        fulfill_single_order(env, mut book, resolvers, fulfiller_conduit_key, recipient)
    } else {
        fulfill_single_contract_order(env, mut book, resolvers, fulfiller_conduit_key, recipient)
    }
    clear_reentrancy_guard(env)
    true
}

fn fulfill_single_order(
    _ env: Env,
    book: mut Book,
    resolvers: Resolvers,
    fulfiller_conduit_key: u256,
    recipient: Address,
)
uses (store: mut OrderStore, ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    let (order_hash, fill_numerator, fill_denominator) = prepare_single_order(
        env,
        mut book,
        resolvers,
        recipient,
    )
    authorize_single_order(book, order_hash, fill_numerator, fill_denominator)
    finish_single_order(
        env,
        mut book,
        order_hash,
        fulfiller_conduit_key,
        recipient,
    )
}

fn fulfill_single_contract_order(
    _ env: Env,
    book: mut Book,
    resolvers: Resolvers,
    fulfiller_conduit_key: u256,
    recipient: Address,
)
uses (store: mut OrderStore, ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    let _ = prepare_single_order(env, mut book, resolvers, recipient)
    let generated = generate_order(book, order_index: 0, revert_on_invalid: true)
    install_generated_order(mut book, order_index: 0, generated)
    finish_single_order(
        env,
        mut book,
        order_hash: generated.order_hash,
        fulfiller_conduit_key,
        recipient,
    )
}

/// Validate the order, resolve criteria and apply the fill fraction.
fn prepare_single_order(_ env: Env, book: mut Book, resolvers: Resolvers, recipient: Address) -> (
    u256,
    u256,
    u256,
)
uses (store: OrderStore, ctx: Ctx, call: Call, ops: RawOps)
{
    let (order_hash, fill_numerator, fill_denominator) = validate_order(
        env,
        book,
        order: ref book.orders[(0) as usize],
        revert_on_invalid: true,
    )
    apply_criteria_resolvers(mut book, resolvers)
    apply_fractions(
        mut book.items,
        order: ref book.orders[(0) as usize],
        numerator: fill_numerator,
        denominator: fill_denominator,
        recipient,
    )
    (order_hash, fill_numerator, fill_denominator)
}

/// `authorizeOrder` with the zone, then record the fill.
fn authorize_single_order(
    _ book: Book,
    order_hash: u256,
    fill_numerator: u256,
    fill_denominator: u256,
)
uses (store: mut OrderStore, ctx: Ctx, call: mut Call, ops: mut RawOps)
{
    var order_hashes = MemArray<u256>::new_zeroed(1)
    order_hashes[(0) as usize] = 0
    assert_restricted_advanced_order_authorization(
        book,
        order: ref book.orders[(0) as usize],
        order_hashes,
        order_hash,
        order_index: 0,
    )
    let _ = update_status(
        order_hash,
        numerator: fill_numerator,
        denominator: fill_denominator,
        revert_on_invalid: true,
    )
}

/// Transfers, `validateOrder` or `ratifyOrder`, and `OrderFulfilled`.
fn finish_single_order(
    _ env: Env,
    book: mut Book,
    order_hash: u256,
    fulfiller_conduit_key: u256,
    recipient: Address,
)
uses (ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    transfer_each(
        env,
        items: mut book.items,
        order: ref book.orders[(0) as usize],
        fulfiller_conduit_key,
        recipient,
    )
    var order_hashes = MemArray<u256>::new_zeroed(1)
    order_hashes[(0) as usize] = order_hash
    assert_restricted_advanced_order_validity(
        book,
        order: ref book.orders[(0) as usize],
        order_hashes,
        order_hash,
    )
    emit_order_fulfilled(
        order_hash,
        book,
        order: ref book.orders[(0) as usize],
        recipient,
    )
}
