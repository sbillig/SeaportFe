    assert_restricted_advanced_order_authorization,
    assert_restricted_advanced_order_validity,
    generate_order,
    install_generated_order,
}

/// `_verifyTime`: `start_time <= now < end_time`.
pub fn verify_time(start_time: u256, end_time: u256, revert_on_invalid: bool) -> bool
uses (ctx: Ctx)
{
    let valid = start_time <= ctx.timestamp() && end_time > ctx.timestamp()
    if revert_on_invalid && !valid {
        revert_error(InvalidTime { startTime: start_time, endTime: end_time })
    }
    valid
}

/// `_assertConsiderationLengthAndGetOrderHash`
pub fn consideration_length_checked_order_hash(_ book: ref Book, order: *OrderState) -> u256
uses (ops: RawOps)
{
    if order.consideration_len < order.total_original {
        revert_error(MissingOriginalConsiderationItems {})
    }
    derive_order_hash(book, order, counter: get_counter(order.offerer))
}

/// `_validateOrder`: the order hash and the fraction that can be filled now,
/// or a zero fraction for an order that is not fillable (only when
/// `revert_on_invalid` is false). Contract orders yield `(1, 1, 1)`.
pub fn validate_order(_ env: Env, book: ref Book, order: *OrderState, revert_on_invalid: bool) -> (
    u256,
    u256,
    u256,
)
uses (ctx: Ctx, call: Call, ops: RawOps)
{
    if !verify_time(
        start_time: order.start_time,
        end_time: order.end_time,
        revert_on_invalid,
    ) {
        return (0, 0, 0)
    }
    let numerator = order.numerator
    let denominator = order.denominator
    let order_type = checked_enum(order.order_type, variants: 5)
    if order_type == CONTRACT as u256 {
        if numerator * denominator != 1 {
            revert_error(BadFraction {})
        }
        return (1, 1, 1)
    }
    if numerator > denominator || numerator == 0 {
        revert_error(BadFraction {})
    }
    if numerator < denominator && order_type & 1 == 0 {
        revert_error(PartialFillsNotEnabledForOrder {})
    }
    let order_hash = consideration_length_checked_order_hash(book, order)
    let raw_status = ops.sload(status_slot(order_hash))
    let status = unpack_status(raw_status)
    if !verify_order_status(
        order_hash,
        status,
        only_allow_unused: false,
        revert_on_invalid,
    ) {
        return (order_hash, 0, 0)
    }
    if !status.is_validated {
        verify_signature(
            env,
            offerer: order.offerer,
            order_hash,
            signature: book.bytes(order.signature),
        )
    }
    let (fill_numerator, fill_denominator) = adjust_fill_fraction(
        raw_status,
        numerator,
        denominator,
    )
    (order_hash, fill_numerator, fill_denominator)
}

/// `_applyFractions`: current amounts of the partial fill; offer items go to
/// `recipient`.
fn apply_fractions(
    _ book: ref Book,
    order: *OrderState,
    numerator: u256,
    denominator: u256,
    recipient: Address,
)
uses (ctx: Ctx)
{
    let mut any_native = false
    let mut i: u256 = 0
    while i < order.offer_len {
        if apply_offer_fraction(book, order, index: i, numerator, denominator, recipient) {
            any_native = true
        }
        i += 1
    }
    if order.order_type < 4 && any_native {
        revert_error(InvalidNativeOfferItem {})
    }
    i = 0
    while i < order.consideration_len {
        apply_consideration_fraction(book, order, index: i, numerator, denominator)
        i += 1
    }
}

/// Returns whether the item is a native token item.
fn apply_offer_fraction(
    _ book: ref Book,
    order: *OrderState,
    index: u256,
    numerator: u256,
    denominator: u256,
    recipient: Address,
) -> bool
uses (ctx: Ctx)
{
    let item = book.offer_item(order, index)
    let amount = apply_fraction(
        start_amount: item.start_amount,
        end_amount: item.end_amount,
        numerator,
        denominator,
        start_time: order.start_time,
        end_time: order.end_time,
        round_up: false,
    )
    item.amount = amount
    item.original = amount
    item.receiver = recipient
    item.item_type == NATIVE as u256
}

fn apply_consideration_fraction(
    _ book: ref Book,
    order: *OrderState,
    index: u256,
    numerator: u256,
    denominator: u256,
)
uses (ctx: Ctx)
{
    let item = book.consideration_item(order, index)
    let amount = apply_fraction(
        start_amount: item.start_amount,
        end_amount: item.end_amount,
        numerator,
        denominator,
        start_time: order.start_time,
        end_time: order.end_time,
        round_up: true,
    )
    item.amount = amount
    item.original = amount
    item.receiver = item.recipient
}

pub fn item_transfer(_ item: *Item) -> Transfer {
    Transfer {
        item_type: item.item_type,
        token: item.token,
        identifier: item.identifier,
        amount: item.amount,
        recipient: item.receiver,
    }
}

/// `_transferEach`: offer items from the offerer, consideration items from
/// the caller, then refund any native tokens left in the contract.
fn transfer_each(
    _ env: Env,
    book: ref Book,
    order: *OrderState,
    fulfiller_conduit_key: u256,
    recipient: Address,
)
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let mut i: u256 = 0
    while i < order.offer_len {
        let item = book.offer_item(order, i)
        item.receiver = recipient
        i += 1
    }
    let buf = transfer_buffer(order.offer_len + order.consideration_len)
    let mut acc = new_accumulator()
    i = 0
    while i < order.offer_len {
        acc = transfer_offer_item(env, book, order, index: i, recipient, acc, buf)
        i += 1
    }
    i = 0
    while i < order.consideration_len {
        acc = transfer_consideration_item(
            env,
            book,
            order,
            index: i,
            fulfiller_conduit_key,
            acc,
            buf,
        )
        i += 1
    }
    let _ = trigger_if_armed(acc, buf, env)
    let balance = ctx.selfbalance()
    if balance != 0 {
        transfer_native_tokens(to: ctx.caller(), amount: balance)
    }
}

fn transfer_offer_item(
    _ env: Env,
    book: ref Book,
    order: *OrderState,
    index: u256,
    recipient: Address,
    acc: Accumulator,
    buf: *u8,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let item = book.offer_item(order, index)
    transfer(
        item_transfer(item),
        from: order.offerer,
        conduit_key: order.conduit_key,
        acc,
        buf,
        env,
    )
}

fn transfer_consideration_item(
    _ env: Env,
    book: ref Book,
    order: *OrderState,
    index: u256,
    fulfiller_conduit_key: u256,
    acc: Accumulator,
    buf: *u8,
) -> Accumulator
uses (ctx: Ctx, call: mut Call, ops: RawOps)
{
    let item = book.consideration_item(order, index)
    if item.item_type == NATIVE as u256 && item.amount > ctx.selfbalance() {
        revert_error(InsufficientNativeTokensSupplied {})
    }
    transfer(
        item_transfer(item),
        from: ctx.caller(),
        conduit_key: fulfiller_conduit_key,
        acc,
        buf,
        env,
    )
}

/// Encode an OrderFulfilled array directly into the final event buffer.
/// Model words are cleaned exactly as for the typed SpentItem/ReceivedItem
/// event fields; the mutable model itself retains its original raw words.
pub fn write_fulfilled_items(
    _ dst: *u8,
    book: ref Book,
    start: u256,
    count: u256,
    consideration: bool,
) {
    store_word(dst, count)
    let payload = ptr::offset_bytes(dst, 32)
    let stride: u256 = if consideration { 160 } else { 128 }
    let mut i: u256 = 0
    while i < count {
        let item = book.items.at(start + i)
        let out = ptr::offset_bytes(payload, i * stride)
        store_word(out, checked_enum(item.item_type, variants: 6))
        store_word(
            ptr::offset_bytes(out, 32),
            Address::from_word_truncate(item.token.inner).inner,
        )
        store_word(ptr::offset_bytes(out, 64), item.identifier)
        store_word(ptr::offset_bytes(out, 96), item.amount)
        if consideration {
            store_word(
                ptr::offset_bytes(out, 128),
                Address::from_word_truncate(item.receiver.inner).inner,
            )
        }
        i += 1
    }
}

pub fn emit_order_fulfilled(
    _ order_hash: u256,
    book: ref Book,
    order: *OrderState,
    recipient: Address,
)
uses (log: mut Log)
{
    // Non-indexed fields: hash, recipient, offer offset, consideration offset.
    let consideration_at = 160 + order.offer_len * 128
    let size = consideration_at + 32 + order.consideration_len * 160
    let data = ptr::alloc_bytes(size)
    store_word(data, order_hash)
    store_word(ptr::offset_bytes(data, 32), recipient.inner)
    store_word(ptr::offset_bytes(data, 64), 128)
    store_word(ptr::offset_bytes(data, 96), consideration_at)
    write_fulfilled_items(
        ptr::offset_bytes(data, 128),
        book,
        start: order.offer_start,
        count: order.offer_len,
        consideration: false,
    )
    write_fulfilled_items(
        ptr::offset_bytes(data, consideration_at),
        book,
        start: order.consideration_start,
        count: order.consideration_len,
        consideration: true,
    )
    log.log3(
        data: ptr::MemSpan::from_raw_parts(ptr: data, len: size),
        topic0: OrderFulfilled::TOPIC0,
        topic1: Address::from_word_truncate(order.offerer.inner).inner,
        topic2: Address::from_word_truncate(order.zone.inner).inner,
    )
}

/// `_validateAndFulfillAdvancedOrder` for the single order of `book`.
///
/// The phases are separate functions; Fe's borrow checker is much cheaper on
/// them than on one long body (ISSUES.md #9).
pub fn validate_and_fulfill_advanced_order(
    _ env: ref Env,
    book: ref Book,
    resolvers: Resolvers,
    fulfiller_conduit_key: u256,
    recipient: Address,
) -> bool
uses (ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    let order_type = checked_enum(book.order(0).order_type, variants: 5)
    set_reentrancy_guard(env, accept_native_tokens: order_type == CONTRACT as u256)
    if order_type != CONTRACT as u256 {
        fulfill_single_order(env, book, resolvers, fulfiller_conduit_key, recipient)
    } else {
        fulfill_single_contract_order(env, book, resolvers, fulfiller_conduit_key, recipient)
    }
    clear_reentrancy_guard(env)
    true
}

fn fulfill_single_order(
    _ env: Env,
    book: ref Book,
    resolvers: Resolvers,
    fulfiller_conduit_key: u256,
    recipient: Address,
)
uses (ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    let (order_hash, fill_numerator, fill_denominator) = prepare_single_order(
        env,
        book,
        resolvers,
        recipient,
    )
    authorize_single_order(book, order_hash, fill_numerator, fill_denominator)
    finish_single_order(env, book, order_hash, fulfiller_conduit_key, recipient)
}

fn fulfill_single_contract_order(
    _ env: Env,
    book: ref Book,
    resolvers: Resolvers,
    fulfiller_conduit_key: u256,
    recipient: Address,
)
uses (ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    let _ = prepare_single_order(env, book, resolvers, recipient)
    let generated = generate_order(book, order_index: 0, revert_on_invalid: true)
    let installed = install_generated_order(book, order_index: 0, generated)
    finish_single_order(
        env,
        book: ref installed,
        order_hash: generated.order_hash,
        fulfiller_conduit_key,
        recipient,
    )
}

/// Validate the order, resolve criteria and apply the fill fraction.
fn prepare_single_order(_ env: Env, book: ref Book, resolvers: Resolvers, recipient: Address) -> (
    u256,
    u256,
    u256,
)
uses (ctx: Ctx, call: Call, ops: RawOps)
{
    let (order_hash, fill_numerator, fill_denominator) = validate_order(
        env,
        book,
        order: book.order(0),
        revert_on_invalid: true,
    )
    apply_criteria_resolvers(book, resolvers)
    apply_fractions(
        book,
        order: book.order(0),
        numerator: fill_numerator,
        denominator: fill_denominator,
        recipient,
    )
    (order_hash, fill_numerator, fill_denominator)
}

/// `authorizeOrder` with the zone, then record the fill.
fn authorize_single_order(
    _ book: ref Book,
    order_hash: u256,
    fill_numerator: u256,
    fill_denominator: u256,
)
uses (ctx: Ctx, call: mut Call, ops: mut RawOps)
{
    let order_hashes = Arr<u256>::alloc(1)
    *order_hashes.at(0) = 0
    assert_restricted_advanced_order_authorization(
        book,
        order: book.order(0),
        order_hashes,
        order_hash,
        order_index: 0,
    )
    let _ = update_status(
        order_hash,
        numerator: fill_numerator,
        denominator: fill_denominator,
        revert_on_invalid: true,
    )
}

/// Transfers, `validateOrder` or `ratifyOrder`, and `OrderFulfilled`.
fn finish_single_order(
    _ env: Env,
    book: ref Book,
    order_hash: u256,
    fulfiller_conduit_key: u256,
    recipient: Address,
)
uses (ctx: Ctx, call: mut Call, ops: mut RawOps, log: mut Log)
{
    transfer_each(
        env,
        book,
        order: book.order(0),
        fulfiller_conduit_key,
        recipient,
    )
    let order_hashes = Arr<u256>::alloc(1)
    *order_hashes.at(0) = order_hash
    assert_restricted_advanced_order_validity(book, order: book.order(0), order_hashes, order_hash)
    emit_order_fulfilled(order_hash, book, order: book.order(0), recipient)
}
