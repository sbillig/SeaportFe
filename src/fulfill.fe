// OrderValidator._validateOrder, OrderFulfiller and the order event helpers.
use core::ptr
use std::evm::{Address, Call, Ctx, Event, Log, RawOps, revert_error}
use super::amount::apply_fraction
use super::arr::Arr
use super::criteria::apply_criteria_resolvers
use super::errors::{
    BadFraction,
    InsufficientNativeTokensSupplied,
    InvalidNativeOfferItem,
    InvalidTime,
    MissingOriginalConsiderationItems,
    OrderFulfilled,
    PartialFillsNotEnabledForOrder,
}
use super::executor::{
    Accumulator,
    Transfer,
    new_accumulator,
    transfer,
    transfer_buffer,
    transfer_native_tokens,
    trigger_if_armed,
}
use super::hashing::{Env, derive_order_hash}
use super::model::{Book, Item, OrderState, Resolvers, checked_enum}
use super::signature::verify_signature
use super::status::{
    adjust_fill_fraction,
    clear_reentrancy_guard,
    get_counter,
    set_reentrancy_guard,
    status_slot,
    unpack_status,
    update_status,
    verify_order_status,
}
use super::types::{CONTRACT, NATIVE}
use super::lowlevel::store_word
